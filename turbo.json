{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DEPLOY_TARGET",
    "DATA_SOURCE",
    "PUBLIC_SITE_URL",
    "PUBLIC_THIRDWEB_CLIENT_ID",
    "GITHUB_REPO_OWNER",
    "GITHUB_REPO_NAME",
    "GITHUB_BRANCH"
  ],
  "tasks": {
    "type-check": {
      "dependsOn": ["^type-check"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["type-check"],
      "outputs": ["coverage/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vercel/output/**"]
    }
  }
}
