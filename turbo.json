{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "type-check": {
      "dependsOn": ["^type-check"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["type-check"],
      "outputs": ["coverage/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vercel/output/**"]
    }
  }
}
