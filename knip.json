{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["apps/store/scripts/**", "cucumber.js", "khepri/**"],
  "ignoreDependencies": ["prettier", "secretlint", "@secretlint/secretlint-rule-preset-recommend"],
  "ignoreBinaries": ["wrangler.jsonc"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "features/steps/*.mjs"]
    },
    "apps/store": {
      "entry": ["src/pages/**/*.{astro,ts}", "src/scripts/*.ts", "e2e/*.spec.ts"]
    },
    "apps/com": {
      "entry": ["src/pages/**/*.astro"]
    },
    "packages/domain": {
      "entry": ["src/index.ts", "__tests__/*.test.ts"]
    },
    "packages/analytics": {
      "entry": ["src/index.ts", "__tests__/*.test.ts"]
    },
    "packages/auth": {
      "entry": ["src/index.ts", "__tests__/*.test.ts"]
    }
  }
}
