{
  // Deploy target for numinia.com (MISSION-012). Inert until the Oracle runs
  // `wrangler deploy`: nothing here reaches the internet by itself.
  //
  //   DEPLOY_TARGET=cloudflare npm run build --workspace=apps/store
  //   npx wrangler deploy
  //
  // Secrets are NEVER in this file. Set them once with:
  //   npx wrangler secret put THIRDWEB_SECRET_KEY
  //   npx wrangler secret put AUTH_SESSION_SECRET
  //   npx wrangler secret put ADMIN_WALLET_ADDRESSES
  //   npx wrangler secret put GITHUB_TOKEN        (only when the write path lands)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "numinia-web",
  "main": "apps/store/dist/server/entry.mjs",
  // The build lives HERE, not in the Cloudflare panel. Workers Builds runs
  // `npm ci`, then `npx wrangler deploy`; wrangler runs this command before
  // uploading. One script, versioned and reviewable, does what the retired
  // GitHub workflow did: env → fetch the lore → turbo build → seal
  // /version.json. The panel's "Build command" field stays EMPTY — anything
  // in it runs BEFORE this, without the env this script sets, and dies at
  // parseEnv (2026-09-17, builds 8eb4a759 and b1a44a52: the field held a
  // turbo command and wrangler was never reached). The one input the repo
  // cannot carry is PUBLIC_THIRDWEB_CLIENT_ID (a public client id, per
  // environment): a build variable in the Worker's Settings → Builds.
  "build": {
    "command": "node scripts/build-cloudflare.mjs"
  },
  "compatibility_date": "2026-08-15",
  // Astro's Cloudflare adapter also writes apps/store/dist/server/wrangler.json
  // (bindings it needs). This file is the DEPLOY config: domains + vars.
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs (MISSION-021): structured events, queryable in the dash,
  // free-tier 200k events/day. The API routes emit JSON lines (lib/telemetry).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "apps/store/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
  },
  "routes": [
    { "pattern": "numinia.com", "custom_domain": true },
    { "pattern": "www.numinia.com", "custom_domain": true },
  ],
  "vars": {
    "PUBLIC_SITE_URL": "https://numinia.com",
    "GITHUB_REPO_OWNER": "PabloFMM",
    "GITHUB_REPO_NAME": "numinia-digital-goods-data",
    "DATA_SOURCE": "fixture",
  },
  // The till's Oracle desk (MIS-184): the price room (LAP › Prices) reads the
  // tariff, checks a draft and schedules a dated version through it. A
  // service binding, not a URL: `OracleDesk` is a named RPC entrypoint of
  // the `numinia-till` Worker, and an RPC entrypoint has no address at all —
  // it answers only Workers that declare a binding to it, like this one, so
  // the desk stays unreachable from the internet even if the till gets a
  // route later. This Worker checks the Oracle's session before calling it;
  // the till re-validates every field. Deploy order, as Cloudflare asks for
  // bindings: the bound Worker first — numinia-till with its OracleDesk —
  // then this config. Until the desk is there, the room says the till did
  // not answer; nothing else on the site depends on it.
  //
  // The till's account desk («Saldo»): your balance and your organizations',
  // top-ups through Stripe, members. Same walls as the Oracle's desk:
  // `AccountDesk` is a second named RPC entrypoint of `numinia-till`, with no
  // address. This Worker reads the person's session first (any rank) and
  // passes its wallet; the till decides what that wallet may see or do. Same
  // deploy order: the till with its AccountDesk first, then this config.
  // Until it is there, «Saldo» says the till did not answer.
  "services": [
    { "binding": "TILL_ORACLE", "service": "numinia-till", "entrypoint": "OracleDesk" },
    { "binding": "TILL_ACCOUNTS", "service": "numinia-till", "entrypoint": "AccountDesk" },
    { "binding": "TILL_DNS", "service": "numinia-till", "entrypoint": "DnsDesk" },
    { "binding": "TILL_FLEET", "service": "numinia-till", "entrypoint": "FleetDesk" },
  ],
}
