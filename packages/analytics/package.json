{
  "name": "@numinia/analytics",
  "version": "0.22.0",
  "description": "Numinia analytics foundation — typed funnel events, consent-gated, privacy-first, transport-pluggable.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint src __tests__",
