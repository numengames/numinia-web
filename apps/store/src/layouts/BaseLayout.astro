---
import '@numinia/ui/tokens.css';
import '@numinia/ui/platform.css';
// Kit motion (§13.1 + integration) ships INLINE: the landing budget
// forbids external JS on Layer 0 pages, and the kit is ~2KB.
import kitMotion from '../scripts/sistema.js?raw';
import { DEFAULT_LOCALE, SUPPORTED_LOCALES, type SupportedLocale } from '@numinia/domain';
// The app shell (v3, «La ciudad y tú»): the city's rail on the left, yours
// on the right, the page between them; on a phone upright a header, a
// bottom bar and the «Tú» sheet instead (the rails' words, one list:
// lib/app-nav.ts).
import '../styles/shell.css';
import ChromeSprite from '../components/chrome/ChromeSprite.astro';
import CityRail from '../components/chrome/CityRail.astro';
import YouRail from '../components/chrome/YouRail.astro';
import PhoneHeader from '../components/chrome/PhoneHeader.astro';
import PhoneBar from '../components/chrome/PhoneBar.astro';
import RailScript from '../components/chrome/RailScript.astro';
import RailTips from '../components/chrome/RailTips.astro';
import ShellFooter from '../components/chrome/ShellFooter.astro';
import CookieNotice from '../components/chrome/CookieNotice.astro';
import Starfield from '../components/chrome/Starfield.astro';
import { APP_SHELL_UI } from '../i18n/app-shell';

interface Props {
  locale: SupportedLocale;
  title: string;
  /** Meta + OG description; every indexed page should pass one. */
  description?: string | undefined;
  /** The spike page opts out of the site chrome (internal, not in the sitemap). */
  chrome?: boolean;
  /** Platform surfaces fill the viewport instead of the reading column
      (in the app shell every page has the full width; pages read this
      attribute for their own bleed). */
  wide?: boolean;
  /** Share-card image; pages with their own visual (asset detail) override. */
  ogImage?: string | undefined;
}

// Font preloads: same files the kit CSS declares — Vite dedupes to one
// hashed URL, so the preload and the @font-face hit the same cache entry.
// Kills the swap-induced layout shift on text-first pages.
import geistWoff from '../../../../packages/ui/src/assets/fonts/Geist-Variable.woff2?url';
import geistMonoWoff from '../../../../packages/ui/src/assets/fonts/GeistMono-Variable.woff2?url';

const { locale, title, description, chrome = true, wide = false, ogImage } = Astro.props;
const shell = APP_SHELL_UI[locale];

/** OG locale codes (territory formats differ from our ids). */
const OG_LOCALES: Record<SupportedLocale, string> = {
  es: 'es_ES',
  en: 'en_US',
  ja: 'ja_JP',
  ko: 'ko_KR',
  'pt-br': 'pt_BR',
};

// SEO: canonical + hreflang alternates, derived from the current path.
// Locale variants share the path minus the locale prefix; en is unprefixed.
const site = (Astro.site?.toString() ?? '/').replace(/\/$/, '');
const localePrefix = locale === DEFAULT_LOCALE ? '' : `/${locale}`;
const basePath = Astro.url.pathname.startsWith(`${localePrefix}/`)
  ? Astro.url.pathname.slice(localePrefix.length)
  : Astro.url.pathname;
const urlFor = (target: SupportedLocale): string =>
  `${site}${target === DEFAULT_LOCALE ? '' : `/${target}`}${basePath}`;
---

<!doctype html>
<html lang={locale} data-modo="diurno">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      /* Sistema modes (§13.11): Diurno default, Nocturno by choice. Runs before
         first paint so a stored choice never flashes. localStorage is allowed
         here by decision D17 — this is chrome bootstrap, not component state. */
      /* Marks that JS is alive BEFORE first paint: the reveal animation may
         only hide content when something can bring it back (Layer 0/1 must
         render without JS, per the constitution). */
      document.documentElement.dataset.js = 'on';
      try {
        /* M-029: stored choice > OS preference > diurno default. */
        var sm = localStorage.getItem('numinia-modo');
        if (sm === 'nocturno') document.documentElement.dataset.modo = 'nocturno';
        else if (sm !== 'diurno' && matchMedia('(prefers-color-scheme: dark)').matches)
          document.documentElement.dataset.modo = 'nocturno';
        /* M-029: language auto-detect — first visit, root only, then stored. */
        if (!localStorage.getItem('numinia-lang') && location.pathname === '/') {
          var ls = ['es', 'en', 'ja', 'ko', 'pt-br'];
          var nl = (navigator.language || 'en').toLowerCase();
          var lt = nl.indexOf('pt') === 0 ? 'pt-br' : nl.slice(0, 2);
          if (ls.indexOf(lt) < 0) lt = 'en';
          localStorage.setItem('numinia-lang', lt);
          if (lt !== 'en') location.replace('/' + lt + '/');
        }
        if (localStorage.getItem('numinia-lap-nav') === 'plegado')
          document.documentElement.dataset.lapNav = 'plegado';
        /* v3 «La ciudad y tú»: each rail's fold, before the first paint —
           a phone on its side folds both; else the kept choice; else the
           width (≥ 1440 both open, 1024–1439 yours folded, below both).
           The same rule as lib/app-nav.ts railState (this script is inline). */
        var rw = innerWidth, rh = innerHeight;
        var folds = localStorage.getItem('numinia-sidebar') || '';
        var rail = function (side) {
          var kept = (new RegExp('(?:^|;)' + side + '=(\\w+)').exec(folds) || [])[1];
          if (side === 'city' && /^(expanded|collapsed)$/.test(folds)) kept = folds;
          if (rh <= 540 && rw > rh) return 'collapsed';
          if (kept === 'expanded' || kept === 'collapsed') return kept;
          if (rw >= 1440) return 'expanded';
          return rw >= 1024 && side === 'city' ? 'expanded' : 'collapsed';
        };
        document.documentElement.dataset.railCity = rail('city');
        document.documentElement.dataset.railYou = rail('you');
        var hidden = localStorage.getItem('numinia-lap-hidden');
        /* Never chosen: a quiet panel (lib/lap-sections.ts); '' is a choice. */
        if (hidden === null) hidden = 'codex,portals,loot,stats';
        if (hidden) document.documentElement.dataset.lapHidden = hidden.split(',').join(' ');
      } catch {}
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <link rel="preload" href={geistWoff} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoWoff} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlFor(locale)} />
    {/* The share card (Sistema: Noche + relieve + wordmark + the 1920·2020·2120
        seal). Absolute URL: scrapers resolve nothing relative. */}
    <meta property="og:image" content={ogImage ?? `${site}/og-card.png`} />
    <meta property="og:site_name" content="Numinia — Numen Games" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage ?? `${site}/og-card.png`} />
    <meta name="theme-color" content="#14110F" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    <link rel="canonical" href={urlFor(locale)} />
    {SUPPORTED_LOCALES.map((alt) => (
      <link rel="alternate" hreflang={alt} href={urlFor(alt)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={urlFor(DEFAULT_LOCALE)} />
    <slot name="head" />
  </head>
  <body>
    {/* The first stop of the keyboard: straight past the sidebar to the page. */}
    {
      chrome && (
        <a class="saltar" href="#contenido" data-metric="nav-skip">
          {shell.skip}
        </a>
      )
    }
    {/* The sky belongs to the site chrome: the chromeless book plane (Codex)
        keeps its paper, the internal spike keeps its one WebGL canvas. */}
    {chrome && <Starfield />}
    {chrome && <ChromeSprite basePath={basePath} />}
    {
      chrome ? (
        <div class="app">
          <CityRail locale={locale} basePath={basePath} />
          <div class="app-centro">
            <PhoneHeader locale={locale} basePath={basePath} />
            <main id="contenido" tabindex="-1" data-wide={wide ? '' : undefined}>
              <slot />
            </main>
            {/* A phone upright has no rails: the folded footer closes the
                page there (the legal links one scroll away). */}
            <div class="pie-movil">
              <ShellFooter locale={locale} where="page" />
            </div>
          </div>
          <YouRail locale={locale} basePath={basePath} />
        </div>
      ) : (
        <main class="plano" data-wide={wide ? '' : undefined}>
          <slot />
        </main>
      )
    }
    {chrome && <PhoneBar locale={locale} basePath={basePath} />}
    {chrome && <RailScript />}
    {chrome && <RailTips />}
    {/* Every page asks, the chromeless Codex included (LEG-003 §4). */}
    <CookieNotice />
    <script>
      // One module, inlined: the cookie notice's loader and the metrics it gates.
      import '../scripts/cookie-notice';
      import '../scripts/metrics';
    </script>
    <script is:inline>
      /* M-022 error beacon: no identity, max 3 per page. */
      (function () {
        var n = 0;
        function r(m, s) {
          if (n > 2) return;
          n += 1;
          try {
            navigator.sendBeacon(
              '/api/telemetry',
              new Blob(
                [
                  JSON.stringify({
                    message: String(m || '?').slice(0, 500),
                    source: String(s || '').slice(0, 300),
                    path: location.pathname.slice(0, 300),
                  }),
                ],
                { type: 'application/json' },
              ),
            );
          } catch (e) {}
        }
        addEventListener('error', function (e) {
          r(e.message, (e.filename || '') + ':' + (e.lineno || 0));
        });
        addEventListener('unhandledrejection', function (e) {
          r((e.reason && e.reason.message) || 'rejection', 'promise');
        });
      })();
    </script>
    <script is:inline set:html={kitMotion} />
  </body>
</html>

<style>
  /* Base surface and type come from the kit (body rule in sistema.css); the
     app shell's layout lives in styles/shell.css. What stays here is the
     chromeless planes' page (the Codex, the spike): the reading column
     numinia.org uses, 1100px with 24px sides. */
  .plano {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--numinia-space-5) var(--s5);
  }
  /* A fixed decorative canvas must never widen the page: clip, not hidden
     (hidden on <html> would kill the sticky bars). */
  :global(html) {
    overflow-x: clip;
  }

  /* Platform surfaces use the room they have — no vw hacks (Firefox counts
     the scrollbar in 50vw and the page would overflow). */
  .plano[data-wide] {
    max-width: none;
    padding: var(--s5) var(--s4) var(--s7);
  }
  @media (min-width: 100rem) {
    .plano[data-wide] {
      padding-inline: var(--s8);
    }
  }
</style>
