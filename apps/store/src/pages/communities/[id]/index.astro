---
import CommunityPage from '../../../components/communities/CommunityPage.astro';
import HousePage from '../../../components/communities/HousePage.astro';
import { COMMUNITIES } from '../../../components/communities/register';

export function getStaticPaths() {
  return COMMUNITIES.map((community) => ({ params: { id: community.id }, props: { community } }));
}

const { community } = Astro.props;
---

{
  community.state === 'founder' ? (
    <HousePage locale="en" community={community} />
  ) : (
    <CommunityPage locale="en" community={community} />
  )
}
