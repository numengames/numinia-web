---
import ManualChapter from "../../../../components/lap/codex/ManualChapter.astro";

/* On demand: the Manual is session-gated, so its text must never be baked
   into a static file (Oracle order 2026-08-15). */
export const prerender = false;

const { chapter } = Astro.params;
---

<ManualChapter locale="ko" chapterId={chapter ?? ''} />
