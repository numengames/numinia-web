---
import CodexCapituloPage from '../../../components/lap/codex/CodexCapituloPage.astro';
import { resolveCodexRoute } from '../../../lib/codex/routes';
import { codexLang } from '../../../lib/codex/source';

export const prerender = false;

const prefix = '';
const route = resolveCodexRoute(Astro.params.chapter ?? '', prefix, codexLang('en'));
if (route.kind === 'redirect') {
  return Astro.redirect(route.to, route.permanent ? 301 : 302);
}
---

<CodexCapituloPage locale="en" slug={route.slug} />
