---
import RitualPage from '../../../components/communities/RitualPage.astro';
import { RITUALS, communityOf } from '../../../components/communities/register';

export function getStaticPaths() {
  return RITUALS.map((ritual) => ({
    params: { id: ritual.id },
    props: { ritual, community: communityOf(ritual.community) },
  }));
}

const { ritual, community } = Astro.props;
---

<RitualPage locale="en" ritual={ritual} community={community} />
