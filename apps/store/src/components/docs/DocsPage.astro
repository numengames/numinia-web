---
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DOCS_MESSAGES } from '../../i18n/messages';
import { prevNext } from '../../lib/docs';
import { docPage, docsNav } from './content';

interface Props {
  locale: SupportedLocale;
  slug: string;
}

const { locale, slug } = Astro.props;
const t = DOCS_MESSAGES[locale];
// Content exists in en+ja only (original corpus); everyone else reads EN.
const contentLocale = locale === 'ja' ? 'ja' : 'en';
const page = docPage(contentLocale, slug);
if (!page) throw new Error(`Unknown doc: ${contentLocale}/${slug}`);
const nav = docsNav(contentLocale);
const { prev, next } = prevNext(nav, slug);
const prefix = locale === 'en' ? '' : `/${locale}`;
const hrefFor = (target: string): string =>
  `${prefix}/docs/${target === '' ? '' : `${target}/`}`;
const { Content } = page.module;
const description =
  typeof page.module.frontmatter['description'] === 'string'
    ? page.module.frontmatter['description']
    : undefined;
---

<BaseLayout locale={locale} title={`${page.title} — Numinia`} description={description}>
  <div class="layout">
    <nav aria-label={t.sidebarLabel}>
      <h2>{t.sidebarLabel}</h2>
      <ul>
        {
          nav.map((entry) => (
            <li class={entry.slug.includes('/') ? 'child' : ''}>
              <a
                href={hrefFor(entry.slug)}
                aria-current={entry.slug === slug ? 'page' : undefined}
                data-metric="docs-nav"
              >
                {entry.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <article data-doc={slug || 'index'}>
      {t.languageNotice && <p class="language-notice">{t.languageNotice}</p>}
      {page.legacy && <p class="legacy-banner" role="note" data-doc-legacy>{t.legacyBanner}</p>}
      <Content />
      <nav class="pager" aria-label={`${t.previousLabel} / ${t.nextLabel}`}>
        {
          prev ? (
            <a href={hrefFor(prev.slug)} rel="prev" data-metric="docs-prev">
              ← {prev.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={hrefFor(next.slug)} rel="next" data-metric="docs-next">
              {next.title} →
            </a>
          )
        }
      </nav>
    </article>
  </div>
</BaseLayout>

<style>
  /* Responsive audit 2026-08-16: wide content scrolls inside its own box —
     the page never scrolls sideways (house rule). Grid children default to
     min-width:auto, which lets content blow the column open — the pre can
     only scroll once every ancestor may shrink. */
  .layout > :global(*) {
    min-width: 0;
  }
  .pager {
    flex-wrap: wrap;
  }
  .pager :global(a) {
    overflow-wrap: anywhere;
    min-width: 0;
  }
  article :global(pre) {
    overflow-x: auto;
    max-width: 100%;
  }
  article :global(code) {
    overflow-wrap: anywhere;
  }
  article :global(table) {
    display: block;
    overflow-x: auto;
    max-width: 100%;
  }
  nav {
    min-width: 0;
  }
  nav :global(a) {
    overflow-wrap: anywhere;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(11rem, 1fr) minmax(0, 3fr);
    gap: var(--s5);
    align-items: start;
  }
  @media (max-width: 50rem) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
  /* §13.11 sidebar: group label as amber etiqueta. */
  nav h2 {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ambar);
  }
  nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  nav li {
    margin-bottom: var(--s1);
  }
  nav li.child {
    padding-left: var(--s3);
  }
  /* §13.11 sidebar rows: secondary ink; the active one dresses in ink. */
  nav a {
    display: inline-block;
    color: var(--texto-2);
    text-decoration: none;
    font-size: 0.9rem;
    padding: 2px var(--s2);
    border-radius: var(--radio-control);
  }
  nav a:hover {
    color: var(--texto);
  }
  nav a[aria-current='page'] {
    background: var(--texto);
    color: var(--fondo);
  }
  article {
    line-height: 1.65;
    max-width: 46rem;
  }
  article :global(h1) {
    color: var(--texto);
    letter-spacing: -0.02em;
  }
  article :global(a) {
    color: var(--enlace);
  }
  article :global(code) {
    font-family: var(--mono);
    background: var(--superficie);
    padding: 0.1rem 0.3rem;
    border-radius: var(--radio-control);
  }
  article :global(pre) {
    background: var(--superficie);
    border: 1px solid var(--linea);
    padding: var(--s3);
    border-radius: var(--radio-control);
    overflow-x: auto;
  }
  .language-notice {
    color: var(--texto-3);
    font-size: 0.875rem;
  }
  /* Khepri §9.7 aviso: surface + amber edge; text keeps mode contrast. */
  .legacy-banner {
    background: var(--superficie);
    border: 1px solid var(--linea-f);
    border-left: 2px solid var(--ambar);
    color: var(--texto);
    padding: var(--numinia-space-2);
    border-radius: var(--numinia-radius-sm);
    font-size: 0.85rem;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--s3);
    margin-top: var(--s7);
    border-top: 1px solid var(--linea-f);
    padding-top: var(--s3);
  }
  .pager a {
    color: var(--enlace);
    text-decoration: none;
  }
</style>
