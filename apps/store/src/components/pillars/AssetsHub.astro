---
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ASSETS_HUB_MESSAGES } from '../../i18n/pillars';
import {
  ARCHIVE_MESSAGES,
  DOCS_MESSAGES,
  FINDER_MESSAGES,
  GALLERY_MESSAGES,
  INSPECTOR_MESSAGES,
} from '../../i18n/messages';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = ASSETS_HUB_MESSAGES[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;

const CARDS = [
  {
    href: `${prefix}/gallery/`,
    title: GALLERY_MESSAGES[locale].galleryTitle,
    body: GALLERY_MESSAGES[locale].galleryIntro,
    metric: 'assets-gallery',
  },
  {
    href: `${prefix}/archive/`,
    title: ARCHIVE_MESSAGES[locale].archiveTitle,
    body: ARCHIVE_MESSAGES[locale].archiveIntro,
    metric: 'assets-archive',
  },
  {
    href: `${prefix}/finder/`,
    title: FINDER_MESSAGES[locale].finderTitle,
    body: FINDER_MESSAGES[locale].finderIntro,
    metric: 'assets-finder',
  },
  {
    href: `${prefix}/inspector/`,
    title: INSPECTOR_MESSAGES[locale].inspectorTitle,
    body: INSPECTOR_MESSAGES[locale].inspectorIntro,
    metric: 'assets-inspector',
  },
  {
    href: `${prefix}/docs/`,
    title: DOCS_MESSAGES[locale].docsTitle,
    body: t.resourcesCard,
    metric: 'assets-docs',
  },
] as const;
---

<BaseLayout locale={locale} title={`${t.assetsTitle} — Numinia`} description={t.assetsIntro}>
  <header>
    <h1>{t.assetsTitle}</h1>
    <p>{t.assetsIntro}</p>
  </header>
  <ul data-assets-hub>
    {
      CARDS.map((card) => (
        <li>
          <a href={card.href} class="tarjeta reveal" data-metric={card.metric}>
            <h2>{card.title}</h2>
            <p>{card.body}</p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  h1 {
    font-size: 2.488rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  header p {
    color: var(--texto-2);
    max-width: 65ch;
  }
  ul {
    list-style: none;
    padding: 0;
    margin-top: var(--s5);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--s4);
  }
  /* §9.4 tarjeta: titular titulo.s scaled down for grid, body in secondary. */
  a {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  h2 {
    margin: 0 0 var(--s2);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--texto);
  }
  a p {
    font-size: 0.875rem;
    line-height: 1.55;
    margin: 0;
    color: var(--texto-2);
  }
</style>
