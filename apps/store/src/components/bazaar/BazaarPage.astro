---
/**
 * The Bazaar's page (v0.83.0): its title and lead, then the island — the
 * Finder rethought, at the full width of the platform surfaces.
 */
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BAZAAR_MESSAGES } from '../../i18n/messages';
import { VIEWER_MESSAGES } from '../../i18n/viewer';
import { loadBazaarItems } from '../../lib/bazaar';
import { communityShelves } from '../../lib/goods';
import { AHORA_UI } from '../../i18n/ahora';
import { COMMUNITIES } from '../communities/register';
import { Bazaar } from './Bazaar';
import MovementsSection from './MovementsSection.astro';
import { MOVEMENTS_MESSAGES } from '../../i18n/movements';
import { MOVEMENTS } from '../../lib/movements';
import { fill } from '../../lib/bazaar-view';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = BAZAAR_MESSAGES[locale];
const a = AHORA_UI[locale];
const m = MOVEMENTS_MESSAGES[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;
const items = await loadBazaarItems(locale);
// «El de cada comunidad, si ha subido algo»: only the communities with goods, never a «· 0».
const shelves = communityShelves(COMMUNITIES, items.length);
---

<BaseLayout locale={locale} title={`${t.title} — Numinia`} description={t.lead} wide>
  <header class="bazaar-cabeza">
    <h1>{t.title}</h1>
    <p>{t.lead}</p>
    <p class="a-movimientos">
      <a class="estante" href="#movimientos" data-metric="bazaar-movements-jump">
        {fill(m.jump, { n: MOVEMENTS.length })}
      </a>
    </p>
  </header>
  {
    shelves.length > 0 && (
      <nav class="bazares" aria-label={a.shelvesLabel} data-bazaar-shelves>
        <p>{a.shelvesLine}</p>
        <ul>
          {shelves.map((shelf) => (
            <li>
              <a
                class="estante"
                href={`${prefix}/communities/${shelf.id}/`}
                data-metric="bazaar-community-shelf"
              >
                {shelf.name} · {shelf.count}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <Bazaar
    client:load
    items={items}
    labels={t}
    viewerLabels={VIEWER_MESSAGES[locale]}
    locale={locale}
  />
  <MovementsSection locale={locale} />
</BaseLayout>

<style>
  .bazaar-cabeza {
    margin-bottom: var(--s5);
  }
  .bazaar-cabeza h1 {
    margin: 0 0 var(--s2);
  }
  .bazaar-cabeza .a-movimientos {
    margin-top: var(--s3);
  }
  .bazaar-cabeza p {
    max-width: 62ch;
    margin: 0;
    font-size: 1.125rem;
    color: var(--texto-2);
  }
  /* The line of shelves per community, above the finder (v3). */
  .bazares {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s3);
    align-items: center;
    margin: 0 0 var(--s5);
  }
  .bazares p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--texto-2);
  }
  .bazares ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .estante {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 4px 12px;
    border: 1px solid color-mix(in srgb, var(--verdemar) 45%, transparent);
    border-radius: 999px;
    color: var(--verdemar);
    font: 500 0.7rem var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  .estante:hover,
  .estante:focus-visible {
    border-color: var(--verdemar);
    background: color-mix(in srgb, var(--verdemar) 12%, transparent);
  }
</style>

<style is:global>
  /* Island internals — global by necessity (Astro scoping stops at React).
     Three panes from a 56rem page (the island's WIDE_REM): filters, cards,
     preview + queue. Below it the preview opens as a sheet; below a 44rem
     page the filters ride above the cards as rows of chips. Since v0.112.0
     the page's width, not the window's, decides: two rails take theirs and
     fold on their own (the container `pagina` is the shell's <main>). */
  [data-bazaar] {
    --bazaar-arriba: 88px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s5);
    align-items: start;
  }
  [data-bazaar] > * {
    min-width: 0;
  }
  [data-bazaar] ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  [data-bazaar] .glyph {
    display: inline-flex;
    flex: none;
  }
  [data-bazaar] .glyph svg {
    width: 100%;
    height: 100%;
  }
  [data-bazaar] .mono {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
  }
  @container pagina (min-width: 44rem) {
    [data-bazaar] {
      grid-template-columns: 12.5rem minmax(0, 1fr);
    }
    [data-bazaar] .bazaar-filters {
      grid-column: 1;
      grid-row: 1;
    }
    [data-bazaar] .centro {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    [data-bazaar] .lado {
      grid-column: 1;
      grid-row: 2;
    }
  }
  /* The third pane exists only while a good is chosen (data-open): beside
     the 252px sidebar a reserved empty preview left the cards one column at
     1280 (v0.89.0). Closed, the queue rides under the filters. */
  @container pagina (min-width: 56rem) {
    [data-bazaar] {
      grid-template-columns: 13rem minmax(0, 1fr);
    }
    [data-bazaar][data-open] {
      grid-template-columns: 13rem minmax(0, 1fr) 21rem;
    }
    [data-bazaar][data-open] .centro {
      grid-row: 1;
    }
    [data-bazaar][data-open] .lado {
      grid-column: 3;
      grid-row: 1;
    }
    [data-bazaar][data-open] .bazaar-filters,
    [data-bazaar][data-open] .lado {
      position: sticky;
      top: var(--bazaar-arriba);
      max-height: calc(100vh - var(--bazaar-arriba) - var(--s4));
      overflow: auto;
      scrollbar-width: thin;
    }
  }
  /* From a 56rem to a 72rem page the three panes are tight: with the 13rem
     rail and the 21rem preview, a chosen good left ONE card per row. A
     slimmer rail and preview, and cards that may be 12rem wide, keep two
     (v0.91.0). The rail is slim closed as well, so opening a good never
     moves it. */
  @container pagina (min-width: 56rem) and (max-width: 71.99rem) {
    [data-bazaar] {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: var(--s4);
    }
    [data-bazaar][data-open] {
      grid-template-columns: 11rem minmax(0, 1fr) 18rem;
    }
    [data-bazaar][data-open] .bazaar-grid {
      grid-template-columns: repeat(auto-fill, minmax(min(12rem, 100%), 1fr));
    }
    [data-bazaar][data-open] .acciones {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @container pagina (max-width: 55.99rem) {
    /* The inline preview waits for a wide page; until the island knows
       the width, its empty state must not flash in the left column. */
    [data-bazaar] .previa {
      display: none;
    }
    /* Two panes beside two rails (a 1280 laptop): cards may be 12rem, so
       three still sit in a row. */
    [data-bazaar][data-bazaar] .bazaar-grid {
      grid-template-columns: repeat(auto-fill, minmax(min(12rem, 100%), 1fr));
    }
  }

  /* Filters (§13.11 rows: 36px, secondary text; the active row an ink pill). */
  [data-bazaar] .bazaar-filters h2 {
    font: 500 0.68rem var(--mono);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--texto-2);
    margin: 0 0 var(--s2);
  }
  [data-bazaar] .bazaar-filters .grupo + .grupo {
    margin-top: var(--s4);
  }
  [data-bazaar] .filtro {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 36px;
    padding: 0 10px;
    border: 0;
    border-radius: var(--radio-control);
    background: none;
    color: var(--texto-2);
    cursor: pointer;
    font: 400 0.93rem var(--sans);
    text-align: left;
    transition:
      background 120ms var(--ciclo),
      color 120ms var(--ciclo);
  }
  [data-bazaar] .filtro .n {
    margin-left: auto;
    font: 500 0.72rem var(--mono);
    color: var(--texto-2);
  }
  [data-bazaar] .filtro:hover {
    color: var(--texto);
    background: var(--superficie);
  }
  [data-bazaar] .filtro[aria-pressed='true'] {
    background: var(--texto);
    color: var(--fondo);
  }
  [data-bazaar] .filtro[aria-pressed='true'] .n {
    color: var(--fondo);
  }
  [data-bazaar] .filtro.sub {
    min-height: 32px;
    padding-left: 38px;
    font-size: 0.86rem;
    overflow-wrap: anywhere;
  }
  [data-bazaar] .formatos {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  [data-bazaar] .bazaar-filters .licencia p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--texto-2);
  }
  @container pagina (max-width: 43.99rem) {
    [data-bazaar] .bazaar-filters .grupo + .grupo {
      margin-top: var(--s3);
    }
    [data-bazaar] .clases {
      display: flex;
      gap: var(--s2);
      overflow-x: auto;
      padding-bottom: var(--s1);
      scrollbar-width: thin;
    }
    [data-bazaar] .clases > li {
      flex: none;
    }
    [data-bazaar] .clases .colecciones,
    [data-bazaar] .bazaar-filters .licencia {
      display: none;
    }
    [data-bazaar] .clases .filtro {
      width: auto;
      min-height: 40px;
      padding: 0 var(--s3);
      border: 1px solid var(--linea-f);
      border-radius: 999px;
    }
  }

  /* Chips (§9.3): Mono caps, full radius. */
  [data-bazaar] .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 1px solid var(--linea-f);
    border-radius: 999px;
    background: transparent;
    color: var(--texto-2);
    font: 500 0.68rem var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  [data-bazaar] .chip.vivo {
    color: var(--verdemar);
    border-color: color-mix(in srgb, var(--verdemar) 45%, transparent);
  }
  [data-bazaar] button.chip {
    min-height: 32px;
    cursor: pointer;
  }
  [data-bazaar] button.chip[aria-pressed='true'] {
    color: var(--texto);
    border-color: var(--verdemar);
    background: color-mix(in srgb, var(--verdemar) 12%, transparent);
  }

  /* The bar above the cards: search, count (the licence in sight), order. */
  [data-bazaar] .barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
    margin-bottom: var(--s4);
  }
  [data-bazaar] .busca {
    flex: 1 1 16rem;
    display: flex;
    align-items: center;
    gap: var(--s2);
    min-height: 44px;
    padding: 0 var(--s3);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-control);
    background: var(--superficie);
    color: var(--texto-2);
  }
  [data-bazaar] .busca:focus-within {
    outline: 2px solid #018ea1;
    outline-offset: 2px;
  }
  [data-bazaar] .busca input {
    flex: 1;
    align-self: stretch;
    min-width: 0;
    padding: var(--s2) 0;
    border: 0;
    background: transparent;
    color: var(--texto);
    font: inherit;
  }
  [data-bazaar] .busca input:focus-visible {
    outline: none;
  }
  [data-bazaar] .busca input::placeholder {
    color: var(--texto-2);
    opacity: 1;
  }
  [data-bazaar] .cuantos {
    margin: 0;
    font: 400 0.8rem var(--mono);
    color: var(--texto-2);
  }
  [data-bazaar] .orden {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    margin-left: auto;
    font-size: 0.875rem;
    color: var(--texto-2);
  }
  [data-bazaar] .orden select {
    min-height: 40px;
    padding: 0 var(--s2);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-control);
    background: var(--superficie);
    color: var(--texto);
    font: inherit;
  }
  [data-bazaar] .vacio {
    margin: 0;
    padding: var(--s6) var(--s4);
    border: 1px dashed var(--linea-f);
    border-radius: var(--radio-marco);
    color: var(--texto-2);
    text-align: center;
  }

  /* The cards (v0.89.0, «las fichas hay que darles una vuelta»): the picture
     first and large (4:3), the name, one quiet line — kind · format — and
     the licence as a small chip. */
  [data-bazaar] .bazaar-grid {
    display: grid;
    gap: var(--s4);
    grid-template-columns: repeat(auto-fill, minmax(min(13.5rem, 100%), 1fr));
  }
  @media (max-width: 30rem) {
    [data-bazaar] .bazaar-grid {
      gap: var(--s3);
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  [data-bazaar] .bazaar-grid > li {
    display: flex;
    min-width: 0;
  }
  [data-bazaar] .bazaar-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--linea);
    border-radius: var(--radio-marco);
    background: var(--superficie);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 120ms var(--ciclo);
  }
  [data-bazaar] .bazaar-card:hover {
    border-color: var(--verdemar);
  }
  [data-bazaar] .bazaar-card[aria-pressed='true'] {
    border-color: var(--turquesa);
    box-shadow: inset 0 0 0 1px var(--turquesa);
  }
  [data-bazaar] .bazaar-card .stage {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--elevada);
  }
  [data-bazaar] .bazaar-card .stage img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  [data-bazaar] .sin-foto {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s2);
    width: 100%;
    height: 100%;
    color: var(--texto-2);
    font: 500 0.75rem var(--mono);
    letter-spacing: 0.1em;
  }
  [data-bazaar] .en-cola {
    position: absolute;
    top: var(--s2);
    left: var(--s2);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border: 1px solid var(--verdemar);
    border-radius: 999px;
    background: var(--fondo);
    color: var(--texto);
    font: 500 0.68rem var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  [data-bazaar] .bazaar-card .cuerpo {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--s2);
    min-width: 0;
    padding: var(--s3);
  }
  [data-bazaar] .bazaar-card .nombre {
    display: -webkit-box;
    overflow: hidden;
    color: var(--texto);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  [data-bazaar] .bazaar-card .pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s2);
    min-width: 0;
    margin-top: auto;
  }
  [data-bazaar] .bazaar-card .tipo {
    min-width: 0;
    overflow: hidden;
    color: var(--texto-2);
    font-size: 0.8rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  [data-bazaar] .bazaar-card .chip {
    flex: none;
    padding: 2px 8px;
    font-size: 0.62rem;
  }

  /* The preview (§9.4 tarjeta): chips, stage, name, facts, actions. */
  [data-bazaar] .previa {
    padding: var(--s4);
  }
  [data-bazaar] .previa > .vacio {
    padding: var(--s5) var(--s3);
  }
  [data-bazaar] .previa-cuerpo {
    display: flex;
    flex-direction: column;
    gap: var(--s3);
  }
  [data-bazaar] .previa-cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s2);
  }
  [data-bazaar] .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  [data-bazaar] .cerrar {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: var(--radio-control);
    background: transparent;
    color: var(--texto-2);
    cursor: pointer;
  }
  [data-bazaar] .cerrar:hover {
    background: var(--superficie);
    color: var(--texto);
  }
  [data-bazaar] .escenario {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--linea);
    border-radius: var(--radio-control);
    background: var(--fondo);
  }
  [data-bazaar] .escenario img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* A picture on show is seen whole: never cropped to the stage. */
  [data-bazaar] .escenario img.entera {
    object-fit: contain;
  }
  [data-bazaar] .escenario video {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  [data-bazaar] .escenario.visor {
    aspect-ratio: auto;
    min-height: 16rem;
  }
  [data-bazaar] .escenario.visor > * {
    width: 100%;
  }
  [data-bazaar] .ver-3d {
    position: absolute;
    right: var(--s2);
    bottom: var(--s2);
    min-height: 36px;
    padding: 6px var(--s3);
    background: var(--fondo);
    font-size: 0.875rem;
  }
  /* Beside «See it in 3D» the kind's glyph rides higher, clear of the
     button: in the slim pane (v0.91.0) the stage is short and the button
     covered the label. */
  [data-bazaar] .escenario .sin-foto:has(+ .ver-3d) {
    padding-bottom: 3rem;
  }
  [data-bazaar] .previa-cuerpo audio {
    width: 100%;
  }
  [data-bazaar] .previa-cuerpo h2 {
    margin: 0;
    font-size: 1.35rem;
    overflow-wrap: anywhere;
  }
  [data-bazaar] .previa-cuerpo .linea {
    margin: 0;
    color: var(--texto-2);
    font-size: 0.9rem;
  }
  [data-bazaar] .datos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s2) var(--s4);
    margin: 0;
    padding: var(--s3) 0;
    border-block: 1px solid var(--linea);
  }
  [data-bazaar] .datos dt {
    font: 500 0.68rem var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--texto-2);
  }
  [data-bazaar] .datos dd {
    margin: 0;
    font-size: 0.92rem;
    overflow-wrap: anywhere;
  }
  [data-bazaar] .acciones {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s2);
  }
  [data-bazaar] .acciones > :first-child {
    grid-column: 1 / -1;
  }
  [data-bazaar] .acciones .btn {
    justify-content: center;
    padding-inline: var(--s3);
    font-size: 0.92rem;
    text-align: center;
    text-decoration: none;
  }
  [data-bazaar] .no-disponible {
    margin: 0;
    color: var(--texto-2);
    font-size: 0.9rem;
  }

  /* The queue: what goes in the zip, and the zip. */
  [data-bazaar] .cola {
    padding: var(--s4);
  }
  [data-bazaar] .previa + .cola {
    margin-top: var(--s4);
  }
  [data-bazaar] .cola h2 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 var(--s3);
    font-size: 0.95rem;
  }
  [data-bazaar] .cola h2 .mono {
    color: var(--texto-2);
    font-size: 0.8rem;
  }
  [data-bazaar] .cola .vacia {
    margin: 0;
    color: var(--texto-2);
    font-size: 0.875rem;
  }
  [data-bazaar] .cola ul {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: var(--s3);
  }
  [data-bazaar] .cola li {
    display: flex;
    align-items: center;
    gap: var(--s2);
    min-width: 0;
    color: var(--texto-2);
    font-size: 0.88rem;
  }
  [data-bazaar] .cola li .nombre {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    color: var(--texto);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  [data-bazaar] .cola li .mono {
    font-size: 0.72rem;
  }
  [data-bazaar] .quitar {
    display: inline-grid;
