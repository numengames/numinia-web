---
/**
 * The Oracle's asset table (MISSION-011). The page itself is static; the
 * DATA is not — it arrives from a session-gated endpoint, so what a visitor
 * without rank receives is a refusal, never a leak.
 */
import type { SupportedLocale } from '@numinia/domain';
import { ADMIN_ASSETS_MESSAGES } from '../../../i18n/admin-assets';
import { LAP_UI } from '../../../i18n/lap';
import { BAZAAR_MESSAGES } from '../../../i18n/messages';
import LapShell from '../LapShell.astro';
import { AdminAssets } from './AdminAssets';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = LAP_UI[locale];
---

<LapShell
  fullCanvas
  locale={locale}
  current="admin-assets"
  title={`${t.admin.assets} — LAP — Numinia`}
  description={t.admin.assetsIntro}
>
  <header class="cabecera">
    <h1>{t.admin.assets}</h1>
    <p class="intro">{t.admin.assetsIntro}</p>
  </header>
  <AdminAssets
    client:load
    labels={t.admin}
    edit={ADMIN_ASSETS_MESSAGES[locale]}
    kinds={BAZAAR_MESSAGES[locale].kinds}
  />
</LapShell>

<style>
  .cabecera {
    margin-bottom: var(--s5);
  }
  h1 {
    font-size: 2.074rem;
    font-weight: 400;
    letter-spacing: -0.025em;
    margin: 0 0 var(--s2);
  }
  .intro {
    color: var(--texto-2);
    max-width: 65ch;
    line-height: 1.55;
    margin: 0;
  }
</style>

<style is:global>
  /* §13.11 platform table: amber etiqueta header, 40px rows, Mono measures,
     the whole thing scrolling inside its own box on narrow screens. */
  [data-admin-assets] .controles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
    margin-bottom: var(--s4);
  }
  [data-admin-assets] input[type='search'] {
    flex: 1 1 16rem;
    min-height: 44px;
    padding: 10px var(--s4);
    font: inherit;
    color: inherit;
    background: var(--fondo);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-control);
  }
  [data-admin-assets] .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }
  [data-admin-assets] .filtros button {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    min-height: 32px;
    padding: 4px var(--s3);
    color: var(--texto-2);
    background: transparent;
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-control);
    cursor: pointer;
    transition:
      background 120ms var(--ciclo),
      color 120ms var(--ciclo);
  }
  [data-admin-assets] .filtros button[aria-pressed='true'] {
    background: var(--texto);
    border-color: var(--texto);
    color: var(--fondo);
  }
  [data-admin-assets] .cuenta {
    margin: 0 0 0 auto;
    color: var(--texto-3);
    font-size: 0.875rem;
  }
  [data-admin-assets] .tabla-envoltura {
    /* Positioned: the rows' visually hidden «opens GitHub» words (absolute)
       stay inside the scroll box instead of widening the page. */
    position: relative;
    overflow-x: auto;
    border: 1px solid var(--linea);
    border-radius: var(--radio-marco);
    background: var(--superficie);
  }
  [data-admin-assets] table {
    width: 100%;
    border-collapse: collapse;
  }
  [data-admin-assets] th {
    text-align: left;
    padding: var(--s2) var(--s4);
    border-bottom: 1px solid var(--linea-f);
    white-space: nowrap;
  }
  [data-admin-assets] th button {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ambar);
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  [data-admin-assets] th:not(:has(button)) {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ambar);
  }
  [data-admin-assets] td {
    padding: var(--s2) var(--s4);
    height: 40px;
    border-bottom: 1px solid var(--linea);
    vertical-align: middle;
  }
  [data-admin-assets] tbody tr {
    transition: background 120ms var(--ciclo);
  }
  [data-admin-assets] tbody tr:hover {
    background: var(--elevada);
  }
  [data-admin-assets] .nombre {
    display: block;
    color: var(--texto);
    font-weight: 500;
  }
  [data-admin-assets] .id {
    display: block;
    font-size: 0.75rem;
    color: var(--texto-3);
    overflow-wrap: anywhere;
  }
  [data-admin-assets] .secundario {
    color: var(--texto-2);
    font-size: 0.875rem;
  }
  [data-admin-assets] .formato {
    color: var(--turquesa);
    font-size: 0.75rem;
  }
  [data-admin-assets] .capas {
    display: inline-flex;
    gap: var(--s2);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }
  [data-admin-assets] .capas [data-on='yes'] {
    color: var(--verdemar);
  }
  [data-admin-assets] .capas [data-on='no'] {
    color: var(--texto-3);
    opacity: 0.5;
  }
  [data-admin-assets] .nota,
  [data-admin-assets] .estado {
    margin-top: var(--s4);
    color: var(--texto-2);
    font-size: 0.875rem;
  }
  [data-admin-assets] .refuso {
    max-width: 46rem;
    border-left: 2px solid var(--ambar);
  }
  [data-admin-assets] .refuso p {
    margin: 0 0 var(--s2);
    color: var(--texto-2);
  }
  [data-admin-assets] .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  /* v0.89.0 — the room edits through GitHub: «Añadir» (the one primary)
     unfolds the kinds; the publish line beside it; per row two quiet links. */
  [data-admin-assets] .editar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--s3) var(--s4);
    margin-bottom: var(--s4);
  }
  [data-admin-assets] .anadir > summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    list-style: none;
    cursor: pointer;
  }
  [data-admin-assets] .anadir > summary::-webkit-details-marker {
    display: none;
  }
  [data-admin-assets] .anadir-menu {
    max-width: 36rem;
    margin-top: var(--s2);
    padding: var(--s4);
  }
  [data-admin-assets] .anadir-menu p {
    margin: 0 0 var(--s3);
    color: var(--texto-2);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  [data-admin-assets] .anadir-menu ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  [data-admin-assets] .anadir-menu .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s1);
    min-height: 44px;
    padding-inline: var(--s4);
    text-decoration: none;
  }
  [data-admin-assets] .publica {
    flex: 1 1 18rem;
    align-self: center;
    margin: 0;
    color: var(--texto-2);
    font-size: 0.875rem;
  }
  [data-admin-assets] .acciones {
    display: inline-flex;
    gap: var(--s1);
    white-space: nowrap;
  }
  [data-admin-assets] .acciones .btn {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    min-height: 36px;
    padding: 4px var(--s2);
    font-size: 0.875rem;
    text-decoration: none;
  }
  [data-admin-assets] .acciones .borrar {
    color: var(--texto-2);
  }
  [data-admin-assets] .acciones .borrar:hover {
    color: var(--texto);
  }
  [data-admin-assets] .fuera {
    font-size: 0.75em;
    opacity: 0.7;
  }
  @media (max-width: 40rem) {
    [data-admin-assets] .acciones .btn {
      min-height: 44px;
    }
  }

  /* While the table loads («tarda un poquito»): a still skeleton of it. */
  [data-admin-assets] .esqueleto {
    margin-top: var(--s3);
  }
  [data-admin-assets] .fila-esqueleto {
    display: grid;
    grid-template-columns: 3fr 1fr 2fr 1fr;
    gap: var(--s4);
    align-items: center;
    height: 48px;
    padding: 0 var(--s4);
    border-bottom: 1px solid var(--linea);
  }
  [data-admin-assets] .fila-esqueleto .barra {
    display: block;
    height: 10px;
    border-radius: 6px;
    background: var(--elevada);
  }
  [data-admin-assets] .fila-esqueleto .larga {
    width: 80%;
  }
  [data-admin-assets] .fila-esqueleto .media {
    width: 60%;
  }
  [data-admin-assets] .fila-esqueleto .corta {
    width: 45%;
  }
</style>
