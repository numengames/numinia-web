---
/**
 * Settings (MISSION-010): what the platform can honestly offer today —
 * appearance, language, which sidebar sections you keep, your session, what
 * your rank grants (§Ranks, straight from the domain), and where your data
 * lives. Controls follow §9.8: switches are capsules, ON dresses in ink.
 */
import {
  PERMISSION_GROUPS,
  PERMISSIONS,
  RANK_DEFINITIONS,
  resolvePermissions,
  type SupportedLocale,
} from '@numinia/domain';
import { SETTINGS_UI } from '../../i18n/settings';
import { LAP_UI } from '../../i18n/lap';
import {
  NOTIFICATIONS_PATH,
  SETTINGS_PATH,
  localeHref,
  signInHref,
  signOutHref,
} from '../../lib/app-nav';
import { DEFAULT_HIDDEN, HIDEABLE_SECTIONS, isUnderConstruction } from '../../lib/lap-sections';
import { CURRENT_VERSION } from '../../lib/updates';
import Icon from '../chrome/Icon.astro';
import LapShell from './LapShell.astro';
import ProfileNameSection from './ProfileNameSection.astro';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = SETTINGS_UI[locale];
const lap = LAP_UI[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;

/** Sections a citizen may hide from the rail (chrome preference, D17). */
const HIDEABLE = HIDEABLE_SECTIONS;
/** What a first visit finds off, named in the page's language («Códice, Portales, Botín y Estadísticas»). */
const quietList = new Intl.ListFormat(locale === 'pt-br' ? 'pt-BR' : locale, {
  type: 'conjunction',
}).format(DEFAULT_HIDDEN.map((section) => lap.sections[section]));

/** What the first rank opens (Nomad: signed in, STD-003), against all there are. */
const nomadGrants = resolvePermissions('nomad');
const LANGUAGE_NAMES: Record<SupportedLocale, string> = {
  es: 'Español',
  en: 'English',
  ja: '日本語',
  ko: '한국어',
  'pt-br': 'Português',
};

/**
 * Wireframe v3 splits personal settings in five (cuenta / avisos / aspecto /
 * saldo / datos). First story (MIS-268): the five live as parts of this one
 * page, reached from a side navigation of anchors; no logic moved yet. The
 * anchors are the design's own slugs, so a later split into pages can keep
 * them as paths.
 */
const PARTS = [
  { id: 'cuenta', key: 'account', icon: 'user-circle' },
  { id: 'avisos', key: 'notices', icon: 'bell' },
  { id: 'aspecto', key: 'look', icon: 'palette' },
  { id: 'saldo', key: 'balance', icon: 'coins' },
  { id: 'datos', key: 'data', icon: 'archive' },
] as const;
---

<LapShell locale={locale} current="settings" title={`${t.title} — LAP — Numinia`} description={t.intro}>
  <article data-lap-settings>
    <h1>{t.title}</h1>
    <p class="intro">{t.intro}</p>

    <div class="ajustes">
      <nav class="partes" aria-labelledby="partes-titulo">
        <p id="partes-titulo" class="etiqueta">{t.parts.nav}</p>
        <ul>
          {
            PARTS.map((part) => (
              <li>
                <a href={`#${part.id}`} data-metric={`settings-part-${part.id}`}>
                  <Icon name={part.icon} size={18} />
                  {t.parts[part.key]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="partes-cuerpo">

        <section id="cuenta" class="parte" aria-labelledby="p-cuenta">
          <h2 id="p-cuenta">{t.parts.account}</h2>

          <!-- Session: the login lives here, contextual, never a wall (D16). -->
          <section aria-labelledby="s-session">
            <h3 id="s-session" class="etiqueta">{t.session}</h3>
            <div class="tarjeta sesion" data-session-card>
              <p data-session-out>{t.signedOut}</p>
              <p data-session-in hidden>{t.signedIn}</p>
              <dl data-session-in hidden>
                <div>
                  <dt>{t.rank}</dt>
                  <dd>
                    {
                      RANK_DEFINITIONS.map((rank) => (
                        <span data-rank-name={rank.id} hidden>
                          {rank.name[locale]}
                        </span>
                      ))
                    }
                  </dd>
                </div>
                <div>
                  <dt>{t.address}</dt>
                  <dd class="mono" data-session-short>—</dd>
                </div>
              </dl>
              <div class="acciones">
                <a
                  href={signInHref(locale, SETTINGS_PATH)}
                  class="btn btn-primario"
                  data-session-out
                  data-metric="settings-sign-in"
                >
                  {t.signIn}
                </a>
                <a
                  href={signOutHref(locale)}
                  class="btn btn-fantasma"
                  data-session-in
                  hidden
                  data-metric="settings-sign-out"
                >
                  {t.signOut}
                </a>
              </div>
            </div>
          </section>

          <!-- «Tu nombre en la ciudad» (cut «Tu nombre y tu cara», 2026-10-16): only with a session. -->
          <ProfileNameSection locale={locale} />

          <section aria-labelledby="s-permissions">
            <h3 id="s-permissions" class="etiqueta">{t.permissions}</h3>
            <div class="tarjeta">
              <p class="nota">{t.permissionsNote}</p>
              <ol class="rangos" data-rank-ladder>
                {
                  RANK_DEFINITIONS.map((rank, index) => (
                    <li data-rank-level={index} data-rank={rank.id}>
                      <span class="mono nivel">{index}</span>
                      <div>
                        <p class="nombre">{rank.name[locale]}</p>
                        <p class="grupo mono">{PERMISSION_GROUPS[index]?.toUpperCase()}</p>
                      </div>
                      <span
                        class="pildora"
                        data-estado="locked"
                        data-granted={t.granted}
                        data-locked={t.locked}
                      >
                        {t.locked}
                      </span>
                    </li>
                  ))
                }
              </ol>
              <p class="nota mono">
                {nomadGrants.size}/{PERMISSIONS.length} · {[...nomadGrants].join(' · ')}
              </p>
            </div>
          </section>
        </section>

        <section id="avisos" class="parte" aria-labelledby="p-avisos">
          <h2 id="p-avisos">{t.parts.notices}</h2>
          <div class="tarjeta">
            <p>{t.noticesNote}</p>
            <a
              class="ir"
              href={localeHref(locale, NOTIFICATIONS_PATH)}
              data-metric="settings-part-avisos-go"
            >
              <Icon name="arrow-right" size={16} />
              {t.noticesLink}
            </a>
          </div>
        </section>

        <section id="aspecto" class="parte" aria-labelledby="p-aspecto">
          <h2 id="p-aspecto">{t.parts.look}</h2>

          <section aria-labelledby="s-appearance">
            <h3 id="s-appearance" class="etiqueta">{t.appearance}</h3>
            <div class="tarjeta">
              <div class="fila">
                <span>{t.mode}</span>
                <div class="segmento" role="group" aria-label={t.mode}>
                  <button type="button" data-set-mode="diurno" data-metric="settings-mode-diurno">
                    <Icon name="sun" size={16} />
                    {t.modeDiurno}
                  </button>
                  <button type="button" data-set-mode="nocturno" data-metric="settings-mode-nocturno">
                    <Icon name="moon-stars" size={16} />
                    {t.modeNocturno}
                  </button>
                </div>
              </div>
              <p class="nota">
                <strong>{t.motion}.</strong>
                {t.motionNote}
              </p>
            </div>
          </section>

          <section aria-labelledby="s-language">
            <h3 id="s-language" class="etiqueta">{t.language}</h3>
            <div class="tarjeta">
              <div class="idiomas">
                {
                  (Object.keys(LANGUAGE_NAMES) as SupportedLocale[]).map((code) => (
                    <a
                      href={`${code === 'en' ? '' : `/${code}`}/lap/settings/`}
                      lang={code}
                      aria-current={code === locale ? 'true' : undefined}
                      data-metric={`settings-lang-${code}`}
                    >
                      {LANGUAGE_NAMES[code]}
                    </a>
                  ))
                }
              </div>
              <p class="nota">{t.languageNote}</p>
            </div>
          </section>

          <section aria-labelledby="s-sidebar">
            <h3 id="s-sidebar" class="etiqueta">{t.sidebar}</h3>
            <div class="tarjeta">
              <ul class="interruptores">
                {
                  HIDEABLE.map((section) => (
                    <li>
                      <label>
                        <span class="seccion">
                          {lap.sections[section]}
                          {isUnderConstruction(section) && (
                            <span class="obra">
                              <Icon name="crane-tower" size={14} />
                              {lap.building.label}
                            </span>
                          )}
                        </span>
                        <input
                          type="checkbox"
                          checked={!DEFAULT_HIDDEN.includes(section)}
                          data-section-toggle={section}
                          data-metric="settings-section-toggle"
                        />
                        <span class="pista" aria-hidden="true" />
                      </label>
                    </li>
                  ))
                }
              </ul>
              <p class="nota">{lap.quietPanel.replace('{list}', quietList)}</p>
              <p class="nota">{t.sidebarNote}</p>
            </div>
          </section>
        </section>

        <section id="saldo" class="parte" aria-labelledby="p-saldo">
          <h2 id="p-saldo">{t.parts.balance}</h2>
          <div class="tarjeta">
            <p>{t.balanceNote}</p>
            <a class="ir" href={localeHref(locale, '/saldo/')} data-metric="settings-part-saldo-go">
              <Icon name="arrow-right" size={16} />
              {t.balanceLink}
            </a>
          </div>
        </section>

        <section id="datos" class="parte" aria-labelledby="p-datos">
          <h2 id="p-datos">{t.parts.data}</h2>
          <div class="tarjeta">
            <p>{t.dataNote}</p>
          </div>

          <section aria-labelledby="s-about">
            <h3 id="s-about" class="etiqueta">{t.about}</h3>
            <div class="tarjeta">
              <dl class="acerca">
                <div>
                  <dt>{t.version}</dt>
                  <dd class="mono">
                    <a href={`${prefix}/updates/`} data-metric="settings-version">{CURRENT_VERSION}</a>
                  </dd>
                </div>
                <div>
                  <dt>{t.designSystem}</dt>
                  <dd class="mono">Sistema de Diseño v5.0.0</dd>
                </div>
                <div>
                  <dt>{t.sourceData}</dt>
                  <dd class="mono">
                    <a
                      href="https://github.com/PabloFMM/numinia-digital-goods-data"
                      target="_blank"
                      rel="noopener noreferrer"
                      data-metric="settings-data-repo"
                    >
                      numinia-digital-goods-data
                    </a>
                  </dd>
                </div>
              </dl>
            </div>
          </section>
        </section>
      </div>
    </div>
  </article>
</LapShell>

<script>
  import {
    LAP_HIDDEN_KEY,
    hiddenSections,
    isHideable,
    storedValue,
    withSection,
  } from '../../lib/lap-sections';

  /* Chrome preferences (D17: localStorage for chrome only). Without JS the
     page still reads, it just cannot toggle (the switches then show the
     default a first visit gets). */
  const root = document.documentElement;

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-set-mode]')) {
    button.addEventListener('click', () => {
      const mode = button.dataset['setMode'] ?? 'diurno';
      root.dataset['modo'] = mode;
      try {
        localStorage.setItem('numinia-modo', mode);
      } catch {
        /* private mode */
      }
      paintMode();
    });
  }
  function paintMode(): void {
    const current = root.dataset['modo'] === 'nocturno' ? 'nocturno' : 'diurno';
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-set-mode]')) {
      button.setAttribute('aria-pressed', String(button.dataset['setMode'] === current));
    }
  }
  paintMode();

  const HIDDEN_KEY = LAP_HIDDEN_KEY;
  const readStored = (): string | null => {
    try {
      return localStorage.getItem(HIDDEN_KEY);
    } catch {
      return null;
    }
  };
  /* Nothing stored = never chose: the quiet default. Any switch moved is
     stored as the person's choice — an empty value shows everything — and
     wins over the default from then on (lib/lap-sections.ts). */
  let hidden = hiddenSections(readStored());
  for (const input of document.querySelectorAll<HTMLInputElement>('[data-section-toggle]')) {
    const section = input.dataset['sectionToggle'];
    if (!isHideable(section)) continue;
    input.checked = !hidden.includes(section);
    input.addEventListener('change', () => {
      hidden = withSection(hidden, section, input.checked);
      try {
        localStorage.setItem(HIDDEN_KEY, storedValue(hidden));
      } catch {
        /* private mode */
      }
      root.dataset['lapHidden'] = hidden.join(' ');
    });
  }

  /* The session card's faces (`data-session-in/out`) and the ladder of
     ranks (`data-rank-ladder`, every rank up to yours granted) are painted
     by the chrome's one session read. Signing out is the shared link to
     the sign-in page, which disconnects the wallet first. */
</script>

<style>
  /* Responsive audit 2026-08-16: long Mono values wrap, never overflow,
     and the definition rows may fold on narrow phones. An 8px residue of
     layout overflow resists every element scan — clipped, root cause
     unresolved, noted honestly. */
  :global(main) {
    overflow-x: clip;
  }
  dd {
    overflow-wrap: anywhere;
    min-width: 0;
    max-width: 100%;
  }
  dl {
    flex-wrap: wrap;
  }

  h1 {
    font-size: 2.074rem;
    font-weight: 400;
    letter-spacing: -0.025em;
    margin-top: 0;
  }
  .intro {
    color: var(--texto-2);
    max-width: 65ch;
    line-height: 1.55;
  }
  section {
    margin-top: var(--s6);
  }
  h3 {
    margin: 0 0 var(--s3);
    font-weight: 500;
  }
  /* The five parts (wireframe v3 «Tus ajustes»): a side navigation of
     anchors beside the parts on a wide screen, a wrapping row above them
     on a narrow one. Rows mirror the panel's own side navigation (40px,
     icon 18, ink on hover); the part you jump to clears the phone header. */
  .ajustes {
    margin-top: var(--s5);
  }
  .partes ul {
    list-style: none;
    margin: var(--s2) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s2);
  }
  .partes a {
    display: flex;
    align-items: center;
    gap: var(--s2);
    min-height: 44px;
    padding: 0 var(--s3);
    border-radius: var(--radio-control);
    color: var(--texto-2);
    text-decoration: none;
    transition:
      color 120ms var(--ciclo),
      background 120ms var(--ciclo);
  }
  .partes a:hover,
  .partes a:focus-visible {
    color: var(--texto);
    background: var(--elevada);
  }
  .parte {
    scroll-margin-top: var(--s5);
  }
  .parte:first-child {
    margin-top: var(--s5);
  }
  .parte > h2 {
    margin: 0 0 var(--s4);
    font-size: 1.44rem;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .parte > section {
    margin-top: var(--s5);
  }
  .parte > h2 + section,
  .parte > h2 + :global(section) {
    margin-top: 0;
  }
  .ir {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    min-height: 44px;
    margin-top: var(--s2);
    color: var(--enlace);
    text-decoration: none;
  }
  .ir:hover,
  .ir:focus-visible {
    text-decoration: underline;
  }
  @media (min-width: 64rem) {
    .ajustes {
      display: grid;
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: var(--s6);
      align-items: start;
    }
    .partes {
      position: sticky;
      top: var(--s5);
    }
    .partes ul {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 2px;
    }
    .partes a {
      min-height: 40px;
    }
    .parte:first-child {
      margin-top: 0;
    }
  }
  @media (max-width: 767px) and (min-height: 541px) {
    .parte {
      scroll-margin-top: calc(56px + var(--s3));
    }
  }
  .tarjeta {
    max-width: 46rem;
  }
  .nota {
    color: var(--texto-2);
    font-size: 0.875rem;
    line-height: 1.55;
    margin: var(--s3) 0 0;
  }
  .fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    flex-wrap: wrap;
  }
  /* §9.8 segmented control: the chosen option dresses in ink. */
  .segmento {
    display: flex;
    gap: var(--s1);
  }
  .segmento button {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    min-height: 44px;
    padding: 0 var(--s4);
    font: inherit;
    font-size: 0.875rem;
    color: var(--texto-2);
    background: transparent;
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-control);
    cursor: pointer;
    transition:
      color 120ms var(--ciclo),
      background 120ms var(--ciclo);
  }
  .segmento button[aria-pressed='true'] {
    background: var(--texto);
    border-color: var(--texto);
    color: var(--fondo);
  }
  .idiomas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }
  .idiomas a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--s4);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-control);
    color: var(--texto-2);
    text-decoration: none;
  }
  .idiomas a[aria-current='true'] {
    background: var(--texto);
    border-color: var(--texto);
    color: var(--fondo);
  }
  /* §9.8 switch: capsule 36×20, disc 14, ON = ink. */
  .interruptores {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .interruptores label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    min-height: 44px;
    cursor: pointer;
  }
  .seccion {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s1) var(--s3);
  }
  /* «En construcción»: the same crane and words the rail shows, in amber
     (AA on the card in both modes). */
  .obra {
    display: inline-flex;
    align-items: center;
    gap: var(--s1);
    font-size: 0.75rem;
    color: var(--ambar);
  }
  .interruptores input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .pista {
    position: relative;
    flex: none;
    width: 36px;
    height: 20px;
    border-radius: var(--radio-completo);
    background: var(--superficie);
    border: 1px solid var(--linea-f);
    transition: background 120ms var(--ciclo);
  }
  .pista::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--texto-3);
    transition: transform 120ms var(--ciclo);
  }
  input:checked + .pista {
    background: var(--texto);
    border-color: var(--texto);
  }
  input:checked + .pista::after {
    background: var(--fondo);
    transform: translateX(16px);
  }
  input:focus-visible + .pista {
    outline: 2px solid #018ea1;
    outline-offset: 2px;
  }
  .rangos {
    list-style: none;
    margin: var(--s4) 0 0;
    padding: 0;
  }
  .rangos li {
    display: flex;
    align-items: center;
    gap: var(--s3);
    min-height: 40px;
    border-bottom: 1px solid var(--linea);
  }
  .nivel {
    color: var(--texto-3);
  }
  .rangos .nombre {
    margin: 0;
    font-size: 0.875rem;
    color: var(--texto);
  }
  .grupo {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--enlace);
  }
  .rangos li > div {
    flex: 1;
  }
  .pildora[data-estado='granted'] {
    color: var(--verdemar);
  }
  .pildora[data-estado='locked'] {
    /* §19.4: terciario only over the base background — the pill sits on a surface. */
    color: var(--texto-2);
  }
  .sesion .acciones {
    display: flex;
    gap: var(--s3);
    flex-wrap: wrap;
    margin-top: var(--s4);
  }
  .sesion .acciones a {
    text-decoration: none;
  }
  .sesion dl,
  .acerca {
    display: grid;
    gap: var(--s2) var(--s5);
    grid-template-columns: minmax(0, max-content) minmax(0, 1fr);
    margin: var(--s4) 0 0;
  }
  dt {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ambar);
  }
  dd {
    margin: 0;
    color: var(--texto-2);
  }
  dd a {
    color: var(--enlace);
    text-decoration: none;
  }
</style>
