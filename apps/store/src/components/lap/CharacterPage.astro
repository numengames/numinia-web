---
/**
 * Character page: builds localized options from the domain and hands them to
 * the sheet island. Styles live here (island markup is global to Astro).
 */
import {
  ARCHETYPES,
  COMPETENCES,
  DISTRICTS,
  FACTIONS,
  GUILDS,
  HUMORS,
  POSITIONS,
  SPECIES,
  type SupportedLocale,
} from '@numinia/domain';
import { LAP_UI } from '../../i18n/lap';
import LapShell from './LapShell.astro';
import { SheetIsland } from './sheet/SheetIsland';
import type { SheetOptions } from './sheet/sheet-props';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = LAP_UI[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;
const L = (text: Readonly<Record<string, string>>): string => text[locale] ?? text['en'] ?? '';
const opt = (items: ReadonlyArray<{ id: string; name: Readonly<Record<string, string>> }>) =>
  items.map((item) => ({ id: item.id, label: L(item.name) }));

const options: SheetOptions = {
  species: opt(SPECIES),
  positions: opt(POSITIONS),
  guilds: GUILDS.map((guild) => ({
    id: guild.id,
    label: L(guild.name),
    branches: guild.branches.map((branch) => ({
      id: branch.id,
      guildId: guild.id,
      label: L(branch.name),
      houses: branch.houses.map((house) => ({
        id: house.id,
        branchId: branch.id,
        label: L(house.name),
      })),
    })),
  })),
  factions: opt(FACTIONS),
  districts: opt(DISTRICTS),
  archetypes: opt(ARCHETYPES),
  humors: opt(HUMORS),
  competences: opt(COMPETENCES),
};
---

<LapShell
  locale={locale}
  current="character"
  title={`${t.sheet.title} — L.A.P. — Numinia`}
  description={t.sheet.fileNote}
>
  <h1>{t.sheet.title}</h1>
  {/* The reciprocal door (§4.9): the living sheet points at the manual's. */}
  <p class="anexo-enlace">
    <a href={`${prefix}/lap/codex/ficha/`} data-metric="lap-sheet-annex">{t.sheet.annexLink}</a>
  </p>
  <SheetIsland client:load options={options} labels={t.sheet} />
</LapShell>

<style>
  h1 {
    font-size: 2.074rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 0;
  }
  .anexo-enlace {
    margin: calc(-1 * var(--s2)) 0 var(--s3);
    font-size: 0.875rem;
  }
</style>

<style is:global>
  /* Sheet island internals (§9.3 fields, §13.11 rows, Mono for measures). */
  [data-lap-sheet] .nota {
    color: var(--texto-2);
    max-width: 65ch;
    line-height: 1.55;
  }
  [data-lap-sheet] .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin: var(--s4) 0;
  }
  /* Prestige/Prisma probes (§9.5): the figure in Mono, label as etiqueta. */
  [data-lap-sheet] .kpis {
    display: grid;
    gap: var(--s3);
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    max-width: 26rem;
    margin: 0 0 var(--s4);
  }
  [data-lap-sheet] .kpis .dato-xl {
    margin: 0;
    color: var(--texto);
    font-variant-numeric: tabular-nums;
  }
  [data-lap-sheet] .kpis .etiqueta {
    margin: var(--s1) 0 0;
  }
  /* Export PDF = print: the sheet alone, ink on paper — no chrome, no
     actions, no rail. The browser's own dialog does the file part
     (File Over App: the PDF lands wherever the citizen decides). */
  @media print {
    header,
    footer,
    [data-lap-shell] > nav,
    [data-lap-sheet] .acciones,
    [data-lap-sheet] .nota,
    [data-lap-sheet] .resultado {
      display: none !important;
    }
    .lap {
      display: block !important;
      min-height: 0 !important;
    }
    body {
      background: #fff !important;
      color: #000 !important;
    }
  }
  [data-lap-sheet] .resultado {
    background: var(--superficie);
    border: 1px solid var(--linea);
    border-left: 2px solid var(--ambar);
    border-radius: var(--radio-marco);
    padding: var(--s2) var(--s4);
  }
  [data-lap-sheet] .etiqueta {
    margin: var(--s6) 0 var(--s3);
    font-weight: 500;
  }
  [data-lap-sheet] .campos {
    display: grid;
    gap: var(--s3) var(--s5);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  [data-lap-sheet] label {
    display: flex;
    flex-direction: column;
    gap: var(--s1);
  }
  [data-lap-sheet] label > span {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--texto-3);
  }
  [data-lap-sheet] input,
  [data-lap-sheet] select,
  [data-lap-sheet] textarea {
    font: inherit;
    color: inherit;
    background: var(--fondo);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-control);
    padding: 8px var(--s3);
  }
  [data-lap-sheet] output,
  [data-lap-sheet] .notas {
    min-height: 1.4em;
    color: var(--texto);
  }
  [data-lap-sheet] .notas {
    white-space: pre-wrap;
    max-width: 65ch;
    line-height: 1.55;
  }
  [data-lap-sheet] .stats {
    display: grid;
    gap: var(--s5);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    align-items: start;
  }
  [data-lap-sheet] .stats ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  [data-lap-sheet] .stats li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    min-height: 36px;
    border-bottom: 1px solid var(--linea);
  }
  [data-lap-sheet] .stat-label {
    font-size: 0.875rem;
    color: var(--texto-2);
  }
  [data-lap-sheet] .stat-value {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    font-variant-numeric: tabular-nums;
  }
  [data-lap-sheet] .stats input {
    width: 4.5rem;
    text-align: right;
  }
  /* §9.1 silent button: a verb, sentence case, interactive Verdemar. */
  [data-lap-sheet] .stat-value button {
    font: inherit;
    font-size: 0.875rem;
    color: var(--enlace);
    background: transparent;
    border: none;
    border-radius: var(--radio-control);
    padding: var(--s1) var(--s2);
    cursor: pointer;
  }
  [data-lap-sheet] .stat-value button:hover,
  [data-lap-sheet] .stat-value button:focus-visible {
    text-decoration: underline;
  }
  /* Gear sections (MIS-085 D, Khepri EXTENSIÓN §7.5): full-width rows. */
  [data-lap-sheet] .filas-engranaje {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 34rem;
  }
  [data-lap-sheet] .filas-engranaje li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    min-height: 40px;
    border-bottom: 1px solid var(--linea);
  }
  [data-lap-sheet] .presupuesto {
    margin: 0 0 var(--s2);
    font-size: 0.8rem;
    color: var(--texto-2);
    font-variant-numeric: tabular-nums;
  }
  [data-lap-sheet] .presupuesto span {
    color: var(--texto-3);
  }
  [data-lap-sheet] .aviso-regla {
    max-width: 60ch;
    font-size: 0.85rem;
    color: var(--texto-2);
    border-left: 2px solid var(--ambar);
    padding-left: var(--s3);
  }
  [data-lap-sheet] .nota-regla {
    font-size: 0.85rem;
    color: var(--texto-3);
    max-width: 60ch;
  }
  [data-lap-sheet] .chip-regla {
    font-style: normal;
    font-size: 0.68rem;
    color: var(--ambar-texto, var(--texto-3));
    border: 1px solid var(--linea);
    border-radius: 999px;
    padding: 1px 7px;
    margin-left: var(--s2);
    white-space: nowrap;
  }
  /* The gears: presentation over a radio group. A set gear turns a quarter. */
  [data-lap-sheet] .engranajes {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  [data-lap-sheet] .engranajes .diente {
    position: relative;
    display: inline-flex;
    width: 26px;
    height: 26px;
    align-items: center;
    justify-content: center;
    color: var(--linea-f);
    cursor: pointer;
  }
  [data-lap-sheet] .engranajes .diente svg {
    width: 20px;
    height: 20px;
    transition: transform 0.35s ease, color 0.2s;
  }
  [data-lap-sheet] .engranajes .diente.puesto {
    color: var(--ambar);
  }
  [data-lap-sheet] .engranajes .diente.puesto svg {
    transform: rotate(90deg);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-lap-sheet] .engranajes .diente svg {
      transition: none;
    }
  }
  [data-lap-sheet] .engranajes input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  [data-lap-sheet] .engranajes input:focus-visible + svg,
  [data-lap-sheet] .engranajes input:focus-visible + .cero {
    outline: 2px solid var(--enlace);
    outline-offset: 2px;
    border-radius: 4px;
  }
  [data-lap-sheet] .engranajes .cero {
    font-size: 0.8rem;
    color: var(--texto-3);
  }
  [data-lap-sheet] .engranajes.vedado .diente {
    cursor: not-allowed;
    opacity: 0.35;
  }
  [data-lap-sheet] li:has(.engranajes.vedado) .stat-label {
    color: var(--texto-3);
  }
  [data-lap-sheet] .apt-nombre {
    flex: 1;
    min-width: 0;
  }
  /* Destructive door (§ data-loss warnings): Grana, never a primary. */
  [data-lap-sheet] .btn-peligro {
    color: var(--numinia-color-danger, #b02330);
    border: 1px solid currentColor;
    background: transparent;
  }
  [data-lap-sheet] .btn-peligro:hover,
  [data-lap-sheet] .btn-peligro:focus-visible {
    background: color-mix(in srgb, currentColor 8%, transparent);
  }
</style>
