---
/**
 * Character page: builds localized options from the domain and hands them to
 * the sheet island. Styles live here (island markup is global to Astro).
 */
import {
  ARCHETYPES,
  COMPETENCES,
  DISTRICTS,
  FACTIONS,
  GUILDS,
  HUMORS,
  POSITIONS,
  SPECIES,
  type SupportedLocale,
} from '@numinia/domain';
import { LAP_UI } from '../../i18n/lap';
import { PROFILE_UI } from '../../i18n/profile';
import LapShell from './LapShell.astro';
import { SheetIsland } from './sheet/SheetIsland';
import type { SheetOptions } from './sheet/sheet-props';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = LAP_UI[locale];
const p = PROFILE_UI[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;
// The manual's sheet is read where the Codex keeps it: its on-demand page
// (the Codex text never lands in a static file), fetched when opened.
const annexPage = `${prefix}/lap/codex/ficha/`;
const annexMd = locale === 'es' ? '/api/codex/ficha.md' : '/api/codex/ficha.en.md';
const L = (text: Readonly<Record<string, string>>): string => text[locale] ?? text['en'] ?? '';
const opt = (items: ReadonlyArray<{ id: string; name: Readonly<Record<string, string>> }>) =>
  items.map((item) => ({ id: item.id, label: L(item.name) }));

const options: SheetOptions = {
  species: opt(SPECIES),
  positions: opt(POSITIONS),
  guilds: GUILDS.map((guild) => ({
    id: guild.id,
    label: L(guild.name),
    branches: guild.branches.map((branch) => ({
      id: branch.id,
      guildId: guild.id,
      label: L(branch.name),
      houses: branch.houses.map((house) => ({
        id: house.id,
        branchId: branch.id,
        label: L(house.name),
      })),
    })),
  })),
  factions: opt(FACTIONS),
  districts: opt(DISTRICTS),
  archetypes: opt(ARCHETYPES),
  humors: opt(HUMORS),
  competences: opt(COMPETENCES),
};
---

<LapShell
  locale={locale}
  current="character"
  title={`${t.sheet.title} — LAP — Numinia`}
  description={t.sheet.fileNote}
>
  <h1>{t.sheet.title}</h1>
  {
    /* The reciprocal door (§4.9), now inside the page (Pablo, 2026-10-14: «el
       códice no te debería sacar al códice entero»): the manual's sheet opens
       here, read from the Codex's own page with this visitor's session — so
       a signed-out visitor sees exactly what the Codex shows them. */
  }
  <details class="anexo" data-sheet-annex data-src={annexPage}>
    <summary data-metric="lap-sheet-annex">{p.annex.summary}</summary>
    <div class="anexo-int">
      <p class="anexo-pista">{p.annex.hint}</p>
      <div class="anexo-cuerpo" data-annex-body aria-live="polite">
        <p class="anexo-pista">{p.annex.loading}</p>
      </div>
      <p class="anexo-fallo" data-annex-failed hidden>
        {p.annex.failed}
        <a href={annexPage} data-metric="lap-sheet-annex-page">{t.sheet.annexLink}</a>
      </p>
      <p class="anexo-pie">
        <a href={annexMd} download data-metric="lap-sheet-annex-md">{p.annex.download}</a>
      </p>
    </div>
  </details>
  <SheetIsland client:load options={options} labels={t.sheet} layout={p.sheet} />
</LapShell>

<script>
  /* Opens the manual's sheet inside the page: the first time the panel is
     opened, read the Codex page (same origin, the session cookie goes with
     it) and adopt its body — parsed, never written as a string. */
  const annex = document.querySelector<HTMLDetailsElement>('[data-sheet-annex]');
  const body = annex?.querySelector<HTMLElement>('[data-annex-body]');
  const failed = annex?.querySelector<HTMLElement>('[data-annex-failed]');
  let asked = false;
  annex?.addEventListener('toggle', () => {
    if (!annex.open || asked || !body || !failed) return;
    asked = true;
    const src = annex.dataset['src'] ?? '';
    fetch(src, { credentials: 'same-origin', headers: { accept: 'text/html' } })
      .then((response) => (response.ok ? response.text() : Promise.reject(new Error('status'))))
      .then((html) => {
        const page = new DOMParser().parseFromString(html, 'text/html');
        const cuerpo = page.querySelector('.pliego .cuerpo') ?? page.querySelector('.cuerpo');
        if (!cuerpo) throw new Error('empty');
        cuerpo.querySelectorAll('script, style, iframe').forEach((node) => node.remove());
        body.replaceChildren(
          ...Array.from(cuerpo.childNodes, (node) => document.importNode(node, true)),
        );
      })
      .catch(() => {
        body.replaceChildren();
        failed.hidden = false;
      });
  });
</script>

<style>
  h1 {
    font-size: 2.074rem;
    font-weight: 400;
    letter-spacing: -0.025em;
    margin-top: 0;
  }
  .anexo {
    margin: calc(-1 * var(--s2)) 0 var(--s4);
    background: var(--superficie);
    border: 1px solid var(--linea);
    border-radius: var(--radio-marco);
  }
  .anexo summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--s4);
    color: var(--enlace);
    cursor: pointer;
  }
  .anexo-int {
    padding: 0 var(--s4) var(--s4);
    border-top: 1px solid var(--linea);
  }
  .anexo-pista,
  .anexo-fallo {
    font-size: 0.875rem;
    color: var(--texto-2);
  }
  .anexo-fallo[hidden] {
    display: none;
  }
  .anexo-pie {
    margin: var(--s3) 0 0;
    font-size: 0.875rem;
  }
</style>

<style is:global>
  /* The manual's sheet, adopted from the Codex page: its own markup, read
     here in the panel's quiet register (tables scroll on a phone). */
  [data-annex-body] {
    max-width: 72ch;
    line-height: 1.55;
    color: var(--texto);
    overflow-x: auto;
  }
  [data-annex-body] h2,
  [data-annex-body] h3 {
    margin: var(--s5) 0 var(--s2);
    font-size: 1rem;
    font-weight: 600;
  }
  [data-annex-body] p {
    margin: 0 0 var(--s2);
  }
  [data-annex-body] table {
    border-collapse: collapse;
    margin: 0 0 var(--s3);
    font-size: 0.875rem;
  }
  [data-annex-body] th,
  [data-annex-body] td {
    padding: var(--s1) var(--s3);
    border-bottom: 1px solid var(--linea);
    text-align: left;
  }
  /* The sheet's head: portrait, name, the two probes. */
  [data-lap-sheet] .ficha-cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s4) var(--s5);
    padding: var(--s4);
    background: var(--superficie);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-marco);
  }
  [data-lap-sheet] .retrato-ficha {
    flex: none;
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    overflow: hidden;
    background: var(--fondo);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-marco);
  }
  [data-lap-sheet] .retrato-ficha img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  [data-lap-sheet] .monograma {
    font-size: 2rem;
    color: var(--texto-2);
  }
  [data-lap-sheet] .ficha-quien {
    flex: 1 1 12rem;
    min-width: 0;
  }
  [data-lap-sheet] .ficha-nombre {
    margin: 0;
    font-size: 1.44rem;
    font-weight: 600;
    color: var(--texto);
    overflow-wrap: anywhere;
  }
  [data-lap-sheet] .ficha-sub,
  [data-lap-sheet] .ficha-pista {
    margin: var(--s1) 0 0;
    font-size: 0.875rem;
    color: var(--texto-2);
  }
  [data-lap-sheet] .ficha-cabeza .kpis {
    margin: 0;
    min-width: 14rem;
  }
  /* A blank sheet: one door. */
  [data-lap-sheet] .ficha-vacia {
    padding: var(--s6) var(--s5);
    background: var(--superficie);
    border: 1px dashed var(--linea-f);
    border-radius: var(--radio-marco);
  }
  [data-lap-sheet] .ficha-vacia h2 {
    margin: 0 0 var(--s2);
    font-size: 1.44rem;
    font-weight: 600;
  }
  [data-lap-sheet] .ficha-vacia p {
    margin: 0;
    max-width: 60ch;
    line-height: 1.55;
    color: var(--texto-2);
  }
  [data-lap-sheet] .ficha-vacia .acciones {
    margin-bottom: 0;
  }
  /* Identity in three groups: label and value on one line. */
  [data-lap-sheet] .grupos-identidad {
    display: grid;
    gap: var(--s4) var(--s5);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    align-items: start;
  }
  [data-lap-sheet] .grupo-identidad h3 {
    margin: 0 0 var(--s2);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--texto);
  }
  [data-lap-sheet] .grupo-identidad .campos {
    grid-template-columns: 1fr;
  }
  [data-lap-sheet] .grupo-identidad dl {
    margin: 0;
  }
  [data-lap-sheet] .grupo-identidad dl > div {
    display: flex;
    justify-content: space-between;
    gap: var(--s3);
    min-height: 36px;
    align-items: center;
    border-bottom: 1px solid var(--linea);
  }
  [data-lap-sheet] .grupo-identidad dt {
    font-size: 0.875rem;
    color: var(--texto-2);
  }
  [data-lap-sheet] .grupo-identidad dd {
    margin: 0;
    text-align: right;
    color: var(--texto);
    overflow-wrap: anywhere;
  }
  [data-lap-sheet] .grupo-identidad .vacio dd {
    color: var(--texto-3);
  }
  /* Characteristics in view: a compact two-column grid of dots. */
  [data-lap-sheet] .filas-engranaje.rejilla {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--s5);
    max-width: 48rem;
  }
  @media (max-width: 34rem) {
    [data-lap-sheet] .filas-engranaje.rejilla {
      grid-template-columns: 1fr;
    }
  }
  [data-lap-sheet] .puntos-escala {
    display: inline-flex;
    gap: 3px;
  }
  [data-lap-sheet] .puntos-escala i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--linea-f);
  }
  [data-lap-sheet] .puntos-escala i.lleno {
    background: var(--ambar);
    border-color: var(--ambar);
  }
  [data-lap-sheet] .cifra {
    min-width: 1ch;
    text-align: right;
  }
  [data-lap-sheet] .stats ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    column-gap: var(--s5);
    max-width: 48rem;
  }
  /* Sheet island internals (§9.3 fields, §13.11 rows, Mono for measures). */
  [data-lap-sheet] .nota {
    color: var(--texto-2);
    max-width: 65ch;
    line-height: 1.55;
  }
  [data-lap-sheet] .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin: var(--s4) 0;
  }
  /* Prestige/Prisma probes (§9.5): the figure in Mono, label as etiqueta. */
  [data-lap-sheet] .kpis {
    display: grid;
    gap: var(--s3);
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    max-width: 26rem;
    margin: 0 0 var(--s4);
  }
  [data-lap-sheet] .kpis .dato-xl {
    margin: 0;
    color: var(--texto);
    font-variant-numeric: tabular-nums;
  }
  [data-lap-sheet] .kpis .etiqueta {
    margin: var(--s1) 0 0;
  }
  /* Export PDF = print: the sheet alone, ink on paper — no chrome, no
     actions, no rail. The browser's own dialog does the file part
     (File Over App: the PDF lands wherever the citizen decides). */
  @media print {
    header,
    footer,
    [data-lap-shell] > nav,
    [data-sheet-annex],
    [data-lap-sheet] .acciones,
    [data-lap-sheet] .nota,
    [data-lap-sheet] .resultado {
      display: none !important;
    }
    .lap {
      display: block !important;
      min-height: 0 !important;
    }
    /* One house criterion for paper: the sheet prints like the book and like
       the corpus PDFs — Arena paper, Noche ink (§3 Diurno, kit @media print).
       Pure white and pure black were the only place the platform printed
       outside the Sistema. */
    body {
      background: #f9ebdc !important;
      color: #14110f !important;
    }
  }
  [data-lap-sheet] .resultado {
    background: var(--superficie);
    border: 1px solid var(--linea);
    border-left: 2px solid var(--ambar);
    border-radius: var(--radio-marco);
    padding: var(--s2) var(--s4);
  }
  [data-lap-sheet] .etiqueta {
    margin: var(--s6) 0 var(--s3);
    font-weight: 500;
  }
  [data-lap-sheet] .campos {
    display: grid;
    gap: var(--s3) var(--s5);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  [data-lap-sheet] label {
    display: flex;
    flex-direction: column;
    gap: var(--s1);
  }
  [data-lap-sheet] label > span {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--texto-3);
  }
  [data-lap-sheet] input,
  [data-lap-sheet] select,
  [data-lap-sheet] textarea {
    font: inherit;
    color: inherit;
    background: var(--fondo);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-control);
    padding: 8px var(--s3);
  }
  [data-lap-sheet] output,
  [data-lap-sheet] .notas {
    min-height: 1.4em;
    color: var(--texto);
  }
  [data-lap-sheet] .notas {
    white-space: pre-wrap;
    max-width: 65ch;
    line-height: 1.55;
  }
  [data-lap-sheet] .stats {
    display: grid;
    gap: var(--s5);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    align-items: start;
  }
  [data-lap-sheet] .stats ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  [data-lap-sheet] .stats li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    min-height: 36px;
    border-bottom: 1px solid var(--linea);
  }
  [data-lap-sheet] .stat-label {
    font-size: 0.875rem;
    color: var(--texto-2);
  }
  [data-lap-sheet] .stat-value {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    font-variant-numeric: tabular-nums;
  }
  [data-lap-sheet] .stats input {
    width: 4.5rem;
    text-align: right;
  }
  /* §9.1 silent button: a verb, sentence case, interactive Verdemar. */
  [data-lap-sheet] .stat-value button {
    font: inherit;
    font-size: 0.875rem;
    color: var(--enlace);
    background: transparent;
    border: none;
    border-radius: var(--radio-control);
    padding: var(--s1) var(--s2);
    cursor: pointer;
  }
  [data-lap-sheet] .stat-value button:hover,
  [data-lap-sheet] .stat-value button:focus-visible {
    text-decoration: underline;
  }
  /* Gear sections (MIS-085 D, Sistema §7.5): full-width rows. */
  [data-lap-sheet] .filas-engranaje {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 34rem;
  }
  [data-lap-sheet] .filas-engranaje li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    min-height: 40px;
    border-bottom: 1px solid var(--linea);
  }
  [data-lap-sheet] .presupuesto {
    margin: 0 0 var(--s2);
    font-size: 0.8rem;
    color: var(--texto-2);
    font-variant-numeric: tabular-nums;
  }
  [data-lap-sheet] .presupuesto span {
    color: var(--texto-3);
  }
  [data-lap-sheet] .aviso-regla {
    max-width: 60ch;
    font-size: 0.85rem;
    color: var(--texto-2);
    border-left: 2px solid var(--ambar);
    padding-left: var(--s3);
  }
  [data-lap-sheet] .nota-regla {
    font-size: 0.85rem;
    color: var(--texto-3);
    max-width: 60ch;
  }
  [data-lap-sheet] .chip-regla {
    font-style: normal;
    font-size: 0.68rem;
    color: var(--ambar-texto, var(--texto-3));
    border: 1px solid var(--linea);
    border-radius: var(--radio-control);
    padding: 1px 7px;
    margin-left: var(--s2);
    white-space: nowrap;
  }
  /* The gears: presentation over a radio group. A set gear turns a quarter. */
  [data-lap-sheet] .engranajes {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  [data-lap-sheet] .engranajes .diente {
    position: relative;
    display: inline-flex;
    width: 26px;
    height: 26px;
    align-items: center;
    justify-content: center;
    color: var(--linea-f);
    cursor: pointer;
  }
  [data-lap-sheet] .engranajes .diente svg {
    width: 20px;
    height: 20px;
    transition: transform 0.35s ease, color 0.2s;
  }
  [data-lap-sheet] .engranajes .diente.puesto {
    color: var(--ambar);
  }
  [data-lap-sheet] .engranajes .diente.puesto svg {
    transform: rotate(90deg);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-lap-sheet] .engranajes .diente svg {
      transition: none;
    }
  }
  [data-lap-sheet] .engranajes input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  [data-lap-sheet] .engranajes input:focus-visible + svg,
  [data-lap-sheet] .engranajes input:focus-visible + .cero {
    outline: 2px solid var(--enlace);
    outline-offset: 2px;
    border-radius: var(--radio-control);
  }
  [data-lap-sheet] .engranajes .cero {
    font-size: 0.8rem;
    color: var(--texto-3);
  }
  [data-lap-sheet] .engranajes.vedado .diente {
    cursor: not-allowed;
    opacity: 0.35;
  }
  [data-lap-sheet] li:has(.engranajes.vedado) .stat-label {
    color: var(--texto-3);
  }
  [data-lap-sheet] .apt-nombre {
    flex: 1;
    min-width: 0;
  }
  /* Destructive door (§9.1, data-loss): the danger lives in the edge and the
     hover, not in the label — Grana as text reads 3.88:1 over Noche. The label
     keeps primary ink so the button is legible in both modes; it is still never
     a primary, and still asks for confirmation. */
  [data-lap-sheet] .btn-peligro {
    color: var(--texto);
    border: 1px solid var(--grana);
    background: transparent;
  }
  [data-lap-sheet] .btn-peligro:hover,
  [data-lap-sheet] .btn-peligro:focus-visible {
    background: color-mix(in srgb, var(--grana) 8%, transparent);
  }
</style>
