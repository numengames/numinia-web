---
/**
 * Archive statistics (MISSION-009): §9.5 probes — the figure in Mono
 * tabular, the label as etiqueta; the redundancy bar is §9.8 (real
 * percentage known, ink fill, Mono figure beside it). Honest numbers only.
 */
import type { SupportedLocale } from '@numinia/domain';
import { LAP_UI } from '../../i18n/lap';
import { loadArchive } from '../../lib/archive';
import { loadBazaarItems } from '../../lib/bazaar';
import { cityStats } from '../../lib/city-stats';
import { computeArchiveStats } from '../../lib/lap/stats';
import { REGISTER, RITUALS } from '../communities/register';
import LapShell from './LapShell.astro';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = LAP_UI[locale];
const stats = computeArchiveStats(await loadArchive());
/* «La ciudad» (the Oracle, 2026-10-14): counted at build from the register
   the communities pages read and the Bazaar's own list; «Ahora dentro» is
   the only live figure (lib/city-stats.ts). */
const city = cityStats(REGISTER, RITUALS);
const bazaarCount = (await loadBazaarItems(locale)).length;
const CITY: ReadonlyArray<[number, string]> = [
  [city.communities, t.stats.communities],
  [city.upcoming, t.stats.upcoming],
  [city.sedes, t.stats.sedes],
  [bazaarCount, t.stats.bazaar],
];
const LAYERS: ReadonlyArray<[keyof typeof stats.layers, string]> = [
  ['r2', 'R2'],
  ['ipfs', 'IPFS'],
  ['arweave', 'Arweave'],
  ['github', 'GitHub'],
];
const pct = Math.round((stats.redundancy.redundant / Math.max(1, stats.total)) * 100);
---

<LapShell
  locale={locale}
  current="stats"
  title={`${t.stats.title} — LAP — Numinia`}
  description={t.stats.source}
>
  <article data-lap-stats>
    <h1>{t.stats.title}</h1>
    <p class="intro" data-stats-source>{t.stats.source}</p>

    <h2 class="parte">{t.stats.city}</h2>
    <div class="sondas ciudad" data-city-stats>
      {
        CITY.map(([count, label]) => (
          <div class="kpi reveal">
            <p class="dato-xl">{count}</p>
            <p class="etiqueta">{label}</p>
          </div>
        ))
      }
      <div class="kpi reveal">
        {/* Filled from /api/live in the browser; «—» until a home answers. */}
        <p class="dato-xl" data-inside-total>—</p>
        <p class="etiqueta">{t.stats.insideNow}</p>
      </div>
    </div>

    <h2 class="parte">{t.stats.archive}</h2>
    <p class="intro">{t.stats.intro}</p>

    <div class="sondas" data-escalonado>
      <div class="kpi reveal">
        <p class="dato-xl">{stats.total}</p>
        <p class="etiqueta">{t.stats.totalAssets}</p>
      </div>
      <div class="kpi reveal">
        <p class="dato-xl">{stats.projects}</p>
        <p class="etiqueta">{t.stats.projects}</p>
      </div>
    </div>

    <h3 class="etiqueta">{t.stats.byFormat}</h3>
    <div class="malla">
      {
        stats.byFormat.map((row) => (
          <div class="kpi reveal">
            <p class="cifra mono">{row.count}</p>
            <p class="etiqueta">{row.format.toUpperCase()}</p>
          </div>
        ))
      }
    </div>

    <h3 class="etiqueta">{t.stats.storageLayers}</h3>
    <div class="malla">
      {
        LAYERS.map(([key, label]) => (
          <div class="kpi reveal">
            <p class="cifra mono">{stats.layers[key]}</p>
            <p class="etiqueta">{label}</p>
          </div>
        ))
      }
    </div>

    <h3 class="etiqueta">{t.stats.redundancy}</h3>
    <div class="tarjeta reveal salud">
      <div class="barra-fila">
        <div
          class="barra"
          role="progressbar"
          aria-valuenow={pct}
          aria-valuemin="0"
          aria-valuemax="100"
          aria-label={t.stats.redundancy}
        >
          <span style={`width:${pct}%`}></span>
        </div>
        <span class="mono pctcifra">{pct}%</span>
      </div>
      <dl>
        <div>
          <dt class="mono">{stats.redundancy.redundant}</dt>
          <dd>{t.stats.redundant}</dd>
        </div>
        <div>
          <dt class="mono">{stats.redundancy.single}</dt>
          <dd>{t.stats.single}</dd>
        </div>
        <div>
          <dt class="mono">{stats.total}</dt>
          <dd>{t.stats.totalAssets}</dd>
        </div>
      </dl>
    </div>
  </article>
</LapShell>

<script>
  import { insideTotal } from '../../lib/city-stats';

  /* «Ahora dentro»: the same answer the communities pages read for their
     «N dentro» (/api/live, numbers only, reused for 30 s). Without
     JavaScript, or when no home answers, the «—» stays: never a made-up 0. */
  const slot = document.querySelector<HTMLElement>('[data-inside-total]');
  if (slot) {
    void fetch('/api/live', { headers: { accept: 'application/json' } })
      .then((response) => (response.ok ? (response.json() as Promise<{ inside?: unknown }>) : null))
      .then((body) => {
        const total = insideTotal(body?.inside);
        if (total === null) return;
        slot.textContent = String(total);
        slot.dataset['count'] = String(total);
      })
      .catch(() => {
        /* offline or a static preview: the «—» stays */
      });
  }
</script>

<style>
  h1 {
    font-size: 2.074rem;
    font-weight: 400;
    letter-spacing: -0.025em;
    margin-top: 0;
  }
  .intro {
    color: var(--texto-2);
    max-width: 65ch;
    line-height: 1.55;
  }
  h2.parte {
    margin: var(--s7) 0 var(--s3);
    font-size: 1.44rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--texto);
  }
  h3 {
    margin: var(--s7) 0 var(--s3);
    font-weight: 500;
  }
  /* The five city figures in one row on a desktop panel. */
  .sondas.ciudad {
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    margin-top: var(--s4);
  }
  /* Five to a row: a little less padding and tracking, so the longest
     label («COMUNIDADES») stays inside its card. */
  .ciudad .kpi {
    padding: var(--s4);
  }
  .ciudad .kpi .etiqueta {
    letter-spacing: 0.06em;
    overflow-wrap: anywhere;
  }
  .sondas,
  .malla {
    display: grid;
    gap: var(--s3);
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
  }
  .sondas {
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    margin-top: var(--s5);
  }
  .kpi .dato-xl {
    margin: 0;
    color: var(--texto);
  }
  .cifra {
    margin: 0;
    font-size: 2.074rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.35;
    color: var(--texto);
  }
  .kpi .etiqueta {
    margin: var(--s1) 0 0;
  }
  .salud {
    max-width: 40rem;
  }
  /* §9.8 progress bar: 4px capsule, ink fill, ALWAYS a Mono figure beside. */
  .barra-fila {
    display: flex;
    align-items: center;
    gap: var(--s3);
  }
  .barra {
    flex: 1;
    height: 4px;
    border-radius: var(--radio-completo);
    background: var(--linea-f);
    overflow: hidden;
  }
  .barra span {
    display: block;
    height: 100%;
    border-radius: var(--radio-completo);
    background: var(--texto);
  }
  .pctcifra {
    font-variant-numeric: tabular-nums;
    color: var(--texto);
  }
  dl {
    display: flex;
    gap: var(--s6);
    margin: var(--s4) 0 0;
    flex-wrap: wrap;
  }
  dt {
    font-size: 1.44rem;
    font-variant-numeric: tabular-nums;
    color: var(--texto);
  }
  dd {
    margin: 0;
    font-size: 0.875rem;
    color: var(--texto-2);
  }
</style>
