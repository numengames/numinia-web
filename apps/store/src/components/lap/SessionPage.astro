---
/**
 * Enter Numinia (MISSION-010 / MISSION-002 Steps 1–3): the login promoted
 * from the spike into the L.A.P. — a contextual moment, never a wall (D16).
 * The vendor proves the address; the session is ours (@numinia/auth).
 * Guide copy inside the island is EN pending translation QA (D9).
 */
import type { SupportedLocale } from '@numinia/domain';
import { SETTINGS_UI } from '../../i18n/settings';
import { LoginSpike } from '../auth/LoginSpike';
import LapShell from './LapShell.astro';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = SETTINGS_UI[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;
---

<LapShell
  locale={locale}
  current="settings"
  title={`${t.sessionTitle} — L.A.P. — Numinia`}
  description={t.sessionIntro}
>
  <article data-lap-session>
    <nav class="volver">
      <a href={`${prefix}/lap/settings/`} data-metric="session-back">{t.backToSettings}</a>
    </nav>
    <h1>{t.sessionTitle}</h1>
    <p class="intro">{t.sessionIntro}</p>
    <p class="nota">{t.sessionWhy}</p>
    <LoginSpike client:load />
    <p class="dignidad">{t.sessionOpen}</p>
  </article>
</LapShell>

<style>
  h1 {
    font-size: 2.074rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 var(--s3);
  }
  .volver {
    margin-bottom: var(--s4);
  }
  .volver a {
    color: var(--enlace);
    text-decoration: none;
    font-size: 0.875rem;
  }
  .intro {
    font-size: 1.44rem;
    color: var(--texto-2);
    max-width: 56ch;
    line-height: 1.55;
  }
  .nota,
  .dignidad {
    color: var(--texto-2);
    max-width: 65ch;
    line-height: 1.55;
    font-size: 0.875rem;
  }
  .dignidad {
    margin-top: var(--s6);
    padding-top: var(--s4);
    border-top: 1px solid var(--linea);
    color: var(--texto-3);
  }
</style>
