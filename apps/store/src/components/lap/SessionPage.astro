---
/**
 * Enter Numinia (MISSION-010 / MISSION-002 Steps 1–3): the login promoted
 * from the spike into the LAP — a contextual moment, never a wall (D16).
 * The vendor proves the address; the session is ours (@numinia/auth).
 * Since v0.84.0 the island speaks the reader's language (i18n/sign-in.ts)
 * and is the site's one way out (`?salir=1`); a fresh sign-in lands on your
 * profile, or on the room of the player area the door was opened from.
 *
 * Balanced (Pablo, 2026-10-14: «esto está claramente descompensado» — all
 * of it sat in the left half): from 64rem the page is two columns, centred —
 * the words and the steps on the left, the way in on the right; on a phone,
 * one column in reading order. The island draws its two regions straight
 * into this grid (`astro-island` takes no box of its own).
 */
import { RANK_DEFINITIONS, type SupportedLocale } from '@numinia/domain';
import { CHROME_MESSAGES } from '../../i18n/messages';
import { SETTINGS_UI } from '../../i18n/settings';
import { SIGN_IN_UI } from '../../i18n/sign-in';
import { localeHref } from '../../lib/app-nav';
import { LoginSpike } from '../auth/LoginSpike';
import LapShell from './LapShell.astro';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = SETTINGS_UI[locale];
const chrome = CHROME_MESSAGES[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;
const legal = {
  label: t.acceptLabel,
  read: t.acceptRead,
  pending: t.acceptPending,
  termsHref: `${prefix}/legal/terms/`,
  termsLabel: chrome.legalTerms,
  privacyHref: `${prefix}/legal/privacy/`,
  privacyLabel: chrome.legalPrivacy,
};
const rankNames = Object.fromEntries(RANK_DEFINITIONS.map((rank) => [rank.id, rank.name[locale]]));
---

<LapShell
  locale={locale}
  current="settings"
  title={`${t.sessionTitle} — LAP — Numinia`}
  description={t.sessionIntro}
>
  <article data-lap-session>
    <div class="puerta" data-sign-in-layout>
      <header class="puerta-cab">
        <nav class="volver">
          <a href={`${prefix}/lap/settings/`} data-metric="session-back">{t.backToSettings}</a>
        </nav>
        <h1>{t.sessionTitle}</h1>
        <p class="intro">{t.sessionIntro}</p>
        <p class="nota">{t.sessionWhy}</p>
      </header>
      <LoginSpike
        locale={locale}
        legal={legal}
        copy={SIGN_IN_UI[locale]}
        rankNames={rankNames}
        profileHref={localeHref(locale, '/lap/')}
        homeHref={localeHref(locale, '/')}
        client:load
      />
      <p class="dignidad">{t.sessionOpen}</p>
    </div>
  </article>
</LapShell>

<style is:global>
  /* The island renders client-side, outside Astro's scoped hashing. Its two
     regions are grid items of the page: the island element takes no box. */
  [data-sign-in-layout] > astro-island {
    display: contents;
  }
  [data-sign-in-layout] {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'cab' 'pasos' 'entrada' 'pie';
    align-items: start;
  }
  [data-sign-in-layout] > .puerta-cab {
    grid-area: cab;
  }
  [data-sign-in-steps] {
    grid-area: pasos;
    min-width: 0;
  }
  [data-sign-in-way] {
    grid-area: entrada;
    min-width: 0;
  }
  [data-sign-in-layout] > .dignidad {
    grid-area: pie;
  }
  @media (min-width: 64rem) {
    [data-sign-in-layout] {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 24rem);
      grid-template-rows: auto auto 1fr;
      grid-template-areas: 'cab entrada' 'pasos entrada' 'pie entrada';
      column-gap: var(--s7);
      max-width: 64rem;
      margin-inline: auto;
    }
    [data-sign-in-way] {
      /* The way in starts level with the title, below the back link. */
      padding-top: var(--s7);
    }
  }
  /* The widget's place while the terms wait: as tall as the widget, quiet. */
  [data-way-waiting] {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--s3);
    min-height: 22rem;
    margin: var(--s5) 0 var(--s3);
    padding: var(--s6) var(--s5);
    border: 1px dashed var(--linea-f);
    border-radius: var(--radio-marco);
    background: color-mix(in srgb, var(--superficie) 55%, transparent);
    text-align: center;
  }
  [data-way-waiting] p {
    margin: 0;
    color: var(--texto-2);
    line-height: 1.55;
  }
  [data-way-waiting] [data-legal-gate-pending] {
    font-size: 0.875rem;
  }
  [data-metric='auth-connect'] {
    margin: var(--s5) 0 var(--s3);
  }
  [data-session-panel] {
    margin: var(--s5) 0 var(--s3);
    padding: var(--s5);
    max-width: 56ch;
    background: var(--superficie);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-marco);
  }
  [data-session-panel] .hecho {
    margin: 0 0 var(--s4);
    font-size: 1.2rem;
  }
  [data-session-panel] dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s5);
    margin: 0 0 var(--s5);
  }
  [data-session-panel] dt {
    margin-bottom: var(--s1);
  }
  [data-session-panel] dd {
    margin: 0;
  }
  [data-session-panel] .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
  }
  [data-session-panel] .btn {
    text-decoration: none;
  }
  [data-legal-gate] {
    margin: var(--s5) 0 var(--s3);
    max-width: 56ch;
  }
  [data-legal-gate] label {
    display: flex;
    gap: var(--s2);
    align-items: flex-start;
    line-height: 1.5;
    cursor: pointer;
  }
  [data-legal-gate] input {
    /* 44px touch target without inflating the visual box (§9.8). */
    width: 1.1rem;
    height: 1.1rem;
    margin: 0.2rem 0;
    accent-color: var(--ambar);
    flex: none;
  }
  [data-legal-gate] p {
    margin: var(--s2) 0 0 1.85rem;
    font-size: 0.875rem;
    color: var(--texto-3);
  }
  [data-legal-gate] a {
    color: var(--enlace);
  }
  /* The guide: the method and the step, then the three steps — each one
     numbered once, by its own dot (the list draws no numbers). */
  [data-login-progress] {
    margin: var(--s5) 0 var(--s3);
    padding: var(--s4) var(--s5);
    max-width: 56ch;
    background: var(--superficie);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-marco);
  }
  [data-login-progress] .etiqueta {
    margin: 0 0 var(--s3);
  }
  [data-login-progress] ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s3);
  }
  [data-login-progress] li {
    position: relative;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: var(--s3);
    align-items: start;
    color: var(--texto-2);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  /* The thread between two dots. */
  [data-login-progress] li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 13.5px;
    top: 30px;
    bottom: calc(-1 * var(--s3) + 2px);
    width: 1px;
    background: var(--linea-f);
  }
  [data-step-dot] {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--linea-f);
    background: var(--fondo);
    color: var(--texto-3);
    font-family: var(--mono);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  [data-login-progress] li[data-step-state='active'] {
    color: var(--texto);
    font-weight: 500;
  }
  [data-login-progress] li[data-step-state='active'] [data-step-dot] {
    border-color: var(--ambar);
    color: var(--ambar);
  }
  [data-login-progress] li[data-step-state='done'] [data-step-dot] {
    border-color: var(--verdemar);
    color: var(--verdemar);
  }
  /* What the wallet's permission list means here: one plain line. */
  [data-wallet-note] {
    margin: var(--s4) 0 0;
    padding-left: var(--s3);
    border-left: 2px solid var(--turquesa);
    color: var(--texto-2);
    font-size: 0.875rem;
    line-height: 1.55;
  }
</style>

<style>
  h1 {
    font-size: 2.074rem;
    font-weight: 400;
    letter-spacing: -0.025em;
    margin: 0 0 var(--s3);
  }
  .volver {
    margin-bottom: var(--s4);
  }
  .volver a {
    color: var(--enlace);
    text-decoration: none;
    font-size: 0.875rem;
  }
  .intro {
    font-size: 1.44rem;
    color: var(--texto-2);
    max-width: 56ch;
    line-height: 1.55;
  }
  .nota,
  .dignidad {
    color: var(--texto-2);
    max-width: 65ch;
    line-height: 1.55;
    font-size: 0.875rem;
  }
  .dignidad {
    margin-top: var(--s6);
    padding-top: var(--s4);
    border-top: 1px solid var(--linea);
    color: var(--texto-3);
  }
</style>
