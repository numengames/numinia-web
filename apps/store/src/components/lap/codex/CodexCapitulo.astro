---
/**
 * A chapter of the Códex (§4.1 portadilla + page architecture §4): reading
 * column ≤70ch centered, real margin column at ≥1200px carrying the glyph
 * and the footnotes, everything collapsing inline on mobile. The corner
 * frames draw themselves once on chapter open — THE orchestrated moment.
 */
import { CODEX_UI } from '../../../i18n/codex';
import type { CodexChapterMeta } from '../../../lib/codex/manifest';
import { loadCodexDoc } from '../../../lib/codex/docs';
import { parseGlossary } from '../../../lib/codex/glossary';
import { slugify, type CodexChapter } from '../../../lib/codex/parse';
import { renderChapter } from '../../../lib/codex/render';
import type { CodexLang } from '../../../lib/codex/source';
import { glossaryVariants, linkGlossaryTerms } from '../../../lib/codex/terms';
import CodexMarcos from './CodexMarcos.astro';

// §4.8: chapter prose links its glossary terms (first occurrence only).
// Module-level: one variant list per edition, the same for every chapter.
const TERM_TARGETS = {
  es: glossaryVariants(parseGlossary(loadCodexDoc('glosario', 'es'))),
  en: glossaryVariants(parseGlossary(loadCodexDoc('glosario', 'en'))),
};

interface Props {
  prefix: string;
  lang: CodexLang;
  chapter: CodexChapter;
  prev: CodexChapterMeta | undefined;
  next: CodexChapterMeta | undefined;
}
const { prefix, lang, chapter, prev, next } = Astro.props;
const t = CODEX_UI[lang];
const rendered = renderChapter(chapter);
const bodyHtml = linkGlossaryTerms(
  rendered.html,
  TERM_TARGETS[lang],
  `${prefix}/lap/codex/glosario/`,
);

const eyebrow =
  chapter.number !== null
    ? t.chapterKicker(chapter.number)
    : chapter.slug === 'el-espejo-roto' || chapter.slug === 'the-broken-mirror'
      ? t.moduleKicker
      : t.introKicker;
---

<article class="pliego" aria-label={chapter.title} data-codex-chapter={chapter.slug}>
  <header class="cap-abre dibujado" data-dibujable id={slugify(chapter.title)}>
    <CodexMarcos />
    <span class="num">{eyebrow}</span>
    <h2>{chapter.title}</h2>
  </header>

  <div class="pliego-int">
    <div class="cuerpo" set:html={bodyHtml} />
    <aside class="margen" aria-label={t.marginNotes}>
      <div class="glifo-m" aria-hidden="true">
        <svg viewBox="0 0 34 34" fill="none" stroke="currentColor" stroke-width="1.1">
          <circle cx="17" cy="17" r="14" stroke-dasharray="3 2.4"></circle>
          <path d="M17 7 27 17 17 27 7 17z"></path>
        </svg>
      </div>
      {
        rendered.notes.map((note) => (
          <div class="nota-m">
            <span class="num">{note.number}</span> · <Fragment set:html={note.html} />
          </div>
        ))
      }
    </aside>
  </div>

  <nav class="pager" aria-label={t.prevNext}>
    {
      prev ? (
        <a href={`${prefix}/lap/codex/${prev.slug}/`} rel="prev" data-metric="codex-prev">
          ← {prev.title}
        </a>
      ) : (
        <a href={`${prefix}/lap/codex/`} rel="up" data-metric="codex-index">
          {t.backToCover}
        </a>
      )
    }
    {
      next && (
        <a href={`${prefix}/lap/codex/${next.slug}/`} rel="next" data-metric="codex-next">
          {next.title} →
        </a>
      )
    }
  </nav>
</article>
