---
/**
 * The book plane's shell (MIS-085 B): a full-viewport paper surface inside
 * the platform document. BaseLayout keeps SEO, consent, metrics and the
 * error beacon; the shell keeps the paper, the chrome and the reader
 * behavior. The manual's Diurno/Nocturno and text size are restored BEFORE
 * first paint from the manual's own localStorage keys (D13).
 */
import type { SupportedLocale } from '@numinia/domain';
import { CODEX_UI } from '../../../i18n/codex';
import { CHROME_MESSAGES } from '../../../i18n/messages';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import type { CodexLang } from '../../../lib/codex/source';
import CodexChrome from './CodexChrome.astro';
import SpeechPlayer from '../../speech/SpeechPlayer.astro';
import '../../../styles/codex.css';

import alegreyaWoff from '../../../../../../packages/ui/src/assets/fonts/Alegreya-Variable.woff2?url';
import alegreyaScWoff from '../../../../../../packages/ui/src/assets/fonts/AlegreyaSC-Regular.woff2?url';

interface Props {
  locale: SupportedLocale;
  /** The manual's language: the chrome speaks it too. */
  lang: CodexLang;
  title: string;
  description: string;
  /** Chapter slug when reading one; '' on the cover/index surfaces. */
  slug?: string;
  path: string;
  showGateCta: boolean;
  capActual: string;
  /** Chapter navigation for the running footer (chapter pages only). */
  prevHref?: string | undefined;
  prevLabel?: string | undefined;
  nextHref?: string | undefined;
  nextLabel?: string | undefined;
}
const {
  locale,
  lang,
  title,
  description,
  slug = '',
  path,
  showGateCta,
  capActual,
  prevHref,
  prevLabel,
  nextHref,
  nextLabel,
} = Astro.props;
const prefix = locale === 'en' ? '' : `/${locale}`;
// The Codex has no site footer (chrome=false): a discreet legal line at the
// foot of the paper keeps the four texts and the cookie choice one tap away.
const legal = CHROME_MESSAGES[locale];
// The client scripts' live labels. Spanish is their built-in default, so
// the attribute only travels with the English edition.
const chrome = CODEX_UI[lang].chrome;
const clientUi =
  lang === 'es'
    ? undefined
    : JSON.stringify({
        bookmark: chrome.bookmark,
        bookmarked: chrome.bookmarked,
        day: chrome.day,
        night: chrome.night,
        mode: chrome.mode,
        phases: chrome.moonPhases,
      });
---

<BaseLayout locale={locale} title={title} description={description} chrome={false} wide>
  <link
    slot="head"
    rel="preload"
    href={alegreyaWoff}
    as="font"
    type="font/woff2"
    crossorigin
  />
  <link
    slot="head"
    rel="preload"
    href={alegreyaScWoff}
    as="font"
    type="font/woff2"
    crossorigin
  />
  <div class="codex" data-tam="m" data-slug={slug} data-prefix={prefix} data-ui={clientUi}>
    <script is:inline>
      /* The manual's own mode and size, restored before its first paint —
         independent of the LAP chrome by decision D13. */
      (function () {
        var codex = document.currentScript.parentElement;
        try {
          if (localStorage.getItem('numinia-codex-modo') === 'nocturno')
            codex.classList.add('nocturno');
          var tam = localStorage.getItem('numinia-codex-tam');
          if (tam === 's' || tam === 'l') codex.dataset.tam = tam;
        } catch (e) {}
      })();
    </script>
    <CodexChrome
      prefix={prefix}
      lang={lang}
      path={path}
      showGateCta={showGateCta}
      prevHref={prevHref}
      prevLabel={prevLabel}
      nextHref={nextHref}
      nextLabel={nextLabel}
    >
      <span slot="cap-actual">{capActual}</span>
      <SpeechPlayer
        slot="listen"
        textSelector=".codex .cuerpo, .codex .glosario"
        lang={chrome.voice}
        htmlLang={locale}
        title={capActual}
        bar=".codex .chrome"
        toggleClass="cbtn"
        t={CODEX_UI[lang].listen}
      />
    </CodexChrome>
    <div class="lienzo">
      <slot />
      <nav class="legal-pie" aria-label={legal.footerLegal}>
        <a href={`${prefix}/legal/legal-notice/`} data-metric="codex-legal-notice">{legal.legalNotice}</a>
        <a href={`${prefix}/legal/privacy/`} data-metric="codex-legal-privacy">{legal.legalPrivacy}</a>
        <a href={`${prefix}/legal/cookies/`} data-metric="codex-legal-cookies">{legal.legalCookies}</a>
        <a href={`${prefix}/legal/terms/`} data-metric="codex-legal-terms">{legal.legalTerms}</a>
        <button type="button" data-cookie-choice data-metric="codex-cookie-choice">
          {legal.legalCookieChoice}
        </button>
      </nav>
    </div>
  </div>
  <script>
    import '../../../scripts/codex-reader';
  </script>
</BaseLayout>

<style is:global>
  /* The paper covers the platform surface edge to edge. */
  body:has(.codex) {
    background: #fdf6ee;
  }
  body:has(.codex.nocturno) {
    background: #14110f;
  }
  main[data-wide]:has(> .codex) {
    padding: 0;
    max-width: none;
  }
  /* The reading player's colours: numinia.org's own tokens, day and night,
     which are the manual's paper and ink (Sistema §19.3). Set on <body>
     because the dock and the light live there. */
  body:has(.codex) {
    --sp-text: 20 17 15;
    --sp-text-dim: 110 98 89;
    --sp-accent: 1 110 125;
    --sp-teal: 1 110 125;
    --sp-bg-card: 253 246 238;
    --sp-border: 196 181 166;
    --sp-font-mono: 'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    --sp-font-sans: 'Geist', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  body:has(.codex.nocturno) {
    --sp-text: 249 235 220;
    --sp-text-dim: 138 125 114;
    --sp-accent: 166 218 213;
    --sp-teal: 1 142 161;
    --sp-bg-card: 30 26 23;
    --sp-border: 58 51 45;
  }
  .codex .chrome .speech-player {
    display: contents;
  }
  /* While the dock is up it takes the running footer's place. */
  body.sp-on .codex .pie {
    transform: translateY(100%);
  }
</style>
