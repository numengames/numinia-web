---
/** The four engraved corner frames — single stroke, palette only, they may
 * self-draw (Sistema §10.1-13, trazo). Wrap them in a container marked
 * `data-dibujable` to get the once-per-view drawing animation. */
const PATH = 'M4 70 V14 Q4 4 14 4 H70 M4 30 Q14 30 18 22 Q22 14 30 14 M12 4 Q12 12 4 12';
const CORNERS = ['ne', 'no', 'se', 'so'] as const;
---

{
  CORNERS.map((corner) => (
    <span class={`marco ${corner}`} aria-hidden="true">
      <svg viewBox="0 0 74 74">
        <path d={PATH} />
      </svg>
    </span>
  ))
}
