---
/**
 * Cromo del Códex (§4.12): top bar + running footer, both auto-hiding on
 * read. The mode toggle belongs to the MANUAL, not the LAP (D13). The
 * Umbral CTA shows only to visitors without a session — the gate is a
 * funnel, not a wall (D2).
 */
import { CODEX_UI } from '../../../i18n/codex';
import type { CodexLang } from '../../../lib/codex/source';

interface Props {
  prefix: string;
  lang: CodexLang;
  path: string;
  showGateCta: boolean;
  /** Mid-reading chapter navigation in the running footer (Oracle
   * amendment 2026-08-18): jumping chapters must not require reaching
   * the chapter's end. */
  prevHref?: string | undefined;
  prevLabel?: string | undefined;
  nextHref?: string | undefined;
  nextLabel?: string | undefined;
}
const { prefix, lang, path, showGateCta, prevHref, prevLabel, nextHref, nextLabel } = Astro.props;
const t = CODEX_UI[lang].chrome;
---

<header class="chrome" role="banner">
  <a class="wm" href={`${prefix}/lap/`} data-metric="codex-lap-back">LAP</a>
  <span class="path">{path}</span>
  <span class="sp"></span>
  <a class="cbtn" href={`${prefix}/lap/codex/#indice`} aria-label={t.index} data-metric="codex-toc">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
      ><path d="M2 4h12M2 8h12M2 12h8"></path></svg
    >
    <span class="lbl">{t.index}</span>
  </a>
  <button
    class="cbtn"
    data-codex-marca
    aria-pressed="false"
    aria-label={t.bookmark}
    data-metric="codex-bookmark"
  >
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
      ><path d="M4 2h8v12l-4-3-4 3V2z"></path></svg
    >
    <span class="lbl">{t.bookmark}</span>
  </button>
  <button
    class="cbtn"
    data-codex-narrador
    aria-pressed="false"
    aria-label={t.narrator}
    hidden
    title={t.narratorTitle}
    data-metric="codex-narrator"
  >
    <svg data-ico-lee viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
      ><path d="M2 6v4h3l4 3V3L5 6H2z"></path><path d="M11.5 5.5a3.5 3.5 0 0 1 0 5"></path></svg
    >
    <svg
      data-ico-pausa
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      style="display:none"><path d="M6 3v10M10 3v10"></path></svg
    >
    <span class="lbl">{t.narrator}</span>
  </button>
  <button
    class="cbtn"
    data-codex-ritmo
    hidden
    title={t.paceTitle}
    data-metric="codex-narrator-rate"
  >
    <span class="ritmo mono">×1</span>
  </button>
  <div class="tams" role="group" aria-label={t.textSize}>
    <button data-tam="s" aria-pressed="false" data-metric="codex-size">A</button>
    <button data-tam="m" aria-pressed="true" data-metric="codex-size">A</button>
    <button data-tam="l" aria-pressed="false" data-metric="codex-size">A</button>
  </div>
  <button
    class="cbtn"
    data-codex-modo
    aria-pressed="false"
    aria-label={t.mode}
    title={t.modeTitle}
    data-metric="codex-mode"
  >
    <svg data-ico-sol viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
      ><circle cx="8" cy="8" r="3.2"></circle><path
        d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M13 3l-1.4 1.4M4.4 11.6 3 13"
      ></path></svg
    >
    <svg
      data-ico-luna
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      style="display:none"><path d="M13 9.5A6 6 0 0 1 6.5 3 6 6 0 1 0 13 9.5z"></path></svg
    >
    <span class="lbl">{t.night}</span>
  </button>
  {
    showGateCta && (
      <a class="cbtn tinta" href={`${prefix}/lap/session/`} data-metric="codex-gate-enter">
        <span class="lbl">{t.cross}</span>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 3l5 5-5 5" />
        </svg>
      </a>
    )
  }
</header>

<footer class="pie" role="contentinfo">
  {
    prevHref && (
      <a
        class="salto"
        href={prevHref}
        rel="prev"
        aria-label={`${t.prevChapter}: ${prevLabel}`}
        title={prevLabel}
        data-metric="codex-pie-prev"
      >
        ←
      </a>
    )
  }
  <span class="cap-actual"><slot name="cap-actual">Códex</slot></span>
  {
    nextHref && (
      <a
        class="salto"
        href={nextHref}
        rel="next"
        aria-label={`${t.nextChapter}: ${nextLabel}`}
        title={nextLabel}
        data-metric="codex-pie-next"
      >
        →
      </a>
    )
  }
  <span class="sp"></span>
  <a
    class="cbtn"
    data-codex-volver
    style="display:none;font-size:.64rem;padding:4px 10px"
    href={`${prefix}/lap/codex/`}
    data-metric="codex-bookmark-return"
  >
    <span class="lbl">{t.backToBookmark}</span>
  </a>
  <span class="luna" aria-label={t.progress}>
    <svg viewBox="0 0 20 20" aria-hidden="true">
      <circle cx="10" cy="10" r="8.4" fill="none" stroke="currentColor" stroke-width="1" opacity=".35"
      ></circle>
      <path data-luna-fase fill="currentColor" d=""></path>
    </svg>
    <span data-luna-txt>{t.moonPhases[0]}</span>
  </span>
</footer>
