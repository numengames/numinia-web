---
/**
 * The Códex home: cover, index, free downloads, acknowledgments, colophon.
 * Everything here is open to everyone — the map is never hidden (D2); the
 * veil begins inside the gated chapters.
 */
import type { SupportedLocale } from '@numinia/domain';
import { CODEX_UI } from '../../../i18n/codex';
import { loadCodexDoc } from '../../../lib/codex/docs';
import { codexLang, loadCodex } from '../../../lib/codex/source';
import { viewerFrom } from '../../../lib/lap/gate';
import CodexColofon from './CodexColofon.astro';
import CodexDescargas from './CodexDescargas.astro';
import CodexIndice from './CodexIndice.astro';
import CodexPortada from './CodexPortada.astro';
import CodexShell from './CodexShell.astro';

interface Props {
  locale: SupportedLocale;
}
const { locale } = Astro.props;
const prefix = locale === 'en' ? '' : `/${locale}`;
const viewer = await viewerFrom(Astro.cookies);
const lang = codexLang(locale);
const t = CODEX_UI[lang].home;
const { manifest } = loadCodex(lang);

const gracias = loadCodexDoc('agradecimientos', lang)
  .split('\n')
  .map((line) => line.trim())
  .filter((line) => line !== '' && !line.startsWith('#'));
---

<CodexShell
  locale={locale}
  lang={lang}
  title={t.title}
  description={t.description}
  path={t.path}
  showGateCta={viewer === null}
  capActual={CODEX_UI[lang].cover}
>
  <CodexPortada lang={lang} />
  <CodexIndice prefix={prefix} lang={lang} chapters={manifest.chapters} hasSession={viewer !== null} />
  <section class="hoja" aria-label={t.downloadsLabel}>
    <p class="etq">{t.downloadsHeading}</p>
    <CodexDescargas lang={lang} />
  </section>
  <section class="cierre">
    <div class="hoja" aria-label={t.acknowledgments}>
      <p class="etq">{t.acknowledgments}</p>
      {
        gracias.map((line) => (
          <p class={line.includes('·') ? 'gracias nombres' : 'gracias'}>{line}</p>
        ))
      }
    </div>
    <CodexColofon lang={lang} />
  </section>
</CodexShell>
