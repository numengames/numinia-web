---
/**
 * Colofón (§4.11): binaria separator, closing seal, the provisional legal
 * note (D10 — the Oracle will revise the wording; keep it marked), version.
 * The binaria spells «Numinia» in bits, computed at build — no client JS.
 */
import { CODEX_UI } from '../../../i18n/codex';
import { MANUAL_VERSION } from '../../../lib/codex/manifest';
import type { CodexLang } from '../../../lib/codex/source';

interface Props {
  lang: CodexLang;
}
const t = CODEX_UI[Astro.props.lang].colophon;

const WORD = 'Numinia';
const bits = [...WORD].flatMap((char) =>
  char.charCodeAt(0).toString(2).padStart(8, '0').split(''),
);
---

<div class="colofon">
  <div class="binaria" aria-hidden="true">
    {bits.map((bit) => <i class={bit === '1' ? 'uno' : undefined}></i>)}
  </div>
  <div class="marca-cierre" title={t.seal}>✦</div>
  <p>
    {t.line1(MANUAL_VERSION)}<br />
    {/* The lore is CC0 since 2026-09-24 (numinia-archive lore/codex/legal.md). */}
    {t.line2}<br />
    {t.line3}<br />
    {t.line4}
  </p>
  <p class="firma">numen games · leave things better than we found them</p>
</div>
