---
/**
 * Download cards (D6): the book always travels free — no login, ever.
 * .md straight from the canonical file; PDF and EPUB are the print/Kindle
 * editions the export pipeline (scripts/build-exports.mjs) drops into
 * /descargas/ at build time.
 */
import { MANUAL_VERSION } from '../../../lib/codex/manifest';

interface Props {
  /** Chapter slug for a per-chapter download card; omit for book-only. */
  slug?: string | undefined;
}
const { slug } = Astro.props;
const base = `Numinia_Manual_del_juego_de_rol_v${MANUAL_VERSION.replaceAll('.', '_')}`;
---

<div class="descargas">
  <a
    class="dcard"
    href="/api/codex/manual.md"
    download="Numinia_Manual_del_juego_de_rol_v0_6_0.md"
    data-metric="codex-download-md"
  >
    <span class="f">.md</span>
    <p class="d">El libro entero. Texto plano, tuyo.</p>
  </a>
  {
    slug && (
      <a
        class="dcard"
        href={`/api/codex/${slug}.md`}
        download={`Numinia_${slug}.md`}
        data-metric="codex-download-chapter-md"
      >
        <span class="f">.md · capítulo</span>
        <p class="d">Solo este capítulo.</p>
      </a>
    )
  }
  <a
    class="dcard"
    href={`/descargas/${base}.pdf`}
    download={`${base}.pdf`}
    data-metric="codex-download-pdf"
  >
    <span class="f">pdf</span>
    <p class="d">Para imprimir. Edición Diurno.</p>
  </a>
  <a
    class="dcard"
    href={`/descargas/${base}.epub`}
    download={`${base}.epub`}
    data-metric="codex-download-epub"
  >
    <span class="f">epub</span>
    <p class="d">Para tu Kindle o lector.</p>
  </a>
</div>
