---
/**
 * The Manual's index — the threshold of the founding text: chapter cards
 * with their fragments, staggered reveal on entry. Original Spanish, and
 * says so honestly in every other locale.
 */
import type { SupportedLocale } from '@numinia/domain';
import { LAP_UI } from '../../../i18n/lap';
import { loadManual } from '../../../lib/lap/manual';
import CodexTabs from './CodexTabs.astro';
import LapShell from '../LapShell.astro';

interface Props {
  locale: SupportedLocale;
}
const { locale } = Astro.props;
const t = LAP_UI[locale].manual;
const prefix = locale === 'en' ? '' : `/${locale}`;
const chapters = await loadManual();
---

<LapShell
  locale={locale}
  current="codex"
  title={`${t.title} — L.A.P. — Numinia`}
  description={t.intro}
>
  <CodexTabs locale={locale} current="manual" />
  <article data-codex-manual>
    <h1>{t.title}</h1>
    <p class="intro">{t.intro}</p>
    {t.esNote && <p class="nota">{t.esNote}</p>}

    <ol class="capitulos" data-escalonado>
      {
        chapters.map((chapter) => (
          <li>
            <a href={`${prefix}/lap/codex/${chapter.id}/`} class="tarjeta reveal" data-metric="codex-chapter">
              <p class="etiqueta">
                {chapter.number === null ? 'Introducción' : `${t.chapter} ${chapter.number}`}
              </p>
              <h2>{chapter.title}</h2>
              <p class="fragmentos">
                {chapter.fragments
                  .map((fragment) => fragment.title)
                  .filter(Boolean)
                  .join(' · ')}
              </p>
            </a>
          </li>
        ))
      }
    </ol>
  </article>
</LapShell>

<style>
  h1 {
    font-size: 2.074rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-top: 0;
  }
  .intro {
    color: var(--texto-2);
    max-width: 65ch;
    line-height: 1.55;
  }
  .nota {
    color: var(--texto-3);
    font-size: 0.875rem;
  }
  .capitulos {
    list-style: none;
    margin: var(--s5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s4);
  }
  .capitulos a {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .capitulos .etiqueta {
    margin: 0 0 var(--s2);
  }
  h2 {
    margin: 0 0 var(--s2);
    font-size: 1.44rem;
    font-weight: 600;
    color: var(--texto);
  }
  .fragmentos {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--texto-2);
  }
</style>
