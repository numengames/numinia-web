---
/** L.A.P. overview — open to everyone (D16): what this place is, the ranks
    ladder, and the honest status note. */
import { RANK_DEFINITIONS, type SupportedLocale } from '@numinia/domain';
import { LAP_MESSAGES } from '../../i18n/pillars';
import { UPDATES_MESSAGES } from '../../i18n/messages';
import LapShell from './LapShell.astro';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = LAP_MESSAGES[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;
---

<LapShell locale={locale} current="overview" title={`${t.lapTitle} — Numinia`} description={t.lapIntro}>
  <article data-lap>
    <h1>{t.lapTitle}</h1>
    <p class="intro">{t.lapIntro}</p>
    <p>{t.lapBody}</p>

    <aside data-lap-status role="note">
      <h2>{t.statusTitle}</h2>
      <p>{t.statusBody}</p>
      <p>
        {t.updatesNote}
        <a href={`${prefix}/updates/`} data-metric="lap-updates">
          → {UPDATES_MESSAGES[locale].updatesTitle}
        </a>
      </p>
    </aside>

    <h2>{t.ranksTitle}</h2>
    <p>{t.ranksIntro}</p>
    <ol data-lap-ranks>
      {
        RANK_DEFINITIONS.map((rank) => (
          <li class="reveal">
            <h3>{rank.name[locale]}</h3>
            <p>{rank.description[locale]}</p>
          </li>
        ))
      }
    </ol>
  </article>
</LapShell>

<style>
  h1 {
    font-size: 2.074rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--texto);
    margin-top: 0;
  }
  h2 {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ambar);
    margin-top: var(--s6);
  }
  p {
    line-height: 1.55;
    max-width: 65ch;
  }
  .intro {
    font-size: 1.44rem;
    color: var(--texto-2);
  }
  [data-lap-status] {
    background: var(--superficie);
    border: 1px solid var(--linea);
    border-left: 2px solid var(--ambar);
    border-radius: var(--radio-marco);
    padding: var(--s3) var(--s4);
    margin: var(--s5) 0;
  }
  [data-lap-status] h2 {
    margin-top: 0;
  }
  [data-lap-status] a {
    color: var(--enlace);
    margin-left: 0.3rem;
  }
  ol {
    list-style: none;
    padding: 0;
  }
  ol li {
    border-left: 2px solid var(--verdemar);
    padding: 0 0 var(--s3) var(--s4);
  }
  ol h3 {
    margin: 0;
    font-size: 1rem;
  }
  ol p {
    margin: 0.2rem 0 0;
    font-size: 0.875rem;
    color: var(--texto-2);
  }
</style>
