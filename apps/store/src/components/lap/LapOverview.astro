---
/**
 * The player's post (D16: open to Nomads). Citizen card first, then the
 * doors of the area as tiles — a dashboard, not an essay. Ranks keep their
 * ladder below, because progression is the point of the place.
 */
import { RANK_DEFINITIONS, type SupportedLocale } from '@numinia/domain';
import { LAP_MESSAGES } from '../../i18n/pillars';
import { LAP_UI } from '../../i18n/lap';
import Icon from '../chrome/Icon.astro';
import CitizenCard from './CitizenCard.astro';
import LapShell from './LapShell.astro';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = LAP_MESSAGES[locale];
const lap = LAP_UI[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;

type IconName = 'user' | 'book-open' | 'globe' | 'sword' | 'flame' | 'chart-bar';
const DOORS: ReadonlyArray<{ href: string; label: string; icon: IconName; note: string }> = [
  {
    href: `${prefix}/lap/character/`,
    label: lap.sections.character,
    icon: 'user',
    note: lap.sheet.fileNote,
  },
  { href: `${prefix}/lap/codex/`, label: lap.sections.codex, icon: 'book-open', note: lap.manual.intro },
  { href: `${prefix}/lap/portals/`, label: lap.sections.portals, icon: 'globe', note: lap.emptyPortals },
  { href: `${prefix}/lap/loot/`, label: lap.sections.loot, icon: 'sword', note: lap.emptyLoot },
  { href: `${prefix}/lap/seasons/`, label: lap.sections.seasons, icon: 'flame', note: lap.emptySeasons },
  { href: `${prefix}/lap/stats/`, label: lap.sections.stats, icon: 'chart-bar', note: lap.stats.intro },
];
---

<LapShell
  locale={locale}
  current="overview"
  title={`${t.lapTitle} — Numinia`}
  description={lap.citizen.dashboardIntro}
>
  <article data-lap>
    <h1>{t.lapTitle}</h1>
    <p class="intro">{lap.citizen.dashboardIntro}</p>

    <CitizenCard locale={locale} />

    <ul class="puertas" data-escalonado>
      {
        DOORS.map((door) => (
          <li>
            <a href={door.href} class="tarjeta reveal" data-metric="lap-door">
              <Icon name={door.icon} size={20} />
              <h2>{door.label}</h2>
              <p>{door.note}</p>
            </a>
          </li>
        ))
      }
    </ul>

    <h2 class="etiqueta seccion">{t.ranksTitle}</h2>
    <p class="nota">{t.ranksIntro}</p>
    <ol data-lap-ranks>
      {
        RANK_DEFINITIONS.map((rank, index) => (
          <li class="reveal">
            <span class="mono nivel">{index}</span>
            <div>
              <h3>{rank.name[locale]}</h3>
              <p>{rank.description[locale]}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <aside data-lap-status role="note">
      <p>{t.statusBody}</p>
    </aside>
  </article>
</LapShell>

<style>
  h1 {
    font-size: 2.074rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--texto);
    margin-top: 0;
  }
  .intro {
    font-size: 1.44rem;
    color: var(--texto-2);
    max-width: 65ch;
    line-height: 1.55;
    margin-bottom: var(--s6);
  }
  .puertas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s3);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .puertas a {
    display: block;
    height: 100%;
    color: var(--texto-2);
    text-decoration: none;
    padding: var(--s4);
  }
  .puertas h2 {
    margin: var(--s3) 0 var(--s2);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--texto);
  }
  .puertas p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .seccion {
    display: block;
    margin: var(--s7) 0 var(--s3);
    font-weight: 500;
  }
  .nota {
    color: var(--texto-2);
    max-width: 65ch;
    line-height: 1.55;
  }
  ol {
    list-style: none;
    padding: 0;
    margin: var(--s4) 0 0;
  }
  ol li {
    display: flex;
    gap: var(--s3);
    align-items: baseline;
    border-left: 2px solid var(--verdemar);
    padding: 0 0 var(--s3) var(--s4);
  }
  .nivel {
    color: var(--texto-3);
  }
  ol h3 {
    margin: 0;
    font-size: 1rem;
  }
  ol p {
    margin: 0.2rem 0 0;
    font-size: 0.875rem;
    color: var(--texto-2);
  }
  [data-lap-status] {
    background: var(--superficie);
    border: 1px solid var(--linea);
    border-left: 2px solid var(--ambar);
    border-radius: var(--radio-marco);
    padding: var(--s3) var(--s4);
    margin-top: var(--s6);
  }
  [data-lap-status] p {
    margin: 0;
    color: var(--texto-2);
    font-size: 0.875rem;
  }
</style>
