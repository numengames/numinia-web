---
/**
 * LAP platform shell (§13.11): sidebar on surface, 40px rows with
 * Phosphor regular 18px icons, the active section dressed in ink, and a
 * collapse toggle — folded, the rail keeps icons and tooltips (legacy LAP
 * pattern, redrawn with the Sistema). Open to Nomads (D16): no wall, ever.
 */
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../chrome/Icon.astro';
import { LAP_UI } from '../../i18n/lap';
import { isUnderConstruction } from '../../lib/lap-sections';

export type LapSection =
  | 'overview'
  | 'character'
  | 'codex'
  | 'portals'
  | 'loot'
  | 'seasons'
  | 'stats'
  | 'settings'
  | 'admin-assets'
  | 'admin-census'
  | 'admin-worlds'
  | 'admin-prices';

interface Props {
  locale: SupportedLocale;
  current: LapSection;
  title: string;
  description?: string | undefined;
  /** Opt-out of the 85rem tool cap for views whose content demands the
      full canvas (today: the admin assets table). */
  fullCanvas?: boolean;
}

const { locale, current, title, description, fullCanvas = false } = Astro.props;
const t = LAP_UI[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;

type IconName =
  | 'house'
  | 'user'
  | 'book-open'
  | 'globe'
  | 'sword'
  | 'flame'
  | 'chart-bar'
  | 'gear'
  | 'package'
  | 'users'
  | 'planet'
  | 'coins';
const ITEMS: ReadonlyArray<{
  id: LapSection;
  href: string;
  label: string;
  icon: IconName;
}> = [
  { id: 'overview', href: `${prefix}/lap/`, label: t.sections.overview, icon: 'house' },
  { id: 'character', href: `${prefix}/lap/character/`, label: t.sections.character, icon: 'user' },
  { id: 'codex', href: `${prefix}/lap/codex/`, label: t.sections.codex, icon: 'book-open' },
  { id: 'portals', href: `${prefix}/lap/portals/`, label: t.sections.portals, icon: 'globe' },
  { id: 'loot', href: `${prefix}/lap/loot/`, label: t.sections.loot, icon: 'sword' },
  { id: 'seasons', href: `${prefix}/lap/seasons/`, label: t.sections.seasons, icon: 'flame' },
  { id: 'stats', href: `${prefix}/lap/stats/`, label: t.sections.stats, icon: 'chart-bar' },
  // No «Novedades» here (the Oracle, 2026-10-15): the updates have one door,
  // the version in the footer; /lap/updates/ redirects to /updates/.
  { id: 'settings', href: `${prefix}/lap/settings/`, label: t.sections.settings, icon: 'gear' },
];

/** Management zone — signposted only when the session carries the rank; the
    data behind it is gated server-side, so this is signage, not the lock. */
const ADMIN: ReadonlyArray<{ id: LapSection; href: string; label: string; icon: IconName }> = [
  { id: 'admin-assets', href: `${prefix}/lap/admin/assets/`, label: t.admin.assets, icon: 'package' },
  { id: 'admin-census', href: `${prefix}/lap/admin/census/`, label: t.census.title, icon: 'users' },
];

/** Oracle-only rooms inside the management zone (ADR-069): signposted only
    for the Oracle rank; the endpoint behind each one is the lock. */
const ORACLE: ReadonlyArray<{ id: LapSection; href: string; label: string; icon: IconName }> = [
  { id: 'admin-worlds', href: `${prefix}/lap/admin/worlds/`, label: t.worlds.title, icon: 'planet' },
  // The till's tariff and the calculator behind it (MIS-184).
  { id: 'admin-prices', href: `${prefix}/lap/admin/prices/`, label: t.prices.title, icon: 'coins' },
];
---

<BaseLayout locale={locale} title={title} description={description} wide>
  <div class="lap" data-lap-shell data-canvas={fullCanvas ? '' : undefined}>
    <nav aria-label="LAP">
      <div class="cabecera">
        <p class="etiqueta">LAP</p>
          <button
          type="button"
          class="plegar"
          data-lap-fold
          aria-expanded="true"
          aria-controls="lap-nav-items"
          aria-label={t.foldNav}
          title={t.foldNav}
        >
          <Icon name="caret-left" size={16} />
      </button>
      </div>
      <ul id="lap-nav-items">
        {
          ITEMS.map((item) => {
            const building = isUnderConstruction(item.id);
            const here = item.id === current;
            return (
              <li data-row={item.id} data-here={here ? '' : undefined}>
                <a
                  href={item.href}
                  data-section={item.id}
                  data-building={building ? '' : undefined}
                  aria-current={here ? 'page' : undefined}
                  title={building ? `${item.label} · ${t.building.label}` : item.label}
                  data-metric={`lap-nav-${item.id}`}
                >
                  <Icon name={item.icon} size={18} />
                  <span class="texto">{item.label}</span>
                  {building && (
                    <span class="obra">
                      <Icon name="crane-tower" size={14} />
                      <span class="obra-texto">{t.building.label}</span>
                    </span>
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
      <div class="gestion" data-admin-zone data-session-ranks="archon oracle" hidden>
        <p class="etiqueta">{t.adminGroup}</p>
        <ul>
          {
            ADMIN.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-section={item.id}
                  aria-current={item.id === current ? 'page' : undefined}
                  title={item.label}
                  data-metric={`lap-nav-${item.id}`}
                >
                  <Icon name={item.icon} size={18} />
                  <span class="texto">{item.label}</span>
                </a>
              </li>
            ))
          }
          {
            ORACLE.map((item) => (
              <li data-oracle-only data-session-ranks="oracle" hidden>
                <a
                  href={item.href}
                  data-section={item.id}
                  aria-current={item.id === current ? 'page' : undefined}
                  title={item.label}
                  data-metric={`lap-nav-${item.id}`}
                >
                  <Icon name={item.icon} size={18} />
                  <span class="texto">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
    <div class="contenido">
      <slot />
    </div>
  </div>
</BaseLayout>

<script>
  /* Sidebar fold — a chrome preference like the mode (decision D17):
     localStorage only, applied by the BaseLayout boot script pre-paint. */
  const root = document.documentElement;
  /* Mobile rail: edge fades appear only where content actually hides —
     a faded card border reads as "broken", a faded overflowing label reads
     as "more". And bring the current section into view by scrolling the
     rail itself (scrollIntoView can drag ancestors along). */
  const rail = document.querySelector<HTMLElement>('[data-lap-shell] #lap-nav-items');
  const railNav = rail?.closest('nav');
  const updateFades = (): void => {
    if (!rail || !railNav) return;
    const max = rail.scrollWidth - rail.clientWidth;
    railNav.toggleAttribute('data-fade-left', max > 0 && rail.scrollLeft > 4);
    railNav.toggleAttribute('data-fade-right', max > 0 && rail.scrollLeft < max - 4);
  };
  rail?.addEventListener('scroll', updateFades, { passive: true });
  window.addEventListener('resize', updateFades, { passive: true });
  const active = document.querySelector<HTMLElement>('[data-lap-shell] a[aria-current="page"]');
  if (rail && active && rail.scrollWidth > rail.clientWidth) {
    rail.scrollLeft = active.offsetLeft - (rail.clientWidth - active.offsetWidth) / 2;
  }
  updateFades();
  /* The management zone and the Oracle's rooms carry `data-session-ranks`:
     the chrome's one session read shows them to those ranks, and hides them
     again on a sign-out, without a reload. */

  const foldButton = document.querySelector('[data-lap-fold]');
  foldButton?.setAttribute('aria-expanded', String(root.dataset['lapNav'] !== 'plegado'));
  foldButton?.addEventListener('click', () => {
    const folded = root.dataset['lapNav'] === 'plegado';
    if (folded) delete root.dataset['lapNav'];
    else root.dataset['lapNav'] = 'plegado';
    foldButton.setAttribute('aria-expanded', String(folded));
    try {
      localStorage.setItem('numinia-lap-nav', folded ? 'abierto' : 'plegado');
    } catch {
      /* private mode: the fold lives for this page */
    }
  });
</script>

<style>
  /* Width scale (Oracle 2026-08-16): prose reads at 60rem site-wide; the
     LAP is a tool and works at 85rem, centered so its margins keep the
     rhythm of the rest of the city; the full canvas is per-view, granted
     only where the content demands it (data-canvas). */
  .lap {
    display: grid;
    gap: var(--s5);
    align-items: start;
    min-height: 70vh;
    max-width: 85rem;
    margin-inline: auto;
  }
  .lap[data-canvas] {
    max-width: none;
  }
  /* Grid items default to min-width:auto — the scrollable mobile rail would
     stretch the page instead of scrolling inside itself. */
  .lap > * {
    min-width: 0;
  }
  @media (min-width: 50rem) {
    .lap {
      grid-template-columns: 240px minmax(0, 1fr);
    }
    :global(html[data-lap-nav='plegado']) .lap {
      grid-template-columns: 64px minmax(0, 1fr);
    }
  }
  nav {
    background: var(--superficie);
    border: 1px solid var(--linea);
    border-radius: var(--radio-marco);
    padding: var(--s3);
  }
  .cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--s1) var(--s2) var(--s2);
  }
  .etiqueta {
    margin: 0;
  }
  .plegar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: var(--radio-control);
    color: var(--texto-3);
    cursor: pointer;
    transition:
      color 120ms var(--ciclo),
      transform 120ms var(--ciclo);
  }
  .plegar:hover,
  .plegar:focus-visible {
    color: var(--texto);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  a {
    display: flex;
    align-items: center;
    gap: var(--s3);
    min-height: 40px;
    padding: 0 var(--s3);
    border-radius: var(--radio-control);
    color: var(--texto-2);
    text-decoration: none;
    transition:
      color 120ms var(--ciclo),
      background 120ms var(--ciclo);
  }
  a:hover,
  a:focus-visible {
    color: var(--texto);
    background: var(--elevada);
  }
  a[aria-current='page'] {
    background: var(--texto);
    color: var(--fondo);
  }
  /* «En construcción» (the Oracle, 2026-10-14): the crane and the words,
     in amber, on a second line under the section's name. The current row
     is dressed in ink, so its mark takes the row's own ink (amber on ink
     would fall under AA in both modes). */
  .obra {
    display: inline-flex;
    align-items: center;
    gap: var(--s1);
    color: var(--ambar);
    font-size: 0.75rem;
    line-height: 1.3;
  }
  a[aria-current='page'] .obra {
    color: inherit;
  }
  @media (min-width: 50rem) {
    a[data-building] {
      display: grid;
      grid-template-columns: 18px minmax(0, 1fr);
      column-gap: var(--s3);
      row-gap: 0;
      align-content: center;
      padding-block: 4px;
    }
    a[data-building] .obra {
      grid-column: 2;
    }
    a[data-building] > :global(.icono) {
      align-self: center;
    }
  }
  /* Mobile: the sidebar becomes a horizontal scrollable rail — thumb-first,
     44px touch targets, no fold button (nothing to fold). */
  @media (max-width: 49.99rem) {
    nav {
      position: sticky;
      top: 0;
      z-index: 6;
    }
    nav {
      overflow: hidden;
    }
    ul {
      flex-direction: row;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
    }
    ul::-webkit-scrollbar {
      display: none;
    }
    ul li {
      scroll-snap-align: start;
    }
    /* No JS: a static right fade still says "there is more rail". */
    :global(html:not([data-js='on'])) nav #lap-nav-items {
      mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent 100%);
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent 100%);
    }
    /* Edge fades on the CONTENT (never the card border), each side only
       while something hides behind it — toggled by the shell script. */
    nav[data-fade-right] #lap-nav-items {
      mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent 100%);
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent 100%);
    }
    nav[data-fade-left] #lap-nav-items {
      mask-image: linear-gradient(to right, transparent 0, #000 40px);
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 40px);
    }
    nav[data-fade-left][data-fade-right] #lap-nav-items {
      mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 40px,
        #000 calc(100% - 40px),
        transparent 100%
      );
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 40px,
        #000 calc(100% - 40px),
        transparent 100%
      );
    }
    a {
      min-height: 44px;
      flex: none;
    }
    /* The phone's rail keeps one line: the crane alone says it, the
       words stay for screen readers. */
    .obra-texto {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .cabecera {
      display: none;
    }
  }
  .gestion {
    margin-top: var(--s4);
    padding-top: var(--s3);
    border-top: 1px solid var(--linea);
  }
  .gestion .etiqueta {
    margin: 0 0 var(--s2) var(--s2);
  }
  /* Sections the citizen hid in Settings, or that a first visit finds off
     (never the current one). The whole row goes, so the rail keeps its
     rhythm (a hidden link inside a kept row left its gap behind). */
  :global(html[data-lap-hidden~='character']) li[data-row='character']:not([data-here]),
  :global(html[data-lap-hidden~='codex']) li[data-row='codex']:not([data-here]),
  :global(html[data-lap-hidden~='portals']) li[data-row='portals']:not([data-here]),
  :global(html[data-lap-hidden~='loot']) li[data-row='loot']:not([data-here]),
  :global(html[data-lap-hidden~='seasons']) li[data-row='seasons']:not([data-here]),
  :global(html[data-lap-hidden~='stats']) li[data-row='stats']:not([data-here]) {
    display: none;
  }
  /* Folded rail: icons only, labels and wordgroup hidden, caret flips. */
  :global(html[data-lap-nav='plegado']) .texto,
  :global(html[data-lap-nav='plegado']) .obra-texto,
  :global(html[data-lap-nav='plegado']) .etiqueta {
    display: none;
  }
  :global(html[data-lap-nav='plegado']) .cabecera {
    justify-content: center;
  }
  :global(html[data-lap-nav='plegado']) .plegar {
    transform: rotate(180deg);
  }
  :global(html[data-lap-nav='plegado']) a {
    justify-content: center;
    padding: 0;
  }
  /* Folded, an unfinished section shows its icon with the crane under it;
     the row's title names both («Botín · En construcción»). */
  :global(html[data-lap-nav='plegado']) a[data-building] {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding-block: 4px;
  }
</style>
