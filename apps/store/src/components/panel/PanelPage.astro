---
/**
 * «El panel»: an organization's panel — the screen the account menu's
 * «Paneles» opens. Five faces of one frame: `summary` (Resumen), `venues`
 * (Sedes: ./PanelSedes.tsx, the organization's worlds), `members`
 * (Miembros), `roles` (Roles), `agents` (Agentes: the community's AIs) and `balance` (Saldo y consumo); the people's
 * two are «La gente» (./PanelMiembros.tsx, ./PanelRoles.tsx), the balance
 * hosts the screen Saldo already has, for the organization the address
 * names (`?org=<account id>`, lib/panel.ts). The page is static and the
 * island reads the session and the till (/api/saldo): nothing is made up
 * here, and nothing is stored.
 *
 * The words are in i18n/panel.ts (the pieces), i18n/panel-people.ts (the
 * people's two screens, carried only by them) and i18n/saldo.ts (Saldo's
 * own terms); the rules in ./panel.css and the very file /saldo/ draws with
 * (../saldo/saldo.css).
 */
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PANEL_UI } from '../../i18n/panel';
import { PANEL_SETTINGS_UI } from '../../i18n/panel-settings';
import { MUNDOS_UI } from '../../i18n/mundos';
import { PEOPLE_UI } from '../../i18n/panel-people';
import { GENTE_UI } from '../../i18n/panel-gente';
import { AGENTES_UI } from '../../i18n/panel-agentes';
import { SALDO_UI } from '../../i18n/saldo';
import { COMMUNITY_REQUESTS_UI } from '../../i18n/community-requests';
import { communityOfAccount } from '../../lib/community-accounts';
import { REGISTER } from '../communities/register';
import { localeHref, signInHref } from '../../lib/app-nav';
import { PIECES, type BuiltPiece } from '../../lib/panel';
import { PanelMiembros } from './PanelMiembros';
import { PanelGente } from './PanelGente';
import { PanelAgentes } from './PanelAgentes';
import { PanelAjustes } from './PanelAjustes';
import { PanelRoles } from './PanelRoles';
import { PanelSedes } from './PanelSedes';
import PanelSummary from './PanelSummary.astro';
import { PanelSaldo } from './PanelSaldo';
import '../saldo/saldo.css';
// The invitation dialog is the world page's own (its rules, not a copy).
import '../mundos/mundo.css';
import './panel.css';

interface Props {
  locale: SupportedLocale;
  face: BuiltPiece;
}

const { locale, face } = Astro.props;
const words = PANEL_UI[locale];
// The door comes back to this very screen (the organization is chosen again
// from the till's list: it is never carried through the sign-in).
const here = PIECES.find((piece) => piece.id === face)?.path ?? '/panel/';
const signIn = signInHref(locale, here);
// Where an organization is created: the islands take their hrefs from here
// (an island never imports lib/app-nav.ts: see lib/panel.ts).
const saldoHref = localeHref(locale, '/saldo/');
// The panel's door: where leaving an organization lands.
const homeHref = localeHref(locale, '/panel/');
// Which community each organization is of, for Members' «Peticiones».
const communities = face === 'members' ? await communityOfAccount(REGISTER) : {};
---

<BaseLayout
  locale={locale}
  title={`${words.names[face]} — Numinia`}
  description={words.leads[face]}
  wide
>
  {
    face === 'summary' && (
      <PanelSummary locale={locale} words={words} signIn={signIn} saldoHref={saldoHref} />
    )
  }
  {
    face === 'venues' && (
      <PanelSedes
        client:load
        locale={locale}
        words={words}
        signIn={signIn}
        saldoHref={saldoHref}
        venues={MUNDOS_UI[locale].venues}
      />
    )
  }
  {
    face === 'members' && (
      <PanelMiembros
        client:load
        locale={locale}
        words={words}
        signIn={signIn}
        saldoHref={saldoHref}
        homeHref={homeHref}
        ui={SALDO_UI[locale]}
        people={PEOPLE_UI[locale]}
        communities={communities}
        requests={COMMUNITY_REQUESTS_UI[locale].list}
      />
    )
  }
  {
    face === 'gente' && (
      <PanelGente
        client:load
        locale={locale}
        words={words}
        signIn={signIn}
        saldoHref={saldoHref}
        ui={SALDO_UI[locale]}
        people={PEOPLE_UI[locale]}
        gente={GENTE_UI[locale]}
      />
    )
  }
  {
    face === 'agents' && (
      <PanelAgentes
        client:load
        locale={locale}
        words={words}
        signIn={signIn}
        saldoHref={saldoHref}
        ui={SALDO_UI[locale]}
        people={PEOPLE_UI[locale]}
        agentes={AGENTES_UI[locale]}
        world={MUNDOS_UI[locale].page.ai.dialog}
      />
    )
  }
  {
    face === 'roles' && (
      <PanelRoles
        client:load
        locale={locale}
        words={words}
        signIn={signIn}
        saldoHref={saldoHref}
        ui={SALDO_UI[locale]}
        people={PEOPLE_UI[locale]}
      />
    )
  }
  {
    face === 'balance' && (
      <PanelSaldo
        client:load
        locale={locale}
        words={words}
        signIn={signIn}
        saldoHref={saldoHref}
        ui={SALDO_UI[locale]}
      />
    )
  }
  {
    face === 'settings' && (
      <PanelAjustes
        client:load
        locale={locale}
        words={words}
        ui={PANEL_SETTINGS_UI[locale]}
        signIn={signIn}
        saldoHref={saldoHref}
      />
    )
  }
</BaseLayout>
