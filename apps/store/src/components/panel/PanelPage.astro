---
/**
 * «El panel»: an organization's panel — the screen the account menu's
 * «Paneles» opens. Three faces of one frame: `summary` (Resumen),
 * `members` (Miembros y roles) and `balance` (Saldo y consumo); the last two
 * host the screens Saldo already has, for the organization the address
 * names (`?org=<account id>`, lib/panel.ts). The page is static and the
 * island reads the session and the till (/api/saldo): nothing is made up
 * here, and nothing is stored.
 *
 * The words are in i18n/panel.ts (the pieces) and i18n/saldo.ts (the hosted
 * screens'); the rules in ./panel.css and, for the hosted screens, the very
 * file /saldo/ draws with (../saldo/saldo.css).
 */
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PANEL_UI } from '../../i18n/panel';
import { SALDO_UI } from '../../i18n/saldo';
import { localeHref, signInHref } from '../../lib/app-nav';
import { PIECES, type BuiltPiece } from '../../lib/panel';
import { PanelMiembros } from './PanelMiembros';
import { PanelResumen } from './PanelResumen';
import { PanelSaldo } from './PanelSaldo';
import '../saldo/saldo.css';
import './panel.css';

interface Props {
  locale: SupportedLocale;
  face: BuiltPiece;
}

const { locale, face } = Astro.props;
const words = PANEL_UI[locale];
// The door comes back to this very screen (the organization is chosen again
// from the till's list: it is never carried through the sign-in).
const here = PIECES.find((piece) => piece.id === face)?.path ?? '/panel/';
const signIn = signInHref(locale, here);
// Where an organization is created: the islands take their hrefs from here
// (an island never imports lib/app-nav.ts: see lib/panel.ts).
const saldoHref = localeHref(locale, '/saldo/');
---

<BaseLayout
  locale={locale}
  title={`${words.names[face]} — Numinia`}
  description={words.leads[face]}
  wide
>
  {
    face === 'summary' && (
      <PanelResumen client:load locale={locale} words={words} signIn={signIn} saldoHref={saldoHref} />
    )
  }
  {
    face === 'members' && (
      <PanelMiembros
        client:load
        locale={locale}
        words={words}
        signIn={signIn}
        saldoHref={saldoHref}
        ui={SALDO_UI[locale]}
      />
    )
  }
  {
    face === 'balance' && (
      <PanelSaldo
        client:load
        locale={locale}
        words={words}
        signIn={signIn}
        saldoHref={saldoHref}
        ui={SALDO_UI[locale]}
      />
    )
  }
</BaseLayout>
