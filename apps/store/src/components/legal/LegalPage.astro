---
/**
 * Legal page dispatcher: `terms` and `privacy` render the real corpus
 * (MIS-086); `cookies` and `legal-notice` are still Oracle drafts and keep
 * saying so. No markup or styles of its own — each branch owns them, so a
 * published page never even ships the draft banner's CSS.
 */
import type { SupportedLocale } from '@numinia/domain';
import { isPublishedLegalDoc, type LegalDoc } from '../../lib/legal';
import LegalCorpusDoc from './LegalCorpusDoc.astro';
import LegalDraftDoc from './LegalDraftDoc.astro';

interface Props {
  locale: SupportedLocale;
  doc: LegalDoc;
}

const { locale, doc } = Astro.props;
---

{
  isPublishedLegalDoc(doc) ? (
    <LegalCorpusDoc locale={locale} doc={doc} />
  ) : (
    <LegalDraftDoc locale={locale} doc={doc} />
  )
}
