---
/**
 * «MCP remoto», story W4, rebuilt as C5: the «Conecta tu IA» consent,
 * /conectar-ia/ in five locales (DISENO-MCP-REMOTO.md §1 step 4 and §2 (d)).
 * An MCP client (Claude, ChatGPT, Hermes…) asks to act in Numinia worlds; the
 * relay (W6) sends the browser here with `?app=&host=&req=` (contract in
 * lib/conectar-ia-page.ts).
 *
 * Written for someone who has never done this. Three steps on top (1 your AI
 * asks · 2 pick the community and the permission · 3 back to your AI), then
 * one card: which app asks and, in large type, the machine it goes back to
 * (cut only after a dot, never inside a name, with a warning apart when that
 * is this computer); what it will and will not be able to do, in two short
 * lists; the community (only those where the person may add or reconnect an
 * AI), which AI it is (a new one with its name, or one already connected this
 * way, whose old connection stops), its role (only roles the person can give)
 * — and an unchecked box: whether it may hear what is said nearby (Pablo,
 * 2026-10-20: a switch per AI, off by default). «Permitir» posts to
 * /api/conectar-ia; «No permitir» connects nothing; after «Permitir» the card
 * becomes «Listo» (step 3), and when the relay says where the AI waits the
 * browser goes there after a moment.
 *
 * Signed out it says what this is and offers the door, which comes back
 * here (lib/island-session.ts). With no community to add an AI to it says why
 * and what to do. Rendered on demand (it reads the session cookie and asks
 * the till), never cached. A link that is missing something shows no form at
 * all (fail closed).
 */
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONECTAR_IA_UI } from '../../i18n/conectar-ia';
import { fill } from '../../i18n/communities';
import { accountsFrom } from '../../lib/accounts-source';
import { localeHref, signInHref } from '../../lib/app-nav';
import { SESSION_COOKIE } from '../../lib/auth/server';
import { sessionAsker } from '../../lib/auth/session-wallet';
import {
  AGENTS_PANEL_PATH,
  COMMUNITIES_PATH,
  CONSENT_API,
  consentChoices,
  consentHref,
  hostLabels,
  readConsentAsk,
  type ConsentOrg,
} from '../../lib/conectar-ia-page';
import { runtimeBinding } from '../../lib/runtime-env';
import Icon from '../chrome/Icon.astro';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = CONECTAR_IA_UI[locale];

Astro.response.headers.set('cache-control', 'private, no-store');

const ask = readConsentAsk(Astro.url.search);
type State = 'bad' | 'out' | 'unavailable' | 'none' | 'ok';
let state: State = 'bad';
let orgs: readonly ConsentOrg[] = [];
if (ask !== null) {
  const asker = await sessionAsker(Astro.cookies.get(SESSION_COOKIE)?.value);
  const desk = accountsFrom({
    binding: runtimeBinding('TILL_ACCOUNTS'),
    dataSource: process.env.DATA_SOURCE,
  });
  const choices = await consentChoices(desk, asker);
  if (choices.ok) {
    orgs = choices.orgs;
    state = orgs.length === 0 ? 'none' : 'ok';
  } else {
    state = choices.reason === 'signed-out' ? 'out' : 'unavailable';
  }
}
const [asksBefore = '', asksAfter = ''] = t.asks.split('{app}');
const [doneBefore = '', doneAfter = ''] = t.doneLead.split('{name}');
const signIn = ask === null ? '' : signInHref(locale, consentHref(ask));
const one = orgs.length === 1 ? orgs[0] : undefined;
const labels = ask === null ? [] : hostLabels(ask.host);
const words = JSON.stringify({
  allow: t.allow,
  allowing: t.allowing,
  yes: t.yes,
  no: t.no,
  refusals: t.refusals,
});
---

<BaseLayout locale={locale} title={`${t.title} — Numinia`} description={t.lead}>
  <meta slot="head" name="robots" content="noindex" />
  <div class="conectar-pagina">
    <header class="titulo-vista">
      <h1 class="display-m">{t.title}</h1>
    </header>

    {
      ask === null ? (
        <section class="tarjeta conectar" data-consent="bad">
          <Icon name="lock-key" size={28} />
          <p class="titulo-s">{t.badTitle}</p>
          <p class="texto-2">{t.badLead}</p>
        </section>
      ) : (
        <>
          <ol class="pasos" aria-label={t.stepsLabel} data-consent-steps>
            {t.steps.map((step, i) => (
              <li class={i === 0 ? 'hecho' : i === 1 ? 'ahora' : ''} aria-current={i === 1 ? 'step' : undefined}>
                <span class="num-paso" aria-hidden="true">
                  <span class="cifra">{i + 1}</span>
                  <span class="marca">
                    <Icon name="check" size={16} />
                  </span>
                </span>
                <span class="rotulo">{step}</span>
              </li>
            ))}
          </ol>

          <section
            class="tarjeta conectar"
            data-consent={state}
            data-words={words}
            data-api={CONSENT_API}
          >
            <div class="quien" data-consent-ask>
              <p class="pide">
                {asksBefore}
                <strong data-consent-app>{ask.app}</strong>
                {asksAfter}
              </p>
              <div class="vuelve">
                <span>{t.returnsTo}</span>
                <span class="maquina">
                  <Icon name="arrow-square-out" size={20} />
                  <span class="host mono" data-consent-host>
                    {labels.map((label, i) => (
                      <>
                        {i > 0 && <wbr />}
                        <span class="et">{label}</span>
                      </>
                    ))}
                  </span>
                </span>
              </div>
              {ask.loopback && (
                <p class="alerta-maquina" role="note" data-consent-loopback>
                  {t.loopback}
                </p>
              )}
            </div>

            <div data-consent-body>
              {state === 'out' && (
                <div class="centrado">
                  <span class="medalla">
                    <Icon name="lock-key" size={40} />
                  </span>
                  <h2>{t.signedOutTitle}</h2>
                  <p class="texto-2">{t.signedOutLead}</p>
                  <a class="btn btn-primario" href={signIn} data-metric="connect-ai-sign-in">
                    <Icon name="sign-in" size={18} />
                    {t.signIn}
                  </a>
                </div>
              )}
              {state === 'unavailable' && <p class="texto-2">{t.unavailable}</p>}
              {state === 'none' && (
                <div class="centrado">
                  <span class="medalla aviso">
                    <Icon name="users-three" size={40} />
                  </span>
                  <h2>{t.noneTitle}</h2>
                  <div class="por-que">
                    <Icon name="question" size={20} />
                    <p>
                      <b>{t.noneWhyLabel}</b> {t.noneWhy}
                    </p>
                    <span class="sep" />
                    <Icon name="arrow-right" size={20} />
                    <p>
                      <b>{t.noneDoLabel}</b> {t.noneDo}
                    </p>
                  </div>
                  <div class="acciones al-centro">
                    <a
                      class="btn btn-fantasma"
                      href={localeHref(locale, COMMUNITIES_PATH)}
                      data-metric="connect-ai-communities"
                    >
                      {t.noneCommunities}
                    </a>
                    <button
                      type="button"
                      class="btn btn-fantasma"
                      data-consent-cancel
                      data-metric="connect-ai-cancel"
                    >
                      {t.noneClose}
                    </button>
                  </div>
                </div>
              )}
              {state === 'ok' && (
                <form id="ci-form" class="formulario" data-consent-form novalidate>
                  <input type="hidden" name="req" value={ask.req} />
                  <input type="hidden" name="app" value={ask.app} />
                  <input type="hidden" name="host" value={ask.host} />

                  <div class="campo">
                    <label for="ci-org">{t.community}</label>
                    {one ? (
                      <>
                        <input type="hidden" name="accountId" value={one.accountId} />
                        <p class="valor" id="ci-org" data-consent-community>
                          {one.name}
                        </p>
                      </>
                    ) : (
                      <select
                        id="ci-org"
                        name="accountId"
                        data-consent-community
                        data-metric="connect-ai-community"
                      >
                        {orgs.map((org) => (
                          <option value={org.accountId}>{org.name}</option>
                        ))}
                      </select>
                    )}
                  </div>

                  {orgs.map((org, i) => (
                    <div class="por-comunidad" data-consent-org={org.accountId} hidden={i !== 0}>
                      <fieldset class="campo">
                        <legend>{t.which}</legend>
                        {org.mayCreate && (
                          <div class="eleccion">
                            <label class="opcion">
                              <input
                                type="radio"
                                name={`ai-${i}`}
                                value="new"
                                checked
                                data-metric="connect-ai-new"
                              />
                              <span class="en-negrita">{t.newAi}</span>
                            </label>
                            <div class="campo nombre" data-consent-name>
                              <label for={`ci-name-${i}`}>{t.nameLabel}</label>
                              <input
                                id={`ci-name-${i}`}
                                name={`name-${i}`}
                                type="text"
                                value={ask.app}
                                maxlength={40}
                                autocomplete="off"
                                aria-describedby={`ci-name-help-${i}`}
                                data-metric="connect-ai-name"
                              />
                              <span class="ayuda" id={`ci-name-help-${i}`}>
                                {t.nameHint}
                              </span>
                            </div>
                          </div>
                        )}
                        {org.again.map((agent, j) => (
                          <div class="eleccion">
                            <label class="opcion">
                              <input
                                type="radio"
                                name={`ai-${i}`}
                                value={agent.id}
                                checked={!org.mayCreate && j === 0}
                                data-metric="connect-ai-again"
                              />
                              <span>
                                <span class="en-negrita">{fill(t.again, { name: agent.name })}</span>
                                <span class="ayuda" style="display: block">
                                  {t.againNote}
                                </span>
                              </span>
                            </label>
                          </div>
                        ))}
                      </fieldset>

                      <div class="campo">
                        <p class="etiqueta-campo" id={`ci-role-label-${i}`}>
                          {t.role}
                        </p>
                        {org.mayCreate && (
                          <select
                            name={`role-${i}-new`}
                            aria-labelledby={`ci-role-label-${i}`}
                            aria-describedby="ci-role-help"
                            data-consent-role="new"
                            data-metric="connect-ai-role"
                          >
                            <option value="">{t.roleNone}</option>
                            {org.roles.map((role) => (
                              <option value={role.id}>{role.name}</option>
                            ))}
                          </select>
                        )}
                        {org.again.map((agent, j) => (
                          <select
                            name={`role-${i}-${agent.id}`}
                            aria-labelledby={`ci-role-label-${i}`}
                            aria-describedby="ci-role-help"
                            data-consent-role={agent.id}
                            data-metric="connect-ai-role"
                            hidden={org.mayCreate || j !== 0}
                          >
                            <option value="">{t.roleKeep}</option>
                            {agent.roles.map((role) => (
                              <option value={role.id}>{role.name}</option>
                            ))}
                          </select>
                        ))}
                        <p class="ayuda" id="ci-role-help">
                          {t.roleHelp}
                        </p>
                      </div>
                    </div>
                  ))}

                  <div class="puede">
                    <div class="si" data-consent-can>
                      <h3>
                        <Icon name="check" size={18} />
                        {t.canTitle}
                      </h3>
                      <ul>
                        {t.canItems.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="no" data-consent-cannot>
                      <h3>
                        <Icon name="prohibit" size={18} />
                        {t.cannotTitle}
                      </h3>
                      <ul>
                        {t.cannotItems.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <label class="opcion casilla" data-consent-hear>
                    <input type="checkbox" name="hear" data-metric="connect-ai-hear" />
                    <span>
                      <span class="en-negrita">{t.hearLabel}</span>
                      <span class="ayuda" style="display: block">
                        {t.hearHint}
                      </span>
                    </span>
                  </label>
                  <p class="oye">
                    <Icon name="user" size={18} />
                    {t.answer}
                  </p>
                  <p class="fallo" data-consent-problem role="alert" hidden />
                </form>
              )}

              {state === 'ok' && (
                <div class="acciones">
                  <button
                    type="button"
                    class="btn btn-fantasma"
                    data-consent-cancel
                    data-metric="connect-ai-cancel"
                  >
                    {t.deny}
                  </button>
                  <button
                    type="submit"
                    form="ci-form"
                    class="btn btn-primario"
                    data-consent-allow
                    data-metric="connect-ai-allow"
                  >
                    {t.allow}
                  </button>
                </div>
              )}
            </div>

            <div class="centrado" data-consent-done role="status" hidden>
              <span class="medalla ok">
                <Icon name="check" size={40} />
              </span>
              <h2 tabindex="-1" data-consent-done-title>
                {t.doneTitle}
              </h2>
              <p class="texto-2" data-consent-done-lead>
                {doneBefore}
                <strong data-consent-done-name />
                {doneAfter}
              </p>
              <p class="texto-2" data-consent-returning hidden>
                {t.doneReturning}
              </p>
              <dl class="resumen">
                <div>
                  <dt>{t.sumCommunity}</dt>
                  <dd data-consent-sum="community" />
                </div>
                <div>
                  <dt>{t.sumRole}</dt>
                  <dd data-consent-sum="role" />
                </div>
                <div>
                  <dt>{t.sumHear}</dt>
                  <dd data-consent-sum="hear" />
                </div>
                <div>
                  <dt>{t.sumReturn}</dt>
                  <dd class="host mono" data-consent-sum="host">
                    {labels.map((label, i) => (
                      <>
                        {i > 0 && <wbr />}
                        <span class="et">{label}</span>
                      </>
                    ))}
                  </dd>
                </div>
              </dl>
              <p class="ayuda">{t.doneNote}</p>
              <div class="acciones al-centro">
                <a
                  class="btn btn-primario"
                  href="/"
                  data-consent-return
                  data-metric="connect-ai-return"
                  hidden
                >
                  {t.doneBack}
                </a>
                <a
                  class="btn btn-fantasma"
                  href={localeHref(locale, AGENTS_PANEL_PATH)}
                  data-metric="connect-ai-panel"
                >
                  {t.donePanel}
                </a>
              </div>
            </div>

            <p class="final" data-consent-cancelled role="status" hidden>
              {t.cancelled}
            </p>
          </section>
        </>
      )
    }
  </div>
</BaseLayout>

<script>
  import type { ConectarIaMessages } from '../../i18n/conectar-ia';

  type Words = Pick<ConectarIaMessages, 'allow' | 'allowing' | 'yes' | 'no' | 'refusals'>;

  /** How long «Listo» stays before the browser goes back to the AI by itself. */
  const BACK_AFTER_MS = 1800;

  const root = document.querySelector<HTMLElement>('[data-consent]');
  if (root && root.dataset['consent'] !== 'bad') wire(root);

  function wire(card: HTMLElement): void {
    const words = JSON.parse(card.dataset['words'] ?? '{}') as Words;
    const ask = card.querySelector<HTMLElement>('[data-consent-ask]');
    const body = card.querySelector<HTMLElement>('[data-consent-body]');
    const done = card.querySelector<HTMLElement>('[data-consent-done]');
    const cancelled = card.querySelector<HTMLElement>('[data-consent-cancelled]');
    const steps = document.querySelector<HTMLElement>('[data-consent-steps]');

    // The progress on top: «Listo» ticks all three, «No permitir» takes it away (nothing is under way).
    const showSteps = (all: boolean): void => {
      if (!steps) return;
      if (!all) {
        steps.hidden = true;
        return;
      }
      for (const step of steps.querySelectorAll('li')) {
        step.className = 'hecho';
        step.removeAttribute('aria-current');
      }
    };
    const end = (shown: HTMLElement | null): void => {
      if (body) body.hidden = true;
      if (shown) shown.hidden = false;
    };

    // «No permitir» connects nothing. The relay (W6) will be told the person said no.
    card.querySelector('[data-consent-cancel]')?.addEventListener('click', () => {
      showSteps(false);
      end(cancelled);
    });

    const form = card.querySelector<HTMLFormElement>('[data-consent-form]');
    if (!form) return;
    const value = (name: string): string => {
      const element = form.elements.namedItem(name);
      if (element instanceof RadioNodeList) return element.value;
      return (element as HTMLInputElement | HTMLSelectElement | null)?.value ?? '';
    };
    const blocks = Array.from(form.querySelectorAll<HTMLElement>('[data-consent-org]'));
    const current = (): HTMLElement | undefined =>
      blocks.find((block) => block.dataset['consentOrg'] === value('accountId'));
    const index = (block: HTMLElement): number => blocks.indexOf(block);

    // The community's own choices; within it, the name for a new AI and one role list per choice.
    const refresh = (): void => {
      const shown = current();
      for (const block of blocks) block.hidden = block !== shown;
      if (!shown) return;
      const choice = value(`ai-${index(shown)}`);
      const name = shown.querySelector<HTMLElement>('[data-consent-name]');
      if (name) name.hidden = choice !== 'new';
      for (const select of shown.querySelectorAll<HTMLSelectElement>('[data-consent-role]')) {
        select.hidden = select.dataset['consentRole'] !== choice;
      }
    };
    form.addEventListener('change', refresh);
    refresh();

    const problem = form.querySelector<HTMLElement>('[data-consent-problem]');
    const say = (text: string | null): void => {
      if (!problem) return;
      problem.hidden = text === null;
      problem.textContent = text ?? '';
    };
    const allow = card.querySelector<HTMLButtonElement>('[data-consent-allow]');
    const refusal = (key: string | undefined): string =>
      words.refusals[(key ?? 'failed') as keyof Words['refusals']] ?? words.refusals.failed;

    // «Listo»: what was chosen, read from the form as the person left it.
    const summarize = (name: string, hear: boolean): void => {
      const put = (key: string, text: string): void => {
        const cell = card.querySelector<HTMLElement>(`[data-consent-sum="${key}"]`);
        if (cell) cell.textContent = text;
      };
      const community = form.querySelector<HTMLElement>('[data-consent-community]');
      put(
        'community',
        community instanceof HTMLSelectElement
          ? (community.selectedOptions[0]?.text ?? '')
          : (community?.textContent?.trim() ?? ''),
      );
      const role = current()?.querySelector<HTMLSelectElement>('[data-consent-role]:not([hidden])');
      put('role', role?.selectedOptions[0]?.text ?? '');
      put('hear', hear ? words.yes : words.no);
      const who = card.querySelector<HTMLElement>('[data-consent-done-name]');
      if (who) who.textContent = name;
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const shown = current();
      if (!shown) return;
      const i = index(shown);
      const choice = value(`ai-${i}`);
      const role = value(`role-${i}-${choice}`);
      const hear = (form.elements.namedItem('hear') as HTMLInputElement | null)?.checked === true;
      const sent = {
        req: value('req'),
        app: value('app'),
        host: value('host'),
        accountId: value('accountId'),
        ai:
          choice === 'new'
            ? { kind: 'new', name: value(`name-${i}`) }
            : { kind: 'again', agentId: choice },
        roleId: role === '' ? null : role,
        hear,
      };
      say(null);
      if (allow) {
        allow.disabled = true;
        allow.textContent = words.allowing;
      }
      void fetch(card.dataset['api'] ?? '', {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify(sent),
      })
        .then(async (response) => {
          const answer = (await response.json().catch(() => null)) as {
            ok?: boolean;
            refusal?: string;
            error?: string;
            connection?: { name: string };
            next?: string | null;
          } | null;
          if (response.ok && answer?.ok === true && answer.connection) {
            summarize(answer.connection.name, hear);
            if (ask) ask.hidden = true;
            showSteps(true);
            end(done);
            done?.querySelector<HTMLElement>('[data-consent-done-title]')?.focus();
            // The relay says where the AI waits: show «Listo» for a moment, then go there.
            if (typeof answer.next === 'string') {
              const next = answer.next;
              const back = card.querySelector<HTMLAnchorElement>('[data-consent-return]');
              if (back) {
                back.href = next;
                back.hidden = false;
              }
              const returning = card.querySelector<HTMLElement>('[data-consent-returning]');
              if (returning) returning.hidden = false;
              setTimeout(() => location.assign(next), BACK_AFTER_MS);
            }
            return;
          }
          say(refusal(answer?.refusal ?? answer?.error));
        })
        .catch(() => say(words.refusals.failed))
        .finally(() => {
          if (allow) {
            allow.disabled = false;
            allow.textContent = words.allow;
          }
        });
    });
  }
</script>

<style>
  .conectar-pagina {
    max-width: 44rem;
    margin-inline: auto;
  }
  /* One shrinkable column everywhere: a long unbreakable name must scroll in its own box,
     not push the card wider than the screen. */
  .conectar,
  .quien,
  [data-consent-body],
  .formulario,
  .por-comunidad {
    grid-template-columns: minmax(0, 1fr);
  }
  .conectar {
    display: grid;
    gap: var(--s4);
  }
  .conectar p {
    margin: 0;
  }

  /* The three steps: done = ticked, now = ringed, to come = grey; the line joins them. */
  .pasos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: var(--s4) 0 var(--s5);
    padding: 0;
    list-style: none;
  }
  .pasos[hidden] {
    display: none;
  }
  .pasos li {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s2);
    padding: 0 6px;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--texto-3);
  }
  .pasos li::before {
    content: '';
    position: absolute;
    top: 15px;
    right: 50%;
    width: 100%;
    height: 2px;
    background: var(--linea-f);
  }
  .pasos li:first-child::before {
    display: none;
  }
  .pasos li.hecho::before,
  .pasos li.ahora::before {
    background: var(--turquesa);
  }
  .pasos li.hecho,
  .pasos li.ahora {
    color: var(--texto);
    font-weight: 500;
  }
  .num-paso {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 2px solid var(--linea-f);
    border-radius: 50%;
    background: var(--fondo);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--texto-3);
  }
  .marca {
    display: none;
  }
  .hecho .num-paso {
