---
import type { SupportedLocale } from '@numinia/domain';
import { CHROME_MESSAGES } from '../../i18n/messages';
import { VERSION, COMMIT_SHA, COMMIT_URL, LICENSE_URL } from '../../lib/build-info';
import { SOCIAL_LINKS } from '../../lib/social-links';
// §8.5 / repertoire rule: the scarab closes every piece, never opens it — the
// scarab's one canonical home on the site is the foot of the page.
import scarab from '@numinia/ui/assets/brand/Khepri_Logo.svg?raw';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = CHROME_MESSAGES[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;
---

<footer>
  <p class="binaria" aria-hidden="true">
    
  </p>
  <div class="columns">
    <nav aria-label={t.footerNavigation}>
      <h2>{t.footerNavigation}</h2>
      <a href={`${prefix}/`} data-metric="footer-home">{t.navHome}</a>
      <a href={`${prefix}/city/`} data-metric="footer-city">{t.navCity}</a>
      <a href={`${prefix}/assets/`} data-metric="footer-assets">{t.navAssets}</a>
      <a href={`${prefix}/lap/`} data-metric="footer-lap">{t.navLap}</a>
      <a href={`${prefix}/updates/`} data-metric="footer-updates">{t.navUpdates}</a>
    </nav>
    <nav aria-label={t.navAssets}>
      <h2>{t.navAssets}</h2>
      <a href={`${prefix}/gallery/`} data-metric="footer-gallery">{t.navGallery}</a>
      <a href={`${prefix}/archive/`} data-metric="footer-archive">{t.navArchive}</a>
      <a href={`${prefix}/finder/`} data-metric="footer-finder">{t.navFinder}</a>
      <a href={`${prefix}/inspector/`} data-metric="footer-inspector">{t.navInspector}</a>
      <a href={`${prefix}/docs/`} data-metric="footer-docs">{t.navDocs}</a>
    </nav>
    <nav aria-label={t.footerResources}>
      <h2>{t.footerResources}</h2>
      <a href="https://numen.games" target="_blank" rel="noopener noreferrer" data-metric="footer-numen">Numen Games</a>
      <!-- The catalogue still lives in a personal repository; the deploy
           workflow reads it from there (GITHUB_REPO_OWNER=PabloFMM). The
           footer points at the organisation until the data moves — a
           personal account is not a house address. -->
      <a
        href="https://github.com/numengames"
        target="_blank"
        rel="noopener noreferrer"
        data-metric="footer-data-repo"
      >
        {t.footerDataRepo}
      </a>
    </nav>
    <nav aria-label={t.footerLegal}>
      <h2>{t.footerLegal}</h2>
      <a href={`${prefix}/legal/privacy/`} data-metric="footer-privacy">{t.legalPrivacy}</a>
      <a href={`${prefix}/legal/cookies/`} data-metric="footer-cookies">{t.legalCookies}</a>
      <a href={`${prefix}/legal/terms/`} data-metric="footer-terms">{t.legalTerms}</a>
      <a href={`${prefix}/legal/legal-notice/`} data-metric="footer-legal-notice">{t.legalNotice}</a>
    </nav>
    {SOCIAL_LINKS.length > 0 && (
      <nav aria-label={t.footerSocial}>
        <h2>{t.footerSocial}</h2>
        {SOCIAL_LINKS.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" data-metric="footer-social">
            {link.label}
          </a>
        ))}
      </nav>
    )}
  </div>
  <div class="cierre">
    <span class="escarabajo" set:html={scarab} />
    <!-- Explicit string expressions: Astro collapses template whitespace
         around inline elements, which once glued "by" to the link. -->
    <p class="byline">
      {'by '}<a
        href="https://numen.games"
        target="_blank"
        rel="noopener noreferrer"
        data-metric="footer-numen-signature"
      >Numen Games</a>{' — we build for a better future.'}
    </p>
    <!-- The build line, the same on the three sites: licence · telemetry ·
         version · commit. The version keeps linking to /updates/ (the
         human record); the commit links to GitHub (the exact artefact).
         /telemetry has no page yet, on purpose: the link is the commitment,
         the page is its own mission. -->
    <p class="build">
      <a href={LICENSE_URL} target="_blank" rel="noopener noreferrer" title={t.footerLicenceTitle} data-metric="footer-licence">{t.footerLicence}</a>
      {' · '}
      <a href={`${prefix}/telemetry/`} title={t.footerTelemetryTitle} data-metric="footer-telemetry">{t.footerTelemetry}</a>
      {' · '}
      <a href={`${prefix}/updates/`} class="version" title={t.footerVersionTitle} data-metric="footer-version">{VERSION}</a>
      {' · '}
      {COMMIT_URL ? (
        <a href={COMMIT_URL} target="_blank" rel="noopener noreferrer" title={t.footerCommitTitle} data-metric="footer-commit">{COMMIT_SHA}</a>
      ) : (
        <span data-metric="footer-commit">{COMMIT_SHA}</span>
      )}
    </p>
  </div>
</footer>

<style>
  footer {
    max-width: 60rem;
    margin: var(--s7) auto 0;
    padding: var(--s5) var(--s4) var(--s6);
    border-top: 1px solid var(--linea-f);
    font-size: 0.875rem;
  }
  /* §6.1 — the binary is signal, not noise: a decorative separator. */
  .binaria {
    margin: 0 0 var(--s5);
  }
  .columns {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s7);
  }
  nav {
    display: flex;
    flex-direction: column;
    gap: var(--s1);
  }
  h2 {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ambar);
    font-weight: 500;
    margin: 0 0 var(--s2);
  }
  a {
    color: var(--texto-2);
    text-decoration: none;
    transition: color 120ms var(--ciclo);
  }
  a:hover,
  a:focus-visible {
    color: var(--texto);
  }
  /* The closing signature: hairline above, scarab in muted ink beside the
     license line. Arena on Nocturno, Noche on Diurno — never in color (§8.2). */
  .cierre {
    display: flex;
    align-items: center;
    gap: var(--s4);
    margin-top: var(--s6);
    padding-top: var(--s4);
    border-top: 1px solid var(--linea);
  }
  .escarabajo {
    display: inline-flex;
    color: var(--texto-3);
    flex: none;
  }
  .escarabajo :global(svg) {
    width: 28px;
    height: 28px;
  }
  .cierre p {
    margin: 0;
    color: var(--texto-3);
  }
  /* The house signature: brand voice, never translated, link in seafoam. */
  .byline {
    flex: 1;
  }
  .build {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 0.72rem;
    white-space: nowrap;
  }
  .build a {
    color: var(--texto-3);
  }
  .build a:hover,
  .build a:focus-visible {
    color: var(--enlace);
  }
  /* A link inside running text must not rely on color alone (WCAG 1.4.1):
     against the quiet byline ink the accent reads 2.58:1, so it stays
     underlined at rest. */
  .byline a {
    color: var(--enlace);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .build .version {
    color: var(--enlace);
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .cierre {
      flex-wrap: wrap;
    }
    .build {
      margin-left: 0;
      white-space: normal;
      flex-basis: 100%;
    }
  }
</style>
