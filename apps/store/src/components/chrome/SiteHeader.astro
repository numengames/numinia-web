---
import type { SupportedLocale } from '@numinia/domain';
import { CHROME_MESSAGES } from '../../i18n/messages';
import { COMMUNITIES_UI } from '../../i18n/communities';
// Brand asset (§8): the scarab opens the bar (the Oracle, 2026-10-14 — it
// makes the better mark), in currentColor: the text's colour, the link's
// colour under the pointer. The wordmark stays as the footer's name.
import scarab from '@numinia/ui/assets/brand/Khepri_Logo.svg?raw';
import Icon from './Icon.astro';
import LanguageMenu from './LanguageMenu.astro';

interface Props {
  locale: SupportedLocale;
  /** Current path without the locale prefix (from BaseLayout). */
  basePath: string;
}

const { locale, basePath } = Astro.props;
const t = CHROME_MESSAGES[locale];
const ui = COMMUNITIES_UI[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;
---

<header>
  <div class="inner">
    <a href={`${prefix}/`} class="brand" data-metric="nav-home" aria-label="Numinia" set:html={scarab} />
    <div class="tools">
      <!-- No menu (the Oracle, 2026-10-14): the front door and the footer
           carry the sections. The bar keeps the search, the mode, the
           language and the door. -->
      <a
        href={`${prefix}/communities/`}
        class="buscar"
        data-metric="nav-search"
        aria-label={ui.search}
        aria-current={basePath.startsWith('/communities/') ? 'page' : undefined}
      >
        <Icon name="magnifying-glass" size={20} />
        <span class="t">{ui.search}</span>
      </a>
      <!-- §13.2 utilities as Phosphor regular 20px: the icon shows the mode
           you are in — moon with stars at night, sun by day. -->
      <button type="button" class="mode" data-metric="chrome-mode" aria-label={t.modeToggle}>
        <Icon name="moon-stars" size={20} class="solo-nocturno" />
        <Icon name="sun" size={20} class="solo-diurno" />
      </button>
      <LanguageMenu locale={locale} basePath={basePath} label={t.languageSelector} />
      <!-- The door is always in sight (§13.2 utilities): a Nomad can enter
           from any page, and the icon fills once a session exists. -->
      <a
        href={`${prefix}/lap/session/`}
        class="entrar"
        aria-label={t.signIn}
        title={t.signIn}
        data-metric="chrome-sign-in"
      >
        <Icon name="user" size={20} />
      </a>
    </div>
  </div>
</header>

<script>
  /* Mode toggle (§7.4 / §13.11: Diurno default, Nocturno by choice).
     Persistence via localStorage is decision D17 (chrome preference, not
     component state); the boot script in BaseLayout applies it pre-paint. */
  const root = document.documentElement;
  /* MISSION-029: while the citizen has not chosen, the page follows the OS
     as the light changes — sunset flips the city with it. A stored choice
     ends the following. */
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    try {
      if (localStorage.getItem('numinia-modo')) return;
    } catch {
      return;
    }
    // Assign, never delete: the kit reads a MISSING attribute as Nocturno
    // (the platform markup pins diurno explicitly for that reason).
    root.dataset.modo = event.matches ? 'nocturno' : 'diurno';
  });
  document.querySelector('[data-metric="chrome-mode"]')?.addEventListener('click', () => {
    const next = root.dataset.modo === 'nocturno' ? 'diurno' : 'nocturno';
    root.dataset.modo = next;
    try {
      localStorage.setItem('numinia-modo', next);
    } catch {
      /* private mode: the choice simply lives for this page */
    }
  });
</script>

<style>
  /* The bar as numinia.org draws it (BLU-009 §12, STD-023 §23): sticky,
     56px, the page seen through at 85% with a 24px blur, a half hairline. */
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid color-mix(in srgb, var(--linea-f) 50%, transparent);
  }
  /* The glass lives on a pseudo-element so the bar itself stays a plain
     containing block. */
  header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--fondo) 85%, transparent);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: var(--s4);
    height: 56px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--s5);
  }
  .brand {
    color: var(--texto);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: 44px;
    transition: color 120ms var(--ciclo);
  }
  .brand:hover,
  .brand:focus-visible {
    color: var(--enlace);
  }
  /* The scarab at 22px: the wordmark's 20px, as a square. */
  .brand :global(svg) {
    height: 22px;
    width: 22px;
    display: block;
  }
  .tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--s2);
  }
  .buscar,
  .entrar,
  .mode {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s2);
    min-width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    color: var(--texto-2);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-control);
    cursor: pointer;
    text-decoration: none;
    font: 500 0.875rem var(--sans);
    transition:
      color 120ms var(--ciclo),
      border-color 120ms var(--ciclo);
  }
  .buscar:hover,
  .buscar:focus-visible,
  .entrar:hover,
  .entrar:focus-visible,
  .mode:hover,
  .mode:focus-visible {
    border-color: var(--verdemar);
    color: var(--texto);
  }
  .buscar[aria-current='page'] {
    color: var(--texto);
    border-color: var(--turquesa);
  }
  /* The word "Search" shows where there is room; on a phone the glass alone. */
  .buscar .t {
    display: none;
  }
  @media (min-width: 48.0625rem) {
    .buscar {
      padding: 0 var(--s3);
    }
    .buscar .t {
      display: inline;
    }
  }
  /* Pure-CSS swap keyed on the html mode attribute: no flash, no JS paint. */
  :global(html:not([data-modo='diurno'])) .mode :global(.solo-diurno) {
    display: none;
  }
  :global(html[data-modo='diurno']) .mode :global(.solo-nocturno) {
    display: none;
  }
  /* Phones: the scarab and the utilities share the 56px row. */
  @media (max-width: 48rem) {
    .inner {
      gap: var(--s2);
      padding: 0 var(--s4);
    }
    .brand :global(svg) {
      height: 20px;
      width: 20px;
    }
    .tools {
      gap: var(--s1);
    }
  }
</style>
