---
import type { SupportedLocale } from '@numinia/domain';
import { CHROME_MESSAGES } from '../../i18n/messages';
// Brand asset (§8): wordmark travels as currentColor and dresses in ink.
import wordmark from '../../../../../design-system/assets/Numinia_Word.svg?raw';
import Icon from './Icon.astro';
import LanguageMenu from './LanguageMenu.astro';

interface Props {
  locale: SupportedLocale;
  /** Current path without the locale prefix (from BaseLayout). */
  basePath: string;
}

const { locale, basePath } = Astro.props;
const t = CHROME_MESSAGES[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;

const isActive = (section: string): boolean => basePath.startsWith(`/${section}/`);
const NAV = [
  { section: 'city', href: `${prefix}/city/`, label: t.navCity, metric: 'nav-city' },
  { section: 'assets', href: `${prefix}/assets/`, label: t.navAssets, metric: 'nav-assets' },
  { section: 'lap', href: `${prefix}/lap/`, label: t.navLap, metric: 'nav-lap' },
];
---

<header>
  <div class="inner">
    <a
      href={`${prefix}/`}
      class="brand"
      data-metric="nav-home"
      aria-label="Numinia"
      set:html={wordmark}
    />
    <nav aria-label={t.footerNavigation}>
      {
        NAV.map((item) => (
          <a
            href={item.href}
            data-metric={item.metric}
            aria-current={isActive(item.section) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="tools">
      <!-- §13.2 utilities as Phosphor regular 20px: the icon shows the mode
           a tap takes you to — moon invites Nocturno, sun invites Diurno. -->
      <button type="button" class="mode" data-metric="chrome-mode" aria-label={t.modeToggle}>
        <Icon name="moon-stars" size={20} class="solo-diurno" />
        <Icon name="sun" size={20} class="solo-nocturno" />
      </button>
      <LanguageMenu locale={locale} basePath={basePath} label={t.languageSelector} />
      <!-- The door is always in sight (§13.2 utilities): a Nomad can enter
           from any page, and the icon fills once a session exists. -->
      <a
        href={`${prefix}/lap/session/`}
        class="entrar"
        aria-label={t.signIn}
        title={t.signIn}
        data-metric="chrome-sign-in"
      >
        <Icon name="user" size={20} />
      </a>
    </div>
  </div>
</header>

<script>
  /* Mode toggle (§7.4 / §13.11: Diurno default, Nocturno by choice).
     Persistence via localStorage is decision D17 (chrome preference, not
     component state); the boot script in BaseLayout applies it pre-paint. */
  const root = document.documentElement;
  /* MISSION-029: while the citizen has not chosen, the page follows the OS
     as the light changes — sunset flips the city with it. A stored choice
     ends the following. */
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    try {
      if (localStorage.getItem('numinia-modo')) return;
    } catch {
      return;
    }
    // Assign, never delete: the kit reads a MISSING attribute as Nocturno
    // (the platform markup pins diurno explicitly for that reason).
    root.dataset.modo = event.matches ? 'nocturno' : 'diurno';
  });
  document.querySelector('[data-metric="chrome-mode"]')?.addEventListener('click', () => {
    const next = root.dataset.modo === 'nocturno' ? 'diurno' : 'nocturno';
    root.dataset.modo = next;
    try {
      localStorage.setItem('numinia-modo', next);
    } catch {
      /* private mode: the choice simply lives for this page */
    }
  });
</script>

<style>
  header {
    border-bottom: 1px solid var(--linea-f);
    background: var(--superficie);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s4);
    max-width: 60rem;
    margin: 0 auto;
    padding: var(--s3) var(--s4);
  }
  .brand {
    color: var(--texto);
    display: inline-flex;
    align-items: center;
  }
  .brand :global(svg) {
    height: 20px;
    width: auto;
    display: block;
  }
  /* §13.2 menu: entries in Mono etiqueta caps; active = 2px amber underline. */
  nav {
    display: flex;
    gap: var(--s1);
    flex-wrap: wrap;
  }
  nav a {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--texto-2);
    text-decoration: none;
    padding: 6px var(--s2);
    border-bottom: 2px solid transparent;
    transition: color 120ms var(--ciclo);
  }
  nav a:hover,
  nav a:focus-visible {
    color: var(--texto);
  }
  nav a[aria-current='page'] {
    color: var(--texto);
    border-bottom-color: var(--ambar);
  }
  .tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--s3);
  }
  .entrar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--texto-2);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-control);
    transition:
      color 120ms var(--ciclo),
      border-color 120ms var(--ciclo);
  }
  .entrar:hover,
  .entrar:focus-visible {
    border-color: var(--verdemar);
    color: var(--texto);
  }
  .mode {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    color: var(--texto-2);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-control);
    cursor: pointer;
    transition:
      color 120ms var(--ciclo),
      border-color 120ms var(--ciclo);
  }
  .mode:hover,
  .mode:focus-visible {
    border-color: var(--verdemar);
    color: var(--texto);
  }
  /* Pure-CSS swap keyed on the html mode attribute: no flash, no JS paint. */
  :global(html:not([data-modo='diurno'])) .mode :global(.solo-diurno) {
    display: none;
  }
  :global(html[data-modo='diurno']) .mode :global(.solo-nocturno) {
    display: none;
  }
  /* Phones: the chrome sprawled into three loose rows (~154px before any
     content). Two tight rows instead — brand + utilities share the first,
     the nav takes the second at full width, entries grown to 44px targets. */
  @media (max-width: 48rem) {
    .inner {
      gap: 0 var(--s3);
      padding: var(--s2) var(--s4);
    }
    .brand {
      order: 1;
      margin-right: auto;
    }
    /* The wordmark sheds 4px so brand and utilities truly share the row. */
    .brand :global(svg) {
      height: 16px;
    }
    .tools {
      order: 2;
      margin-left: 0;
      gap: var(--s1);
    }
    nav {
      order: 3;
      flex-basis: 100%;
      gap: var(--s2);
    }
    nav a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 var(--s2);
    }
  }
</style>
