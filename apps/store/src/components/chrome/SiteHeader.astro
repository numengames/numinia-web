---
import { SUPPORTED_LOCALES, type SupportedLocale } from '@numinia/domain';
import { CHROME_MESSAGES } from '../../i18n/messages';

interface Props {
  locale: SupportedLocale;
  /** Current path without the locale prefix (from BaseLayout). */
  basePath: string;
}

const { locale, basePath } = Astro.props;
const t = CHROME_MESSAGES[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;

/** Language names in their own language — never translated (a11y convention). */
const LANGUAGE_NAMES: Record<SupportedLocale, string> = {
  es: 'Español',
  en: 'English',
  ja: '日本語',
  ko: '한국어',
  'pt-br': 'Português',
};

const pathFor = (target: SupportedLocale): string =>
  `${target === 'en' ? '' : `/${target}`}${basePath}`;
---

<header>
  <a href={`${prefix}/`} class="brand" data-metric="nav-home">Numinia</a>
  <nav aria-label={t.footerNavigation}>
    <a href={`${prefix}/gallery/`} data-metric="nav-gallery">{t.navGallery}</a>
    <a href={`${prefix}/archive/`} data-metric="nav-archive">{t.navArchive}</a>
  </nav>
  <nav aria-label={t.languageSelector} class="languages">
    {
      SUPPORTED_LOCALES.map((code) => (
        <a
          href={pathFor(code)}
          aria-current={code === locale ? 'true' : undefined}
          lang={code}
          data-metric={`lang-${code}`}
        >
          {LANGUAGE_NAMES[code]}
        </a>
      ))
    }
  </nav>
</header>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--numinia-space-3);
    max-width: 60rem;
    margin: 0 auto;
    padding: var(--numinia-space-3);
  }
  .brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--numinia-color-primary-strong);
    text-decoration: none;
    letter-spacing: 0.04em;
  }
  nav {
    display: flex;
    gap: var(--numinia-space-2);
    flex-wrap: wrap;
  }
  nav a {
    color: inherit;
    text-decoration: none;
    padding: 0.2rem 0.4rem;
    border-radius: var(--numinia-radius-sm);
  }
  nav a:hover,
  nav a:focus-visible {
    background: var(--numinia-color-surface);
  }
  .languages {
    margin-left: auto;
    font-size: 0.8rem;
  }
  .languages a[aria-current='true'] {
    color: var(--numinia-color-primary-strong);
    font-weight: 700;
  }
</style>
