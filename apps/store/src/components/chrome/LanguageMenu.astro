---
/**
 * The language, as a segmented control (v3, «La ciudad y tú»): five short
 * codes in a row at the foot of your rail, the current one pressed in. Plain
 * links: it works without JS. Each code carries its language's own name for
 * the screen reader (never translated, an a11y convention).
 */
import { SUPPORTED_LOCALES, type SupportedLocale } from '@numinia/domain';

interface Props {
  locale: SupportedLocale;
  basePath: string;
  label: string;
}

const { locale, basePath, label } = Astro.props;

/** Language names in their own language — never translated (a11y convention). */
const LANGUAGE_NAMES: Record<SupportedLocale, string> = {
  es: 'Español',
  en: 'English',
  ja: '日本語',
  ko: '한국어',
  'pt-br': 'Português',
};

/** The short code drawn in the segment. */
const SHORT: Record<SupportedLocale, string> = {
  en: 'EN',
  es: 'ES',
  'pt-br': 'PT',
  ja: '日本',
  ko: '한국',
};

/** The wireframe's order: the two widest first, then the rest. */
const ORDER: readonly SupportedLocale[] = ['en', 'es', 'pt-br', 'ja', 'ko'];

const pathFor = (target: SupportedLocale): string =>
  `${target === 'en' ? '' : `/${target}`}${basePath}`;
const codes = ORDER.filter((code) => SUPPORTED_LOCALES.includes(code));
---

<nav class="seg seg-idioma" aria-label={label} data-lang-menu>
  {
    codes.map((code) => (
      <a
        href={pathFor(code)}
        aria-current={code === locale ? 'true' : undefined}
        lang={code}
        data-metric={`lang-${code}`}
      >
        {SHORT[code]}
        <span class="sr-solo">{LANGUAGE_NAMES[code]}</span>
      </a>
    ))
  }
</nav>

<script>
  /* MISSION-029: an explicit language choice is a chrome preference (D17) —
     it silences the first-visit auto-detection forever. */
  document.querySelectorAll('[data-lang-menu] a[lang]').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem('numinia-lang', link.getAttribute('lang') ?? 'en');
      } catch {
        /* private mode: the choice lives in the URL they navigate to */
      }
    });
  });
</script>
