---
/**
 * Language selector as a §9.8-style dropdown: globe + current code + caret
 * (closed), elevated panel with 40px rows (open), the current locale dressed
 * in ink. Built on details/summary: works without JS; a small script adds
 * Esc + click-outside closing.
 */
import { SUPPORTED_LOCALES, type SupportedLocale } from '@numinia/domain';
import Icon from './Icon.astro';

interface Props {
  locale: SupportedLocale;
  basePath: string;
  label: string;
}

const { locale, basePath, label } = Astro.props;

/** Language names in their own language — never translated (a11y convention). */
const LANGUAGE_NAMES: Record<SupportedLocale, string> = {
  es: 'Español',
  en: 'English',
  ja: '日本語',
  ko: '한국어',
  'pt-br': 'Português',
};

const pathFor = (target: SupportedLocale): string =>
  `${target === 'en' ? '' : `/${target}`}${basePath}`;
---

<details class="lang" data-lang-menu>
  <summary aria-label={label} data-metric="chrome-language">
    <Icon name="globe" size={20} />
    <span class="code">{locale.toUpperCase()}</span>
    <Icon name="caret-down" size={16} />
  </summary>
  <ul>
    {
      SUPPORTED_LOCALES.map((code) => (
        <li>
          <a
            href={pathFor(code)}
            aria-current={code === locale ? 'true' : undefined}
            lang={code}
            data-metric={`lang-${code}`}
          >
            {LANGUAGE_NAMES[code]}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  // Close on Esc and on clicks outside — the panel never lingers.
  const menu = document.querySelector<HTMLDetailsElement>('[data-lang-menu]');
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) menu.open = false;
  });
  document.addEventListener('click', (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) {
      menu.open = false;
    }
  });
</script>

<style>
  .lang {
    position: relative;
  }
  summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    min-height: 44px;
    padding: 4px var(--s3);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-control);
    color: var(--texto-2);
    cursor: pointer;
    transition:
      color 120ms var(--ciclo),
      border-color 120ms var(--ciclo);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover,
  summary:focus-visible,
  .lang[open] summary {
    color: var(--texto);
    border-color: var(--verdemar);
  }
  .code {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }
  /* §9.8 selector panel: elevated, marco radius, 40px rows. */
  ul {
    position: absolute;
    right: 0;
    top: calc(100% + var(--s2));
    z-index: 10;
    min-width: 11rem;
    margin: 0;
    padding: var(--s2);
    list-style: none;
    background: var(--elevada);
    border: 1px solid var(--linea);
    border-radius: var(--radio-marco);
  }
  :global([data-modo='diurno']) ul {
    box-shadow:
      0 1px 2px rgba(20, 17, 15, 0.08),
      0 8px 24px rgba(20, 17, 15, 0.06);
  }
  a {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--s3);
    border-radius: var(--radio-control);
    color: var(--texto-2);
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    color: var(--texto);
    background: var(--superficie);
  }
  /* The chosen one dresses in ink (§9.8). */
  a[aria-current='true'] {
    background: var(--texto);
    color: var(--fondo);
  }
</style>
