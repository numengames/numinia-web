---
/**
 * The Veil's sky (STD-023, velo.cielo), ported from numinia.org's Layout:
 * 175 stars on the canonical rarity scale — Común Arena 60, Poco común 25,
 * Raro 10, Épico 4, Legendario Ámbar 1 — drifting and fading at 30fps.
 * Decorative (aria-hidden), behind everything, Nocturno only: CSS hides the
 * canvas by day and the loop idles. Under prefers-reduced-motion the sky is
 * drawn once, still, at half alpha. It pauses in a hidden tab.
 */
---

<canvas id="starfield" aria-hidden="true"></canvas>

<script>
  interface Tier {
    color: string;
    weight: number;
    minR: number;
    maxR: number;
  }
  interface Star {
    x: number;
    y: number;
    r: number;
    color: string;
    alpha: number;
    dir: number;
    speed: number;
    vx: number;
    vy: number;
  }

  const TIERS: readonly Tier[] = [
    { color: '249,235,220', weight: 60, minR: 0.3, maxR: 1.2 }, // Común — Arena
    { color: '143,196,107', weight: 25, minR: 0.5, maxR: 1.5 }, // Poco común
    { color: '93,155,214', weight: 10, minR: 0.6, maxR: 1.8 }, // Raro
    { color: '169,139,224', weight: 4, minR: 0.8, maxR: 2.5 }, // Épico
    { color: '239,165,23', weight: 1, minR: 1.0, maxR: 3.0 }, // Legendario — Ámbar
  ];
  const STAR_COUNT = 175;
  const FRAME_MS = 1000 / 30;

  const canvas = document.getElementById('starfield');
  const ctx = canvas instanceof HTMLCanvasElement ? canvas.getContext('2d') : null;
  if (canvas instanceof HTMLCanvasElement && ctx) {
    const root = document.documentElement;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pool: Tier[] = TIERS.flatMap((tier) => Array<Tier>(tier.weight).fill(tier));
    let stars: Star[] = [];
    let w = 0;
    let h = 0;
    let last = 0;

    // clientWidth, not innerWidth: innerWidth counts the scrollbar gutter
    // and would give a page of prose a horizontal scrollbar.
    const size = (): void => {
      w = canvas.width = root.clientWidth;
      h = canvas.height = root.clientHeight;
    };
    const seed = (): void => {
      stars = Array.from({ length: STAR_COUNT }, () => {
        const tier = pool[Math.floor(Math.random() * pool.length)] ?? TIERS[0]!;
        return {
          x: Math.random() * w,
          y: Math.random() * h,
          r: tier.minR + Math.random() * (tier.maxR - tier.minR),
          color: tier.color,
          alpha: Math.random(),
          dir: Math.random() > 0.5 ? 1 : -1,
          speed: Math.random() * 0.004 + 0.002,
          vx: (Math.random() - 0.5) * 0.06,
          vy: (Math.random() - 0.5) * 0.06,
        };
      });
    };
    const paint = (move: boolean): void => {
      ctx.clearRect(0, 0, w, h);
      for (const s of stars) {
        if (move) {
          s.x += s.vx;
          s.y += s.vy;
          if (s.x < -2) s.x = w + 2;
          if (s.x > w + 2) s.x = -2;
          if (s.y < -2) s.y = h + 2;
          if (s.y > h + 2) s.y = -2;
          s.alpha += s.dir * s.speed;
          if (s.alpha > 0.85) {
            s.alpha = 0.85;
            s.dir = -1;
          }
          if (s.alpha < 0.05) {
            s.alpha = 0.05;
            s.dir = 1;
          }
        }
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${s.color}, ${move ? s.alpha : 0.45})`;
        ctx.fill();
      }
    };
    const loop = (now: number): void => {
      requestAnimationFrame(loop);
      if (document.hidden || root.dataset['modo'] === 'diurno' || now - last < FRAME_MS) return;
      last = now;
      paint(true);
    };

    let timer: ReturnType<typeof setTimeout> | undefined;
    addEventListener('resize', () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        size();
        seed();
        if (still) paint(false);
      }, 200);
    });
    size();
    seed();
    if (still) paint(false);
    else requestAnimationFrame(loop);
  }
</script>

<style>
  #starfield {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* The sky is Nocturno only (STD-023). */
  :global(html[data-modo='diurno']) #starfield {
    display: none;
  }
</style>
