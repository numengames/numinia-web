---
/**
 * The phone's tab bar (the app shell below the sidebar's breakpoint): the
 * sidebar's five places, fixed at the bottom, icon over a short word, at
 * least 56 px tall plus the safe area. The places and the current one come
 * from lib/app-nav.ts, like the sidebar's.
 */
import type { SupportedLocale } from '@numinia/domain';
import { APP_SHELL_UI } from '../../i18n/app-shell';
import { NAV_ITEMS, ariaCurrent, localeHref, navIcon, navState } from '../../lib/app-nav';
import Icon from './Icon.astro';

interface Props {
  locale: SupportedLocale;
  /** Current path without the locale prefix (from BaseLayout). */
  basePath: string;
}

const { locale, basePath } = Astro.props;
const ui = APP_SHELL_UI[locale];
---

<nav class="pestanas-app" aria-label={ui.tabsNav}>
  {
    NAV_ITEMS.map((item) => {
      const state = navState(item, basePath);
      return (
        <a
          href={localeHref(locale, item.path)}
          aria-current={ariaCurrent(state)}
          data-metric={`tab-${item.id}`}
        >
          <Icon name={navIcon(item, state)} size={24} use />
          <span>{ui.nav[item.id]}</span>
        </a>
      );
    })
  }
</nav>
