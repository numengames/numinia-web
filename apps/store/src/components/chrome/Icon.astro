---
/**
 * Phosphor icon (§7) — regular weight, self-hosted subset (§7.3), official
 * SVGs from phosphor-icons/core normalized to currentColor. Never redrawn.
 * Decorative by default (aria-hidden); pass a label to make it meaningful.
 */
import archive from '../../../../../packages/ui/src/icons/archive.svg?raw';
import musicNotes from '../../../../../packages/ui/src/icons/music-notes.svg?raw';
import bell from '../../../../../packages/ui/src/icons/bell.svg?raw';
import buildings from '../../../../../packages/ui/src/icons/buildings.svg?raw';
import planet from '../../../../../packages/ui/src/icons/planet.svg?raw';
import coins from '../../../../../packages/ui/src/icons/coins.svg?raw';
import bookOpen from '../../../../../packages/ui/src/icons/book-open.svg?raw';
import caretDown from '../../../../../packages/ui/src/icons/caret-down.svg?raw';
import caretLeft from '../../../../../packages/ui/src/icons/caret-left.svg?raw';
import coffee from '../../../../../packages/ui/src/icons/coffee.svg?raw';
import chartBar from '../../../../../packages/ui/src/icons/chart-bar.svg?raw';
import downloadSimple from '../../../../../packages/ui/src/icons/download-simple.svg?raw';
import flame from '../../../../../packages/ui/src/icons/flame.svg?raw';
import gear from '../../../../../packages/ui/src/icons/gear.svg?raw';
import githubLogo from '../../../../../packages/ui/src/icons/github-logo.svg?raw';
import gameController from '../../../../../packages/ui/src/icons/game-controller.svg?raw';
import globe from '../../../../../packages/ui/src/icons/globe-hemisphere-west.svg?raw';
import house from '../../../../../packages/ui/src/icons/house.svg?raw';
import list from '../../../../../packages/ui/src/icons/list.svg?raw';
import magnifyingGlass from '../../../../../packages/ui/src/icons/magnifying-glass.svg?raw';
import flameLight from '../../../../../packages/ui/src/icons/flame-light.svg?raw';
import globeLight from '../../../../../packages/ui/src/icons/globe-hemisphere-west-light.svg?raw';
import moon from '../../../../../packages/ui/src/icons/moon.svg?raw';
import moonStars from '../../../../../packages/ui/src/icons/moon-stars.svg?raw';
import swordLight from '../../../../../packages/ui/src/icons/sword-light.svg?raw';
import packageIcon from '../../../../../packages/ui/src/icons/package.svg?raw';
import skull from '../../../../../packages/ui/src/icons/skull.svg?raw';
import signOut from '../../../../../packages/ui/src/icons/sign-out.svg?raw';
import sun from '../../../../../packages/ui/src/icons/sun.svg?raw';
import sword from '../../../../../packages/ui/src/icons/sword.svg?raw';
import user from '../../../../../packages/ui/src/icons/user.svg?raw';
import users from '../../../../../packages/ui/src/icons/users.svg?raw';
import x from '../../../../../packages/ui/src/icons/x.svg?raw';
import xLogo from '../../../../../packages/ui/src/icons/x-logo.svg?raw';
// The communities platform (phase 0): places, dates, the home's steps,
// templates and agents, and the empty states.
import mapPin from '../../../../../packages/ui/src/icons/map-pin.svg?raw';
import calendarBlank from '../../../../../packages/ui/src/icons/calendar-blank.svg?raw';
import check from '../../../../../packages/ui/src/icons/check.svg?raw';
import scroll from '../../../../../packages/ui/src/icons/scroll.svg?raw';
import clipboardText from '../../../../../packages/ui/src/icons/clipboard-text.svg?raw';
import shieldCheck from '../../../../../packages/ui/src/icons/shield-check.svg?raw';
import craneTower from '../../../../../packages/ui/src/icons/crane-tower.svg?raw';
import lockKey from '../../../../../packages/ui/src/icons/lock-key.svg?raw';
import palette from '../../../../../packages/ui/src/icons/palette.svg?raw';
import confetti from '../../../../../packages/ui/src/icons/confetti.svg?raw';
import hourglass from '../../../../../packages/ui/src/icons/hourglass.svg?raw';
import fileText from '../../../../../packages/ui/src/icons/file-text.svg?raw';
import robot from '../../../../../packages/ui/src/icons/robot.svg?raw';
import eye from '../../../../../packages/ui/src/icons/eye.svg?raw';

const ICONS = {
  archive,
  bell,
  'book-open': bookOpen,
  buildings,
  planet,
  'caret-down': caretDown,
  'caret-left': caretLeft,
  'chart-bar': chartBar,
  coffee,
  coins,
  'download-simple': downloadSimple,
  flame,
  gear,
  'github-logo': githubLogo,
  'game-controller': gameController,
  globe,
  house,
  list,
  'magnifying-glass': magnifyingGlass,
  moon,
  'moon-stars': moonStars,
  'flame-light': flameLight,
  'globe-light': globeLight,
  'sword-light': swordLight,
  package: packageIcon,
  'sign-out': signOut,
  skull,
  sun,
  sword,
  user,
  users,
  'music-notes': musicNotes,
  x,
  'x-logo': xLogo,
  'map-pin': mapPin,
  'calendar-blank': calendarBlank,
  check,
  scroll,
  'clipboard-text': clipboardText,
  'shield-check': shieldCheck,
  'crane-tower': craneTower,
  'lock-key': lockKey,
  palette,
  confetti,
  hourglass,
  'file-text': fileText,
  robot,
  eye,
} as const;

interface Props {
  name: keyof typeof ICONS;
  /** §7.1: regular 16–40px default; `-light` variants are for ≥48px. */
  size?: number;
  /** Meaningful icons carry a label; omitted = decorative (aria-hidden). */
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
---

<span
  class:list={['icono', className]}
  style={`--icono-size:${size}px`}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={ICONS[name]}
/>

<style>
  .icono {
    display: inline-flex;
    flex: none;
  }
  .icono :global(svg) {
    width: var(--icono-size, 20px);
    height: var(--icono-size, 20px);
    display: block;
  }
</style>
