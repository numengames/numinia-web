---
/**
 * Phosphor icon (§7) — regular weight, self-hosted subset (§7.3), official
 * SVGs from phosphor-icons/core normalized to currentColor. Never redrawn.
 * Decorative by default (aria-hidden); pass a label to make it meaningful.
 * To add one: copy the official SVG into packages/ui/src/icons/, import it
 * `?raw` below and name it in ICONS. `use` draws the page sprite's copy
 * (ChromeSprite) instead of inlining the SVG again.
 */
import archive from '../../../../../packages/ui/src/icons/archive.svg?raw';
import musicNotes from '../../../../../packages/ui/src/icons/music-notes.svg?raw';
import bell from '../../../../../packages/ui/src/icons/bell.svg?raw';
import buildings from '../../../../../packages/ui/src/icons/buildings.svg?raw';
import planet from '../../../../../packages/ui/src/icons/planet.svg?raw';
import coins from '../../../../../packages/ui/src/icons/coins.svg?raw';
import bookOpen from '../../../../../packages/ui/src/icons/book-open.svg?raw';
import caretDown from '../../../../../packages/ui/src/icons/caret-down.svg?raw';
import caretLeft from '../../../../../packages/ui/src/icons/caret-left.svg?raw';
import coffee from '../../../../../packages/ui/src/icons/coffee.svg?raw';
import chartBar from '../../../../../packages/ui/src/icons/chart-bar.svg?raw';
import downloadSimple from '../../../../../packages/ui/src/icons/download-simple.svg?raw';
import flame from '../../../../../packages/ui/src/icons/flame.svg?raw';
import gear from '../../../../../packages/ui/src/icons/gear.svg?raw';
import githubLogo from '../../../../../packages/ui/src/icons/github-logo.svg?raw';
import gameController from '../../../../../packages/ui/src/icons/game-controller.svg?raw';
import globe from '../../../../../packages/ui/src/icons/globe-hemisphere-west.svg?raw';
import house from '../../../../../packages/ui/src/icons/house.svg?raw';
import list from '../../../../../packages/ui/src/icons/list.svg?raw';
import magnifyingGlass from '../../../../../packages/ui/src/icons/magnifying-glass.svg?raw';
import flameLight from '../../../../../packages/ui/src/icons/flame-light.svg?raw';
import globeLight from '../../../../../packages/ui/src/icons/globe-hemisphere-west-light.svg?raw';
import moon from '../../../../../packages/ui/src/icons/moon.svg?raw';
import moonStars from '../../../../../packages/ui/src/icons/moon-stars.svg?raw';
import swordLight from '../../../../../packages/ui/src/icons/sword-light.svg?raw';
import packageIcon from '../../../../../packages/ui/src/icons/package.svg?raw';
import skull from '../../../../../packages/ui/src/icons/skull.svg?raw';
import signOut from '../../../../../packages/ui/src/icons/sign-out.svg?raw';
import sun from '../../../../../packages/ui/src/icons/sun.svg?raw';
import sword from '../../../../../packages/ui/src/icons/sword.svg?raw';
import user from '../../../../../packages/ui/src/icons/user.svg?raw';
import users from '../../../../../packages/ui/src/icons/users.svg?raw';
import x from '../../../../../packages/ui/src/icons/x.svg?raw';
import xLogo from '../../../../../packages/ui/src/icons/x-logo.svg?raw';
// The communities platform (phase 0): places, dates, the home's steps,
// templates and agents, and the empty states.
import mapPin from '../../../../../packages/ui/src/icons/map-pin.svg?raw';
import calendarBlank from '../../../../../packages/ui/src/icons/calendar-blank.svg?raw';
import check from '../../../../../packages/ui/src/icons/check.svg?raw';
import scroll from '../../../../../packages/ui/src/icons/scroll.svg?raw';
import clipboardText from '../../../../../packages/ui/src/icons/clipboard-text.svg?raw';
import shieldCheck from '../../../../../packages/ui/src/icons/shield-check.svg?raw';
import craneTower from '../../../../../packages/ui/src/icons/crane-tower.svg?raw';
import lockKey from '../../../../../packages/ui/src/icons/lock-key.svg?raw';
import palette from '../../../../../packages/ui/src/icons/palette.svg?raw';
import confetti from '../../../../../packages/ui/src/icons/confetti.svg?raw';
import hourglass from '../../../../../packages/ui/src/icons/hourglass.svg?raw';
import fileText from '../../../../../packages/ui/src/icons/file-text.svg?raw';
import robot from '../../../../../packages/ui/src/icons/robot.svg?raw';
import eye from '../../../../../packages/ui/src/icons/eye.svg?raw';
// The app shell (v0.83.0): the five places of the sidebar and the tab bar —
// regular, and the fill the current place draws — the fold, the menus and
// the «Más» list.
import compass from '../../../../../packages/ui/src/icons/compass.svg?raw';
import usersThree from '../../../../../packages/ui/src/icons/users-three.svg?raw';
import broadcast from '../../../../../packages/ui/src/icons/broadcast.svg?raw';
import userCircle from '../../../../../packages/ui/src/icons/user-circle.svg?raw';
import houseFill from '../../../../../packages/ui/src/icons/house-fill.svg?raw';
import compassFill from '../../../../../packages/ui/src/icons/compass-fill.svg?raw';
import usersThreeFill from '../../../../../packages/ui/src/icons/users-three-fill.svg?raw';
import broadcastFill from '../../../../../packages/ui/src/icons/broadcast-fill.svg?raw';
import userCircleFill from '../../../../../packages/ui/src/icons/user-circle-fill.svg?raw';
import sidebarSimple from '../../../../../packages/ui/src/icons/sidebar-simple.svg?raw';
import dotsThree from '../../../../../packages/ui/src/icons/dots-three.svg?raw';
import dotsThreeVertical from '../../../../../packages/ui/src/icons/dots-three-vertical.svg?raw';
import signIn from '../../../../../packages/ui/src/icons/sign-in.svg?raw';
import arrowSquareOut from '../../../../../packages/ui/src/icons/arrow-square-out.svg?raw';
import question from '../../../../../packages/ui/src/icons/question.svg?raw';
import info from '../../../../../packages/ui/src/icons/info.svg?raw';
// The app shell's pages (v0.83.0): the world to enter, the calendar file,
// sharing, the licence line, following.
import play from '../../../../../packages/ui/src/icons/play.svg?raw';
import calendarPlus from '../../../../../packages/ui/src/icons/calendar-plus.svg?raw';
import shareNetwork from '../../../../../packages/ui/src/icons/share-network.svg?raw';
import checkCircle from '../../../../../packages/ui/src/icons/check-circle.svg?raw';
import plus from '../../../../../packages/ui/src/icons/plus.svg?raw';
// v3 «La ciudad y tú» (v0.112.0): the two rails' places — the city's
// encounters, worlds and Bazar, your notices, balance and loot — in both
// weights, and the appearance's «Sistema».
import calendarBlankFill from '../../../../../packages/ui/src/icons/calendar-blank-fill.svg?raw';
import planetFill from '../../../../../packages/ui/src/icons/planet-fill.svg?raw';
import storefront from '../../../../../packages/ui/src/icons/storefront.svg?raw';
import storefrontFill from '../../../../../packages/ui/src/icons/storefront-fill.svg?raw';
import bellFill from '../../../../../packages/ui/src/icons/bell-fill.svg?raw';
import coinsFill from '../../../../../packages/ui/src/icons/coins-fill.svg?raw';
import backpack from '../../../../../packages/ui/src/icons/backpack.svg?raw';
import backpackFill from '../../../../../packages/ui/src/icons/backpack-fill.svg?raw';
import monitor from '../../../../../packages/ui/src/icons/monitor.svg?raw';
import prohibit from '../../../../../packages/ui/src/icons/prohibit.svg?raw';
import arrowRight from '../../../../../packages/ui/src/icons/arrow-right.svg?raw';
import { svgParts, symbolId } from '../../lib/svg-sprite';

const ICONS = {
  archive,
  bell,
  'book-open': bookOpen,
  buildings,
  planet,
  'caret-down': caretDown,
  'caret-left': caretLeft,
  'chart-bar': chartBar,
  coffee,
  coins,
  'download-simple': downloadSimple,
  flame,
  gear,
  'github-logo': githubLogo,
  'game-controller': gameController,
  globe,
  house,
  list,
  'magnifying-glass': magnifyingGlass,
  moon,
  'moon-stars': moonStars,
  'flame-light': flameLight,
  'globe-light': globeLight,
  'sword-light': swordLight,
  package: packageIcon,
  'sign-out': signOut,
  skull,
  sun,
  sword,
  user,
  users,
  'music-notes': musicNotes,
  x,
  'x-logo': xLogo,
  'map-pin': mapPin,
  'calendar-blank': calendarBlank,
  check,
  scroll,
  'clipboard-text': clipboardText,
  'shield-check': shieldCheck,
  'crane-tower': craneTower,
  'lock-key': lockKey,
  palette,
  confetti,
  hourglass,
  'file-text': fileText,
  robot,
  eye,
  compass,
  'users-three': usersThree,
  broadcast,
  'user-circle': userCircle,
  'house-fill': houseFill,
  'compass-fill': compassFill,
  'users-three-fill': usersThreeFill,
  'broadcast-fill': broadcastFill,
  'user-circle-fill': userCircleFill,
  'sidebar-simple': sidebarSimple,
  'dots-three': dotsThree,
  'dots-three-vertical': dotsThreeVertical,
  'sign-in': signIn,
  'arrow-square-out': arrowSquareOut,
  question,
  info,
  play,
  'calendar-plus': calendarPlus,
  'share-network': shareNetwork,
  'check-circle': checkCircle,
  plus,
  'calendar-blank-fill': calendarBlankFill,
  'planet-fill': planetFill,
  storefront,
  'storefront-fill': storefrontFill,
  'bell-fill': bellFill,
  'coins-fill': coinsFill,
  backpack,
  'backpack-fill': backpackFill,
  monitor,
  prohibit,
  'arrow-right': arrowRight,
} as const;

interface Props {
  name: keyof typeof ICONS;
  /** §7.1: regular 16–40px default; `-light` variants are for ≥48px. */
  size?: number;
  /** Meaningful icons carry a label; omitted = decorative (aria-hidden). */
  label?: string;
  class?: string;
  /** The app shell draws some icons in two places (the sidebar and the tab
      bar, the sidebar and the phone's top bar): those travel once per page
      in ChromeSprite and every place draws its copy with <use>. */
  use?: boolean;
  /** Render the icon as the sprite's <symbol> (ChromeSprite only). */
  symbol?: boolean;
}

const { name, size = 20, label, class: className, use = false, symbol = false } = Astro.props;
const parts = symbol ? svgParts(ICONS[name]) : undefined;
// 20px is the stylesheet's default: the attribute only travels when it differs.
const sizeStyle = size === 20 ? undefined : `--icono-size:${size}px`;
---

{
  parts ? (
    <symbol id={symbolId(name)} viewBox={parts.viewBox} set:html={parts.body} />
  ) : use ? (
    <svg
      class:list={['icono', className]}
      width={size}
      height={size}
      fill="currentColor"
      aria-hidden={label ? undefined : 'true'}
      role={label ? 'img' : undefined}
      aria-label={label}
    >
      <use href={`#${symbolId(name)}`} />
    </svg>
  ) : (
    <span
      class:list={['icono', className]}
      style={sizeStyle}
      aria-hidden={label ? undefined : 'true'}
      role={label ? 'img' : undefined}
      aria-label={label}
      set:html={ICONS[name]}
    />
  )
}

<style is:global>
  /* Global, not scoped: the class is this component's alone, and a scope
     attribute on every icon of every page is weight for nothing. */
  .icono {
    display: inline-flex;
    flex: none;
  }
  .icono svg {
    width: var(--icono-size, 20px);
    height: var(--icono-size, 20px);
    display: block;
  }
</style>
