---
/**
 * The «Más» list of the app shell: how the city works and how to open a
 * home, then — after a line — the house's quieter doors (a coffee, the
 * notifications behind the bell, help). The updates are not here: their one
 * door is the version in the footer (the Oracle, 2026-10-15). The sidebar
 * shows it in a popover with icons; a phone shows it compact, as text, at
 * the end of the page.
 */
import type { SupportedLocale } from '@numinia/domain';
import { APP_SHELL_UI } from '../../i18n/app-shell';
import { MORE_ITEMS, localeHref } from '../../lib/app-nav';
import Icon from './Icon.astro';

interface Props {
  locale: SupportedLocale;
  /** The phone's copy: text only, no icons. */
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const ui = APP_SHELL_UI[locale];
---

<ul class:list={['mas', { 'mas-compacta': compact }]}>
  {
    MORE_ITEMS.map((item, index) => (
      <li class={item.group !== MORE_ITEMS[index - 1]?.group && index > 0 ? 'mas-linea' : undefined}>
        <a href={localeHref(locale, item.path)} class="opc" data-metric={item.metric}>
          {!compact && <Icon name={item.icon} size={20} />}
          {ui.moreItems[item.id]}
        </a>
      </li>
    ))
  }
</ul>
