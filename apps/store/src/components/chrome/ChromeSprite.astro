---
/**
 * The chrome's sprite: what the app shell draws in more than one place
 * travels once per page as a <symbol>, and each place draws it with <use>
 * (`<Icon use />`). The Khepri and the wordmark (the city's rail and the
 * phone's header), the magnifier and the Bazar (the rail and the phone's
 * header), the city's places in the state this page gives them (the rail
 * and the phone's bottom bar), yours (the right rail and the «Tú» sheet),
 * the face, «Crear»'s house and plus, the gear and the way out (the rail's
 * foot, the face menu and the sheet). Each name travels once.
 */
import khepri from '@numinia/ui/assets/brand/Khepri_Logo.svg?raw';
import wordmark from '@numinia/ui/assets/brand/Numinia_Word.svg?raw';
import { CITY_ITEMS, YOU_ITEMS, navIcon, navState } from '../../lib/app-nav';
import { svgParts, symbolId } from '../../lib/svg-sprite';
import Icon from './Icon.astro';

interface Props {
  /** Current path without the locale prefix (from BaseLayout). */
  basePath: string;
}

const { basePath } = Astro.props;
const mark = svgParts(khepri);
const word = svgParts(wordmark);
const places = [...CITY_ITEMS, ...YOU_ITEMS].map((item) => navIcon(item, navState(item, basePath)));
const icons = [
  ...new Set([
    'magnifying-glass',
    'storefront',
    ...places,
    'user-circle',
    'user-circle-fill',
    'house',
    'calendar-plus',
    'planet',
    'plus',
    'arrow-square-out',
    'gear',
    'sign-out',
    'sign-in',
  ] as const),
];
---

<svg class="sprite" aria-hidden="true">
  <symbol id={symbolId('khepri')} viewBox={mark.viewBox} set:html={mark.body} />
  <symbol id={symbolId('wordmark')} viewBox={word.viewBox} set:html={word.body} />
  {icons.map((name) => <Icon name={name} symbol />)}
</svg>
