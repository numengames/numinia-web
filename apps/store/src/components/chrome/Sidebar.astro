---
/**
 * The sidebar of the app shell (the Oracle's design, 2026-10-14): sticky,
 * the full height of the window, 252 px — 76 px folded, a choice the device
 * remembers (`numinia-sidebar`, applied before paint by BaseLayout's boot
 * script). Desktop only: a phone gets the tab bar instead.
 *
 *   Khepri + Numinia            fold
 *   [ magnifier  Buscar      / ]
 *   Para ti · Explorar (Comunidades n · Calendario · Bazar) · Perteneces
 *   · Live · Perfil · Más ▸ popover beside the bar
 *   ──
 *   one line inviting to sign in, and the door (gone once you are in:
 *   `data-session-out`, set by the top bar's session script)
 *   (the folded footer is pinned below by the stylesheet: it comes last in
 *   the page, after main — see BaseLayout)
 *
 * Icons without boxes; hover tints icon and word with the link colour; the
 * current place draws its fill icon. The places and their routes come from
 * lib/app-nav.ts, which the tab bar reads too; the Khepri, the magnifier
 * and the places travel once in ChromeSprite.
 */
import type { SupportedLocale } from '@numinia/domain';
import wordmark from '@numinia/ui/assets/brand/Numinia_Word.svg?raw';
import { APP_SHELL_UI } from '../../i18n/app-shell';
import { COMMUNITIES_UI } from '../../i18n/communities';
import {
  EXPLORE_ITEMS,
  NAV_ITEMS,
  SEARCH_PATH,
  ariaCurrent,
  exploreState,
  localeHref,
  navIcon,
  navState,
  signInHref,
  type ExploreId,
} from '../../lib/app-nav';
import { symbolId } from '../../lib/svg-sprite';
import { COMMUNITIES } from '../communities/register';
import Icon from './Icon.astro';
import MoreList from './MoreList.astro';

interface Props {
  locale: SupportedLocale;
  /** Current path without the locale prefix (from BaseLayout). */
  basePath: string;
}

const { locale, basePath } = Astro.props;
const ui = APP_SHELL_UI[locale];
const words = COMMUNITIES_UI[locale];
const exploreLabel: Readonly<Record<ExploreId, string>> = {
  communities: words.navCommunities,
  calendar: words.navCalendar,
  bazaar: ui.bazaar,
};
---

<aside class="lat" aria-label={ui.sidebar}>
  <div class="lat-cab">
    <a href={localeHref(locale, '/')} class="lat-marca" data-metric="nav-home" aria-label="Numinia">
      <svg class="lat-khepri" fill="currentColor" aria-hidden="true">
        <use href={`#${symbolId('khepri')}`} />
      </svg>
      <span class="lat-palabra" set:html={wordmark} />
    </a>
    <button
      type="button"
      class="lat-plegar"
      aria-expanded="true"
      aria-label={ui.collapse}
      title={ui.collapse}
      data-fold={`${ui.collapse}|${ui.expand}`}
      data-metric="nav-collapse"
    >
      <Icon name="sidebar-simple" size={20} />
    </button>
  </div>

  <a
    href={localeHref(locale, SEARCH_PATH)}
    class="lat-buscar"
    title={words.search}
    aria-keyshortcuts="/"
    data-search
    data-metric="nav-search"
  >
    <Icon name="magnifying-glass" size={20} use />
    <span class="lat-t">{words.search}</span>
    <kbd aria-hidden="true">/</kbd>
  </a>

  <nav class="lat-nav" aria-label={ui.mainNav}>
    <ul>
      {
        NAV_ITEMS.map((item) => {
          const state = navState(item, basePath);
          return (
            <li>
              <a
                href={localeHref(locale, item.path)}
                class="lat-item"
                aria-current={ariaCurrent(state)}
                title={ui.nav[item.id]}
                data-metric={`nav-${item.id}`}
              >
                <Icon name={navIcon(item, state)} size={26} use />
                <span class="lat-t">{ui.nav[item.id]}</span>
              </a>
              {item.id === 'explore' && (
                <ul class="lat-sub">
                  {EXPLORE_ITEMS.map((sub) => (
                    <li>
                      <a
                        href={localeHref(locale, sub.path)}
                        aria-current={ariaCurrent(exploreState(sub, basePath))}
                        data-metric={`nav-${sub.id}`}
                      >
                        {exploreLabel[sub.id]}
                        {sub.id === 'communities' && (
                          <span class="lat-n mono">{COMMUNITIES.length}</span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })
      }
      <li>
        <details class="lat-mas" name="shell-menu" data-popover>
          <summary class="lat-item" title={ui.more} data-metric="nav-more">
            <Icon name="dots-three" size={26} />
            <span class="lat-t">{ui.more}</span>
          </summary>
          <div class="pop lat-pop">
            <MoreList locale={locale} />
          </div>
        </details>
      </li>
    </ul>
  </nav>

  <div class="lat-cta" data-session-out>
    <p>{ui.cta}</p>
    <a
      href={signInHref(locale, basePath)}
      class="btn btn-fantasma lat-entrar"
      title={ui.signIn}
      data-metric="nav-sign-in"
    >
      <Icon name="sign-in" size={18} />
      <span class="lat-t">{ui.signIn}</span>
    </a>
  </div>
</aside>

<script>
  /* The app shell's one script: the sidebar's fold, the «/» key, «Más»
     placed beside the bar, the night/day switch (the top bar) and the
     menus' Escape and click-outside. The shell works without it: the menus
     are <details> (`name` keeps one open at a time), the fold stays as
     BaseLayout's boot script left it, the search is a plain link. */
  import { SIDEBAR_KEY, opensSearch, popoverTop } from '../../lib/app-nav';

  const root = document.documentElement;

  /** A device preference (decision D17); private mode keeps it for the page. */
  const keep = (key: string, value: string): void => {
    try {
      localStorage.setItem(key, value);
    } catch {
      /* private mode: the choice lives for this page */
    }
  };

  /* The fold: the boot script applied the stored state before the first
     paint; this keeps the button's state and words in step. */
  const fold = document.querySelector<HTMLButtonElement>('.lat-plegar');
  const [collapse = '', expand = ''] = (fold?.dataset['fold'] ?? '').split('|');
  const paint = (): void => {
    const open = root.dataset['sidebar'] !== 'collapsed';
    const label = open ? collapse : expand;
    if (!fold) return;
    fold.ariaExpanded = String(open);
    fold.ariaLabel = label;
    fold.title = label;
  };
  paint();
  fold?.addEventListener('click', () => {
    const next = root.dataset['sidebar'] === 'collapsed' ? 'expanded' : 'collapsed';
    root.dataset['sidebar'] = next;
    keep(SIDEBAR_KEY, next);
    paint();
  });

  /* Night and day (§7.4 / §13.11: Diurno default, Nocturno by choice).
     MISSION-029: while the citizen has not chosen, the page follows the OS
     as the light changes; a stored choice ends the following. */
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    try {
      if (localStorage.getItem('numinia-modo')) return;
    } catch {
      return;
    }
    // Assign, never delete: the kit reads a MISSING attribute as Nocturno.
    root.dataset['modo'] = event.matches ? 'nocturno' : 'diurno';
  });
  document.querySelector('[data-metric="chrome-mode"]')?.addEventListener('click', () => {
    const next = root.dataset['modo'] === 'nocturno' ? 'diurno' : 'nocturno';
    root.dataset['modo'] = next;
    keep('numinia-modo', next);
  });

  /* The menus: Escape closes them and gives the focus back to the outer
     button, a click elsewhere folds them away. «/» opens the search unless
     the person is typing (a search dialog is a later step). */
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('details[data-popover]')];
  const search = document.querySelector<HTMLAnchorElement>('[data-search]');
  document.addEventListener('keydown', (event) => {
    const open = menus.filter((menu) => menu.open);
    if (event.key === 'Escape' && open[0]) {
      open.forEach((menu) => {
        menu.open = false;
      });
      open[0].querySelector('summary')?.focus();
      return;
    }
    const target = event.target instanceof HTMLElement ? event.target : null;
    if (event.defaultPrevented || !search || !opensSearch(event, target)) return;
    event.preventDefault();
    search.click();
  });
  document.addEventListener('click', (event) => {
    menus.forEach((menu) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
        menu.open = false;
      }
    });
  });

  /* «Más» opens beside the bar (the stylesheet sets its side), level with
     its button, never past the bottom edge. Without JS it unfolds in place. */
  const more = document.querySelector<HTMLDetailsElement>('.lat-mas');
  more?.addEventListener('toggle', () => {
    const pop = more.querySelector<HTMLElement>('.lat-pop');
    const top = more.querySelector('summary')?.getBoundingClientRect().top;
    if (!pop || top === undefined) return;
    pop.style.top = `${popoverTop(top, pop.offsetHeight, innerHeight)}px`;
    pop.toggleAttribute('data-placed', more.open);
  });
</script>
