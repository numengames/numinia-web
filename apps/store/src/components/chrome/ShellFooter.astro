---
/**
 * The folded footer of the app shell, at the foot of the city's rail (v3,
 * «La ciudad y tú»; it was the sidebar's since 2026-10-14). On a phone
 * upright the rails are gone and the footer closes the page instead
 * (BaseLayout draws a second copy there, hidden on a desktop).
 *
 *   Numen Games ▾          the house's three sites, this one marked
 *   Términos y políticas ▾ the four legal texts, the cookie choice, a
 *                          coffee, help, then licence · telemetry · commit
 *   by Numen Games · v0.83.0                                  skull
 *
 * NWOS, GitHub and Discord left the footer with the app shell. The
 * signature is brand voice and never translated; the skull shows the
 * epitaph (canon CAN-002), English on every locale, literal on purpose.
 */
import type { SupportedLocale } from '@numinia/domain';
import { CHROME_MESSAGES } from '../../i18n/messages';
import { APP_SHELL_UI } from '../../i18n/app-shell';
import { VERSION, COMMIT_SHA, COMMIT_URL, LICENSE_URL } from '../../lib/build-info';
import { EPITAPH } from '../../lib/canon';
import { HOUSE_LINKS, THIS_SITE } from '../../lib/house-links';
import { localeHref } from '../../lib/app-nav';
import Icon from './Icon.astro';

interface Props {
  locale: SupportedLocale;
  /** Which copy: the city rail's foot, or the phone's end of the page. */
  where?: 'rail' | 'page';
}

const { locale, where = 'rail' } = Astro.props;
const t = CHROME_MESSAGES[locale];
const ui = APP_SHELL_UI[locale];
const bubble = `footer-epitaph-${where}`;

// CAN-002: the epitaph (lib/canon.ts), literal on purpose.

// The house order of the legal texts (Legal notice · Privacy · Cookies · Terms).
const LEGAL = [
  { path: '/legal/legal-notice/', label: t.legalNotice, metric: 'footer-notice' },
  { path: '/legal/privacy/', label: t.legalPrivacy, metric: 'footer-privacy' },
  { path: '/legal/cookies/', label: t.legalCookies, metric: 'footer-cookies' },
  { path: '/legal/terms/', label: t.legalTerms, metric: 'footer-terms' },
];
---

<footer class="pie-app">
  <details class="pie-pliegue">
    <summary data-metric="footer-house">{ui.footerSites}</summary>
    <ul>
      {
        HOUSE_LINKS.map((site) =>
          site.id === THIS_SITE ? (
            <li>
              <span class="pie-aqui" aria-current="page">
                {site.label} <small>{t.footerThisSite}</small>
              </span>
            </li>
          ) : (
            <li>
              <a
                href={site.href}
                target="_blank"
                rel="noopener noreferrer"
                title={site.what}
                data-metric={`footer-house-${site.id}`}
              >
                {site.id === 'archive' ? ui.archive : site.label}
                <Icon name="arrow-square-out" size={12} use />
              </a>
            </li>
          ),
        )
      }
    </ul>
  </details>
  <details class="pie-pliegue">
    <summary data-metric="footer-legal">{ui.footerLegal}</summary>
    <ul>
      {
        LEGAL.map((doc) => (
          <li>
            <a href={localeHref(locale, doc.path)} data-metric={doc.metric}>
              {doc.label}
            </a>
          </li>
        ))
      }
      <li>
        <button type="button" data-cookie-choice data-metric="footer-cookie-choice">
          {t.legalCookieChoice}
        </button>
      </li>
      <li>
        <a href={localeHref(locale, '/back/')} data-metric="footer-back">{ui.back}</a>
      </li>
      <li>
        <a href={localeHref(locale, '/support/')} data-metric="nav-more-support">{ui.support}</a>
      </li>
      <li class="pie-obra">
        <a
          href={LICENSE_URL}
          target="_blank"
          rel="noopener noreferrer"
          title={t.footerLicenceTitle}
          data-metric="footer-licence">{t.footerLicence}</a
        >
      </li>
      <li>
        <a
          href={localeHref(locale, '/telemetry/')}
          title={t.footerTelemetryTitle}
          data-metric="footer-telemetry">{t.footerTelemetry}</a
        >
      </li>
      <li class="mono">
        {
          COMMIT_URL ? (
            <a
              href={COMMIT_URL}
              target="_blank"
              rel="noopener noreferrer"
              title={t.footerCommitTitle}
              data-metric="footer-commit"
            >
              {`commit ${COMMIT_SHA}`}
            </a>
          ) : (
            <span data-metric="footer-commit">{`commit ${COMMIT_SHA}`}</span>
          )
        }
      </li>
    </ul>
  </details>
  <div class="pie-cierre">
    {/* Explicit string expressions: Astro collapses template whitespace
        around inline elements, which once glued "by" to the link. */}
    <p class="pie-firma">
      {'by '}<a
        href="https://numen.games"
        target="_blank"
        rel="noopener noreferrer"
        data-metric="footer-numen-signature">Numen Games</a
      >{' · '}<a
        href={localeHref(locale, '/updates/')}
        title={t.footerVersionTitle}
        data-metric="footer-version">{VERSION}</a
      >
    </p>
    {/* The epitaph (CAN-002): hover or focus shows it, a tap toggles it,
        Escape closes it. No page, no navigation. */}
    <div class="epitafio" data-epitaph>
      <button
        type="button"
        class="calavera"
        aria-label="Epitaph"
        aria-expanded="false"
        aria-describedby={bubble}
        data-metric="footer-epitaph"
      >
        <Icon name="skull" size={20} />
      </button>
      <p id={bubble} class="bocadillo" role="tooltip" lang="en">{EPITAPH}</p>
    </div>
  </div>
</footer>

<script>
  // The epitaph: click/tap toggles it (aria-expanded), Escape closes it and
  // keeps it hushed until the pointer or the focus leaves the skull. Each
  // copy of the footer (the rail's, the phone's) has its own. The bubble
  // floats `fixed` in the window (lib/epitaph-tip.ts): the rail it sits in
  // scrolls and clips its own box, so it is placed and re-placed every time
  // it is about to show, read straight off the skull's own position.
  import { placeEpitaph } from '../../lib/epitaph-tip';

  document.querySelectorAll<HTMLElement>('[data-epitaph]').forEach((box) => {
    const button = box.querySelector('button');
    const tip = box.querySelector<HTMLElement>('.bocadillo');
    if (!button || !tip) return;
    const place = (): void => {
      const anchor = button.getBoundingClientRect();
      const point = placeEpitaph(
        anchor,
        { width: tip.offsetWidth, height: tip.offsetHeight },
        { width: innerWidth, height: innerHeight },
      );
      tip.style.top = `${point.top}px`;
      tip.style.left = `${point.left}px`;
      tip.toggleAttribute('data-placed', true);
    };
    const set = (open: boolean): void => {
      button.setAttribute('aria-expanded', String(open));
      box.toggleAttribute('data-open', open);
    };
    box.addEventListener('mouseenter', place);
    box.addEventListener('focusin', place);
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      box.removeAttribute('data-hushed');
      if (open) place();
      set(open);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (box.hasAttribute('data-open') || box.matches(':hover, :focus-within')) {
        set(false);
        box.setAttribute('data-hushed', '');
      }
    });
    const unhush = (): void => box.removeAttribute('data-hushed');
    box.addEventListener('mouseleave', unhush);
    box.addEventListener('focusout', unhush);
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !box.contains(event.target)) set(false);
    });
    addEventListener('resize', () => {
      if (box.hasAttribute('data-open') || box.matches(':hover, :focus-within')) place();
    });
    document.addEventListener(
      'scroll',
      () => {
        if (box.hasAttribute('data-open') || box.matches(':hover, :focus-within')) place();
      },
      { capture: true, passive: true },
    );
  });
</script>
