---
/**
 * «Avisos» (/notifications/, the bell; cut J «La ciudad y tú», 2026-10-17,
 * wireframe v3 #avisos): what concerns you, and only that — one list newest
 * first, four chips to narrow it (client-side, `aria-pressed` buttons), each
 * row a small icon, a sentence with its subject in bold, when, and at most
 * two quiet actions. No red numbers: the bar shows a dot when there is
 * something new (YouRail / PhoneBar), and opening this page is «seen».
 *
 * Signed out, the page shows the door. Which face shows is painted by the
 * chrome's one session read (`data-session-out` / `data-session-in`); this
 * page asks /api/notices once (lib/notices-client.ts) and paints the rows
 * from the template below. «Aceptar» decides a request through the decide
 * route; «Ahora no» only hides the row for this visit.
 */
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { APP_SHELL_UI } from '../../i18n/app-shell';
import { NOTIFICATIONS_UI, type NoticeFilter } from '../../i18n/notifications';
import { NOTIFICATIONS_PATH, signInHref } from '../../lib/app-nav';
import Icon from '../chrome/Icon.astro';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = NOTIFICATIONS_UI[locale];
const shell = APP_SHELL_UI[locale];
const CHIPS: readonly NoticeFilter[] = ['all', 'encounter', 'world', 'community'];
const prefix = locale === 'en' ? '' : `/${locale}`;
---

<BaseLayout locale={locale} title={`${t.title} — Numinia`} description={t.description}>
  <div class="avisos-pagina">
    <div class="cabecera-avisos">
      <h1>{t.title}</h1>
      <p class="texto-2">{t.lead}</p>
    </div>

    <div class="vacio-avisos puerta-avisos" data-session-out data-notifications-door>
      <span class="vacio-icono"><Icon name="bell" size={28} /></span>
      <p class="vacio-titulo">{t.signedOut}</p>
      <a
        class="btn btn-primario btn-sm"
        href={signInHref(locale, NOTIFICATIONS_PATH)}
        data-metric="notifications-sign-in"
      >
        <Icon name="sign-in" size={16} />
        {shell.signIn}
      </a>
    </div>

    <section
      class="tarjeta avisos"
      data-session-in
      hidden
      data-notices
      data-locale={locale}
      data-prefix={prefix}
      aria-labelledby="avisos-lista-titulo"
    >
      <h2 id="avisos-lista-titulo" class="visually-hidden">{t.listLabel}</h2>
      <div class="chips-avisos" role="group" aria-label={t.chipsLabel}>
        {
          CHIPS.map((chip) => (
            <button
              type="button"
              aria-pressed={chip === 'all' ? 'true' : 'false'}
              data-chip={chip}
              data-metric={`notifications-chip-${chip}`}
            >
              {t.chips[chip]}
            </button>
          ))
        }
      </div>
      <p class="aviso-estado small" role="status" aria-live="polite" data-notices-status></p>
      <ul class="lista-avisos" data-notices-list></ul>
      <div class="vacio-avisos" data-notices-empty hidden>
        <span class="vacio-icono"><Icon name="bell" size={28} /></span>
        <h3 class="vacio-titulo">{t.empty.title}</h3>
        <p class="vacio-texto">{t.empty.text}</p>
      </div>
      <div class="vacio-avisos" data-notices-failed hidden>
        <p class="vacio-texto">{t.failed}</p>
        <button type="button" class="btn btn-fantasma btn-sm" data-notices-retry data-metric="notifications-retry">
          {t.retry}
        </button>
      </div>
      <template data-notice-row>
        <li class="fila-aviso" data-notice>
          <span class="ico-aviso" data-kind-icon="encounter" role="img" aria-label={t.kinds.encounter}>
            <Icon name="calendar-blank" size={18} />
          </span>
          <span class="ico-aviso" data-kind-icon="world" role="img" aria-label={t.kinds.world}>
            <Icon name="broadcast" size={18} />
          </span>
          <span class="ico-aviso" data-kind-icon="community" role="img" aria-label={t.kinds.community}>
            <Icon name="users-three" size={18} />
          </span>
          <div class="aviso-cuerpo">
            <p class="aviso-texto"><span data-before></span><b data-subject></b><span data-after></span></p>
            <time class="aviso-cuando small" data-when></time>
            <div class="aviso-acciones" data-actions>
              <a class="btn btn-fantasma btn-sm" data-action="calendar" data-metric="notifications-calendar">
                {t.actions.calendar}
              </a>
              <a
                class="btn btn-fantasma btn-sm"
                data-action="enter"
                target="_blank"
                rel="noopener noreferrer"
                data-metric="notifications-enter"
              >
                {t.actions.enter}
              </a>
              <button type="button" class="btn btn-fantasma btn-sm" data-action="accept" data-metric="notifications-accept">
                {t.actions.accept}
              </button>
              <button type="button" class="btn btn-silencioso btn-sm" data-action="later" data-metric="notifications-later">
                {t.actions.later}
              </button>
            </div>
          </div>
        </li>
      </template>
      <span data-words-accepted hidden>{t.acceptedNow}</span>
      <span data-words-accept-failed hidden>{t.acceptFailed}</span>
    </section>
  </div>
</BaseLayout>

<script>
  /* The one fetch of the page (lib/notices-client.ts): the rows are cloned
     from the template, the chips narrow them without a reload, and the
     newest moment is kept as «seen» — the bell's dot goes. «Aceptar» posts
     the decision (lib/community-requests-client.ts) and the row leaves;
     «Ahora no» only hides it for this visit. */
  import { decide } from '../../lib/community-requests-client';
  import { loadNotices, markSeen, readSeen } from '../../lib/notices-client';
  import type { NoticeRow } from '../../lib/notices-source';

  const root = document.querySelector<HTMLElement>('[data-notices]');
  if (root) {
    const list = root.querySelector<HTMLElement>('[data-notices-list]')!;
    const template = root.querySelector<HTMLTemplateElement>('template[data-notice-row]')!;
    const empty = root.querySelector<HTMLElement>('[data-notices-empty]')!;
    const failed = root.querySelector<HTMLElement>('[data-notices-failed]')!;
    const status = root.querySelector<HTMLElement>('[data-notices-status]')!;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-chip]')];
    const locale = root.dataset['locale'] ?? 'es';
    const prefix = root.dataset['prefix'] ?? '';
    const word = (key: string): string =>
      root.querySelector<HTMLElement>(`[data-words-${key}]`)?.textContent?.trim() ?? '';
    const storage = ((): Storage | null => {
      try {
        return window.localStorage;
      } catch {
        return null;
      }
    })();
    let filter = 'all';

    // A page gets the locale's prefix; a calendar file (`.ics`) has one route for every locale.
    const localHref = (href: string): string =>
      href.startsWith('/') && !href.endsWith('.ics') ? `${prefix}${href}` : href;

    function apply(): void {
      const rows = [...list.querySelectorAll<HTMLElement>('[data-notice]')];
      rows.forEach((row) => {
        row.hidden = filter !== 'all' && row.dataset['kind'] !== filter;
      });
      const shown = rows.filter((row) => !row.hidden).length;
      empty.hidden = shown > 0 || !failed.hidden;
    }

    function paint(row: NoticeRow): HTMLElement {
      const clone = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
      clone.dataset['kind'] = row.kind;
      clone.dataset['noticeId'] = row.id;
      clone.querySelectorAll<HTMLElement>('[data-kind-icon]').forEach((icon) => {
        if (icon.dataset['kindIcon'] !== row.kind) icon.remove();
      });
      clone.querySelector('[data-before]')!.textContent = row.text.before;
      clone.querySelector('[data-subject]')!.textContent = row.text.subject;
      clone.querySelector('[data-after]')!.textContent = row.text.after;
      const when = clone.querySelector<HTMLTimeElement>('[data-when]')!;
      when.textContent = row.when;
      when.dateTime = row.at;
      const actions = clone.querySelector<HTMLElement>('[data-actions]')!;
      const wanted = new Map((row.actions ?? []).map((action) => [action.id, action]));
      actions.querySelectorAll<HTMLElement>('[data-action]').forEach((element) => {
        const action = wanted.get(element.dataset['action'] as never);
        if (action === undefined) {
          element.remove();
          return;
        }
        if ('href' in action) (element as HTMLAnchorElement).href = localHref(action.href);
        else element.dataset['request'] = action.request;
        if ('community' in action) element.dataset['community'] = action.community;
      });
      if (wanted.size === 0) actions.remove();
      return clone;
    }

    async function load(): Promise<void> {
      failed.hidden = true;
      empty.hidden = true;
      list.replaceChildren();
      const loaded = await loadNotices((input, init) => fetch(input, init), locale, readSeen(storage));
      if (!loaded.ok) {
        failed.hidden = false;
        return;
      }
      loaded.answer.notices.forEach((row) => list.append(paint(row)));
      markSeen(storage, loaded.answer.notices);
      document.dispatchEvent(new CustomEvent('numinia:notices-seen'));
      apply();
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        filter = chip.dataset['chip'] ?? 'all';
        chips.forEach((other) => other.setAttribute('aria-pressed', other === chip ? 'true' : 'false'));
        apply();
      });
    });

    root.querySelector('[data-notices-retry]')?.addEventListener('click', () => void load());

    list.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-action]');
      const row = button?.closest<HTMLElement>('[data-notice]');
      if (!button || !row) return;
      if (button.dataset['action'] === 'later') {
        row.remove();
        apply();
        return;
      }
      button.disabled = true;
      void decide(
        (input, init) => fetch(input, init),
        button.dataset['request'] ?? '',
        true,
        button.dataset['community'] ?? '',
      ).then((decided) => {
        if (decided.ok) {
          row.remove();
          status.textContent = word('accepted');
          apply();
        } else {
          button.disabled = false;
          status.textContent = word('accept-failed');
        }
      });
    });

    void load();
  }
</script>

<style>
  .avisos-pagina {
    max-width: 60rem;
    padding-top: var(--s5);
  }
  .cabecera-avisos {
    margin: 0 0 var(--s5);
  }
  .cabecera-avisos h1 {
    margin: 0 0 var(--s2);
  }
  .cabecera-avisos p {
    margin: 0;
    max-width: 60ch;
    line-height: 1.5;
  }
  .avisos {
    max-width: 780px;
    padding: var(--s4);
  }
  /* The chips: small buttons on a hairline, the pressed one in ink. */
  .chips-avisos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    padding-bottom: var(--s3);
    border-bottom: 1px solid var(--linea);
  }
  .chips-avisos button {
    min-height: 32px;
    padding: 4px 10px;
    border: 1px solid transparent;
    border-radius: var(--radio-control);
    background: none;
    color: var(--texto-2);
    font: 500 0.8rem var(--sans);
    cursor: pointer;
  }
  .chips-avisos button:hover {
    color: var(--texto);
  }
  .chips-avisos button[aria-pressed='true'] {
    border-color: var(--linea-f);
    background: var(--elevada);
    color: var(--texto);
  }
  .aviso-estado {
    min-height: 1em;
    margin: var(--s2) 0 0;
    color: var(--texto-2);
  }
  .aviso-estado:empty {
    margin: 0;
    min-height: 0;
  }
  /* The rows: icon, sentence, when, actions; a hairline between. */
  .lista-avisos {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fila-aviso {
    display: flex;
    gap: var(--s3);
    padding: var(--s4) 0;
    border-bottom: 1px solid var(--linea);
  }
  .fila-aviso:last-child {
    border-bottom: 0;
  }
  .fila-aviso[hidden] {
    display: none;
  }
  .ico-aviso {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--superficie);
    border: 1px solid var(--linea);
    color: var(--texto-2);
  }
  .aviso-cuerpo {
    min-width: 0;
    flex: 1;
  }
  .aviso-texto {
    margin: 0;
    line-height: 1.5;
  }
  .aviso-cuando {
    display: block;
    margin-top: 2px;
    color: var(--texto-2);
  }
  .aviso-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-top: var(--s3);
  }
  .aviso-acciones .btn {
    text-decoration: none;
  }
  /* The empty states: an icon in a round well, a title, one line. */
  .vacio-avisos {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s2);
    padding: var(--s7) var(--s4);
    text-align: center;
  }
  .vacio-icono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: var(--s2);
    border-radius: 50%;
    background: var(--superficie);
    border: 1px solid var(--linea);
    color: var(--texto-2);
  }
  .vacio-titulo {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--texto);
  }
  .vacio-texto {
    margin: 0;
    max-width: 44ch;
    color: var(--texto-2);
    line-height: 1.5;
  }
  .puerta-avisos .btn {
    margin-top: var(--s3);
    text-decoration: none;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  [hidden] {
    display: none !important;
  }
</style>
