---
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { UPDATES_MESSAGES } from '../../i18n/messages';
import { loadRoadmap, loadUpdates } from '../../lib/updates';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = UPDATES_MESSAGES[locale];
const updates = await loadUpdates();
const roadmap = await loadRoadmap();

/** "2026-04-02 22:00" → "2026-04-02 · 22:00 UTC" (dates without time pass through). */
function formatDate(date: string): string {
  const [day, time] = date.split(' ');
  return time ? `${day} · ${time} UTC` : (day ?? date);
}
---

<BaseLayout locale={locale} title={`${t.updatesTitle} — Numinia`} description={t.updatesIntro}>
  <header>
    <h1>{t.updatesTitle}</h1>
    <p>{t.updatesIntro}</p>
    {locale !== 'en' && <p class="note">{t.techNote}</p>}
  </header>

  {
    roadmap.length > 0 && (
      <section data-roadmap>
        <h2>{t.roadmapTitle}</h2>
        <ul>
          {roadmap.map((entry) => (
            <li>
              <span class={`tag tag-${entry.status}`}>{t.statusLabels[entry.status]}</span>
              {entry.item}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <ol data-updates>
    {
      updates.map((update, index) => (
        <li data-version={update.version}>
          <h2>
            {update.version}
            {index === 0 && <span class="tag tag-latest">{t.latestLabel}</span>}
            <time>{formatDate(update.date)}</time>
          </h2>
          <ul>
            {update.entries.map((entry) => (
              <li>
                <span class={`tag tag-${entry.type.toLowerCase()}`}>
                  {t.typeLabels[entry.type]}
                </span>
                {entry.text}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</BaseLayout>

<style>
  header p {
    color: var(--texto-2);
  }
  .note {
    font-size: 0.85rem;
  }
  /* §9.4 tarjeta. */
  [data-roadmap] {
    background: var(--superficie);
    border: 1px solid var(--linea);
    border-radius: var(--radio-marco);
    padding: var(--s4);
    margin-bottom: var(--s5);
  }
  [data-roadmap] h2 {
    margin-top: 0;
  }
  ol {
    list-style: none;
    padding: 0;
  }
  /* The timeline is a signal line: seafoam hairline. */
  ol > li {
    border-left: 2px solid var(--verdemar);
    padding: 0 0 var(--s4) var(--s4);
    margin: 0;
  }
  h2 {
    font-size: 1rem;
  }
  /* Versions and dates are measured: Mono tabular (§4.2). */
  time {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    color: var(--texto-3);
    font-size: 0.8rem;
    font-weight: 400;
    margin-left: var(--s2);
  }
  ul {
    list-style: none;
    padding: 0;
  }
  ul li {
    margin-bottom: var(--numinia-space-1);
    line-height: 1.5;
  }
  /* Entry types are labels: Mono etiqueta, color informs (§3.4). */
  .tag {
    display: inline-block;
    min-width: 4.2rem;
    text-align: center;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    padding: 0.1rem 0.4rem;
    margin-right: var(--s2);
    border-radius: var(--radio-control);
    border: 1px solid color-mix(in srgb, currentColor 40%, transparent);
    color: var(--texto-3);
  }
  .tag-new {
    color: var(--turquesa);
  }
  .tag-fix {
    color: var(--grana);
  }
  /* Khepri §9.2: emphasis as outlined etiqueta — amber flips per mode, AA in both. */
  .tag-latest {
    color: var(--ambar);
    margin-left: var(--s2);
  }
  .tag-planned,
  .tag-research {
    min-width: 5.4rem;
  }
</style>
