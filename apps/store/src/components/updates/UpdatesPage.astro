---
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { UPDATES_MESSAGES } from '../../i18n/messages';
import { loadRoadmap, loadUpdates } from '../../lib/updates';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = UPDATES_MESSAGES[locale];
const updates = await loadUpdates();
const roadmap = await loadRoadmap();

/** "2026-04-02 22:00" → "2026-04-02 · 22:00 UTC" (dates without time pass through). */
function formatDate(date: string): string {
  const [day, time] = date.split(' ');
  return time ? `${day} · ${time} UTC` : (day ?? date);
}
---

<BaseLayout locale={locale} title={`${t.updatesTitle} — Numinia`}>
  <header>
    <h1>{t.updatesTitle}</h1>
    <p>{t.updatesIntro}</p>
    {locale !== 'en' && <p class="note">{t.techNote}</p>}
  </header>

  {
    roadmap.length > 0 && (
      <section data-roadmap>
        <h2>{t.roadmapTitle}</h2>
        <ul>
          {roadmap.map((entry) => (
            <li>
              <span class={`tag tag-${entry.status}`}>{t.statusLabels[entry.status]}</span>
              {entry.item}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <ol data-updates>
    {
      updates.map((update, index) => (
        <li data-version={update.version}>
          <h2>
            {update.version}
            {index === 0 && <span class="tag tag-latest">{t.latestLabel}</span>}
            <time>{formatDate(update.date)}</time>
          </h2>
          <ul>
            {update.entries.map((entry) => (
              <li>
                <span class={`tag tag-${entry.type.toLowerCase()}`}>
                  {t.typeLabels[entry.type]}
                </span>
                {entry.text}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</BaseLayout>

<style>
  header p {
    color: var(--numinia-color-text-muted);
  }
  .note {
    font-size: 0.85rem;
  }
  [data-roadmap] {
    background: var(--numinia-color-surface);
    border-radius: var(--numinia-radius-md);
    padding: var(--numinia-space-3);
    margin-bottom: var(--numinia-space-4);
  }
  [data-roadmap] h2 {
    margin-top: 0;
  }
  ol {
    list-style: none;
    padding: 0;
  }
  ol > li {
    border-left: 2px solid var(--numinia-color-primary-strong);
    padding: 0 0 var(--numinia-space-3) var(--numinia-space-3);
    margin: 0;
  }
  h2 {
    font-size: 1rem;
  }
  time {
    color: var(--numinia-color-text-muted);
    font-size: 0.8rem;
    font-weight: 400;
    margin-left: var(--numinia-space-1);
  }
  ul {
    list-style: none;
    padding: 0;
  }
  ul li {
    margin-bottom: var(--numinia-space-1);
    line-height: 1.5;
  }
  .tag {
    display: inline-block;
    min-width: 4.2rem;
    text-align: center;
    font-size: 0.7rem;
    padding: 0.1rem 0.4rem;
    margin-right: var(--numinia-space-1);
    border-radius: var(--numinia-radius-sm);
    background: var(--numinia-color-surface);
    color: var(--numinia-color-text-muted);
  }
  .tag-new {
    background: var(--numinia-color-primary-strong);
    color: #ffffff;
  }
  .tag-fix {
    background: var(--numinia-color-danger, #d33440);
    color: #ffffff;
  }
  .tag-latest {
    background: var(--numinia-color-accent, #efa517);
    color: #1c1c1c;
    margin-left: var(--numinia-space-1);
  }
  .tag-planned,
  .tag-research {
    border: 1px solid var(--numinia-color-text-muted);
    background: transparent;
    min-width: 5.4rem;
  }
</style>
