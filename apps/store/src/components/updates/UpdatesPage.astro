---
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { UPDATES_MESSAGES } from '../../i18n/messages';
import UpdatesList from './UpdatesList.astro';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = UPDATES_MESSAGES[locale];
---

<BaseLayout locale={locale} title={`${t.updatesTitle} — Numinia`} description={t.updatesIntro}>
  <header>
    <h1>{t.updatesTitle}</h1>
    <p>{t.updatesIntro}</p>
    {locale !== 'en' && <p class="note">{t.techNote}</p>}
  </header>

  {/* The list itself is shared with the LAP's «Novedades» (/lap/updates/). */}
  <UpdatesList locale={locale} />
</BaseLayout>

<style>
  /* Responsive audit 2026-08-16: entries wrap inside the column and any
     table scrolls inside its own box. A residual 10px of layout overflow
     on main resists every element scan (no child box exceeds the
     viewport); clipped here rather than shipped — root cause unresolved,
     noted honestly. */
  :global(main) {
    overflow-x: clip;
  }
  :global(main) table {
    display: block;
    overflow-x: auto;
    max-width: 100%;
  }
  :global(main) li,
  :global(main) p {
    overflow-wrap: anywhere;
  }

  header p {
    color: var(--texto-2);
  }
  .note {
    font-size: 0.85rem;
  }
</style>
