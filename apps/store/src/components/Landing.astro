---
/**
 * «Ahora» (v3, cut C, 2026-10-16): the front page is what the city is doing
 * now, the same for everyone, signed in or not — action, not explanation
 * (what the page used to explain lives in «Cómo funciona», /how-it-works/).
 *
 * Top to bottom: «Lo que presentamos», the 16:9 frame with one featured thing
 * at a time (Featured.astro); on the phone only, «Ahora mismo, dentro», the
 * worlds with people as rows — only once the live count says so; the
 * upcoming encounters, in the visitor's time zone; the three communities
 * that meet soonest; the four newest goods of the Bazar; and the two doors
 * for a first visit. The worlds with people are NOT repeated here as cards:
 * on a wide screen they live in the left rail.
 *
 * Layer 0: renders whole without JavaScript; the only scripts are inline
 * (the countdowns, the live count, the frame's and the strip's arrows), per
 * the landing budget.
 */
import { AGORA_PLAZA, type SupportedLocale } from '@numinia/domain';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CHROME_MESSAGES } from '../i18n/messages';
import { AHORA_UI } from '../i18n/ahora';
import { COMMUNITIES_UI, fill } from '../i18n/communities';
import {
  countedSedes,
  featuredSlides,
  monogram,
  upcoming,
  withLife,
  worldOf,
} from '../lib/communities';
import { loadArchive } from '../lib/archive';
import { goodCard, newestGoods } from '../lib/goods';
import { COMMUNITIES, RITUALS, communityOf } from './communities/register';
import Icon from './chrome/Icon.astro';
import Featured from './communities/Featured.astro';
import CommunityCard from './communities/CommunityCard.astro';
import RitualCard from './communities/RitualCard.astro';
import GoodCardView from './communities/GoodCard.astro';
import Countdown from './communities/Countdown.astro';
import InsideCount from './communities/InsideCount.astro';
import '../styles/communities.css';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const ui = COMMUNITIES_UI[locale];
const a = AHORA_UI[locale];
// STD-023 §19 — the site's one line is the page description too.
const chrome = CHROME_MESSAGES[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;

/** The city's commons: the one world the repository knows a real address for. */
const commons = { href: AGORA_PLAZA.worldUrl, name: AGORA_PLAZA.name[locale] };
const slides = featuredSlides(COMMUNITIES, RITUALS);
const coming = upcoming(RITUALS);
const alive = withLife(COMMUNITIES, RITUALS).slice(0, 3);
const archive = await loadArchive();
const goods = newestGoods(archive).map((entry) => goodCard(entry, locale));
/** The homes whose people the live count reads: their community and their door. */
const counted = new Set(countedSedes(COMMUNITIES).map((sede) => sede.id));
const live = COMMUNITIES.flatMap((community) => {
  const world = counted.has(community.id) ? worldOf(community, commons, locale) : undefined;
  return world ? [{ community, world }] : [];
});
---

<BaseLayout locale={locale} title="Numinia" description={chrome.footerTagline}>
  <h1 class="oculto">{a.title}</h1>
  <div class="entrada">
    <Featured slides={slides} live={live} later={coming[0]} locale={locale} prefix={prefix} />
  </div>

  {
    live.length > 0 && (
      <section class="vivo-movil" aria-labelledby="vivo-movil-t" data-inside-any hidden>
        <h2 id="vivo-movil-t">{a.nowInside}</h2>
        <ul>
          {live.map(({ community, world }) => (
            <li data-inside-row={community.id} hidden>
              <a
                class="vivo-fila"
                href={world.href}
                target="_blank"
                rel="noopener noreferrer"
                data-metric="home-live-world"
              >
                <span class="vivo-cara" aria-hidden="true">
                  {community.image ? (
                    <img src={community.image.src} alt="" width="40" height="40" loading="lazy" decoding="async" />
                  ) : (
                    <b>{monogram(world.name)}</b>
                  )}
                  <span class="punto-vivo" />
                </span>
                <span class="vivo-txt">
                  <b>{world.name}</b>
                  <span class="dentro" data-inside={community.id} />
                </span>
                <Icon name="caret-left" size={16} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="bloque" id="rituals">
    <div class="cabecera-bloque entrada-1">
      <div>
        <h2 class="titulo-m">{a.upcomingTitle}</h2>
        <p class="ayuda">{a.upcomingHelp}<span data-tz>.</span></p>
      </div>
      <span class="flechas">
        <button
          type="button"
          class="flecha"
          data-step="-1"
          aria-controls="rituales-pista"
          aria-label={ui.previous}
          data-metric="landing-carousel-prev"
        >
          <Icon name="caret-left" size={18} />
        </button>
        <button
          type="button"
          class="flecha der"
          data-step="1"
          aria-controls="rituales-pista"
          aria-label={ui.next}
          data-metric="landing-carousel-next"
        >
          <Icon name="caret-left" size={18} />
        </button>
      </span>
    </div>
    <div class="pista entrada-2" id="rituales-pista" data-step-px="632">
      {
        coming.map((ritual) => (
          <RitualCard
            ritual={ritual}
            community={communityOf(ritual.community)}
            locale={locale}
            prefix={prefix}
            ui={ui}
            inCarousel
          />
        ))
      }
    </div>
  </section>

  <section class="bloque" id="alive">
    <div class="cabecera-bloque">
      <div>
        <h2 class="titulo-m">{a.aliveTitle}</h2>
        <p class="ayuda">{a.aliveHelp}</p>
      </div>
      <a class="btn btn-fantasma btn-sm" href={`${prefix}/communities/`} data-metric="home-communities">
        {fill(a.allCommunities, { n: COMMUNITIES.length })}
      </a>
    </div>
    <div class="rejilla">
      {
        alive.map((community) => (
          <CommunityCard
            community={community}
            rituals={RITUALS}
            locale={locale}
            prefix={prefix}
            ui={ui}
          />
        ))
      }
    </div>
  </section>

  {
    goods.length > 0 && (
      <section class="bloque" id="bazaar">
        <div class="cabecera-bloque">
          <div>
            <h2 class="titulo-m">{a.newTitle}</h2>
            <p class="ayuda">{a.newHelp}</p>
          </div>
          <a class="btn btn-fantasma btn-sm" href={`${prefix}/bazaar/`} data-metric="home-bazaar">
            {fill(a.allBazaar, { n: archive.length })}
          </a>
        </div>
        <div class="rejilla rejilla-obj">
          {goods.map((card) => (
            <GoodCardView card={card} prefix={prefix} ui={ui} />
          ))}
        </div>
      </section>
    )
  }

  <section class="final" aria-label={ui.firstTime}>
    <p>{ui.firstTime}</p>
    <div class="fila puertas">
      <a href={`${prefix}/how-it-works/`} data-metric="home-how">
        <Icon name="question" size={20} />
        {ui.howItWorks}
      </a>
      <a href={`${prefix}/how-it-works/#open`} data-metric="home-open">
        <Icon name="house" size={20} />
        {ui.openYourHome}
      </a>
    </div>
  </section>

  <Countdown ui={ui} />
  <InsideCount ui={ui} />
  <script is:inline>
    /* The hours of the encounters are the visitor's: say whose. */
    try {
      var zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
      if (zone) {
        document.querySelectorAll('[data-tz]').forEach(function (el) {
          el.textContent = ': ' + zone.replace(/_/g, ' ') + '.';
        });
      }
    } catch (error) {
      /* Without the zone the line simply ends. */
    }
    /* The encounters' strip: two cards per step, wrapping at the ends.
       Without JavaScript it scrolls by hand. */
    document.querySelectorAll('[data-step]').forEach(function (b) {
      b.addEventListener('click', function () {
        var s = document.getElementById(b.getAttribute('aria-controls'));
        if (!s) return;
        var w = Number(s.getAttribute('data-step-px')) || s.clientWidth;
        var end = s.scrollWidth - s.clientWidth;
        var x = s.scrollLeft;
        x = b.getAttribute('data-step') === '1' ? (x >= end - 2 ? 0 : Math.min(x + w, end)) : x <= 2 ? end : Math.max(x - w, 0);
        s.scrollTo({ left: x, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      });
    });
  </script>
</BaseLayout>

<style>
  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .pista {
    display: flex;
    gap: var(--s4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 2px 2px var(--s3);
    scrollbar-width: none;
  }
  .pista::-webkit-scrollbar {
    display: none;
  }
  .rejilla-obj {
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
  }
  /* «Ahora mismo, dentro»: the phone only — on a wide screen the left rail says it. */
  .vivo-movil {
    margin: var(--s5) 0 0;
  }
  .vivo-movil[hidden] {
    display: none;
  }
  @media (min-width: 48rem) {
    .vivo-movil {
      display: none;
    }
  }
  .vivo-movil h2 {
    font-size: 1.15rem;
    margin: 0 0 var(--s2);
  }
  .vivo-movil ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .vivo-movil li[hidden] {
    display: none;
  }
  .vivo-fila {
    display: flex;
    align-items: center;
    gap: var(--s3);
    min-height: 52px;
    padding: var(--s2) 0;
    border-bottom: 1px solid var(--linea);
    color: var(--texto);
    text-decoration: none;
  }
  .vivo-fila > :global(svg) {
    transform: scaleX(-1);
    color: var(--texto-2);
    flex: none;
  }
  .vivo-cara {
    position: relative;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 8px;
    background: var(--elevada);
    border: 1px solid var(--linea-f);
    display: grid;
    place-items: center;
  }
  .vivo-cara img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 7px;
  }
  .vivo-cara b {
    font: 600 0.7rem var(--sans);
  }
  .punto-vivo {
    position: absolute;
    right: -4px;
    bottom: -4px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--enlace);
    border: 2px solid var(--fondo);
  }
  .vivo-txt {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    line-height: 1.3;
  }
  .vivo-txt b {
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .vivo-txt .dentro {
    font-size: 0.85rem;
    color: var(--enlace);
  }
  .final {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s4) var(--s6);
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--linea);
    padding: var(--s6) 0 var(--s4);
  }
  .final p {
    margin: 0;
    color: var(--texto-2);
  }
  .puertas {
    gap: var(--s5);
  }
  .puertas a {
    display: inline-flex;
    gap: var(--s2);
    align-items: center;
    font-weight: 500;
    text-decoration: none;
    min-height: 32px;
  }
  .puertas a:hover,
  .puertas a:focus-visible {
    text-decoration: underline;
  }
</style>
