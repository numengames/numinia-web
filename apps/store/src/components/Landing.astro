---
/**
 * The front door (the app shell, v0.83.0, the Oracle 2026-10-14): action,
 * not explanation. The featured card first, landscape and full width — the
 * house's pick and the next rituals — then the upcoming rituals, a shelf of
 * the Bazar, the three communities with the nearest ritual, and the two
 * doors for a first visit: how it works, and how to open a community's home.
 * What the page used to explain lives in «Cómo funciona» (/how-it-works/).
 *
 * Layer 0: renders whole without JavaScript; the only scripts are inline
 * (the countdowns and the strips' arrows), per the landing budget.
 */
import { AGORA_PLAZA, type SupportedLocale } from '@numinia/domain';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CHROME_MESSAGES } from '../i18n/messages';
import { COMMUNITIES_UI } from '../i18n/communities';
import { featuredSlides, upcoming, withLife } from '../lib/communities';
import { loadArchive } from '../lib/archive';
import { goodCard, homeGoods } from '../lib/goods';
import { COMMUNITIES, RITUALS, communityOf } from './communities/register';
import Icon from './chrome/Icon.astro';
import Featured from './communities/Featured.astro';
import CommunityCard from './communities/CommunityCard.astro';
import RitualCard from './communities/RitualCard.astro';
import GoodCardView from './communities/GoodCard.astro';
import Countdown from './communities/Countdown.astro';
import '../styles/communities.css';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const ui = COMMUNITIES_UI[locale];
// STD-023 §19 — the site's one line is the page description too.
const chrome = CHROME_MESSAGES[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;

/** The city's commons: the one world the repository knows a real address for. */
const commons = { href: AGORA_PLAZA.worldUrl, name: AGORA_PLAZA.name[locale] };
const slides = featuredSlides(COMMUNITIES, RITUALS);
const coming = upcoming(RITUALS);
const alive = withLife(COMMUNITIES, RITUALS).slice(0, 3);
const goods = homeGoods(await loadArchive()).map((entry) => goodCard(entry, locale));
---

<BaseLayout locale={locale} title="Numinia" description={chrome.footerTagline}>
  <h1 class="oculto">Numinia</h1>
  {/* The entrance (STD-023 §14), the one orchestrated moment of the page:
      the featured card, then the rituals' head and strip, 100 ms apart. */}
  <div class="entrada">
    <Featured slides={slides} locale={locale} prefix={prefix} commons={commons} />
  </div>

  <section class="bloque" id="rituals">
    <div class="cabecera-bloque entrada-1">
      <div>
        <p class="etiqueta">{ui.upcomingEyebrow}</p>
        <h2 class="titulo-m">{ui.upcomingTitle}</h2>
        <p class="ayuda">{ui.upcomingHelp}</p>
      </div>
      <span class="flechas">
        <button
          type="button"
          class="flecha"
          data-step="-1"
          aria-controls="rituales-pista"
          aria-label={ui.previous}
          data-metric="landing-carousel-prev"
        >
          <Icon name="caret-left" size={18} />
        </button>
        <button
          type="button"
          class="flecha der"
          data-step="1"
          aria-controls="rituales-pista"
          aria-label={ui.next}
          data-metric="landing-carousel-next"
        >
          <Icon name="caret-left" size={18} />
        </button>
      </span>
    </div>
    <div class="pista entrada-2" id="rituales-pista" data-step-px="632">
      {
        coming.map((ritual) => (
          <RitualCard
            ritual={ritual}
            community={communityOf(ritual.community)}
            locale={locale}
            prefix={prefix}
            ui={ui}
            inCarousel
          />
        ))
      }
    </div>
  </section>

  {
    goods.length > 0 && (
      <section class="bloque" id="bazaar">
        <div class="cabecera-bloque">
          <div>
            <p class="etiqueta">{ui.goodsEyebrow}</p>
            <h2 class="titulo-m">{ui.goodsTitle}</h2>
            <p class="ayuda">{ui.goodsHelp}</p>
          </div>
          <a class="btn btn-fantasma btn-sm" href={`${prefix}/bazaar/`} data-metric="home-bazaar">
            {ui.seeBazaar}
          </a>
        </div>
        <div class="rejilla-obj">
          {goods.map((card) => (
            <GoodCardView card={card} prefix={prefix} ui={ui} />
          ))}
        </div>
      </section>
    )
  }

  <section class="bloque" id="alive">
    <div class="cabecera-bloque">
      <div>
        <p class="etiqueta">{ui.liveEyebrow}</p>
        <h2 class="titulo-m">{ui.liveTitle}</h2>
        <p class="ayuda">{ui.liveHelp}</p>
      </div>
    </div>
    <div class="rejilla">
      {
        alive.map((community) => (
          <CommunityCard
            community={community}
            rituals={RITUALS}
            locale={locale}
            prefix={prefix}
            ui={ui}
          />
        ))
      }
    </div>
  </section>

  <section class="final" aria-label={ui.firstTime}>
    <p>{ui.firstTime}</p>
    <div class="fila puertas">
      <a href={`${prefix}/how-it-works/`} data-metric="home-how">
        <Icon name="question" size={20} />
        {ui.howItWorks}
      </a>
      <a href={`${prefix}/how-it-works/#open`} data-metric="home-open">
        <Icon name="house" size={20} />
        {ui.openYourHome}
      </a>
    </div>
  </section>

  <Countdown ui={ui} />
  <script is:inline>
    /* The strips' arrows: the featured card steps one slide, the rituals two
       cards, and both wrap at the ends. Without JavaScript they scroll by hand. */
    document.querySelectorAll('[data-step]').forEach(function (b) {
      b.addEventListener('click', function () {
        var s = document.getElementById(b.getAttribute('aria-controls'));
        if (!s) return;
        var w = Number(s.getAttribute('data-step-px')) || s.clientWidth;
        var end = s.scrollWidth - s.clientWidth;
        var x = s.scrollLeft;
        x = b.getAttribute('data-step') === '1' ? (x >= end - 2 ? 0 : Math.min(x + w, end)) : x <= 2 ? end : Math.max(x - w, 0);
        s.scrollTo({ left: x, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      });
    });
  </script>
</BaseLayout>

<style>
  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .pista {
    display: flex;
    gap: var(--s4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 2px 2px var(--s3);
    scrollbar-width: none;
  }
  .pista::-webkit-scrollbar {
    display: none;
  }
  .rejilla-obj {
    display: grid;
    gap: var(--s4);
    grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr));
  }
  .rejilla-obj > * {
    min-width: 0;
  }
  .final {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s4) var(--s6);
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--linea);
    padding: var(--s6) 0 var(--s4);
  }
  .final p {
    margin: 0;
    color: var(--texto-2);
  }
  .puertas {
    gap: var(--s5);
  }
  .puertas a {
    display: inline-flex;
    gap: var(--s2);
    align-items: center;
    font-weight: 500;
    text-decoration: none;
  }
  .puertas a:hover,
  .puertas a:focus-visible {
    text-decoration: underline;
  }
</style>
