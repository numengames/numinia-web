---
/**
 * The front door (the app shell, v0.83.0, the Oracle 2026-10-14): action,
 * not explanation. The featured card first, landscape and full width — the
 * house's pick and the next gatherings — then the upcoming gatherings, a
 * shelf of the Bazar in one row (the same strip), the three communities with
 * the nearest gathering, and the two doors for a first visit: how it works,
 * and how to open a community's home.
 * What the page used to explain lives in «Cómo funciona» (/how-it-works/).
 *
 * Two faces (v0.86.0, the Oracle 2026-10-14). A visitor without a session
 * gets the visitor face: what Numinia is in a line, the way in without an
 * account, the four steps, the communities with an open home, the templates
 * with a short form, what stays yours, the city in one paragraph and the
 * questions. A signed-in person gets the face above («Para ti»). The top
 * bar's session script swaps them through `data-session-out` /
 * `data-session-in`; without JavaScript the visitor face is what shows.
 *
 * Layer 0: renders whole without JavaScript; the only scripts are inline
 * (the countdowns and the strips' arrows), per the landing budget.
 */
import { AGORA_PLAZA, type SupportedLocale } from '@numinia/domain';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CHROME_MESSAGES } from '../i18n/messages';
import { COMMUNITIES_UI } from '../i18n/communities';
import { FRONT_DOOR } from '../i18n/front-door';
import { HOW_IT_WORKS } from '../i18n/how-it-works';
import { featuredSlides, upcoming, withHome, withLife } from '../lib/communities';
import { loadArchive } from '../lib/archive';
import { goodCard, homeGoods } from '../lib/goods';
import { COMMUNITIES, RITUALS, communityOf } from './communities/register';
import Icon from './chrome/Icon.astro';
import Featured from './communities/Featured.astro';
import CommunityCard from './communities/CommunityCard.astro';
import RitualCard from './communities/RitualCard.astro';
import GoodCardView from './communities/GoodCard.astro';
import Countdown from './communities/Countdown.astro';
import HowSteps from './communities/HowSteps.astro';
import HowTemplates from './communities/HowTemplates.astro';
import '../styles/communities.css';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const ui = COMMUNITIES_UI[locale];
// STD-023 §19 — the site's one line is the page description too.
const chrome = CHROME_MESSAGES[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;

/** The city's commons: the one world the repository knows a real address for. */
const commons = { href: AGORA_PLAZA.worldUrl, name: AGORA_PLAZA.name[locale] };
const slides = featuredSlides(COMMUNITIES, RITUALS);
const coming = upcoming(RITUALS);
const alive = withLife(COMMUNITIES, RITUALS).slice(0, 3);
const goods = homeGoods(await loadArchive()).map((entry) => goodCard(entry, locale));
const door = FRONT_DOOR[locale];
const templates = HOW_IT_WORKS[locale].templates;
const homes = withHome(COMMUNITIES);
---

<BaseLayout locale={locale} title="Numinia" description={chrome.footerTagline}>
  <div class="visita" data-session-out>
    <section class="portada">
      <div class="portada-texto">
        <p class="etiqueta entrada">{door.eyebrow}</p>
        <h1 class="display-m entrada-1">{door.heading}</h1>
        <p class="lead entrada-2">{door.lead}</p>
        <div class="fila botones entrada-3">
          <a
            class="btn btn-primario"
            href={commons.href}
            target="_blank"
            rel="noopener noreferrer"
            data-metric="door-enter-city"
          >
            {door.enterCity}
            <Icon name="arrow-square-out" size={18} />
          </a>
          <a class="btn btn-fantasma" href="#abrir" data-metric="door-open-home">
            {door.openHome}
          </a>
        </div>
        <p class="nota entrada-3">{door.enterNote}</p>
      </div>
      <img
        class="portada-imagen entrada-2"
        src="/images/art/citizens.webp"
        alt={door.pictureAlt}
        width="883"
        height="960"
        decoding="async"
      />
    </section>

    <section class="bloque" id="como">
      <div class="cabecera-bloque">
        <div>
          <p class="etiqueta">{door.stepsEyebrow}</p>
          <h2 class="titulo-m">{door.stepsTitle}</h2>
        </div>
      </div>
      <HowSteps locale={locale} heading="h3" metric="door-step" />
    </section>

    {
      homes.length > 0 && (
        <section class="bloque" id="con-sede">
          <div class="cabecera-bloque">
            <div>
              <p class="etiqueta">{door.homesEyebrow}</p>
              <h2 class="titulo-m">{door.homesTitle}</h2>
              <p class="ayuda">{door.homesHelp}</p>
            </div>
            <a class="btn btn-fantasma btn-sm" href={`${prefix}/communities/`} data-metric="door-communities">
              {door.allCommunities}
            </a>
          </div>
          <div class="rejilla">
            {homes.map((community) => (
              <CommunityCard community={community} rituals={RITUALS} locale={locale} prefix={prefix} ui={ui} />
            ))}
          </div>
        </section>
      )
    }

    <section class="bloque" id="abrir">
      <div class="cabecera-bloque">
        <div>
          <p class="etiqueta">{HOW_IT_WORKS[locale].openEyebrow}</p>
          <h2 class="titulo-m">{HOW_IT_WORKS[locale].openTitle}</h2>
        </div>
      </div>
      <HowTemplates locale={locale} />
      <form
        class="tarjeta pedir"
        id="pedir-sede"
        action="mailto:hola@numengames.com"
        method="post"
        enctype="text/plain"
        data-subject={door.mailSubject}
      >
        <h3>{door.formTitle}</h3>
        <p class="ayuda">{door.formHelp}</p>
        <div class="campos">
          <label>
            <span>{door.formName}</span>
            <input name="name" required autocomplete="organization" />
          </label>
          <label>
            <span>{door.formKind}</span>
            <select name="kind">
              {templates.map((template) => <option>{template.name}</option>)}
              <option>{door.formKindUnsure}</option>
            </select>
          </label>
          <label>
            <span>{door.formWhen}</span>
            <input name="when" type="month" />
          </label>
          <label>
            <span>{door.formEmail}</span>
            <input name="email" type="email" required autocomplete="email" />
          </label>
        </div>
        <div class="fila enviar">
          <button class="btn btn-primario" type="submit" data-metric="door-open-send">
            {door.formSend}
          </button>
          <p class="nota">{door.formNote}</p>
        </div>
      </form>
    </section>

    <section class="bloque" id="vuestro">
      <p class="etiqueta">{door.yoursEyebrow}</p>
      <h2 class="titulo-m">{door.yoursTitle}</h2>
      <p class="lead">{door.yoursLead}</p>
      <div class="fila botones">
        <a class="btn btn-fantasma" href={`${prefix}/bazaar/`} data-metric="door-bazaar">
          {door.yoursBazaar}
        </a>
        <a
          class="btn btn-fantasma"
          href="https://github.com/numengames/numinia-web"
          target="_blank"
          rel="noopener noreferrer"
          data-metric="door-code"
        >
          {door.yoursCode}
          <Icon name="arrow-square-out" size={18} />
        </a>
      </div>
    </section>

    <section class="bloque ciudad" id="ciudad">
      <div>
        <p class="etiqueta">{door.cityEyebrow}</p>
        {door.cityNotice && <p class="nota">{door.cityNotice}</p>}
        <p class="lead">{door.cityLine}</p>
        <a href="https://numinia.org" target="_blank" rel="noopener noreferrer" data-metric="door-story">
          {door.readStory}
          <Icon name="arrow-square-out" size={16} />
        </a>
      </div>
      <img src="/images/art/genesis.webp" alt="" width="887" height="960" loading="lazy" decoding="async" />
    </section>

    <section class="bloque" id="preguntas">
      <p class="etiqueta">{door.faqEyebrow}</p>
      <h2 class="titulo-m">{door.faqTitle}</h2>
      <div class="preguntas">
        {
          door.faq.map((entry) => (
            <details>
              <summary data-metric="door-faq">{entry.q}</summary>
              <p>{entry.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>

  <div data-session-in hidden>
  <h1 class="oculto">Numinia</h1>
  {/* The entrance (STD-023 §14), the one orchestrated moment of the page:
      the featured card, then the rituals' head and strip, 100 ms apart. */}
  <div class="entrada">
    <Featured slides={slides} locale={locale} prefix={prefix} commons={commons} />
  </div>

  <section class="bloque" id="rituals">
    <div class="cabecera-bloque entrada-1">
      <div>
        <p class="etiqueta">{ui.upcomingEyebrow}</p>
        <h2 class="titulo-m">{ui.upcomingTitle}</h2>
        <p class="ayuda">{ui.upcomingHelp}</p>
      </div>
      <span class="flechas">
        <button
          type="button"
          class="flecha"
          data-step="-1"
          aria-controls="rituales-pista"
          aria-label={ui.previous}
          data-metric="landing-carousel-prev"
        >
          <Icon name="caret-left" size={18} />
        </button>
        <button
          type="button"
          class="flecha der"
          data-step="1"
          aria-controls="rituales-pista"
          aria-label={ui.next}
          data-metric="landing-carousel-next"
        >
          <Icon name="caret-left" size={18} />
        </button>
      </span>
    </div>
    <div class="pista entrada-2" id="rituales-pista" data-step-px="632">
      {
        coming.map((ritual) => (
          <RitualCard
            ritual={ritual}
            community={communityOf(ritual.community)}
            locale={locale}
            prefix={prefix}
            ui={ui}
            inCarousel
          />
        ))
      }
    </div>
  </section>

  {
    goods.length > 0 && (
      <section class="bloque" id="bazaar">
        <div class="cabecera-bloque">
          <div>
            <p class="etiqueta">{ui.goodsEyebrow}</p>
            <h2 class="titulo-m">{ui.goodsTitle}</h2>
            <p class="ayuda">{ui.goodsHelp}</p>
          </div>
          <div class="fila acciones-pista">
            <a class="btn btn-fantasma btn-sm" href={`${prefix}/bazaar/`} data-metric="home-bazaar">
              {ui.seeBazaar}
            </a>
            <span class="flechas">
              <button
                type="button"
                class="flecha"
                data-step="-1"
                aria-controls="objetos-pista"
                aria-label={ui.previous}
                data-metric="home-bazaar-prev"
              >
                <Icon name="caret-left" size={18} />
              </button>
              <button
                type="button"
                class="flecha der"
                data-step="1"
                aria-controls="objetos-pista"
                aria-label={ui.next}
                data-metric="home-bazaar-next"
              >
                <Icon name="caret-left" size={18} />
              </button>
            </span>
          </div>
        </div>
        {/* One row, the same strip as the gatherings above (the Oracle,
            2026-10-14: «yo no mostraría dos filas»): two cards per step. */}
        <div class="pista" id="objetos-pista" data-step-px="512">
          {goods.map((card) => (
            <GoodCardView card={card} prefix={prefix} ui={ui} inCarousel />
          ))}
        </div>
      </section>
    )
  }

  <section class="bloque" id="alive">
    <div class="cabecera-bloque">
      <div>
        <p class="etiqueta">{ui.liveEyebrow}</p>
        <h2 class="titulo-m">{ui.liveTitle}</h2>
        <p class="ayuda">{ui.liveHelp}</p>
      </div>
    </div>
    <div class="rejilla">
      {
        alive.map((community) => (
          <CommunityCard
            community={community}
            rituals={RITUALS}
            locale={locale}
            prefix={prefix}
            ui={ui}
          />
        ))
      }
    </div>
  </section>

  <section class="final" aria-label={ui.firstTime}>
    <p>{ui.firstTime}</p>
    <div class="fila puertas">
      <a href={`${prefix}/how-it-works/`} data-metric="home-how">
        <Icon name="question" size={20} />
        {ui.howItWorks}
      </a>
      <a href={`${prefix}/how-it-works/#open`} data-metric="home-open">
        <Icon name="house" size={20} />
        {ui.openYourHome}
      </a>
    </div>
  </section>
  </div>

  <Countdown ui={ui} />
  <script is:inline>
    /* The strips' arrows: the featured card steps one slide, the others two
       cards, and all wrap at the ends. Without JavaScript they scroll by hand. */
    /* The request for a home: without JavaScript the form posts to the mail
       client as it is; with it, the mail opens with a subject and one line
       per field, labelled in the page's language. */
    var pedir = document.getElementById('pedir-sede');
    if (pedir) {
      pedir.addEventListener('submit', function (event) {
        event.preventDefault();
        var lines = [];
        var name = '';
        pedir.querySelectorAll('label').forEach(function (label) {
          var field = label.querySelector('input,select');
          if (!field || !field.value) return;
          if (field.name === 'name') name = field.value;
          lines.push(label.querySelector('span').textContent + ': ' + field.value);
        });
        var subject = (pedir.getAttribute('data-subject') || '').replace('{name}', name);
        location.href =
          'mailto:hola@numengames.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(lines.join('\n'));
      });
    }
    document.querySelectorAll('[data-step]').forEach(function (b) {
      b.addEventListener('click', function () {
        var s = document.getElementById(b.getAttribute('aria-controls'));
        if (!s) return;
        var w = Number(s.getAttribute('data-step-px')) || s.clientWidth;
        var end = s.scrollWidth - s.clientWidth;
        var x = s.scrollLeft;
        x = b.getAttribute('data-step') === '1' ? (x >= end - 2 ? 0 : Math.min(x + w, end)) : x <= 2 ? end : Math.max(x - w, 0);
        s.scrollTo({ left: x, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      });
    });
  </script>
</BaseLayout>

<style>
  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .pista {
    display: flex;
    gap: var(--s4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 2px 2px var(--s3);
    scrollbar-width: none;
  }
  .pista::-webkit-scrollbar {
    display: none;
  }
  .acciones-pista {
    gap: var(--s3);
  }
  .final {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s4) var(--s6);
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--linea);
    padding: var(--s6) 0 var(--s4);
  }
  .final p {
    margin: 0;
    color: var(--texto-2);
  }
  .puertas {
    gap: var(--s5);
  }
  .puertas a {
    display: inline-flex;
    gap: var(--s2);
    align-items: center;
    font-weight: 500;
    text-decoration: none;
  }
  .puertas a:hover,
  .puertas a:focus-visible {
    text-decoration: underline;
  }
  /* The visitor face. */
  .portada {
    display: grid;
    gap: var(--s6);
    grid-template-columns: 1fr;
    align-items: center;
    padding: var(--s6) 0 var(--s7);
  }
  @media (min-width: 56.25rem) {
    .portada {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--s7);
    }
  }
  .portada > *,
  .ciudad > * {
    min-width: 0;
  }
  .portada h1 {
    margin: var(--s3) 0 var(--s4);
  }
  .visita .lead {
    color: var(--texto-2);
    font-size: 1.15rem;
    line-height: 1.5;
    max-width: 58ch;
    margin: var(--s3) 0 var(--s5);
  }
  .botones {
    gap: var(--s3);
  }
  .visita .nota {
    color: var(--texto-2);
    font-size: 0.875rem;
    margin: var(--s3) 0 0;
  }
  .portada-imagen {
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radio-marco);
    border: 1px solid var(--linea);
  }
  .pedir {
    margin-top: var(--s5);
  }
  .pedir h3 {
    margin: 0;
    font-size: 1.15rem;
  }
  .pedir .ayuda {
    color: var(--texto-2);
    margin: var(--s2) 0 var(--s4);
  }
  .campos {
    display: grid;
    gap: var(--s4);
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    margin-bottom: var(--s4);
  }
  .campos label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--texto-2);
    font-size: 0.9rem;
    min-width: 0;
  }
  .campos input,
  .campos select {
    font: 400 1rem var(--sans);
    color: var(--texto);
    background: var(--fondo);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-control);
    min-height: 44px;
    padding: 0 var(--s3);
    min-width: 0;
  }
  .enviar {
    gap: var(--s4);
  }
  .enviar .nota {
    margin: 0;
  }
  .ciudad {
    display: grid;
    gap: var(--s6);
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 56.25rem) {
    .ciudad {
      grid-template-columns: 1.3fr 0.7fr;
    }
  }
  .ciudad a {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }
  .ciudad img {
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radio-marco);
    border: 1px solid var(--linea);
  }
  .preguntas {
    max-width: 760px;
    margin-top: var(--s5);
  }
  .preguntas details {
    border-bottom: 1px solid var(--linea);
    padding: var(--s3) 0;
  }
  .preguntas summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 1.05rem;
    min-height: 32px;
  }
  .preguntas p {
    color: var(--texto-2);
    margin: var(--s2) 0 0;
  }
</style>
