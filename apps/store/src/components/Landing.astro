---
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CHROME_MESSAGES, LANDING_MESSAGES } from '../i18n/messages';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = LANDING_MESSAGES[locale];
// STD-023 §19 — the site's one line is the page description too, so the
// footer, the head and the share card say the same thing.
const chrome = CHROME_MESSAGES[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;

/** §6.1 — the canonical binary phrase; copied from §19.3, never invented. */
const BINARIA =
  '' +
  'x'.repeat(60);

const PILLARS = [
  { href: `${prefix}/city/`, metric: 'landing-pillar-city', text: t.pillarCity },
  { href: `${prefix}/assets/`, metric: 'landing-pillar-assets', text: t.pillarAssets },
  { href: `${prefix}/lap/`, metric: 'landing-pillar-lap', text: t.pillarLap },
];
---

<BaseLayout locale={locale} title="Numinia" description={chrome.footerTagline}>
  <!-- §13.2 hero: the thesis, relief behind it (Nocturno only), the single
       orchestrated moment of the piece — the entrance (STD-023 §14):
       headline, line, actions rising in 100ms apart, as numinia.org opens. -->
  <section class="hero" data-materia="relieve">
    <h1 class="display-m entrada">{t.heroTitle}</h1>
    <p class="sub cuerpo-l entrada-1">{t.heroSub}</p>
    <div class="ctas entrada-2">
      <a href={`${prefix}/city/`} class="btn btn-primario" data-metric="landing-city">
        {t.ctaCity}
      </a>
      <a href={`${prefix}/assets/`} class="btn btn-fantasma" data-metric="landing-assets">
        {t.ctaAssets}
      </a>
    </div>
    <p class="binaria" data-barrido aria-hidden="true">{BINARIA}</p>
  </section>

  <section class="doors">
    <p class="etiqueta">{t.pillarsTitle}</p>
    <ul class="pillars">
      {
        PILLARS.map((pillar) => (
          <li>
            <a href={pillar.href} class="tarjeta reveal" data-metric={pillar.metric}>
              {pillar.text}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--s8) var(--s5) var(--s6);
    margin: 0 calc(-1 * var(--s5));
    text-align: center;
    border-radius: var(--radio-marco);
  }
  /* The page headline at numinia.org's size: 3–3.75rem, Geist 400. */
  .hero h1 {
    font-size: clamp(2.25rem, 2.5vw + 1.75rem, 3.75rem);
    color: var(--texto);
    margin: 0 auto var(--s4);
    max-width: 24ch;
  }
  .sub {
    max-width: 56ch;
    margin: 0 auto var(--s5);
    color: var(--texto-2);
  }
  .ctas {
    display: flex;
    gap: var(--s3);
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn {
    text-decoration: none;
  }
  .hero .binaria {
    margin: var(--s7) auto 0;
    max-width: 100%;
  }
  .doors {
    margin-top: var(--s8);
  }
  .pillars {
    list-style: none;
    padding: 0;
    margin: var(--s4) 0 0;
    display: grid;
    gap: var(--s4);
  }
  .pillars a {
    display: block;
    color: var(--texto);
    text-decoration: none;
  }
</style>
