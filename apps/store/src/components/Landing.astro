---
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../layouts/BaseLayout.astro';
import { LANDING_MESSAGES } from '../i18n/messages';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = LANDING_MESSAGES[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;

/** §6.1 — the canonical binary phrase; copied from §19.3, never invented. */
const BINARIA =
  '' +
  'x'.repeat(60);

const PILLARS = [
  { href: `${prefix}/city/`, metric: 'landing-pillar-city', text: t.pillarCity },
  { href: `${prefix}/assets/`, metric: 'landing-pillar-assets', text: t.pillarAssets },
  { href: `${prefix}/lap/`, metric: 'landing-pillar-lap', text: t.pillarLap },
];
---

<BaseLayout locale={locale} title="Numinia" description={t.heroSub}>
  <!-- §13.2 hero: the thesis, relief behind it (Nocturno only), the single
       orchestrated moment of the piece — typing + staggered reveals. -->
  <section class="hero" data-materia="relieve" data-escalonado>
    <h1 class="display-m" data-tecleo>{t.heroTitle}</h1>
    <p class="sub cuerpo-l reveal">{t.heroSub}</p>
    <div class="ctas reveal">
      <a href={`${prefix}/city/`} class="btn btn-primario" data-metric="landing-city">
        {t.ctaCity}
      </a>
      <a href={`${prefix}/assets/`} class="btn btn-fantasma" data-metric="landing-assets">
        {t.ctaAssets}
      </a>
    </div>
    <p class="binaria" data-barrido aria-hidden="true">{BINARIA}</p>
  </section>

  <section class="doors">
    <p class="etiqueta">{t.pillarsTitle}</p>
    <ul class="pillars">
      {
        PILLARS.map((pillar) => (
          <li>
            <a href={pillar.href} class="tarjeta reveal" data-metric={pillar.metric}>
              {pillar.text}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--s8) var(--s5) var(--s6);
    margin: 0 calc(-1 * var(--s4));
    text-align: center;
    border-radius: var(--radio-marco);
  }
  .hero h1 {
    color: var(--texto);
    margin: 0 auto var(--s4);
    max-width: 24ch;
  }
  .sub {
    max-width: 56ch;
    margin: 0 auto var(--s5);
    color: var(--texto-2);
  }
  .ctas {
    display: flex;
    gap: var(--s3);
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn {
    text-decoration: none;
  }
  .hero .binaria {
    margin: var(--s7) auto 0;
    max-width: 100%;
  }
  .doors {
    margin-top: var(--s8);
  }
  .pillars {
    list-style: none;
    padding: 0;
    margin: var(--s4) 0 0;
    display: grid;
    gap: var(--s4);
  }
  .pillars a {
    display: block;
    color: var(--texto);
    text-decoration: none;
  }
</style>
