---
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ModelViewer } from '../viewer/ModelViewer';
import { ARCHIVE_MESSAGES } from '../../i18n/messages';
import { downloadUrl } from '../../lib/archive';
import type { CatalogedAsset } from '../../lib/data';

interface Props {
  entry: CatalogedAsset;
  locale: SupportedLocale;
}

const { entry, locale } = Astro.props;
const { asset, category } = entry;
const t = ARCHIVE_MESSAGES[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;
const binaryUrl = downloadUrl(asset);
const description = asset.description || `${asset.format.toUpperCase()} · CC0 · Numinia`;
---

<BaseLayout locale={locale} title={`${asset.name} — Numinia`} description={description}>
  <Fragment slot="head">
    {/* BaseLayout owns description/og basics; only the image is page-specific. */}
    {asset.thumbnailUrl && <meta property="og:image" content={asset.thumbnailUrl} />}
  </Fragment>

  <nav>
    <a href={`${prefix}/archive/`} data-metric="archive-back">{t.backToArchive}</a>
  </nav>

  <article>
    <h1>{asset.name}</h1>
    {asset.description && <p>{asset.description}</p>}

    <section aria-label="preview">
      {asset.format === 'png' || asset.format === 'jpg' ? (
        binaryUrl ? (
          <img src={binaryUrl} alt={asset.name} loading="lazy" />
        ) : (
          <p>{t.downloadUnavailable}</p>
        )
      ) : asset.format === 'mp3' ? (
        binaryUrl ? <audio controls src={binaryUrl}></audio> : <p>{t.downloadUnavailable}</p>
      ) : asset.format === 'mp4' ? (
        binaryUrl ? <video controls src={binaryUrl}></video> : <p>{t.downloadUnavailable}</p>
      ) : asset.format === 'hyp' ? (
        <p>{t.worldFileNote}</p>
      ) : (
        <ModelViewer client:visible url={binaryUrl} kind={asset.format === 'vrm' ? 'vrm' : 'glb'} />
      )}
    </section>

    <dl>
      <dt>{t.format}</dt>
      <dd>{asset.format.toUpperCase()}</dd>
      <dt>{t.category}</dt>
      <dd>{category}</dd>
      <dt>{t.license}</dt>
      <dd>{asset.license}</dd>
    </dl>

    {
      binaryUrl ? (
        <a
          href={binaryUrl}
          download
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primario"
          data-metric="archive-download"
        >
          {t.download}
        </a>
      ) : (
        <p data-download-unavailable>{t.downloadUnavailable}</p>
      )
    }
  </article>
</BaseLayout>

<style>
  h1 {
    font-size: 2.488rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  img,
  video {
    max-width: 100%;
    border-radius: var(--radio-marco);
  }
  section {
    margin: var(--s5) 0;
  }
  /* §13.11 table idiom: labels as amber etiqueta, values in Mono (measured). */
  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--s2) var(--s4);
  }
  dt {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ambar);
    font-weight: 500;
    align-self: center;
  }
  dd {
    margin: 0;
    font-family: var(--mono);
    color: var(--texto-2);
  }
  /* The download is the ONE primary of this view (§9.1) — ink per §13.11. */
  a[data-metric='archive-download'] {
    margin-top: var(--s4);
    text-decoration: none;
  }
  [data-download-unavailable] {
    color: var(--texto-2);
  }
</style>
