---
import type { SupportedLocale } from '@numinia/domain';
import type { CatalogedAsset } from '../../lib/data';
import { thumbSrc } from '../../lib/thumbs';

interface Props {
  entry: CatalogedAsset;
  locale: SupportedLocale;
}

const { entry, locale } = Astro.props;
const { asset, category } = entry;
const prefix = locale === 'en' ? '' : `/${locale}`;
---

<a
  href={`${prefix}/archive/${asset.id}/`}
  data-archive-card
  data-name={asset.name.toLowerCase()}
  data-format={asset.format}
  data-metric="archive-card"
>
  <article class="tarjeta reveal">
    {
      asset.thumbnailUrl ? (
        <img src={thumbSrc(asset.id, asset.thumbnailUrl)} alt="" loading="lazy" decoding="async" width="240" height="240" />
      ) : (
        <div class="placeholder" aria-hidden="true">
          {asset.format.toUpperCase()}
        </div>
      )
    }
    <h3>{asset.name}</h3>
    <p>
      <span class="badge">{asset.format.toUpperCase()}</span>
      <span class="badge badge-muted">{category}</span>
    </p>
  </article>
</a>

<style>
  a {
    text-decoration: none;
    color: inherit;
  }
  /* §9.4 tarjeta at platform density; hover = surface step (§10-04). */
  article {
    padding: var(--s3);
    height: 100%;
    transition: background 120ms var(--ciclo);
  }
  a:hover article,
  a:focus-visible article {
    background: var(--elevada);
  }
  img,
  .placeholder {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radio-control);
    background: var(--fondo);
  }
  .placeholder {
    display: grid;
    place-items: center;
    color: var(--texto-3);
    font-family: var(--mono);
    font-size: 1.2rem;
  }
  h3 {
    font-size: 0.95rem;
    margin: var(--s2) 0 var(--s1);
  }
  /* Format is measured data: Mono etiqueta, color informs (§4.2, §3.4). */
  .badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    padding: 0.1rem 0.45rem;
    border-radius: var(--radio-control);
    border: 1px solid color-mix(in srgb, currentColor 40%, transparent);
    /* --enlace, not --turquesa: the turquoise is an interactive FILL; as text
       on a Nocturno surface it reads 4.43:1. §3 keeps a mode-aware ink for
       colored text — verdemar at night, #016E7D on paper. */
    color: var(--enlace);
    margin-right: var(--s1);
  }
  /* Secondary, not tertiary: §19.4 allows terciario ONLY over the base
     background, and a card is a surface. */
  .badge-muted {
    color: var(--texto-2);
  }
</style>
