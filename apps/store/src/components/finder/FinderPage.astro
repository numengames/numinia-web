---
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FINDER_MESSAGES } from '../../i18n/messages';
import { loadFinderTree } from '../../lib/finder';
import { Finder } from './Finder';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = FINDER_MESSAGES[locale];
const tree = await loadFinderTree();
---

<BaseLayout locale={locale} title={`${t.finderTitle} — Numinia`} description={t.finderIntro}>
  <header>
    <h1>{t.finderTitle}</h1>
    <p>{t.finderIntro}</p>
  </header>
  <Finder client:load tree={tree} labels={t} />
</BaseLayout>

<style>
  header p {
    color: var(--texto-2);
  }
</style>

<style is:global>
  /* Island internals — global by necessity (Astro scoping stops at React). */
  [data-finder] .panes {
    display: grid;
    grid-template-columns: minmax(11rem, 1fr) minmax(14rem, 1.4fr) minmax(16rem, 2fr);
    gap: var(--s4);
    align-items: start;
  }
  @media (max-width: 50rem) {
    [data-finder] .panes {
      grid-template-columns: 1fr;
    }
  }
  [data-finder] ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Group labels: §4.3 etiqueta — Mono caps in amber (§13.11 sidebar). */
  [data-finder] h3 {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ambar);
    margin: var(--s3) 0 var(--s2);
  }
  /* §13.11 rows: 36px, secondary text; the active row is an ink pill. */
  [data-finder] button {
    font-family: inherit;
    font-size: 0.875rem;
    min-height: 36px;
    color: var(--texto-2);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radio-control);
    padding: 0.35rem 0.6rem;
    cursor: pointer;
    transition:
      background 120ms var(--ciclo),
      color 120ms var(--ciclo);
  }
  [data-finder] button:hover {
    color: var(--texto);
    background: var(--superficie);
  }
  [data-finder] button[aria-pressed='true'] {
    background: var(--texto);
    color: var(--fondo);
  }
  [data-finder-tree] li,
  [data-finder-files] li,
  [data-finder-queue] li {
    display: flex;
    gap: var(--numinia-space-1);
    margin-bottom: var(--numinia-space-1);
    align-items: center;
  }
  [data-finder-tree] button,
  [data-finder-files] button:first-child {
    flex: 1;
    display: flex;
    justify-content: space-between;
    gap: var(--numinia-space-1);
    text-align: left;
  }
  /* Formats and counts are measured: Mono (§4.2). */
  [data-finder-files] .format,
  [data-finder-tree] .count {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    color: var(--texto-3);
    font-size: 0.75rem;
  }
  [data-finder] button[aria-pressed='true'] .format,
  [data-finder] button[aria-pressed='true'] .count {
    color: var(--fondo);
  }
  /* §9.4 tarjeta. */
  [data-finder-preview] {
    background: var(--superficie);
    border: 1px solid var(--linea);
    border-radius: var(--radio-marco);
    padding: var(--s4);
  }
  [data-finder-preview] img,
  [data-finder-preview] video,
  [data-finder-preview] canvas {
    max-width: 100%;
    height: auto;
    border-radius: var(--radio-control);
  }
  [data-finder-preview] audio {
    width: 100%;
  }
  /* The download is the primary of the pane — ink (§13.11). */
  [data-finder-preview] a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    margin-top: var(--s3);
    padding: 10px var(--s5);
    border-radius: var(--radio-control);
    background: var(--texto);
    color: var(--fondo);
    text-decoration: none;
    transition: background 120ms var(--ciclo);
  }
  [data-finder-preview] a:hover {
    background: var(--texto-2);
  }
  [data-finder-queue] {
    margin-top: var(--s5);
    border-top: 1px solid var(--linea-f);
    padding-top: var(--s3);
  }
</style>
