---
import type { Asset, SupportedLocale } from '@numinia/domain';

interface Props {
  asset: Asset;
  locale: SupportedLocale;
}

const { asset, locale } = Astro.props;
const prefix = locale === 'en' ? '' : `/${locale}`;
---

<a href={`${prefix}/archive/${asset.id}/`} data-gallery-card data-metric="gallery-card">
  <article class="tarjeta">
    {
      asset.thumbnailUrl ? (
        <img src={asset.thumbnailUrl} alt="" loading="lazy" width="280" height="280" />
      ) : (
        <div class="placeholder" aria-hidden="true">
          VRM
        </div>
      )
    }
    <h3>{asset.name}</h3>
  </article>
</a>

<style>
  a {
    text-decoration: none;
    color: inherit;
  }
  /* §9.4 tarjeta at platform density; §10-04: hover elevates, never moves. */
  article {
    padding: var(--s3);
    height: 100%;
    transition: background 120ms var(--ciclo);
  }
  a:hover article,
  a:focus-visible article {
    background: var(--elevada);
  }
  img,
  .placeholder {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radio-control);
    background: var(--fondo);
  }
  .placeholder {
    display: grid;
    place-items: center;
    color: var(--texto-3);
    font-family: var(--mono);
    font-size: 1.2rem;
  }
  h3 {
    font-size: 0.95rem;
    margin: var(--numinia-space-2) 0 0;
    text-align: center;
  }
</style>
