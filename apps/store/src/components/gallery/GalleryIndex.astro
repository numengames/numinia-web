---
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryCard from './GalleryCard.astro';
import { GALLERY_MESSAGES } from '../../i18n/messages';
import { loadGallery } from '../../lib/gallery';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = GALLERY_MESSAGES[locale];
const collections = await loadGallery();
---

<BaseLayout locale={locale} title={`${t.galleryTitle} — Numinia`} description={t.galleryIntro}>
  <header>
    <h1>{t.galleryTitle}</h1>
    <p>{t.galleryIntro}</p>
  </header>

  {
    collections.length === 0 ? (
      <p data-gallery-empty>{t.emptyState}</p>
    ) : (
      collections.map((collection) => (
        <section aria-labelledby={`collection-${collection.id}`}>
          <h2 id={`collection-${collection.id}`}>{collection.id}</h2>
          <ul>
            {collection.avatars.map((asset) => (
              <li>
                <GalleryCard asset={asset} locale={locale} />
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
</BaseLayout>

<style>
  h1 {
    font-size: 2.488rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  header p {
    color: var(--texto-2);
    max-width: 65ch;
  }
  /* Collection names are labels: §4.3 etiqueta — Mono caps in amber. */
  h2 {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    margin: var(--s6) 0 var(--s3);
    color: var(--ambar);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  [data-gallery-empty] {
    color: var(--texto-2);
  }
  ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: var(--s4);
  }
</style>
