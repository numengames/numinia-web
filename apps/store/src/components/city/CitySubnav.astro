---
import type { SupportedLocale } from '@numinia/domain';
import { CITY_MESSAGES } from '../../i18n/city';

interface Props {
  locale: SupportedLocale;
  current: 'index' | 'inhabitants' | 'districts' | 'game';
}

const { locale, current } = Astro.props;
const t = CITY_MESSAGES[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;

const ITEMS = [
  { key: 'index', href: `${prefix}/city/`, label: t.cityTitle },
  { key: 'inhabitants', href: `${prefix}/city/inhabitants/`, label: t.inhabitantsTitle },
  { key: 'districts', href: `${prefix}/city/districts/`, label: t.districtsTitle },
  { key: 'game', href: `${prefix}/city/the-game/`, label: t.gameTitle },
] as const;
---

<nav aria-label={t.cityTitle} data-city-subnav>
  {
    ITEMS.map((item) => (
      <a
        href={item.href}
        aria-current={item.key === current ? 'page' : undefined}
        data-metric={`city-nav-${item.key}`}
      >
        {item.label}
      </a>
    ))
  }
</nav>

<style>
  /* §13.11 tabs: the active one underlines in 2px amber. */
  nav {
    display: flex;
    gap: var(--s4);
    flex-wrap: wrap;
    margin-bottom: var(--s5);
    border-bottom: 1px solid var(--linea-f);
  }
  a {
    color: var(--texto-2);
    text-decoration: none;
    font-size: 0.9rem;
    padding: var(--s2) 2px;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 120ms var(--ciclo);
  }
  a:hover,
  a:focus-visible {
    color: var(--texto);
  }
  a[aria-current='page'] {
    color: var(--texto);
    border-bottom-color: var(--ambar);
  }
</style>
