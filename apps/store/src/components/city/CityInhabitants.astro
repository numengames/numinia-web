---
import { FACTIONS, GUILDS, SPECIES, type SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CitySubnav from './CitySubnav.astro';
import { CITY_LANGUAGE_NOTICE, CITY_LORE, CITY_MESSAGES, loreLocale } from '../../i18n/city';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = CITY_MESSAGES[locale];
const lore = CITY_LORE[loreLocale(locale)];
const notice = CITY_LANGUAGE_NOTICE[locale];
---

<BaseLayout locale={locale} title={`${t.inhabitantsTitle} — Numinia`} description={t.cityIntro}>
  <CitySubnav locale={locale} current="inhabitants" />
  <article data-city="inhabitants">
    <h1>{t.inhabitantsTitle}</h1>
    {notice && <p class="language-notice">{notice}</p>}
    <p>{lore.inhabitantsIntro}</p>

    <h2>{t.speciesLabel}</h2>
    <ul class="cards">
      {
        SPECIES.map((species) => (
          <li>
            <h3>{species.name[locale]}</h3>
            <p class="tagline">
              {species.character[locale]} · {species.forceField[locale]}
            </p>
            <p>{species.description[locale]}</p>
          </li>
        ))
      }
    </ul>

    <h2>{t.guildsLabel}</h2>
    <ul class="cards">
      {
        GUILDS.map((guild) => (
          <li>
            <h3>{guild.name[locale]}</h3>
            <p>{guild.description[locale]}</p>
          </li>
        ))
      }
    </ul>

    <h2>{t.factionsLabel}</h2>
    <ul class="cards">
      {
        FACTIONS.map((faction) => (
          <li>
            <h3>{faction.name[locale]}</h3>
            <p>{faction.description[locale]}</p>
          </li>
        ))
      }
    </ul>

    <h2>{loreLocale(locale) === 'es' ? 'El sistema de roles' : 'The role system'}</h2>
    {lore.roleSystem.map((paragraph) => <p>{paragraph}</p>)}

    <h2>{loreLocale(locale) === 'es' ? 'Las agrupaciones' : 'The groupings'}</h2>
    <ul class="cards">
      {
        lore.groupings.map((group) => (
          <li>
            <h3>{group.name}</h3>
            <p>{group.body}</p>
          </li>
        ))
      }
    </ul>
  </article>
</BaseLayout>

<style>
  article {
    max-width: 52rem;
  }
  h1,
  h2 {
    color: var(--numinia-color-primary-strong);
  }
  h2 {
    font-size: 1.1rem;
    margin-top: var(--numinia-space-5);
  }
  p {
    line-height: 1.7;
  }
  .language-notice {
    color: var(--numinia-color-text-muted);
    font-size: 0.85rem;
  }
  .cards {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--numinia-space-2);
  }
  .cards li {
    background: var(--numinia-color-surface);
    border-radius: var(--numinia-radius-md);
    padding: var(--numinia-space-2) var(--numinia-space-3);
  }
  .cards h3 {
    margin: 0 0 var(--numinia-space-1);
    font-size: 0.95rem;
  }
  .cards p {
    font-size: 0.85rem;
    margin: 0.3rem 0;
  }
  .tagline {
    color: var(--numinia-color-text-muted);
  }
</style>
