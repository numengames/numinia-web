---
/**
 * Chapter threshold: the binaria speaks between chapters (§6.1), then the
 * chapter number in Mono etiqueta and its display title.
 */
interface Props {
  id: string;
  label: string;
  title: string;
}
const { id, label, title } = Astro.props;

/** §6.1 — the canonical phrase, copied from §19.3; sediment after. */
const BINARIA =
  '' +
  'x'.repeat(60);
---

<header id={id} class="capitulo">
  <p class="binaria" aria-hidden="true">{BINARIA}</p>
  <p class="etiqueta">{label}</p>
  <p class="titulo display-m">{title}</p>
</header>

<style>
  .capitulo {
    max-width: 60rem;
    margin: 0 auto;
    padding: var(--s9) var(--s4) var(--s6);
    text-align: center;
    scroll-margin-top: var(--s7);
  }
  .binaria {
    margin: 0 0 var(--s6);
  }
  .etiqueta {
    margin: 0 0 var(--s2);
  }
  .titulo {
    margin: 0;
    color: var(--texto);
  }
</style>
