---
/**
 * The city's threshold: typed tagline (§10-01, THE orchestrated moment),
 * circuit relief behind it in Nocturno (§6.2). No wordmark here — the site
 * header already carries it; the mark never competes with itself.
 */
import type { LandingContent } from '../../../i18n/city-landing';

interface Props {
  hero: LandingContent['hero'];
}
const { hero } = Astro.props;
---

<section class="hero" data-materia="relieve" data-escalonado>
  <h1 class="display-m" data-tecleo>{hero.tagline}</h1>
  <p class="intro cuerpo-l reveal">{hero.intro}</p>
  <div class="ctas reveal">
    <a href="#semilla" class="btn btn-primario" data-metric="city-hero-explore">
      {hero.ctaExplore}
    </a>
  </div>
  <p class="etiqueta reveal">{hero.presentedBy}</p>
</section>

<style>
  .hero {
    text-align: center;
    padding: var(--s9) var(--s5) var(--s7);
    border-bottom: 1px solid var(--linea);
  }
  h1 {
    color: var(--texto);
    margin: 0 auto var(--s4);
    max-width: 24ch;
  }
  .intro {
    max-width: 56ch;
    margin: 0 auto var(--s5);
    color: var(--texto-2);
  }
  .ctas {
    display: flex;
    justify-content: center;
    margin-bottom: var(--s6);
  }
  .ctas a {
    text-decoration: none;
  }
  .etiqueta {
    color: var(--texto-3);
  }
</style>
