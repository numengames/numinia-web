---
/**
 * /communities/ — every published community, with a search box and filters
 * by place. The list renders whole without JavaScript; the box and the
 * chips filter the cards already on the page (inline script, no fetch).
 *
 * v3 «La esfera y la casa»: Numen Games is not one more card. It leaves
 * the grid and sits at the head's top right, in its sphere — one dot per
 * community on the ring (lib/house-sphere.ts) — with a line and a door to
 * its own page; under 960 px the card lies down (sphere left, text right).
 */
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COMMUNITIES_UI, fill } from '../../i18n/communities';
import { HOUSE_UI } from '../../i18n/house';
import { PLACE_IDS, countForm, placeShort, searchText, type PlaceId } from '../../lib/communities';
import { communityActivity, ringChoice } from '../../lib/house-sphere';
import { COMMUNITIES, RITUALS } from './register';
import Icon from '../chrome/Icon.astro';
import CommunityCard from './CommunityCard.astro';
import Countdown from './Countdown.astro';
import HouseSphere from './HouseSphere.astro';
import '../../styles/communities.css';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const ui = COMMUNITIES_UI[locale];
const hui = HOUSE_UI[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;

// The house brings the others together: it is not one of them on this page.
const house = COMMUNITIES.find((community) => community.state === 'founder');
const others = COMMUNITIES.filter((community) => community !== house);
const ring = ringChoice(others, (community) => communityActivity(community, RITUALS));

const counts = new Map<PlaceId, number>();
for (const community of others) {
  for (const place of community.places) counts.set(place, (counts.get(place) ?? 0) + 1);
}
const places = PLACE_IDS.filter((place) => (counts.get(place) ?? 0) > 0);
const placesWithSomeone = places.filter((place) => place !== 'tba').length;
---

<BaseLayout locale={locale} title={`${ui.indexTitle} — Numinia`} description={ui.indexLead}>
  <div class="com-cab">
  <div class="cabeza com-cab-txt">
    <p class="migas"><a href={`${prefix}/`}>Numinia</a> / {ui.crumbCommunities}</p>
    <p class="etiqueta entrada">{ui.indexEyebrow}</p>
    <h1 class="display-m entrada-1">{ui.indexTitle}</h1>
    <p class="desc entrada-2">{ui.indexLead}</p>
  </div>
  {
    house && (
      <figure class="casa-card" data-house-figure>
        <div class="casa-visual">
          <HouseSphere locale={locale} dots={ring.shown} rest={ring.rest.length} restHref="#communities" />
        </div>
        <figcaption>
          <h2>
            <a href={`${prefix}/communities/${house.id}/`} data-metric="communities-house-title">
              {house.name}
            </a>
          </h2>
          <p class="sub">{hui.cardLine}</p>
          <p class="casa-txt">{hui.cardText}</p>
          <a class="casa-entra" href={`${prefix}/communities/${house.id}/`} data-metric="communities-house-enter">
            {hui.cardCta} <span aria-hidden="true">→</span>
          </a>
        </figcaption>
      </figure>
    )
  }
  <div class="com-cab-busca">
    <form class="busca entrada-3" role="search" action={`${prefix}/communities/`} method="get">
      <Icon name="magnifying-glass" size={20} />
      <input
        id="q"
        name="q"
        type="search"
        placeholder={ui.searchPlaceholder}
        aria-label={ui.searchLabel}
        autocomplete="off"
        data-metric="communities-search"
      />
    </form>
    <p class="small texto-2 cuenta">
      <span
        id="count"
        aria-live="polite"
        data-one-one={ui.countLine.oneOne}
        data-one-many={ui.countLine.oneMany}
        data-many-one={ui.countLine.manyOne}
        data-many-many={ui.countLine.manyMany}
        >{fill(countForm(ui.countLine, others.length, placesWithSomeone), {
          n: others.length,
          m: placesWithSomeone,
        })}</span
      >{house && <span>{hui.countHouse}</span>}
    </p>
  <div class="filtros" role="group" aria-label={ui.filterLabel} data-filters>
    <button type="button" class="chip" data-place="" aria-pressed="true" data-metric="communities-filter">
      {ui.filterAll} · {others.length}
    </button>
    {
      places.map((place) => (
        <button type="button" class="chip" data-place={place} aria-pressed="false" data-metric="communities-filter">
          {placeShort(place, locale)} · {counts.get(place)}
        </button>
      ))
    }
  </div>
  </div>
  </div>
  <div class="rejilla" id="communities">
    {
      others.map((community) => (
        <CommunityCard
          community={community}
          rituals={RITUALS}
          locale={locale}
          prefix={prefix}
          ui={ui}
          searchText={searchText(community, RITUALS, locale)}
        />
      ))
    }
  </div>
  <p class="vacio nada" id="none" hidden data-template={ui.noResults}>
    <Icon name="magnifying-glass" size={24} />
    <span><span data-none-text></span> <a href={`${prefix}/communities/`}>{ui.noResultsCta}</a></span>
  </p>

  <Countdown ui={ui} />
  <script is:inline>
    /* Search and filters over the cards on the page. The URL's ?q= seeds the
       box so a search can be shared; nothing is fetched. */
    (function () {
      var box = document.getElementById('q');
      var grid = document.getElementById('communities');
      var none = document.getElementById('none');
      var count = document.getElementById('count');
      if (!box || !grid || !none || !count) return;
      var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-search]'));
      var chips = Array.prototype.slice.call(document.querySelectorAll('[data-filters] [data-place]'));
      var place = '';
      function apply() {
        var q = box.value.trim().toLowerCase();
        var shown = 0;
        var places = {};
        cards.forEach(function (card) {
          var text = card.getAttribute('data-search') || '';
          var own = (card.getAttribute('data-places') || '').split(' ');
          var ok = (!q || text.indexOf(q) !== -1) && (!place || own.indexOf(place) !== -1);
          card.hidden = !ok;
          if (ok) {
            shown += 1;
            own.forEach(function (p) {
              if (p && p !== 'tba') places[p] = 1;
            });
          }
        });
        none.hidden = shown > 0;
        if (shown === 0) none.querySelector('[data-none-text]').textContent = none.getAttribute('data-template').replace('{q}', q);
        var found = Object.keys(places).length;
        /* Singular or plural for each of the two counts: «1 comunidad en 2 lugares». */
        var form =
          shown === 1
            ? found === 1 ? 'data-one-one' : 'data-one-many'
            : found === 1 ? 'data-many-one' : 'data-many-many';
        count.textContent = count.getAttribute(form).replace('{n}', shown).replace('{m}', found);
      }
      box.addEventListener('input', apply);
      box.form.addEventListener('submit', function (event) {
        event.preventDefault();
        apply();
      });
      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          place = chip.getAttribute('data-place') || '';
          chips.forEach(function (other) {
            other.setAttribute('aria-pressed', String(other === chip));
          });
          apply();
        });
      });
      var seed = new URLSearchParams(location.search).get('q');
      if (seed) {
        box.value = seed;
        apply();
      }
    })();
  </script>
</BaseLayout>

<style>
  .busca {
    position: relative;
    max-width: 560px;
  }
  .busca input {
    font: 1.05rem var(--sans);
    color: var(--texto);
    background: var(--superficie);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-control);
    padding: 12px 16px 12px 46px;
    width: 100%;
    transition: border-color 120ms var(--ciclo);
  }
  .busca input::placeholder {
    color: var(--texto-2);
  }
  .busca input:focus {
    border-color: var(--turquesa);
    outline: none;
  }
  .busca :global(.icono) {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--texto-2);
    pointer-events: none;
  }
  .cuenta {
    margin: var(--s3) 0;
  }
  /* The head: the words left, the house's sphere top right, the search under the words. */
  .com-cab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 420px);
    grid-template-areas: 'txt casa' 'busca casa';
    gap: var(--s4) var(--s7);
    align-items: end;
    margin-bottom: var(--s5);
  }
  .com-cab-txt {
    grid-area: txt;
    margin-bottom: 0;
  }
  .com-cab-busca {
    grid-area: busca;
    align-self: start;
    min-width: 0;
  }
  .casa-card {
    grid-area: casa;
    align-self: center;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s2);
    text-align: center;
    min-width: 0;
  }
  .casa-visual {
    width: 100%;
  }
  .casa-card h2 {
    margin: var(--s2) 0 0;
    font-size: 1.55rem;
    letter-spacing: -0.02em;
  }
  .casa-card h2 a {
    color: inherit;
    text-decoration: none;
  }
  .casa-card h2 a:hover {
    color: var(--enlace);
  }
  .sub {
    font: 500 0.7rem var(--mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ambar);
    margin: 4px 0 var(--s3);
  }
  .casa-txt {
    color: var(--texto-2);
    margin: 0 auto var(--s3);
    max-width: 34ch;
    font-size: 0.95rem;
  }
  .casa-entra {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    min-height: 24px;
    font-weight: 500;
    color: var(--enlace);
  }
  @media (max-width: 1180px) {
    .com-cab {
      grid-template-columns: minmax(0, 1fr) minmax(240px, 320px);
      gap: var(--s4) var(--s5);
    }
  }
  /* Under 960 px the house's card lies down: the small sphere left, its words right. */
  @media (max-width: 960px) {
    .com-cab {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'txt' 'casa' 'busca';
      align-items: start;
    }
    .casa-card {
      display: grid;
      grid-template-columns: 150px minmax(0, 1fr);
      align-items: center;
      gap: var(--s3);
      text-align: left;
      padding: var(--s3) var(--s4) var(--s3) var(--s2);
      border: 1px solid color-mix(in srgb, var(--ambar) 35%, transparent);
      border-radius: var(--radio-marco);
      background: color-mix(in srgb, var(--ambar) 5%, transparent);
    }
    .casa-card :global(.esfera-gira) {
      display: none;
    }
    .casa-card h2 {
      margin: 0;
      font-size: 1.25rem;
    }
    .casa-card .sub {
      margin: 2px 0 var(--s2);
    }
    .casa-txt {
      margin: 0 0 var(--s2);
      font-size: 0.9rem;
    }
  }
  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-bottom: 0;
  }
  /* On a phone the place chips are one row that slides, never four lines.
     The row is the positioned ancestor, so nothing inside escapes its
     scroll and widens the page. */
  @media (max-width: 767px) {
    .filtros {
      position: relative;
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 2px;
    }
    .filtros::-webkit-scrollbar {
      display: none;
    }
    .filtros .chip {
      flex: none;
      scroll-snap-align: start;
    }
  }
  /* Without JavaScript the chips could filter nothing. */
  :global(html:not([data-js='on'])) .filtros {
    display: none;
  }
  .nada {
    margin-top: var(--s4);
    justify-content: center;
  }
  #communities {
    margin-bottom: var(--s8);
  }
</style>
