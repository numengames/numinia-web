---
/**
 * /communities/ — every published community, with a search box and filters
 * by place. The list renders whole without JavaScript; the box and the
 * chips filter the cards already on the page (inline script, no fetch).
 */
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COMMUNITIES_UI, fill } from '../../i18n/communities';
import { PLACE_IDS, placeShort, searchText, type PlaceId } from '../../lib/communities';
import { COMMUNITIES, RITUALS } from './register';
import Icon from '../chrome/Icon.astro';
import CommunityCard from './CommunityCard.astro';
import Countdown from './Countdown.astro';
import '../../styles/communities.css';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const ui = COMMUNITIES_UI[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;

const counts = new Map<PlaceId, number>();
for (const community of COMMUNITIES) {
  for (const place of community.places) counts.set(place, (counts.get(place) ?? 0) + 1);
}
const places = PLACE_IDS.filter((place) => (counts.get(place) ?? 0) > 0);
const placesWithSomeone = places.filter((place) => place !== 'tba').length;
---

<BaseLayout locale={locale} title={`${ui.indexTitle} — Numinia`} description={ui.indexLead}>
  <p class="migas"><a href={`${prefix}/`}>Numinia</a> / {ui.crumbCommunities}</p>
  <div class="cabeza">
    <p class="etiqueta entrada">{ui.indexEyebrow}</p>
    <h1 class="display-m entrada-1">{ui.indexTitle}</h1>
    <p class="desc entrada-2">{ui.indexLead}</p>
    <form class="busca entrada-3" role="search" action={`${prefix}/communities/`} method="get">
      <Icon name="magnifying-glass" size={20} />
      <input
        id="q"
        name="q"
        type="search"
        placeholder={ui.searchPlaceholder}
        aria-label={ui.searchLabel}
        autocomplete="off"
        data-metric="communities-search"
      />
    </form>
    <p class="small texto-2 cuenta" id="count" aria-live="polite" data-template={ui.countLine}>
      {fill(ui.countLine, { n: COMMUNITIES.length, m: placesWithSomeone })}
    </p>
  </div>
  <div class="filtros" role="group" aria-label={ui.filterLabel} data-filters>
    <button type="button" class="chip" data-place="" aria-pressed="true" data-metric="communities-filter">
      {ui.filterAll} · {COMMUNITIES.length}
    </button>
    {
      places.map((place) => (
        <button type="button" class="chip" data-place={place} aria-pressed="false" data-metric="communities-filter">
          {placeShort(place, locale)} · {counts.get(place)}
        </button>
      ))
    }
  </div>
  <div class="rejilla" id="communities">
    {
      COMMUNITIES.map((community) => (
        <CommunityCard
          community={community}
          rituals={RITUALS}
          locale={locale}
          prefix={prefix}
          ui={ui}
          searchText={searchText(community, RITUALS, locale)}
        />
      ))
    }
  </div>
  <p class="vacio nada" id="none" hidden data-template={ui.noResults}>
    <Icon name="magnifying-glass" size={24} />
    <span><span data-none-text></span> <a href={`${prefix}/communities/`}>{ui.noResultsCta}</a></span>
  </p>

  <Countdown ui={ui} />
  <script is:inline>
    /* Search and filters over the cards on the page. The URL's ?q= seeds the
       box so a search can be shared; nothing is fetched. */
    (function () {
      var box = document.getElementById('q');
      var grid = document.getElementById('communities');
      var none = document.getElementById('none');
      var count = document.getElementById('count');
      if (!box || !grid || !none || !count) return;
      var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-search]'));
      var chips = Array.prototype.slice.call(document.querySelectorAll('[data-filters] [data-place]'));
      var place = '';
      function apply() {
        var q = box.value.trim().toLowerCase();
        var shown = 0;
        var places = {};
        cards.forEach(function (card) {
          var text = card.getAttribute('data-search') || '';
          var own = (card.getAttribute('data-places') || '').split(' ');
          var ok = (!q || text.indexOf(q) !== -1) && (!place || own.indexOf(place) !== -1);
          card.hidden = !ok;
          if (ok) {
            shown += 1;
            own.forEach(function (p) {
              if (p && p !== 'tba') places[p] = 1;
            });
          }
        });
        none.hidden = shown > 0;
        if (shown === 0) none.querySelector('[data-none-text]').textContent = none.getAttribute('data-template').replace('{q}', q);
        count.textContent = count.getAttribute('data-template').replace('{n}', shown).replace('{m}', Object.keys(places).length);
      }
      box.addEventListener('input', apply);
      box.form.addEventListener('submit', function (event) {
        event.preventDefault();
        apply();
      });
      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          place = chip.getAttribute('data-place') || '';
          chips.forEach(function (other) {
            other.setAttribute('aria-pressed', String(other === chip));
          });
          apply();
        });
      });
      var seed = new URLSearchParams(location.search).get('q');
      if (seed) {
        box.value = seed;
        apply();
      }
    })();
  </script>
</BaseLayout>

<style>
  .busca {
    position: relative;
    max-width: 560px;
  }
  .busca input {
    font: 1.05rem var(--sans);
    color: var(--texto);
    background: var(--superficie);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-control);
    padding: 12px 16px 12px 46px;
    width: 100%;
    transition: border-color 120ms var(--ciclo);
  }
  .busca input::placeholder {
    color: var(--texto-2);
  }
  .busca input:focus {
    border-color: var(--turquesa);
    outline: none;
  }
  .busca :global(.icono) {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--texto-2);
    pointer-events: none;
  }
  .cuenta {
    margin: 0;
  }
  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-bottom: var(--s5);
  }
  /* Without JavaScript the chips could filter nothing. */
  :global(html:not([data-js='on'])) .filtros {
    display: none;
  }
  .nada {
    margin-top: var(--s4);
    justify-content: center;
  }
  #communities {
    margin-bottom: var(--s8);
  }
</style>
