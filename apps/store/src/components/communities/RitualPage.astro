---
/**
 * A ritual's page — the world first (the app shell, v0.83.0, the Oracle
 * 2026-10-14): a wide stage with the home where the ritual happens; the call
 * is to enter it, and joining comes after. Only a real world gets «Enter the
 * world»: the city's own rituals open in the commons; every other community
 * has its home still to open, and the stage says so and offers the calendar.
 *
 * Below: the date line with its countdown, the mode, the title, who holds
 * it, the actions (the calendar file, share), then the facts, the programme
 * as read on the community's site, what happens after, and the side column
 * (the community, how to get there in person, the details).
 */
import { AGORA_PLAZA, type SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AGENDA_UI } from '../../i18n/agenda';
import { CREAR_ENCUENTRO_UI } from '../../i18n/crear-encuentro';
import { COMMUNITIES_UI, fill } from '../../i18n/communities';
import { localeHref, signInHref } from '../../lib/app-nav';
import {
  editHref,
  pick,
  pickList,
  placesLine,
  sedeDomain,
  spanDays,
  whenLong,
  worldOf,
  type Community,
  type Ritual,
} from '../../lib/communities';
import Icon from '../chrome/Icon.astro';
import Cover from './Cover.astro';
import Countdown from './Countdown.astro';
import InsideCount from './InsideCount.astro';
import RsvpAction from './RsvpAction.astro';
import '../../styles/communities.css';

/** «Crear → Un encuentro» (cut M): an encounter of the till — whether it is cancelled, and whether this visitor may cancel it. */
interface TillState {
  readonly cancelledAt: string | null;
  readonly mayCancel: boolean;
}

interface Props {
  locale: SupportedLocale;
  ritual: Ritual;
  community: Community;
  /** Present for an encounter published from the site; absent for a file of the register. */
  till?: TillState;
}

const { locale, ritual, community, till } = Astro.props;
const ui = COMMUNITIES_UI[locale];
const agenda = AGENDA_UI[locale];
const crear = CREAR_ENCUENTRO_UI[locale];
const cancelled = till?.cancelledAt != null;
// «Me apunto» signed out leads to the door and back here; «Tu agenda» is the page of what you said.
const signIn = signInHref(locale, `/rituals/${ritual.id}/`);
const agendaHref = localeHref(locale, '/agenda/');
const prefix = locale === 'en' ? '' : `/${locale}`;
const commons = { href: AGORA_PLAZA.worldUrl, name: AGORA_PLAZA.name[locale] };
const world = worldOf(community, commons, locale, ritual);
const homeName = ritual.city ? commons.name : fill(ui.homeOf, { x: community.name });
// Who is inside, only when the ritual opens on the community's own home of the fleet.
const counted =
  !ritual.city && community.sede !== undefined && sedeDomain(community.sede.href) !== null;
const days = spanDays(ritual);
const description = `${whenLong(ritual, locale)} · ${pick(ritual.where, locale)}`;
const icsHref = `/rituals/${ritual.id}.ics`;
const communityImage = community.image
  ? { src: community.image.src, alt: pick(community.image.alt, locale) }
  : undefined;
const inPerson = ritual.mode === 'in-person' || ritual.mode === 'mixed';
const sourceDate = ritual.source
  ? new Intl.DateTimeFormat(locale === 'es' ? 'es-ES' : 'en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(`${ritual.source.date}T00:00:00Z`))
  : '';
---

<BaseLayout
  locale={locale}
  title={`${pick(ritual.title, locale)} — ${community.name} — Numinia`}
  description={description}
>
  <p class="migas">
    <a href={`${prefix}/`}>Numinia</a> /{' '}
    <a href={`${prefix}/communities/${community.id}/`}>{community.name}</a> / {ui.rituals}
  </p>

  <section class:list={['mundo', { 'con-mundo': world, escena: !world }]} aria-label={ui.stageLabel}>
    {
      world ? (
        <img
          class="fondo"
          src="/images/art/city.webp"
          alt=""
          width="892"
          height="960"
          decoding="async"
          fetchpriority="high"
        />
      ) : (
        <>
          <div class="suelo" />
          <div class="faro" />
        </>
      )
    }
    <div class="entrar">
      {
        world ? (
          <>
            <h2>{homeName}</h2>
            <a
              class="btn btn-primario btn-grande"
              href={world.href}
              target="_blank"
              rel="noopener noreferrer"
              data-metric="ritual-enter-world"
            >
              <Icon name="play" size={20} />
              {ui.enterWorld}
            </a>
            <p>{ui.worldNote}</p>
            {counted && <p class="dentro" data-inside={community.id} />}
          </>
        ) : (
          <>
            <h2>{fill(ui.homeOfToOpen, { x: community.name })}</h2>
            <a class="btn btn-primario btn-grande" href={icsHref} data-metric="ritual-stage-calendar">
              <Icon name="calendar-plus" size={20} />
              {ui.toMyCalendar}
            </a>
          </>
        )
      }
    </div>
  </section>

  <div class="cabeza-rit">
    <div class="titulo">
      <div class="fila">
        <span class="etiqueta">
          {whenLong(ritual, locale)}
          <span class="falta" data-countdown={ritual.status === 'held' ? undefined : ritual.start}></span>
        </span>
        {ritual.mode && <span class="chip">{ui.modes[ritual.mode]}</span>}
        {ritual.city && <span class="chip ambar">{ui.ofTheCity}</span>}
        {ritual.status === 'held' && <span class="chip">{ui.heldChip}</span>}
        {cancelled && <span class="chip ambar" data-ritual-cancelled>{crear.cancelled}</span>}
      </div>
      <h1 class="display-m">{pick(ritual.title, locale)}</h1>
      {cancelled && <p class="desc" data-ritual-cancelled-lead>{crear.cancelledLead}</p>}
      <p class="van" data-rsvp-count={ritual.id} hidden></p>
      <p class="desc">
        {ritual.city ? ui.cityKeeps : ui.organisedBy}{' '}
        <a href={`${prefix}/communities/${community.id}/`} data-metric="ritual-community">{community.name}</a>.
        {ritual.note && <> {pick(ritual.note, locale)}</>}
      </p>
    </div>
    <div class="acciones-rit">
      {ritual.status !== 'held' && till === undefined && (
        <RsvpAction locale={locale} ritualId={ritual.id} signIn={signIn} metric="ritual-rsvp" />
      )}
      <a class="btn btn-fantasma" href={icsHref} data-metric="ritual-add-calendar">
        <Icon name="calendar-plus" size={18} />
        {agenda.addToCalendar}
      </a>
      <button
        type="button"
        class="btn btn-fantasma compartir"
        data-share
        data-metric="ritual-share"
        aria-label={ui.share}
        title={ui.share}
      >
        <Icon name="share-network" size={18} />
      </button>
      <span class="aviso-copia" data-share-note data-copied={ui.linkCopied} role="status"></span>
    </div>
  </div>
  {
    till?.mayCancel === true && !cancelled && (
      <div class="cancelar-rit" data-ritual-cancel-root data-ritual-id={ritual.id}>
        <button type="button" class="btn btn-fantasma btn-sm" data-ritual-cancel data-metric="ritual-cancel">
          {crear.cancel}
        </button>
        <dialog class="cancelar-dialogo" data-ritual-cancel-dialog aria-labelledby="cancelar-titulo">
          <form method="dialog">
            <h2 id="cancelar-titulo" class="titulo-s">{crear.cancelAsk}</h2>
            <p class="texto-2">{crear.cancelLead}</p>
            <p class="fallo" role="alert" data-ritual-cancel-problem hidden>{crear.failed}</p>
            <div class="acciones">
              <button type="button" class="btn btn-fantasma" data-ritual-cancel-keep data-metric="ritual-cancel-keep">
                {crear.cancelKeep}
              </button>
              <button type="button" class="btn btn-primario" data-ritual-cancel-confirm data-metric="ritual-cancel-confirm">
                {crear.cancelConfirm}
              </button>
            </div>
          </form>
        </dialog>
      </div>
    )
  }

  <div class="dos">
    <div class="pila">
      <section class="tarjeta">
        <div class="datos">
          <div class="dato">
            <span class="etiqueta corta"><Icon name="calendar-blank" size={14} />{ui.when}</span>
            <b>{whenLong(ritual, locale)}</b>
            <span class="small texto-2">
              {ritual.allDay ? (days > 1 ? fill(ui.wholeDays, { n: days }) : ui.wholeDay) : 'UTC'}
            </span>
          </div>
          <div class="dato">
            <span class="etiqueta corta"><Icon name="map-pin" size={14} />{ui.where}</span>
            <b>{pick(ritual.where, locale)}</b>
            <span class="small texto-2">{ritual.mode ? ui.modes[ritual.mode] : ui.howToAnnounce}</span>
          </div>
          <div class="dato">
            <span class="etiqueta corta"><Icon name="users" size={14} />{ui.whoCanGo}</span>
            <b>{ui.anyone}</b>
            <span class="small texto-2">{ui.openNote}</span>
          </div>
          <div class="dato">
            <span class="etiqueta corta"><Icon name="download-simple" size={14} />{ui.inYourCalendar}</span>
            <b><a href={icsHref} data-metric="ritual-ics">{ui.add}</a></b>
            <span class="small texto-2">{ui.addNote}</span>
          </div>
          <div class="dato" data-session-in hidden>
            <span class="etiqueta corta"><Icon name="check-circle" size={14} />{agenda.yourAgenda}</span>
            <b><a href={agendaHref} data-metric="ritual-your-agenda">{agenda.yourAgenda}</a></b>
            <span class="small texto-2">{agenda.lead}</span>
          </div>
        </div>
        {
          (ritual.mode === 'online' || ritual.mode === 'mixed') && ritual.status !== 'held' && !world && (
            <p class="small texto-2" style="margin: var(--s4) 0 0">{ui.onlineNote}</p>
          )
        }
      </section>
      {
        ritual.programme && (
          <section class="tarjeta">
            <h2 class="card-h2"><Icon name="clipboard-text" size={20} />{ui.programme}</h2>
            <ol class="agenda">
              {pickList(ritual.programme, locale).map((line) => (
                <li>{line}</li>
              ))}
            </ol>
            {ritual.source && (
              <p class="small texto-2" style="margin: var(--s4) 0 0">
                {fill(ui.readOn, { source: ritual.source.name, date: sourceDate })}
              </p>
            )}
          </section>
        )
      }
      {
        ritual.status !== 'held' && (
          <section class="tarjeta">
            <h2 class="card-h2"><Icon name="scroll" size={20} />{ui.after}</h2>
            <p class="texto-2" style="margin: 0">{ui.afterText}</p>
          </section>
        )
      }
    </div>
    <div class="pila">
      <a class="tarjeta mini-com" href={`${prefix}/communities/${community.id}/`} data-metric="ritual-community-card">
        <span class="mini-cover">
          <Cover id={community.id} name={community.name} image={communityImage} />
        </span>
        <span class="mini-texto">
          <b>{community.name}</b>
          <span class="small texto-2">{pick(community.kind, locale)} · {placesLine(community.places, locale)}</span>
        </span>
      </a>
      {
        inPerson && (
          <section class="tarjeta">
            <h2 class="card-h2"><Icon name="map-pin" size={20} />{ui.howToGetThere}</h2>
            <p class="texto-2" style="margin: 0">{pick(ritual.where, locale)}</p>
          </section>
        )
      }
      {till === undefined && (
      <section class="tarjeta" data-session-ranks="oracle" hidden>
        <h2 class="card-h2"><Icon name="github-logo" size={20} />{ui.editRitual}</h2>
        <p class="small texto-2" style="margin: 0 0 var(--s4)">{ui.editNote}</p>
        <a
          class="btn btn-fantasma btn-sm"
          href={editHref('ritual', ritual.id)}
          target="_blank"
          rel="noopener noreferrer"
          data-metric="ritual-edit"
        >
          <Icon name="arrow-square-out" size={16} />
          {ui.editOpen}
        </a>
      </section>
      )}
    </div>
  </div>

  <Countdown ui={ui} />
  {counted && <InsideCount ui={ui} />}
  <script>
    /* «Publicado…»: the toast the form asks for (`?publicado=1`, dropped from the address), said once. The
       cancel dialog: confirm, POST /api/ritual/cancel, then reload — the
       page says it is cancelled; Esc or «No» keeps it. */
    import { CREAR_ENCUENTRO_UI } from '../../i18n/crear-encuentro';
    const locale = document.documentElement.lang as keyof typeof CREAR_ENCUENTRO_UI;
    const words = CREAR_ENCUENTRO_UI[locale] ?? CREAR_ENCUENTRO_UI.en;
    const url = new URL(location.href);
    if (url.searchParams.get('publicado') === '1') {
      url.searchParams.delete('publicado');
      history.replaceState(null, '', url);
      const toast = document.createElement('p');
      toast.className = 'aviso';
      toast.dataset['tono'] = 'exito';
      toast.dataset['ritualToast'] = '';
      toast.setAttribute('role', 'status');
      toast.textContent = words.published;
      // Beside the right rail, not under it: the rail is fixed and the toast is too.
      const rail = document.querySelector('aside.rail-tu')?.getBoundingClientRect().width ?? 0;
      if (rail > 0) toast.style.right = `calc(${rail}px + var(--s5))`;
      document.body.append(toast);
      window.setTimeout(() => toast.remove(), 6000);
    }
    const root = document.querySelector<HTMLElement>('[data-ritual-cancel-root]');
    const dialog = root?.querySelector<HTMLDialogElement>('[data-ritual-cancel-dialog]');
    if (root && dialog) {
      const open = root.querySelector<HTMLButtonElement>('[data-ritual-cancel]');
      const problem = dialog.querySelector<HTMLElement>('[data-ritual-cancel-problem]');
      open?.addEventListener('click', () => dialog.showModal());
      dialog.querySelector('[data-ritual-cancel-keep]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('close', () => open?.focus());
      dialog.querySelector<HTMLButtonElement>('[data-ritual-cancel-confirm]')?.addEventListener('click', (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        button.disabled = true;
        void fetch('/api/ritual/cancel', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ritualId: root.dataset['ritualId'] }),
        })
          .then((response) => {
            if (response.ok) {
              location.reload();
              return;
            }
            if (problem) problem.hidden = false;
            button.disabled = false;
          })
          .catch(() => {
            if (problem) problem.hidden = false;
            button.disabled = false;
          });
      });
    }
  </script>
  <script is:inline>
    /* Share: the device's own sheet where there is one, else the address
       copied to the clipboard and said aloud. Without JavaScript the button
       hides (the address bar does the job). */
    document.querySelectorAll('[data-share]').forEach(function (button) {
      var note = document.querySelector('[data-share-note]');
      button.addEventListener('click', function () {
        var data = { title: document.title, url: location.href };
        if (navigator.share) {
          navigator.share(data).catch(function () {});
          return;
        }
        if (navigator.clipboard) {
          navigator.clipboard.writeText(location.href).then(function () {
            if (note) note.textContent = note.getAttribute('data-copied');
          }, function () {});
        }
      });
    });
  </script>
</BaseLayout>

<style>
  .migas {
    margin-top: 0;
    margin-bottom: var(--s3);
  }
  /* The stage: wide, about 21:9 where the column allows, never under 360 px
     high. On a phone the ratio would widen the box past the screen to keep
     both rules, so there the height alone holds. */
  .mundo {
    position: relative;
    min-height: 360px;
    border: 1px solid var(--linea);
    border-radius: var(--radio-marco);
    overflow: hidden;
    display: grid;
    place-items: center;
    background-color: var(--fondo);
  }
  @media (min-width: 56.25rem) {
    .mundo {
      aspect-ratio: 21 / 9;
    }
  }
  .mundo .fondo {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .con-mundo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      70% 70% at 50% 50%,
      color-mix(in srgb, var(--fondo) 78%, transparent),
      color-mix(in srgb, var(--fondo) 35%, transparent)
    );
  }
  .entrar {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s4);
    padding: var(--s6) var(--s5);
    text-align: center;
    max-width: 40rem;
  }
  .entrar h2 {
    margin: 0;
    font-size: clamp(1.6rem, 1.6vw + 1.2rem, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--texto);
  }
  .entrar p {
    margin: 0;
    color: var(--texto);
  }
  .entrar .dentro:empty {
    display: none;
  }
  .entrar .dentro:not([data-count='0']) {
    color: var(--enlace);
    font-weight: 500;
  }
  .btn-grande {
    min-height: 52px;
    padding: 12px var(--s6);
    font-size: 1.1rem;
  }
  .cabeza-rit {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s4) var(--s6);
    align-items: end;
    justify-content: space-between;
    padding: var(--s5) 0 var(--s6);
    border-bottom: 1px solid var(--linea);
    margin-bottom: var(--s5);
  }
  .titulo {
    display: grid;
    gap: var(--s3);
    min-width: 0;
    flex: 1 1 28rem;
  }
  .titulo h1 {
    margin: 0;
  }
  .titulo .etiqueta {
    margin: 0;
  }
  .titulo .desc {
    font-size: 1.1rem;
    color: var(--texto-2);
    max-width: 62ch;
    margin: 0;
  }
  .van {
    margin: 0;
    font-weight: 500;
    color: var(--enlace);
  }
  .falta:not(:empty)::before {
    content: ' · ';
  }
  .acciones-rit {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    align-items: center;
  }
  .compartir {
    padding-inline: var(--s3);
  }
  :global(html:not([data-js='on'])) .compartir {
    display: none;
  }
  .aviso-copia {
    font-size: 0.875rem;
    color: var(--texto-2);
  }
  .aviso-copia:empty {
    display: none;
  }
  .datos {
    display: grid;
    gap: var(--s4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    .datos {
      grid-template-columns: 1fr 1fr;
    }
  }
  .dato {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .dato .etiqueta {
    display: flex;
    gap: 6px;
    align-items: center;
    margin: 0 0 4px;
  }
  .dato b {
    font-weight: 500;
    font-size: 1.05rem;
  }
  .agenda {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .mini-com {
    flex-direction: row;
    align-items: center;
    gap: var(--s4);
    padding: var(--s3);
  }
  .mini-cover {
    flex: 0 0 96px;
    width: 96px;
    height: 54px;
    border-radius: var(--radio-control);
    overflow: hidden;
  }
  .mini-cover :global(.cover.card) {
    height: 100%;
    aspect-ratio: auto;
    border-bottom: 0;
  }
  .mini-cover :global(.monogram b) {
    font-size: 1.4rem;
  }
  .mini-texto {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .cancelar-rit {
    margin: var(--s3) 0 0;
  }
  .cancelar-dialogo {
    width: min(28rem, calc(100% - 2rem));
    padding: var(--s5);
    border: 1px solid var(--linea);
    border-radius: var(--radio-marco);
    background: var(--elevada);
    color: inherit;
  }
  .cancelar-dialogo::backdrop {
    background: rgba(20, 17, 15, 0.5);
  }
  .cancelar-dialogo h2,
  .cancelar-dialogo p {
    margin: 0 0 var(--s3);
  }
  .cancelar-dialogo .fallo {
    color: var(--ambar);
    font-size: 0.875rem;
  }
  .cancelar-dialogo .acciones {
    display: flex;
    justify-content: flex-end;
    gap: var(--s2);
  }
</style>
