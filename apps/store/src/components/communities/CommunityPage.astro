---
/**
 * A community's public page: its picture, what it is, where it is from,
 * its line, its links, the invitation to make the page its own, what its
 * space uses (each piece with its honest state), then its gatherings
 * (standing, upcoming, held), its archive, its home, its members and the
 * details. Empty states say what will be here and who fills it.
 */
import type { SupportedLocale } from '@numinia/domain';
import { AGORA_PLAZA } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COMMUNITIES_UI, fill } from '../../i18n/communities';
import { signInHref } from '../../lib/app-nav';
import {
  editHref,
  FOLLOWS_KEY,
  held,
  newRitualHref,
  pick,
  placesLine,
  ritualsOf,
  sedeDomain,
  upcoming,
  whenShort,
  worldOf,
  yearOf,
  type Community,
} from '../../lib/communities';
import { RITUALS } from './register';
import Icon from '../chrome/Icon.astro';
import Cover from './Cover.astro';
import RitualCard from './RitualCard.astro';
import Countdown from './Countdown.astro';
import InsideCount from './InsideCount.astro';
import PeopleList from './PeopleList.astro';
import SpaceUses from './SpaceUses.astro';
import ClaimStrip from './ClaimStrip.astro';
import '../../styles/communities.css';

interface Props {
  locale: SupportedLocale;
  community: Community;
}

const { locale, community } = Astro.props;
const ui = COMMUNITIES_UI[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;
const own = ritualsOf(community.id, RITUALS);
const coming = upcoming(own);
const past = held(own);
const image = community.image
  ? { src: community.image.src, alt: pick(community.image.alt, locale) }
  : undefined;
const isConference = pick(community.kind, 'en').startsWith('Conference');
const founder = community.state === 'founder';
const commons = { href: AGORA_PLAZA.worldUrl, name: AGORA_PLAZA.name[locale] };
const world = worldOf(community, commons, locale);
// Only a home of the fleet answers who is inside; elsewhere the slot is not drawn.
const counted = community.sede !== undefined && sedeDomain(community.sede.href) !== null;
// The new ritual's draft starts on the day the page was built; the Oracle sets the real one.
const today = new Date().toISOString().slice(0, 10);
const followWords = JSON.stringify({
  off: ui.follow,
  on: ui.following,
  followed: ui.followed,
  unfollowed: ui.unfollowed,
  failed: ui.followFailed,
  one: ui.followerOne,
  many: ui.followerMany,
});
---

<BaseLayout
  locale={locale}
  title={`${community.name} — Numinia`}
  description={pick(community.summary, locale)}
  wide
>
  <Cover id={community.id} name={community.name} image={image} variant="cover" eager art />
  <div class="columna">
    <p class="migas">
      <a href={`${prefix}/`}>Numinia</a> / <a href={`${prefix}/communities/`}>{ui.crumbCommunities}</a> / {community.name}
    </p>
    <div class="cabeza">
      <div class="fila">
        <span class="etiqueta">{pick(community.kind, locale)}</span>
        {founder && <span class="chip ambar">{ui.founder}</span>}
        {!founder && <span class="chip">{ui.openedByHouse}</span>}
        {community.operator && <span class="chip turquesa">{fill(ui.runBy, { x: community.operator })}</span>}
      </div>
      <h1 class="display-m">{community.name}</h1>
      <span class="lugar-linea"><Icon name="map-pin" size={16} />{placesLine(community.places, locale)}</span>
      <p class="desc">{pick(community.summary, locale)}</p>
      <div class="fila acciones-com">
        <button
          type="button"
          class="btn btn-primario seguir"
          data-follow={community.id}
          data-follow-words={followWords}
          data-follow-signin={signInHref(locale, `/communities/${community.id}/`)}
          aria-pressed="false"
          data-metric="community-follow"
        >
          <span class="si-no"><Icon name="plus" size={18} /></span>
          <span class="si-si"><Icon name="check" size={18} /></span>
          <span data-follow-label>{ui.follow}</span>
        </button>
        {
          community.links.length > 0 && (
            <div class="enlaces">
              {community.links.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer" data-metric="community-link">
                  {link.label}
                </a>
              ))}
            </div>
          )
        }
        <span class="small texto-2 siguen" data-follow-count={community.id} hidden></span>
      </div>
      {!founder && <ClaimStrip locale={locale} communityId={community.id} />}
    </div>

    <SpaceUses
      community={community}
      rituals={RITUALS}
      commons={commons}
      locale={locale}
      ui={ui}
      gatheringsAnchor="#encuentros"
    />

    <div class="dos">
      <div class="pila">
        <section class="tarjeta" id="encuentros">
          <div class="fila entre" style="margin-bottom: var(--s4)">
            <h2 class="card-h2" style="margin: 0"><Icon name="calendar-blank" size={20} />{ui.rituals}</h2>
            <a
              class="btn btn-fantasma btn-sm"
              href={`/communities/${community.id}/calendar.ics`}
              data-metric="community-subscribe"
            >
              <Icon name="download-simple" size={16} />
              {ui.subscribe}
            </a>
          </div>
          {
            community.weekly.length > 0 && (
              <>
                <p class="etiqueta corta">{ui.weekly}</p>
                <ul class="linea-lista">
                  {community.weekly.map((entry) => (
                    <li>
                      <span>{pick(entry.name, locale)}</span>
                      <span class="small texto-2">{pick(entry.when, locale)}</span>
                    </li>
                  ))}
                </ul>
                <p class="small texto-2" style="margin: var(--s2) 0 var(--s4)">
                  {ui.weeklyNote}
                </p>
              </>
            )
          }
          <p class="etiqueta corta">{ui.upcomingLabel}</p>
          {
            coming.length > 0 ? (
              <ul class="lista-rit">
                {coming.map((ritual) => (
                  <li>
                    <RitualCard ritual={ritual} community={community} locale={locale} prefix={prefix} ui={ui} />
                  </li>
                ))}
              </ul>
            ) : (
              <p class="vacio">
                <Icon name="hourglass" size={24} />
                <span>{isConference ? ui.noUpcomingConference : ui.noUpcoming}</span>
              </p>
            )
          }
          <p class="etiqueta corta" style="margin-top: var(--s5)">{ui.heldLabel}</p>
          {
            past.length > 0 ? (
              <ul class="linea-lista">
                {past.map((ritual) => (
                  <li>
                    <span>
                      <a href={`${prefix}/rituals/${ritual.id}/`} data-metric="community-held-ritual">
                        {pick(ritual.title, locale)}
                      </a>{' '}
                      <span class="texto-2 small">· {pick(ritual.where, locale)}</span>
                    </span>
                    <span class="small texto-2">
                      {whenShort(ritual, locale)} {yearOf(ritual)}
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="vacio">
                <Icon name="scroll" size={24} />
                <span>{founder ? ui.noHeldFounder : ui.noHeld}</span>
              </p>
            )
          }
        </section>

        <section class="tarjeta">
          <h2 class="card-h2"><Icon name="archive" size={20} />{ui.archive}</h2>
          {
            community.archive ? (
              <p class="texto-2" style="margin: 0">{pick(community.archive, locale)}</p>
            ) : (
              <p class="vacio">
                <Icon name="file-text" size={24} />
                <span>{ui.archiveEmpty}</span>
              </p>
            )
          }
        </section>
      </div>

      <div class="pila">
        <section class="tarjeta">
          <h2 class="card-h2"><Icon name="house" size={20} />{ui.home}</h2>
          {
            world ? (
              <>
                <div class="sede con-mundo">
                  <img src="/images/art/city.webp" alt="" loading="lazy" decoding="async" width="892" height="960" />
                </div>
                <div class="fila entre sede-pie">
                  <div>
                    <b>{world.name}</b>
                    {counted && <p class="dentro small" data-inside={community.id} />}
                  </div>
                  <a
                    class="btn btn-primario btn-sm"
                    href={world.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-metric="community-enter-world"
                  >
                    <Icon name="play" size={16} />
                    {ui.enter}
                  </a>
                </div>
                {founder && <p class="texto-2 small" style="margin: var(--s3) 0 0">{ui.homeFounderNote}</p>}
              </>
            ) : (
              <>
                <div class="sede escena" aria-hidden="true">
                  <div class="suelo" />
                  <div class="faro" />
                </div>
                <p class="texto-2 small" style="margin: var(--s3) 0 0">
                  <span class="chip ambar" style="margin-right: 6px">
                    {community.homeInProgress ? ui.homeInProgress : ui.homeToOpen}
                  </span>
                  {community.homeInProgress ? ui.homeInProgressText : ui.homeToOpenLine}
                </p>
              </>
            )
          }
        </section>

        <section class="tarjeta">
          <h2 class="card-h2"><Icon name="users" size={20} />{ui.members}</h2>
          {
            community.people ? (
              <p class="texto-2" style="margin: 0">{pick(community.people, locale)}</p>
            ) : (
              <p class="vacio">
                <Icon name="user" size={24} />
                <span>{ui.membersEmpty}</span>
              </p>
            )
          }
          {community.team !== undefined && <PeopleList ui={ui} community={community.id} />}
          <p class="small texto-2" style="margin: var(--s3) 0 0">{ui.membersNote}</p>
        </section>

        <section class="tarjeta">
          <h2 class="card-h2"><Icon name="gear" size={20} />{ui.details}</h2>
          <dl class="kv">
            <div><dt>{ui.whoSees}</dt><dd>{ui.everyone}</dd></div>
            <div><dt>{ui.howToEnter}</dt><dd>{founder ? ui.byInvitation : ui.decidedByCommunity}</dd></div>
            <div><dt>{ui.district}</dt><dd>{ui.toChoose}</dd></div>
          </dl>
        </section>

        <section class="tarjeta oraculo" data-session-ranks="oracle" hidden>
          <h2 class="card-h2"><Icon name="github-logo" size={20} />{ui.editLabel}</h2>
          <p class="small texto-2" style="margin: 0 0 var(--s4)">{ui.editNote}</p>
          <div class="fila acciones-com">
            <a
              class="btn btn-fantasma btn-sm"
              href={editHref('community', community.id)}
              target="_blank"
              rel="noopener noreferrer"
              data-metric="community-edit"
            >
              <Icon name="arrow-square-out" size={16} />
              {ui.editOpen}
            </a>
            <a
              class="btn btn-fantasma btn-sm"
              href={newRitualHref(community.id, today)}
              target="_blank"
              rel="noopener noreferrer"
              data-metric="community-add-ritual"
            >
              <Icon name="plus" size={16} />
              {ui.addRitual}
            </a>
          </div>
        </section>
      </div>
    </div>
  </div>

  <Countdown ui={ui} />
  {counted && <InsideCount ui={ui} />}
  <script is:inline data-follows-key={FOLLOWS_KEY}>
    /* «Follow» for real (cut «Seguir»): the toggle writes to the till through
       /api/follow, so «Sigues» means the city remembers it, from any browser.
       Signed out the button is the door to sign in, coming back here — never
       a «Sigues» that followed nobody. Who is here is the chrome's one answer,
       published on `html[data-session]` after load; once it says «in» the
       page asks /api/follow for this community (am I following, how many do).

       The list this browser used to keep (`numinia-follows`, a JSON array of
       ids) is carried over once: each id is POSTed, and the key is cleared
       only when every one of them went through — a till down leaves it for
       next time. The key stays declared in lib/consent.ts and the cookie
       notice until this carry-over code goes.

       Without JavaScript the button hides: there is nowhere to act. */
    (function () {
      var key = document.currentScript.getAttribute('data-follows-key');
      var button = document.querySelector('button[data-follow]');
      if (!button) return;
      var id = button.getAttribute('data-follow');
      var words = JSON.parse(button.getAttribute('data-follow-words'));
      var door = button.getAttribute('data-follow-signin');
      var label = button.querySelector('[data-follow-label]');
      var counter = document.querySelector('[data-follow-count="' + id + '"]');
      var toast = null;
      var hide = 0;

      function signedIn() {
        return document.documentElement.getAttribute('data-session') === 'in';
      }
      function say(text, tone) {
        if (!toast) {
          toast = document.createElement('p');
          toast.className = 'aviso';
          toast.setAttribute('role', 'status');
          document.body.appendChild(toast);
        }
        toast.setAttribute('data-tono', tone);
        toast.textContent = text;
        toast.hidden = false;
        clearTimeout(hide);
        hide = setTimeout(function () {
          toast.hidden = true;
        }, 4000);
      }
      function paint(view) {
        var on = view.mine.indexOf(id) >= 0;
        button.setAttribute('aria-pressed', String(on));
        button.classList.toggle('btn-primario', !on);
        button.classList.toggle('btn-fantasma', on);
        label.textContent = on ? words.on : words.off;
        var n = view.counts[id];
        var some = typeof n === 'number' && n > 0;
        if (counter) {
          counter.hidden = !some;
          counter.textContent = some ? (n === 1 ? words.one : words.many.replace('{n}', String(n))) : '';
        }
      }
      function read(response) {
        return response.ok ? response.json() : Promise.resolve(null);
      }
      function post(communityId, on) {
        return fetch('/api/follow', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({ communityId: communityId, on: on }),
        }).then(read);
      }
      /* The ids this browser kept before the till knew: each POSTed once. */
      function stored() {
        try {
          var list = JSON.parse(localStorage.getItem(key) || '[]');
          return Array.isArray(list)
            ? list.filter(function (entry) {
                return typeof entry === 'string';
              })
            : [];
        } catch (e) {
          return [];
        }
      }
      function carryOver() {
        var ids = stored();
        if (ids.length === 0) return Promise.resolve();
        return ids
          .reduce(function (chain, communityId) {
            return chain.then(function (allOk) {
              return post(communityId, true)
                .then(function (view) {
                  return allOk && view !== null;
                })
                .catch(function () {
                  return false;
                });
            });
          }, Promise.resolve(true))
          .then(function (allOk) {
            if (allOk) {
              try {
                localStorage.removeItem(key);
              } catch (e) {}
            }
          });
      }
      function load() {
        carryOver()
          .then(function () {
            return fetch('/api/follow?ids=' + id, { headers: { accept: 'application/json' } });
          })
          .then(read)
          .then(function (view) {
            if (view) paint(view);
          })
          .catch(function () {});
      }
      if (signedIn()) load();
      else {
        /* The chrome answers who is here after load: ask once it says «in». */
        var watcher = new MutationObserver(function () {
          if (!signedIn()) return;
          watcher.disconnect();
          load();
        });
        watcher.observe(document.documentElement, { attributes: true, attributeFilter: ['data-session'] });
      }
      button.addEventListener('click', function () {
        if (!signedIn()) {
          window.location.href = door;
          return;
        }
        var on = button.getAttribute('aria-pressed') !== 'true';
        button.disabled = true;
        post(id, on)
          .then(function (view) {
            if (!view) {
              say(words.failed, 'aviso');
              return;
            }
            paint(view);
            say(on ? words.followed : words.unfollowed, 'exito');
          })
          .catch(function () {
            say(words.failed, 'aviso');
          })
          .then(function () {
            button.disabled = false;
          });
      });
    })();
  </script>
</BaseLayout>

<style>
  /* The page is wide for its cover; the text keeps the reading column. */
  :global(main[data-wide]) {
    padding: 0 0 var(--s7);
  }
  .columna {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--s5);
  }
  .lista-rit {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s3);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    .lista-rit {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* A card never widens its column (it pushed the page sideways on phones). */
  .lista-rit > * {
    min-width: 0;
  }
  .sede {
    position: relative;
    height: 170px;
    border-radius: var(--radio-control);
    overflow: hidden;
    border: 1px solid var(--linea);
  }
  .sede img {
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sede-pie {
    margin-top: var(--s3);
  }
  .dentro {
    margin: 2px 0 0;
    color: var(--texto-2);
  }
  .dentro:empty {
    display: none;
  }
  .dentro:not([data-count='0']) {
    color: var(--enlace);
  }
  .acciones-com {
    gap: var(--s3);
  }
  /* «N personas la siguen»: a quiet figure beside the links, only when somebody does. */
  .siguen {
    margin: 0;
  }
  .siguen[hidden] {
    display: none;
  }
  /* The follow button shows the state you are in: + to follow, ✓ when you do. */
  .seguir .si-no,
  .seguir .si-si {
    display: inline-flex;
    align-items: center;
  }
  .seguir .si-si,
  .seguir[aria-pressed='true'] .si-no {
    display: none;
  }
  .seguir[aria-pressed='true'] .si-si {
    display: inline-flex;
  }
  /* Without JavaScript there is nowhere to keep the choice: no button. */
  :global(html:not([data-js='on'])) .seguir {
    display: none;
  }
</style>
