---
/**
 * «Cómo funciona» (/how-it-works/, the app shell v0.83.0): what the front
 * door used to explain and the old /city/ page told at length, in one page —
 * what Numinia is in a line, four steps each with its door, the six
 * templates a community can open its home from (and how to ask for one),
 * and why a city, in three lines of its canon with the way to the Archive.
 * No price block: there is no public tariff yet. The steps, the templates
 * and the questions were the front door's visitor face (v0.86.0); since v3
 * the front page is «Ahora» and they live here.
 */
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HOW_IT_WORKS } from '../../i18n/how-it-works';
import { FRONT_DOOR } from '../../i18n/front-door';
import Icon from '../chrome/Icon.astro';
import HowSteps from './HowSteps.astro';
import HowTemplates from './HowTemplates.astro';
import '../../styles/communities.css';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = HOW_IT_WORKS[locale];
const door = FRONT_DOOR[locale];
---

<BaseLayout locale={locale} title={t.title} description={t.description}>
  <header class="titulo-vista">
    <p class="etiqueta entrada">{t.eyebrow}</p>
    <h1 class="display-m entrada-1">{t.heading}</h1>
    <p class="lead entrada-2">{t.lead}</p>
  </header>

  <HowSteps locale={locale} heading="h2" metric="how-step" />

  <section class="bloque" id="open">
    <div class="cabecera-bloque">
      <div>
        <p class="etiqueta">{t.openEyebrow}</p>
        <h2 class="titulo-m">{t.openTitle}</h2>
        <p class="ayuda">{t.openHelp}</p>
      </div>
      <a class="btn btn-primario" href="mailto:hola@numengames.com" data-metric="how-write">
        <Icon name="house" size={18} />
        {t.write}
      </a>
    </div>
    <HowTemplates locale={locale} />
  </section>

  <section class="bloque" id="why">
    <div class="cabecera-bloque">
      <div>
        <p class="etiqueta">{t.whyEyebrow}</p>
        <h2 class="titulo-m">{t.whyTitle}</h2>
      </div>
    </div>
    <div class="historia">
      <div class="relato">
        {t.storyNotice && <p class="aviso-idioma small">{t.storyNotice}</p>}
        {t.story.map((line) => <p>{line}</p>)}
        <a href="https://numinia.org" target="_blank" rel="noopener noreferrer" data-metric="how-archive">
          {t.readArchive}
          <Icon name="arrow-square-out" size={16} />
        </a>
      </div>
      <img
        src="/images/art/genesis.webp"
        alt={t.storyImageAlt}
        width="887"
        height="960"
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>

  {/* The front door's questions (v0.86.0) moved here with v3: the front page is «Ahora». */}
  <section class="bloque" id="faq">
    <p class="etiqueta">{door.faqEyebrow}</p>
    <h2 class="titulo-m">{door.faqTitle}</h2>
    <div class="preguntas">
      {
        door.faq.map((entry) => (
          <details>
            <summary data-metric="how-faq">{entry.q}</summary>
            <p>{entry.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .preguntas {
    max-width: 760px;
    margin-top: var(--s5);
  }
  .preguntas details {
    border-bottom: 1px solid var(--linea);
    padding: var(--s3) 0;
  }
  .preguntas summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 1.05rem;
    min-height: 32px;
  }
  .preguntas p {
    color: var(--texto-2);
    margin: var(--s2) 0 0;
  }
  .historia {
    display: grid;
    gap: var(--s6);
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 56.25rem) {
    .historia {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }
  .historia > * {
    min-width: 0;
  }
  .relato p {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--texto-2);
    max-width: 62ch;
    margin: 0 0 var(--s4);
  }
  .relato .aviso-idioma {
    font-size: 0.875rem;
    border-left: 2px solid var(--enlace);
    padding-left: var(--s3);
  }
  .relato a {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }
  .historia img {
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radio-marco);
    border: 1px solid var(--linea);
  }
</style>
