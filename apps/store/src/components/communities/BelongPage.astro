---
/**
 * «Perteneces» (/belong/, the app shell v0.83.0): your communities and what
 * happens in them. «Sigues» lists the communities your account follows —
 * the till keeps them (cut «Seguir», GET /api/follow), and the little each
 * card needs is embedded here as JSON at build, so the page only asks for
 * the ids once a session is in; each card has a quiet «Dejar de seguir».
 * «Perteneces a»: membership does not exist yet — signed out, a door to sign
 * in; signed in (the page's one session read, `data-session-in/out`), one
 * plain sentence that it will appear here.
 */
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COMMUNITIES_UI, fill } from '../../i18n/communities';
import { signInHref } from '../../lib/app-nav';
import { FOLLOWS_KEY, followEntries } from '../../lib/communities';
import { COMMUNITIES, RITUALS } from './register';
import Icon from '../chrome/Icon.astro';
import Countdown from './Countdown.astro';
import '../../styles/communities.css';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const ui = COMMUNITIES_UI[locale];
const prefix = locale === 'en' ? '' : `/${locale}`;
const entries = followEntries(COMMUNITIES, RITUALS, locale, prefix);
---

<BaseLayout locale={locale} title={`${ui.belongTitle} — Numinia`} description={ui.belongLead}>
  <header class="titulo-vista">
    <h1 class="display-m">{ui.belongTitle}</h1>
    <p class="lead">{ui.belongLead}</p>
  </header>

  <section class="bloque" id="follows">
    <div class="cabecera-bloque">
      <div>
        <h2 class="titulo-m">{ui.followsTitle}</h2>
        <p class="ayuda">{ui.followsHelp}</p>
      </div>
    </div>
    <ul class="seguidas" data-follows-list hidden></ul>
    <p class="vacio" data-follows-empty>
      <Icon name="users-three" size={24} />
      <span>{ui.followsEmpty}</span>
    </p>
    <template data-follow-card>
      <li class="tarjeta seguida">
        <h3><a data-name data-metric="belong-community"></a></h3>
        <p class="small texto-2" data-line></p>
        <p class="proximo" data-next>
          <span class="etiqueta corta">{ui.nextRitual}</span>
          <a data-next-title data-metric="belong-ritual"></a>
          <span class="small texto-2"><span data-next-when></span><span class="falta" data-countdown></span></span>
        </p>
        <p class="small texto-2" data-none>{ui.toAnnounce}</p>
        <p class="dejar">
          <button type="button" class="btn btn-fantasma btn-sm" data-unfollow data-metric="belong-unfollow">
            {ui.unfollow}
          </button>
        </p>
      </li>
    </template>
    <script
      is:inline
      type="application/json"
      data-follows-data
      set:html={JSON.stringify(entries).replace(/</g, '\\u003c')}
    />
  </section>

  <section class="bloque" id="member">
    <div class="cabecera-bloque">
      <div>
        <h2 class="titulo-m">{ui.memberOfTitle}</h2>
      </div>
    </div>
    <div class="vacio puerta" data-session-out>
      <Icon name="users-three" size={24} />
      <span>{ui.memberDoor}</span>
      <a class="btn btn-primario btn-sm" href={signInHref(locale, '/belong/')} data-metric="belong-sign-in">
        <Icon name="sign-in" size={16} />
        {ui.signIn}
      </a>
    </div>
    <p class="vacio" data-session-in hidden>
      <Icon name="hourglass" size={24} />
      <span>{ui.memberSoon}</span>
    </p>
    <p class="explorar">
      <a href={`${prefix}/communities/`} data-metric="belong-explore">
        {fill(ui.exploreAll, { n: COMMUNITIES.length })}
      </a>
    </p>
  </section>

  <script is:inline data-follows-key={FOLLOWS_KEY} data-follow-words={JSON.stringify({ unfollowed: ui.unfollowed, failed: ui.followFailed })}>
    /* «Sigues»: the ids the till keeps for your account (GET /api/follow once
       the chrome says the session is in), drawn from the entries embedded at
       build (text only, never markup). «Dejar de seguir» POSTs the change and
       takes the card away. The list this browser used to keep
       (`numinia-follows`) is carried over once, as the community page does:
       each id POSTed, the key cleared only when every one went through. */
    (function () {
      var script = document.currentScript;
      var key = script.getAttribute('data-follows-key');
      var words = JSON.parse(script.getAttribute('data-follow-words'));
      var data = document.querySelector('[data-follows-data]');
      var entries = data ? JSON.parse(data.textContent || '[]') : [];
      var list = document.querySelector('[data-follows-list]');
      var empty = document.querySelector('[data-follows-empty]');
      var template = document.querySelector('[data-follow-card]');
      var toast = null;
      var hide = 0;

      function signedIn() {
        return document.documentElement.getAttribute('data-session') === 'in';
      }
      function say(text, tone) {
        if (!toast) {
          toast = document.createElement('p');
          toast.className = 'aviso';
          toast.setAttribute('role', 'status');
          document.body.appendChild(toast);
        }
        toast.setAttribute('data-tono', tone);
        toast.textContent = text;
        toast.hidden = false;
        clearTimeout(hide);
        hide = setTimeout(function () {
          toast.hidden = true;
        }, 4000);
      }
      function read(response) {
        return response.ok ? response.json() : Promise.resolve(null);
      }
      function post(communityId, on) {
        return fetch('/api/follow', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({ communityId: communityId, on: on }),
        }).then(read);
      }
      function stored() {
        try {
          var kept = JSON.parse(localStorage.getItem(key) || '[]');
          return Array.isArray(kept)
            ? kept.filter(function (entry) {
                return typeof entry === 'string';
              })
            : [];
        } catch (e) {
          return [];
        }
      }
      function carryOver() {
        var ids = stored();
        if (ids.length === 0) return Promise.resolve();
        return ids
          .reduce(function (chain, communityId) {
            return chain.then(function (allOk) {
              return post(communityId, true)
                .then(function (view) {
                  return allOk && view !== null;
                })
                .catch(function () {
                  return false;
                });
            });
          }, Promise.resolve(true))
          .then(function (allOk) {
            if (allOk) {
              try {
                localStorage.removeItem(key);
              } catch (e) {}
            }
          });
      }
      /* The rail's «Tus comunidades» figure, one less when a card goes. */
      function countDown() {
        document.querySelectorAll('[data-you-count="communities"]').forEach(function (figure) {
          var n = parseInt(figure.textContent || '0', 10) - 1;
          figure.hidden = !(n > 0);
          figure.textContent = n > 0 ? String(n) : '';
        });
      }
      function card(entry) {
        var item = template.content.firstElementChild.cloneNode(true);
        var name = item.querySelector('[data-name]');
        name.textContent = entry.name;
        name.setAttribute('href', entry.href);
        item.querySelector('[data-line]').textContent = entry.line;
        if (entry.next) {
          var title = item.querySelector('[data-next-title]');
          title.textContent = entry.next.title;
          title.setAttribute('href', entry.next.href);
          item.querySelector('[data-next-when]').textContent = entry.next.when;
          item.querySelector('[data-countdown]').setAttribute('data-countdown', entry.next.start);
          item.querySelector('[data-none]').remove();
        } else {
          item.querySelector('[data-next]').remove();
        }
        var button = item.querySelector('[data-unfollow]');
        button.setAttribute('data-unfollow', entry.id);
        button.setAttribute('aria-label', button.textContent.trim() + ': ' + entry.name);
        button.addEventListener('click', function () {
          button.disabled = true;
          post(entry.id, false)
            .then(function (view) {
              if (!view) {
                say(words.failed, 'aviso');
                button.disabled = false;
                return;
              }
              item.remove();
              countDown();
              if (!list.children.length) {
                list.hidden = true;
                empty.hidden = false;
              }
              say(words.unfollowed, 'exito');
            })
            .catch(function () {
              say(words.failed, 'aviso');
              button.disabled = false;
            });
        });
        return item;
      }
      function paint(ids) {
        var shown = entries.filter(function (entry) {
          return ids.indexOf(entry.id) >= 0;
        });
        if (!list || !template || shown.length === 0) return;
        shown.forEach(function (entry) {
          list.appendChild(card(entry));
        });
        list.hidden = false;
        empty.hidden = true;
      }
      function load() {
        carryOver()
          .then(function () {
            return fetch('/api/follow', { headers: { accept: 'application/json' } });
          })
          .then(read)
          .then(function (view) {
            if (view && Array.isArray(view.mine)) paint(view.mine);
            document.dispatchEvent(new CustomEvent('numinia:you-counts'));
          })
          .catch(function () {});
      }
      if (signedIn()) load();
      else {
        var watcher = new MutationObserver(function () {
          if (!signedIn()) return;
          watcher.disconnect();
          load();
        });
        watcher.observe(document.documentElement, { attributes: true, attributeFilter: ['data-session'] });
      }
    })();
  </script>
  <Countdown ui={ui} />
</BaseLayout>

<style>
  .seguidas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s4);
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
  }
  .seguidas > * {
    min-width: 0;
  }
  .seguida {
    gap: var(--s2);
  }
  .seguida h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
  }
  .seguida h3 a {
    color: inherit;
    text-decoration: none;
  }
  .seguida h3 a:hover,
  .seguida h3 a:focus-visible {
    color: var(--enlace);
  }
  .seguida p {
    margin: 0;
  }
  .proximo {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-top: 1px solid var(--linea);
    padding-top: var(--s3);
    margin-top: auto !important;
  }
  .proximo .etiqueta {
    margin: 0;
  }
  .falta:not(:empty)::before {
    content: ' · ';
  }
  /* «Dejar de seguir»: quiet, at the foot of the card. */
  .dejar {
    margin-top: var(--s2) !important;
  }
  .puerta {
    flex-wrap: wrap;
  }
  .puerta span {
    flex: 1 1 16rem;
  }
  .explorar {
    margin: var(--s4) 0 0;
  }
  [hidden] {
    display: none !important;
  }
</style>
