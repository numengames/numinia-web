---
/**
 * The picture at the head of a community, a ritual or a world: its own
 * picture when the data names one; otherwise the house's generated scene
 * (CoverArt, drawn from the id, so nothing ever shows a blank or plain-gradient
 * card) with the monogram over it. A gathering's scene is also told apart by
 * its mode (in person / online / mixed). Never a third party's photo (rights,
 * and the budget): the scene is inline and weighs nothing.
 */
import { monogram, type RitualMode } from '../../lib/communities';
import type { CoverFamily } from '../../lib/cover-art';
import CoverArt from './CoverArt.astro';

interface Props {
  id: string;
  name: string;
  image?: { readonly src: string; readonly alt: string } | undefined;
  /** card: 16/9 in a card; cover: the wide band at the head of a page. */
  variant?: 'card' | 'cover';
  /** The first picture above the fold loads eagerly; the rest wait. */
  eager?: boolean;
  /** A gathering without a picture: its mode is part of the scene's seed. */
  ritualMode?: RitualMode | undefined;
  /** A world draws a planet or a landscape; a community or gathering, a landscape. */
  family?: CoverFamily;
}

const { id, name, image, variant = 'card', eager = false, ritualMode, family = 'place' } = Astro.props;

const seed = ritualMode ? `${id}:${ritualMode}` : id;
const loading = eager ? 'eager' : 'lazy';
---

<div class:list={['cover', variant === 'cover' ? 'band' : 'card']}>
  {
    image ? (
      <img src={image.src} alt={image.alt} loading={loading} decoding="async" />
    ) : (
      <div class="monogram" aria-hidden="true">
        <CoverArt id={seed} family={family} />
        <b>{monogram(name)}</b>
      </div>
    )
  }
</div>

<style>
  .cover {
    background: var(--elevada);
    overflow: hidden;
    border-bottom: 1px solid var(--linea);
  }
  .cover.card {
    aspect-ratio: 16 / 9;
  }
  /* The page band. Its own class: `.cover.cover` matched every cover, so
     the cards were 280 px tall and their monogram 4rem. */
  .cover.band {
    height: 280px;
  }
  @media (min-width: 56.25rem) {
    .cover.band {
      height: 360px;
    }
  }
  .cover img {
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .monogram {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: radial-gradient(120% 100% at 30% 0%, var(--elevada), var(--fondo));
    overflow: hidden;
  }
  .monogram b {
    position: relative;
    font-weight: 300;
    font-size: 2.4rem;
    letter-spacing: -0.04em;
    color: var(--arena);
    text-shadow: 0 1px 14px color-mix(in srgb, var(--fondo) 70%, transparent);
  }
  :global([data-modo='diurno']) .monogram b {
    color: var(--texto);
    text-shadow: none;
  }
  .cover.band .monogram b {
    font-size: 4rem;
  }
</style>
