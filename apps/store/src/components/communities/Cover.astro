---
/**
 * The picture at the head of a community or a ritual: a house illustration
 * when the file names one; otherwise a monogram over a dimmed illustration
 * chosen by the id (or, for a ritual, by its mode — in person / online /
 * mixed — so an encounter without a picture still reads as its own kind of
 * gathering, not a blank card). Never a third party's photo (rights, and
 * the budget): the fill images are the house's own, not final per-type art.
 */
import { monogram, type RitualMode } from '../../lib/communities';

interface Props {
  id: string;
  name: string;
  image?: { readonly src: string; readonly alt: string } | undefined;
  /** card: 16/9 in a card; cover: the wide band at the head of a page. */
  variant?: 'card' | 'cover';
  /** The first picture above the fold loads eagerly; the rest wait. */
  eager?: boolean;
  /** Without a picture: the dimmed illustration behind the monogram (page
   *  covers and the featured card), or the plain gradient (the cards, so
   *  the front door stays within its image budget). */
  art?: boolean;
  /** An encounter without a picture: pick the dimmed illustration by its
   *  mode instead of the id's hash, so the fill matches the gathering. */
  ritualMode?: RitualMode | undefined;
}

const { id, name, image, variant = 'card', eager = false, art = false, ritualMode } = Astro.props;

/** The house illustrations a community without a picture borrows, dimmed. */
const ART = ['/images/art/genesis.webp', '/images/art/builder.webp', '/images/art/play.webp', '/images/art/city.webp', '/images/art/interpret.webp', '/images/art/citizens.webp'];
/** Fill by event mode (mechanism only — the real per-mode art is Pablo's call). */
const RITUAL_ART: Record<RitualMode, string> = {
  'in-person': '/images/art/city.webp',
  online: '/images/art/interpret.webp',
  mixed: '/images/art/builder.webp',
};
const hash = [...id].reduce((sum, char) => sum + char.charCodeAt(0), 0);
const fillSrc = ritualMode ? RITUAL_ART[ritualMode] : ART[hash % ART.length];
const loading = eager ? 'eager' : 'lazy';
---

<div class:list={['cover', variant === 'cover' ? 'band' : 'card']}>
  {
    image ? (
      <img src={image.src} alt={image.alt} loading={loading} decoding="async" />
    ) : (
      <div class="monogram" aria-hidden="true">
        {art && <img src={fillSrc} alt="" loading={loading} decoding="async" />}
        <b>{monogram(name)}</b>
      </div>
    )
  }
</div>

<style>
  .cover {
    background: var(--elevada);
    overflow: hidden;
    border-bottom: 1px solid var(--linea);
  }
  .cover.card {
    aspect-ratio: 16 / 9;
  }
  /* The page band. Its own class: `.cover.cover` matched every cover, so
     the cards were 280 px tall and their monogram 4rem. */
  .cover.band {
    height: 280px;
  }
  @media (min-width: 56.25rem) {
    .cover.band {
      height: 360px;
    }
  }
  .cover img {
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .monogram {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: radial-gradient(120% 100% at 30% 0%, var(--elevada), var(--fondo));
    overflow: hidden;
  }
  .monogram img {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    filter: saturate(0.5);
  }
  .monogram b {
    position: relative;
    font-weight: 300;
    font-size: 2.4rem;
    letter-spacing: -0.04em;
    color: color-mix(in srgb, var(--enlace) 70%, transparent);
  }
  .cover.band .monogram b {
    font-size: 4rem;
  }
</style>
