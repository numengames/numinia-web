---
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { INSPECTOR_MESSAGES } from '../../i18n/messages';
import { Inspector } from './Inspector';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = INSPECTOR_MESSAGES[locale];
---

<BaseLayout locale={locale} title={`${t.inspectorTitle} — Numinia`} description={t.inspectorIntro}>
  <header>
    <h1>{t.inspectorTitle}</h1>
    <p>{t.inspectorIntro}</p>
    <p class="privacy">{t.privacyNote}</p>
  </header>
  <Inspector client:load labels={t} />
</BaseLayout>

<style>
  header p {
    color: var(--texto-2);
  }
  .privacy {
    font-size: 0.85rem;
  }
</style>

<style is:global>
  [data-inspector] .dropzone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s2);
    padding: var(--s7);
    border: 2px dashed var(--linea-f);
    border-radius: var(--radio-marco);
    cursor: pointer;
    text-align: center;
  }
  [data-inspector] .dropzone:focus-within {
    border-color: var(--turquesa);
  }
  [data-inspector] .dropzone input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  [data-inspector] .pick {
    color: var(--enlace);
    text-decoration: underline;
  }
  /* §9.7: what happened + what to do, critical edge in grana. */
  [data-inspector] [role='alert'] {
    background: var(--superficie);
    border: 1px solid var(--linea);
    border-left: 2px solid var(--grana);
    color: var(--texto);
    padding: var(--s3) var(--s4);
    border-radius: var(--radio-marco);
  }
  [data-inspector] .result {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 1fr);
    gap: var(--s4);
    margin-top: var(--s4);
    align-items: start;
  }
  @media (max-width: 50rem) {
    [data-inspector] .result {
      grid-template-columns: 1fr;
    }
  }
  [data-inspector] canvas {
    max-width: 100%;
    height: auto;
    background: var(--superficie);
    border-radius: var(--radio-marco);
  }
  /* §9.4 tarjeta; stats are probes. */
  [data-inspector-stats] {
    background: var(--superficie);
    border: 1px solid var(--linea);
    border-radius: var(--radio-marco);
    padding: var(--s4);
  }
  [data-inspector-stats] h3 {
    margin-top: 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ambar);
  }
  [data-inspector-stats] dl {
    margin: 0;
  }
  [data-inspector-stats] .row {
    display: flex;
    justify-content: space-between;
    gap: var(--s3);
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--linea);
  }
  [data-inspector-stats] dt {
    color: var(--texto-2);
  }
  /* Measurements read in Mono tabular (§4.2, §13.11). */
  [data-inspector-stats] dd {
    margin: 0;
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
    text-align: right;
  }
</style>
