---
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { INSPECTOR_MESSAGES } from '../../i18n/messages';
import { Inspector } from './Inspector';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = INSPECTOR_MESSAGES[locale];
---

<BaseLayout locale={locale} title={`${t.inspectorTitle} — Numinia`}>
  <header>
    <h1>{t.inspectorTitle}</h1>
    <p>{t.inspectorIntro}</p>
    <p class="privacy">{t.privacyNote}</p>
  </header>
  <Inspector client:load labels={t} />
</BaseLayout>

<style>
  header p {
    color: var(--numinia-color-text-muted);
  }
  .privacy {
    font-size: 0.85rem;
  }
</style>

<style is:global>
  [data-inspector] .dropzone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--numinia-space-1);
    padding: var(--numinia-space-5);
    border: 2px dashed var(--numinia-color-text-muted);
    border-radius: var(--numinia-radius-md);
    cursor: pointer;
    text-align: center;
  }
  [data-inspector] .dropzone:focus-within {
    border-color: var(--numinia-color-primary-strong);
  }
  [data-inspector] .dropzone input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  [data-inspector] .pick {
    color: var(--numinia-color-primary-strong);
    text-decoration: underline;
  }
  [data-inspector] [role='alert'] {
    background: var(--numinia-color-danger, #d33440);
    color: #ffffff;
    padding: var(--numinia-space-2);
    border-radius: var(--numinia-radius-sm);
  }
  [data-inspector] .result {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 1fr);
    gap: var(--numinia-space-3);
    margin-top: var(--numinia-space-3);
    align-items: start;
  }
  @media (max-width: 50rem) {
    [data-inspector] .result {
      grid-template-columns: 1fr;
    }
  }
  [data-inspector] canvas {
    max-width: 100%;
    height: auto;
    background: var(--numinia-color-surface);
    border-radius: var(--numinia-radius-md);
  }
  [data-inspector-stats] {
    background: var(--numinia-color-surface);
    border-radius: var(--numinia-radius-md);
    padding: var(--numinia-space-3);
  }
  [data-inspector-stats] h3 {
    margin-top: 0;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--numinia-color-text-muted);
  }
  [data-inspector-stats] dl {
    margin: 0;
  }
  [data-inspector-stats] .row {
    display: flex;
    justify-content: space-between;
    gap: var(--numinia-space-2);
    padding: 0.25rem 0;
    border-bottom: 1px solid var(--numinia-color-background);
  }
  [data-inspector-stats] dt {
    color: var(--numinia-color-text-muted);
  }
  [data-inspector-stats] dd {
    margin: 0;
    overflow-wrap: anywhere;
    text-align: right;
  }
</style>
