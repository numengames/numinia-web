---
/**
 * «Saldo» (cut v0.87.0): your account and your organizations' — balance
 * that never expires, top-ups through Stripe in a new tab, usage, movements
 * and members — modelled on the Nous portal's billing (Pablo's brief,
 * 2026-10-14). Three faces of one page: `saldo` (the panel), `vuelta`
 * (where Stripe sends the buyer back) and `referidos` (coming soon). The
 * page is static; every figure comes from /api/saldo, which reads the
 * session and asks the till — nothing is made up here.
 */
import type { SupportedLocale } from '@numinia/domain';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SALDO_UI } from '../../i18n/saldo';
import { localeHref, signInHref } from '../../lib/app-nav';
import { SaldoPanel } from './SaldoPanel';
import { SaldoVuelta } from './SaldoVuelta';

interface Props {
  locale: SupportedLocale;
  face: 'saldo' | 'vuelta' | 'referidos';
}

const { locale, face } = Astro.props;
const ui = SALDO_UI[locale];
const saldoHref = localeHref(locale, '/saldo/');
const referralsHref = localeHref(locale, '/saldo/referidos/');
const title =
  face === 'referidos' ? ui.referrals.title : face === 'vuelta' ? ui.vuelta.title : ui.title;
---

<BaseLayout locale={locale} title={`${title} — Numinia`} description={ui.lead}>
  <header class="titulo-vista saldo-titulo">
    <h1 class="display-m">{title}</h1>
    {face === 'saldo' && <p class="lead">{ui.lead}</p>}
  </header>

  {
    face !== 'vuelta' && (
      <nav class="saldo-pestanas" aria-label={ui.tabs.label}>
        <a href={saldoHref} aria-current={face === 'saldo' ? 'page' : undefined}>
          {ui.tabs.saldo}
        </a>
        <a href={referralsHref} aria-current={face === 'referidos' ? 'page' : undefined}>
          {ui.tabs.referrals}
        </a>
      </nav>
    )
  }

  {
    face === 'saldo' && (
      <SaldoPanel
        client:load
        ui={ui}
        lang={locale}
        locale={locale}
        signIn={signInHref(locale, '/saldo/')}
      />
    )
  }
  {face === 'vuelta' && <SaldoVuelta client:load ui={ui} lang={locale} saldoHref={saldoHref} />}
  {
    face === 'referidos' && (
      <div class="saldo-marco saldo-pronto" data-saldo-referrals>
        <p class="etiqueta">{ui.referrals.soon}</p>
        <p class="saldo-nota">{ui.referrals.text}</p>
      </div>
    )
  }
</BaseLayout>

<style is:global>
  /* «Saldo»: house classes (.btn, .etiqueta, .mono, .titulo-vista) are used,
     never redefined; everything of its own is prefixed saldo-. Secondary text
     on cards is --texto-2 (--texto-3 on --superficie fails AA). */
  .saldo-titulo {
    margin-bottom: var(--s4);
  }
  .saldo-pestanas {
    display: flex;
    gap: var(--s5);
    border-bottom: 1px solid var(--linea-f);
    margin-bottom: var(--s6);
  }
  .saldo-pestanas a {
    padding: var(--s2) 0;
    color: var(--texto-2);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .saldo-pestanas a:hover {
    color: var(--enlace);
  }
  .saldo-pestanas a[aria-current='page'] {
    color: var(--texto);
    border-bottom-color: var(--ambar);
  }
  .saldo-panel {
    display: flex;
    flex-direction: column;
    gap: var(--s6);
    min-width: 0;
    max-width: 960px;
  }
  .saldo-panel > *,
  .saldo-cifras > * {
    min-width: 0;
  }
  .saldo-marco {
    background: var(--superficie);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-marco);
    padding: var(--s5);
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    min-width: 0;
  }
  .saldo-marco h2 {
    margin: 0;
    font-size: 1.44rem;
    font-weight: 400;
  }
  .saldo-marco p {
    margin: 0;
  }
  .saldo-nota {
    color: var(--texto-2);
    line-height: 1.5;
  }
  .saldo-mal {
    color: var(--coral);
  }
  [data-modo='diurno'] .saldo-mal {
    color: var(--grana);
  }
  .saldo-estado {
    display: flex;
    align-items: center;
    gap: var(--s3);
    color: var(--texto-2);
  }
  .saldo-cuentas {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--s4);
  }
  .saldo-elige {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    min-width: min(320px, 100%);
  }
  .saldo-panel select,
  .saldo-panel input {
    font: inherit;
    color: var(--texto);
    background: var(--elevada);
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-control);
    padding: var(--s2) var(--s3);
    min-width: 0;
  }
  .saldo-cifras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: var(--s4);
  }
  .saldo-cifra {
    font-size: 2.488rem;
    letter-spacing: -0.02em;
  }
  .saldo-cifra-m {
    font-size: 1.728rem;
  }
  .saldo-bajo {
    color: var(--ambar);
  }
  [data-modo='diurno'] .saldo-bajo {
    color: var(--texto);
  }
  .saldo-seccion {
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    min-width: 0;
  }
  .saldo-seccion > h2,
  .saldo-cabeza h2 {
    margin: 0;
  }
  .saldo-cabeza {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s3);
  }
  .saldo-importes,
  .saldo-rangos,
  .saldo-botones,
  .saldo-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }
  .saldo-importe,
  .saldo-rangos button {
    font: inherit;
    color: var(--texto);
    background: transparent;
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-control);
    padding: var(--s2) var(--s4);
    cursor: pointer;
  }
  .saldo-importe {
    font-family: var(--mono);
    font-size: 1.2rem;
    min-width: 7rem;
  }
  .saldo-importe:hover,
  .saldo-rangos button:hover {
    border-color: var(--enlace);
  }
  .saldo-importe[aria-pressed='true'],
  .saldo-rangos button[aria-pressed='true'] {
    border-color: var(--ambar);
    background: var(--elevada);
  }
  .saldo-hecho {
    color: var(--texto-2);
  }
  .saldo-grafica {
    margin: 0;
  }
  .saldo-grafica svg {
    width: 100%;
    height: 160px;
    display: block;
  }
  .saldo-grafica rect {
    fill: var(--turquesa);
  }
  .saldo-grafica .eje {
    stroke: var(--linea-f);
  }
  .saldo-ejes {
    display: flex;
    justify-content: space-between;
    color: var(--texto-2);
    font-size: 0.75rem;
    margin-top: var(--s2);
  }
  .saldo-tabla {
    overflow-x: auto;
    border: 1px solid var(--linea-f);
    border-radius: var(--radio-marco);
    background: var(--superficie);
  }
  .saldo-tabla table {
    width: 100%;
    border-collapse: collapse;
  }
  .saldo-tabla th,
  .saldo-tabla td {
    text-align: left;
    padding: var(--s2) var(--s3);
    border-bottom: 1px solid var(--linea-f);
    vertical-align: top;
  }
  .saldo-tabla th {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--texto-2);
    font-weight: 400;
  }
  .saldo-tabla tr:last-child td {
    border-bottom: 0;
  }
  .saldo-tabla .num {
    text-align: right;
    white-space: nowrap;
  }
  .saldo-fecha {
    white-space: nowrap;
    color: var(--texto-2);
  }
  .saldo-detalle {
    display: block;
    color: var(--texto-2);
    font-size: 0.875rem;
  }
  .saldo-tu {
    color: var(--texto-2);
  }
  .saldo-linea-form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s2);
  }
  .saldo-linea-form input {
    flex: 1 1 18rem;
  }
  .saldo-linea-form .saldo-mal {
    flex-basis: 100%;
    margin: 0;
  }
  .saldo-panel .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  /* A phone: the movements wrap instead of pushing the amount out of sight. */
  @media (max-width: 600px) {
    .saldo-marco {
      padding: var(--s4);
    }
    .saldo-tabla th,
    .saldo-tabla td {
      padding: var(--s2);
    }
    .saldo-fecha {
      white-space: normal;
    }
  }
  .saldo-vuelta,
  .saldo-pronto,
  .saldo-fuera {
    max-width: 640px;
  }
</style>
