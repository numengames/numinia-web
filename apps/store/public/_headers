# Workers static assets cache policy (MISSION-018). Hashed /_astro/* is
# already immutable by default; these cover the named statics.
/thumbs/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Security walls (MISSION-025) for the static layer — SSR gets the same set
# from src/middleware.ts. Later rules override same-named headers, so the
# session pages relax CSP after the global rule.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https:; font-src 'self'; connect-src 'self' https:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
