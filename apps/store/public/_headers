# Workers static assets cache policy (MISSION-018). Hashed /_astro/* is
# already immutable by default; these cover the named statics.
/thumbs/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Security walls (MISSION-025, hardened 2026-10-18) for the static layer —
# SSR gets the same set from src/middleware.ts (CSP_STRICT / CSP_SESSION).
# Rules do NOT override each other: every matching rule ADDS its header, and the
# browser enforces all the Content-Security-Policy headers it gets at once, so the
# strictest wins (the global one shut the worlds room off from the fleet machines,
# 2026-10-18). The session pages therefore detach the global CSP (`!`) first and
# then set their relaxed one.
# script-src keeps 'unsafe-inline': a hash list never matches, because the
# Cloudflare build wraps every island bootstrap in its own shim
# (`globalThis.process??={}`) that a Node-built hash never sees, and one
# missed hash blocks the sign-in. connect-src drops the open https: because
# every chain/CDN binary goes through the same-origin /api/media proxy.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' https:; font-src 'self'; connect-src 'self' blob:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
/lap/session/*
