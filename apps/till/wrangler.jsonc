{
  // The till (ADR-070, MIS-177, MIS-178): its own Worker and its own D1
  // database, apart from numinia.com. No routes and no secrets: it runs the
  // nightly close, GET /health answers only in local runs, and its one door
  // is the Oracle desk (MIS-184), the RPC entrypoint `OracleDesk` that only
  // numinia.com's service binding reaches.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "numinia-till",
  "main": "src/worker.ts",
  // The same date as the site's Worker (root wrangler.jsonc).
  "compatibility_date": "2026-08-15",
  "send_metrics": false,
  // Reachable from nowhere over HTTP: no workers.dev address and no preview
  // address. The till holds the money: its entry points are its cron and the
  // Oracle desk, which answers no HTTP request; an accounts API is MIS-179.
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs, as the site's Worker: each nightly close and any error it
  // throws are visible in the dashboard (the till writes no console lines).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "d1_databases": [
    {
      "binding": "TILL_DB",
      "database_name": "numinia-till",
      // Created by an Oracle in the Cloudflare panel on 2026-10-13. Pending
      // migrations are applied by `npm run deploy` (package.json) before each
      // deploy.
      "database_id": "309e7829-6361-40c0-9cde-3d1a601b8e44",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    // Cron is UTC, the till's reference time (ADR-070): at 00:30 UTC every
    // night the run closes the UTC day that has just ended.
    "crons": ["30 0 * * *"],
  },
  "vars": {
    // `none`: no meter, every day pending. `fake`: fixtures/meter.json.
    "TILL_METER": "none",
  },
}
