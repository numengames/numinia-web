{
  // The till (ADR-070, MIS-177, MIS-178): its own Worker and its own D1
  // database, apart from numinia.com. No routes: it runs the nightly close
  // and the minute's poll of Stripe's events, GET /health answers only in
  // local runs, and its doors are two RPC entrypoints that only numinia.com's
  // service bindings reach — the Oracle desk (`OracleDesk`, MIS-184) and the
  // account desk (`AccountDesk`, cut «Saldo», MIS-179, MIS-180).
  //
  // One secret, set in the Cloudflare panel or with `wrangler secret put
  // STRIPE_KEY`, never here: a Stripe restricted key (TEST mode in this cut)
  // with Checkout Sessions write and Events read. Without it the desk answers
  // `payments are not configured` and the minute's run does nothing.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "numinia-till",
  "main": "src/worker.ts",
  // The same date as the site's Worker (root wrangler.jsonc).
  "compatibility_date": "2026-08-15",
  "send_metrics": false,
  // Reachable from nowhere over HTTP: no workers.dev address and no preview
  // address. The till holds the money: its entry points are its crons and
  // its two desks, which answer no HTTP request. It reaches OUT to
  // api.stripe.com; nothing of Stripe's reaches in (no webhook route).
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs, as the site's Worker: each nightly close and any error it
  // throws are visible in the dashboard (the till writes no console lines).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "d1_databases": [
    {
      "binding": "TILL_DB",
      "database_name": "numinia-till",
      // Created by an Oracle in the Cloudflare panel on 2026-10-13. Pending
      // migrations are applied by `npm run deploy` (package.json) before each
      // deploy.
      "database_id": "309e7829-6361-40c0-9cde-3d1a601b8e44",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    // Cron is UTC, the till's reference time (ADR-070): at 00:30 UTC every
    // night the run closes the UTC day that has just ended. Every minute the
    // till reads Stripe's events of paid Checkout Sessions and credits each
    // top-up once (src/worker.ts dispatches by `controller.cron`).
    "crons": ["30 0 * * *", "* * * * *"],
  },
  "vars": {
    // `none`: no meter, every day pending. `fake`: fixtures/meter.json.
    "TILL_METER": "none",
    // The Stripe price of each quick top-up, as JSON
    // `{"10":"price_…","50":"price_…","100":"price_…"}`: one-time euro prices
    // of the Stripe account's TEST mode, created by an Oracle. Unset, or with
    // any of the three missing, the desk answers `payments are not configured`.
    // TEST mode prices of the product «Numinia Credit» (prod_VRQHf5afpKeLaw),
    // tax included, created by Pablo on 2026-10-14. Not secrets: price ids.
    "TILL_TOPUP_PRICES": "{\"10\":\"price_1UQXR9LTAyyB34WXNB1xSY57\",\"50\":\"price_1UQXTSLTAyyB34WXidqWNwNq\",\"100\":\"price_1UQXTSLTAyyB34WX2VwKhVzt\"}",
  },
}
