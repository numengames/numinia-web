{
  "name": "numinia-platform",
  "version": "0.27.0",
  "private": true,
  "description": "Numinia Platform monorepo — the material culture of the city-state, rebuilt. Continues the numinia.store version line (legacy ended at 0.15.0).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "ci": "turbo run type-check lint test build",
    "test:acceptance": "cucumber-js",
    "prepare": "node scripts/install-hooks.mjs",
    "licenses:check": "license-checker-rseidelsohn --excludePrivatePackages --failOn 'GPL-1.0;GPL-2.0;GPL-3.0;GPL-2.0-only;GPL-2.0-or-later;GPL-3.0-only;GPL-3.0-or-later;AGPL-1.0;AGPL-3.0;AGPL-3.0-only;AGPL-3.0-or-later;SSPL-1.0'",
    "e2e": "npm --workspace @numinia/store run e2e",
    "verify": "npm run ci && npm run test:acceptance && npm run licenses:check && npm run budget && npm run links && npm run e2e",
    "deadcode": "knip",
    "test:mutation": "npm --workspace @numinia/domain run test:mutation && npm --workspace @numinia/analytics run test:mutation",
    "budget": "node scripts/bundle-budget.mjs",
    "links": "node scripts/link-check.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^9.39.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "eslint": "^9.39.2",
    "knip": "^6.32.2",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.8.1",
    "secretlint": "^13.0.4",
    "turbo": "^2.6.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "overrides": {
    "axios": "^1.19.0",
    "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
    "ws@>=8.0.0 <8.21.0": "8.21.0"
  }
}
