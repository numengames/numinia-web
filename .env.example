# Numinia Platform — environment variables
# Validated with Zod at boot (packages/domain/src/validators/env.ts).
# Missing REQUIRED vars crash the server before it binds — never silent runtime failure.

# --- Data source (REQUIRED) ---
GITHUB_REPO_OWNER=PabloFMM
GITHUB_REPO_NAME=numinia-digital-goods-data
GITHUB_BRANCH=main

# GitHub token — OPTIONAL in Phase 0 (public raw reads need no auth).
# Required later for write paths. Fine-grained, data repo only, Contents: Read.
GITHUB_TOKEN=

# --- Public ---
PUBLIC_SITE_URL=http://localhost:4321

# --- World pass («Entrar», secret) ---
# Ed25519 private key (PKCS8, base64) that signs the passes numinia.com hands to a world.
# Make one with `node scripts/world-pass-keygen.mjs <path>`, then on Cloudflare:
# `npx wrangler secret put WORLD_PASS_PRIVATE_KEY`. Unset: «Entrar» sends everyone as a guest.
# WORLD_PASS_PRIVATE_KEY=
# `si` puts `acepto: {casa: <terms@…+privacy@…>}` in a person's pass when their session accepted the current legal corpus
# (condiciones/w5), so a world that declares `versionWeb` does not ask for those norms again. Leave it unset until the fleet's
# engines read the field: an older engine refuses a pass that carries it.
# WORLD_PASS_ACEPTO=
