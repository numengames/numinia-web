# Numinia Platform — environment variables
# Validated with Zod at boot (packages/domain/src/validators/env.ts).
# Missing REQUIRED vars crash the server before it binds — never silent runtime failure.

# --- Data source (REQUIRED) ---
GITHUB_REPO_OWNER=PabloFMM
GITHUB_REPO_NAME=numinia-digital-goods-data
GITHUB_BRANCH=main

# GitHub token — OPTIONAL in Phase 0 (public raw reads need no auth).
# Required later for write paths. Fine-grained, data repo only, Contents: Read.
GITHUB_TOKEN=

# --- Public ---
PUBLIC_SITE_URL=http://localhost:4321
